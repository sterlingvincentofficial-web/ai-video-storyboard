          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">ChatTags</string>
              <string name="Source"><![CDATA[--[[
	Adds a [VIP] tag in front of chat messages from VIP pass owners.
]]

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local ChatTags = {}

function ChatTags.start()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return
	end
	TextChatService.OnIncomingMessage = function(message: TextChatMessage): any
		local source = message.TextSource
		local player = source and Players:GetPlayerByUserId(source.UserId)
		if player and player:GetAttribute("VIP") then
			local properties = Instance.new("TextChatMessageProperties")
			properties.PrefixText = "<font color='#FFD24A'>[VIP]</font> " .. message.PrefixText
			return properties
		end
		return nil
	end
end

return ChatTags
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">DiverAnimator</string>
              <string name="Source"><![CDATA[--[[
	Animates every diver model locally from the attributes the server sets:
	Phase, PhaseStart, PhaseDuration, Home, Entry, DepthStuds, DepthMeters, GlowColor.

	Down:    jump off the diving board with a forward flip, then sink head-first into the dark
	Bottom:  search around with the flashlight
	Grabbed: struggle just under the surface while the Kraken holds on
	Up:      rise with the chest's glow getting brighter, then hop back onto the dock
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage").Shared
local Format = require(Shared.Util.Format)

local DiverAnimator = {}

local JUMP_SHARE = 0.18
local CLIMB_SHARE = 0.12
local FAR_DISTANCE = 260

type Tracked = {
	model: Model,
	lastPhase: string?,
	fromDepth: number,
	lastStatus: string,
	frame: number,
}

local tracked: { [Model]: Tracked } = {}

local function easeInOut(t: number): number
	return if t < 0.5 then 2 * t * t else 1 - (-2 * t + 2) ^ 2 / 2
end

local function easeOut(t: number): number
	return 1 - (1 - t) ^ 3
end

local function setStatus(entry: Tracked, text: string)
	if entry.lastStatus == text then
		return
	end
	entry.lastStatus = text
	local tag = entry.model:FindFirstChild("Tag")
	local status = tag and tag:FindFirstChild("Status")
	if status and status:IsA("TextLabel") then
		status.Text = text
	end
end

local function setLights(model: Model, underwater: boolean, glowColor: Color3?, glowStrength: number)
	local head = model:FindFirstChild("Head")
	local root = model.PrimaryPart
	if head then
		local flashlight = head:FindFirstChild("Flashlight") :: SpotLight?
		if flashlight then
			flashlight.Enabled = underwater
			flashlight.Face = Enum.NormalId.Top
		end
		local bubbles = head:FindFirstChild("Bubbles") :: ParticleEmitter?
		if bubbles then
			bubbles.Enabled = underwater
		end
	end
	if root then
		local glow = root:FindFirstChild("Glow") :: PointLight?
		if glow then
			glow.Enabled = glowColor ~= nil and glowStrength > 0
			if glowColor then
				glow.Color = glowColor
				glow.Brightness = 1 + glowStrength * 6
				glow.Range = 10 + glowStrength * 18
			end
		end
	end
end

local function update(entry: Tracked, now: number)
	local model = entry.model
	local home = model:GetAttribute("Home")
	local entryPoint = model:GetAttribute("Entry")
	local phase = model:GetAttribute("Phase")
	local start = model:GetAttribute("PhaseStart")
	local duration = model:GetAttribute("PhaseDuration")
	if typeof(home) ~= "CFrame" or typeof(entryPoint) ~= "Vector3" or type(phase) ~= "string" then
		return
	end
	if type(start) ~= "number" or type(duration) ~= "number" then
		return
	end

	if phase ~= entry.lastPhase then
		entry.fromDepth = if entry.lastPhase == "Grabbed"
			then 3
			else ((model:GetAttribute("DepthStuds") :: number?) or 20)
		entry.lastPhase = phase
	end

	local p = math.clamp((now - start) / math.max(duration, 0.01), 0, 1)
	local depthStuds: number = (model:GetAttribute("DepthStuds") :: number?) or 20
	local depthMeters: number = (model:GetAttribute("DepthMeters") :: number?) or 0
	local rotation = home - home.Position
	local forward = home.LookVector
	local bottom = entryPoint + Vector3.new(0, -depthStuds, 0) + forward * 6

	local position: Vector3
	local pitch = 0
	local glowStrength = 0
	local glowColor = model:GetAttribute("GlowColor")

	if phase == "Down" then
		if p < JUMP_SHARE then
			local s = p / JUMP_SHARE
			position = home.Position:Lerp(entryPoint, s) + Vector3.new(0, 6 * math.sin(math.pi * s), 0)
			pitch = -180 * s
		else
			local s = easeInOut((p - JUMP_SHARE) / (1 - JUMP_SHARE))
			position = entryPoint:Lerp(bottom, s)
			pitch = -180
		end
		setStatus(entry, "⬇ " .. Format.depth(depthMeters * math.max(0, (p - JUMP_SHARE) / (1 - JUMP_SHARE))))
	elseif phase == "Bottom" then
		position = bottom + Vector3.new(math.sin(now * 1.7) * 1.5, math.sin(now * 2.3) * 0.5, 0)
		pitch = -120 + math.sin(now * 2) * 15
		setStatus(entry, "🔦 Searching " .. Format.depth(depthMeters))
	elseif phase == "Grabbed" then
		position = entryPoint + Vector3.new(math.sin(now * 25) * 0.6, -3 + math.sin(now * 9) * 0.8, 0)
		pitch = math.sin(now * 12) * 30
		setStatus(entry, "🦑 GRABBED!")
	elseif phase == "Up" then
		local from = entryPoint + Vector3.new(0, -entry.fromDepth, 0) + forward * 6
		local climbStart = 1 - CLIMB_SHARE
		if p < climbStart then
			local s = easeOut(p / climbStart)
			position = from:Lerp(entryPoint, s)
			glowStrength = s
			local metres = depthMeters * (entry.fromDepth / math.max(depthStuds, 1))
			setStatus(entry, "⬆ " .. Format.depth(metres * (1 - s)))
		else
			local s = (p - climbStart) / CLIMB_SHARE
			position = entryPoint:Lerp(home.Position, s) + Vector3.new(0, 5 * math.sin(math.pi * s), 0)
			glowStrength = 1
			setStatus(entry, "Surfacing!")
		end
	else
		position = home.Position
		setStatus(entry, "Resting")
	end

	model:PivotTo(CFrame.new(position) * rotation * CFrame.Angles(math.rad(pitch), 0, 0))
	setLights(model, position.Y < -1, if typeof(glowColor) == "Color3" then glowColor else nil, glowStrength)
end

local function track(model: Instance)
	if model:IsA("Model") then
		tracked[model] = {
			model = model,
			lastPhase = nil,
			fromDepth = 20,
			lastStatus = "",
			frame = math.random(0, 9),
		}
	end
end

function DiverAnimator.start()
	for _, model in CollectionService:GetTagged("Diver") do
		track(model)
	end
	CollectionService:GetInstanceAddedSignal("Diver"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("Diver"):Connect(function(model)
		tracked[model :: Model] = nil
	end)

	RunService.RenderStepped:Connect(function()
		local now = Workspace:GetServerTimeNow()
		local camera = Workspace.CurrentCamera
		local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
		for model, entry in tracked do
			if model.Parent == nil then
				tracked[model] = nil
				continue
			end
			entry.frame += 1
			-- far away divers update less often
			local home = model:GetAttribute("Home")
			local far = typeof(home) == "CFrame" and (home.Position - cameraPosition).Magnitude > FAR_DISTANCE
			if not far or entry.frame % 10 == 0 then
				update(entry, now)
			end
		end
	end)
end

return DiverAnimator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">WorldFx</string>
              <string name="Source"><![CDATA[--[[
	Local world effects: spinning pedestal treasures, glitch flicker, tentacle sway,
	chest pops when divers surface and floating "+$" text when collecting.
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage").Shared
local Format = require(Shared.Util.Format)
local ModelFactory = require(Shared.ModelFactory)
local Remotes = require(Shared.Remotes)
local Zones = require(Shared.Config.Zones)

local Sounds = require(script.Parent.Parent.Sounds)

local WorldFx = {}

type Spinner = { model: Model, base: CFrame, angle: number, glitch: boolean }

local spinners: { [Model]: Spinner } = {}
local tentacles: { [Model]: CFrame } = {}

local GLITCH_COLORS = {
	Color3.fromRGB(255, 40, 200),
	Color3.fromRGB(40, 255, 240),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(120, 40, 255),
}

local function floatingText(position: Vector3, text: string, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	anchor.Parent = Workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 50)
	gui.AlwaysOnTop = true
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	TweenService
		:Create(anchor, TweenInfo.new(1.4, Enum.EasingStyle.Quad), { CFrame = anchor.CFrame + Vector3.new(0, 6, 0) })
		:Play()
	TweenService:Create(label, TweenInfo.new(1.4), { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, TweenInfo.new(1.4), { Transparency = 1 }):Play()
	Debris:AddItem(anchor, 1.5)
end

local function chestPop(diver: Instance, chestId: string, count: number, glow: Color3?)
	if not diver:IsA("Model") then
		return
	end
	local home = diver:GetAttribute("Home")
	if typeof(home) ~= "CFrame" then
		return
	end
	local camera = Workspace.CurrentCamera
	if camera and (camera.CFrame.Position - home.Position).Magnitude > 200 then
		return
	end
	local chest = Zones.ChestById[chestId]
	if not chest then
		return
	end
	local model = ModelFactory.chest(chestId)
	local start = home * CFrame.new(0, 7, 0)
	model:PivotTo(start)
	model.Parent = Workspace
	local value = Instance.new("NumberValue")
	value.Changed:Connect(function(alpha)
		model:PivotTo(start * CFrame.new(0, alpha * 5, 0) * CFrame.Angles(0, alpha * math.pi * 2, 0))
	end)
	TweenService:Create(value, TweenInfo.new(1.1, Enum.EasingStyle.Quad), { Value = 1 }):Play()
	Debris:AddItem(model, 1.2)
	Debris:AddItem(value, 1.2)
	local text = "+" .. (if count > 1 then count .. "x " else "") .. chest.name
	floatingText(start.Position, text, glow or chest.glow)
end

local function addSpinner(model: Instance)
	if model:IsA("Model") then
		spinners[model] = {
			model = model,
			base = model:GetPivot(),
			angle = math.random() * math.pi * 2,
			glitch = model:GetAttribute("Glitch") == true,
		}
	end
end

local function addTentacle(model: Instance)
	if model:IsA("Model") then
		tentacles[model] = model:GetPivot()
	end
end

function WorldFx.start()
	for _, model in CollectionService:GetTagged("SpinTreasure") do
		addSpinner(model)
	end
	CollectionService:GetInstanceAddedSignal("SpinTreasure"):Connect(addSpinner)
	CollectionService:GetInstanceRemovedSignal("SpinTreasure"):Connect(function(model)
		spinners[model :: Model] = nil
	end)
	for _, model in CollectionService:GetTagged("Tentacle") do
		addTentacle(model)
	end
	CollectionService:GetInstanceAddedSignal("Tentacle"):Connect(addTentacle)
	CollectionService:GetInstanceRemovedSignal("Tentacle"):Connect(function(model)
		tentacles[model :: Model] = nil
	end)

	local glitchTimer = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		glitchTimer += dt
		local flicker = glitchTimer > 0.12
		if flicker then
			glitchTimer = 0
		end
		for model, spinner in spinners do
			if model.Parent == nil then
				spinners[model] = nil
				continue
			end
			spinner.angle += dt * 1.2
			model:PivotTo(
				spinner.base
					* CFrame.new(0, math.sin(t * 2 + spinner.angle) * 0.25, 0)
					* CFrame.Angles(0, spinner.angle, 0)
			)
			if spinner.glitch and flicker then
				for _, part in model:GetDescendants() do
					if part:IsA("BasePart") and part.Transparency < 1 then
						part.Color = GLITCH_COLORS[math.random(1, #GLITCH_COLORS)]
					end
				end
			end
		end
		for model, base in tentacles do
			if model.Parent == nil then
				tentacles[model] = nil
				continue
			end
			model:PivotTo(base * CFrame.Angles(math.sin(t * 3) * 0.25, 0, math.cos(t * 2.4) * 0.3))
		end
	end)

	Remotes.event("DiveFx").OnClientEvent:Connect(chestPop)
	Remotes.event("CollectFx").OnClientEvent:Connect(function(position: Vector3, amount: number)
		floatingText(position, "+" .. Format.money(amount), Color3.fromRGB(120, 255, 130))
		Sounds.play("Coin", 0.5, 1 + math.random() * 0.2)
	end)
end

return WorldFx
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="50">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client entry point.
]]

local Players = game:GetService("Players")

local State = require(script.Parent.State)
local App = require(script.Parent.UI.App)
local DiverAnimator = require(script.Parent.Controllers.DiverAnimator)
local WorldFx = require(script.Parent.Controllers.WorldFx)
local ChatTags = require(script.Parent.Controllers.ChatTags)

State.start()
App.start()
DiverAnimator.start()
WorldFx.start()
ChatTags.start()

local player = Players.LocalPlayer
if not player:GetAttribute("Ready") then
	player:GetAttributeChangedSignal("Ready"):Wait()
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--[[
	Calls server actions. Net.try shows the error as a toast when the action fails.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Remotes = require(Shared.Remotes)

local Net = {}

Net.onError = nil :: ((string) -> ())?

function Net.action(name: string, ...: any): { [string]: any }
	local remote = Remotes.func("Action")
	local ok, response = pcall(remote.InvokeServer, remote, name, ...)
	if not ok or type(response) ~= "table" then
		return { ok = false, err = "Connection problem, try again" }
	end
	return response
end

function Net.try(name: string, ...: any): { [string]: any }
	local response = Net.action(name, ...)
	if not response.ok and response.err and Net.onError then
		Net.onError(response.err)
	end
	return response
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--[[
	UI sounds using Roblox's built-in sound files (no uploads needed).
	Swap the ids for your own audio later.
]]

local SoundService = game:GetService("SoundService")

local Sounds = {}

local IDS = {
	Click = "rbxasset://sounds/button.wav",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Reveal = "rbxasset://sounds/electronicpingshort.wav",
}

local cache: { [string]: Sound } = {}

function Sounds.play(name: string, volume: number?, pitch: number?)
	local id = IDS[name]
	if not id then
		return
	end
	local sound: Sound = cache[name] or Instance.new("Sound")
	if not cache[name] then
		sound.SoundId = id
		sound.Parent = SoundService
		cache[name] = sound
	end
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	Client-side copy of the player's state, pushed by the server through DataSync.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage").Shared
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Util.Signal)

local State = {}

State.Changed = Signal.new()
State.EventsChanged = Signal.new()
State.sync = nil :: { [string]: any }?
State.events = {} :: { [string]: any }

local receivedAt = os.clock()

function State.data(): { [string]: any }?
	local sync = State.sync
	return sync and sync.data
end

function State.get(key: string): any
	local sync = State.sync
	return sync and sync[key]
end

function State.cash(): number
	local cash = Players.LocalPlayer:GetAttribute("Cash")
	if type(cash) == "number" then
		return cash
	end
	local data = State.data()
	return data and data.cash or 0
end

-- Server os.time() right now, estimated from the last sync.
function State.osTime(): number
	local sync = State.sync
	if not sync then
		return os.time()
	end
	return sync.osTime + (os.clock() - receivedAt)
end

function State.hasPass(passId: string): boolean
	local sync = State.sync
	return sync ~= nil and sync.passes ~= nil and sync.passes[passId] == true
end

function State.start()
	Remotes.event("DataSync").OnClientEvent:Connect(function(payload)
		State.sync = payload
		receivedAt = os.clock()
		State.Changed:Fire(payload)
	end)
	Remotes.event("EventState").OnClientEvent:Connect(function(events)
		State.events = events
		State.EventsChanged:Fire(events)
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="54">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">App</string>
              <string name="Source"><![CDATA[--[[
	Builds the whole screen UI: HUD (cash, income, boosts, events, tutorial), left menu,
	quick-buy buttons on the right, and the panel window that hosts every menu panel.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Notifications = require(script.Parent.Notifications)
local Reveal = require(script.Parent.Reveal)
local Panels = script.Parent.Panels
local Client = script.Parent.Parent
local State = require(Client.State)
local Net = require(Client.Net)
local Sounds = require(Client.Sounds)

local App = {}

type PanelModule = {
	title: string,
	color: Color3,
	build: (Frame) -> (),
	refresh: () -> (),
	onClose: () -> (),
	Shop: any?,
}

local MENU = {
	{ id = "Roll", icon = "🎲", label = "Roll", color = Theme.Blue },
	{ id = "Divers", icon = "🤿", label = "Divers", color = Theme.Cyan },
	{ id = "Vault", icon = "💎", label = "Vault", color = Theme.Purple },
	{ id = "Chests", icon = "📦", label = "Chests", color = Theme.Orange },
	{ id = "Index", icon = "📖", label = "Index", color = Theme.Gold },
	{ id = "Upgrades", icon = "⬆", label = "Upgrade", color = Theme.Green },
	{ id = "Rebirth", icon = "♻", label = "Rebirth", color = Color3.fromRGB(255, 170, 40) },
	{ id = "Shop", icon = "🛒", label = "Shop", color = Theme.Red },
}

local panels: { [string]: PanelModule } = {}
local panelContent: { [string]: Frame } = {}
local openPanel: string? = nil
local window: Frame
local windowTitle: TextLabel
local windowBar: Frame
local badges: { [string]: TextLabel } = {}

local cashLabel: TextLabel
local incomeLabel: TextLabel
local boostRow: Frame
local tutorialLabel: TextLabel
local tutorialFrame: Frame
local quickButtons: { [string]: TextButton } = {}
local krakenBar: Frame
local krakenFill: Frame
local krakenText: TextLabel

-- Panel window ------------------------------------------------------------------------------

function App.open(id: string)
	if openPanel == id then
		App.close()
		return
	end
	if openPanel then
		panelContent[openPanel].Visible = false
		panels[openPanel].onClose()
	end
	openPanel = id
	local panel = panels[id]
	windowTitle.Text = panel.title
	windowBar.BackgroundColor3 = panel.color
	panelContent[id].Visible = true
	window.Visible = true
	local scale = window:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.85
	TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	panel.refresh()
end

function App.close()
	if openPanel then
		panelContent[openPanel].Visible = false
		panels[openPanel].onClose()
	end
	openPanel = nil
	window.Visible = false
end

local function buildWindow(root: Frame)
	window = Kit.new("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.52, 0.53),
		Size = UDim2.fromScale(0.66, 0.72),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		ZIndex = 10,
		Parent = root,
	}, { Kit.corner(18), Kit.stroke(4) })
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(980, 620), MinSize = Vector2.new(340, 300), Parent = window })
	Kit.new("UIScale", { Parent = window })
	windowBar = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = Theme.Blue,
		Parent = window,
	}, { Kit.corner(18) })
	-- square off the bottom of the title bar
	Kit.new("Frame", {
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = windowBar,
	})
	windowBar:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
		for _, child in windowBar:GetChildren() do
			if child:IsA("Frame") then
				child.BackgroundColor3 = windowBar.BackgroundColor3
			end
		end
	end)
	windowTitle = Kit.text({
		Text = "",
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -90, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 34,
		StrokeThickness = 3,
		ZIndex = 2,
		Parent = windowBar,
	})
	Kit.button({
		Text = "X",
		Color = Theme.Red,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 6),
		Size = UDim2.fromOffset(44, 40),
		ZIndex = 3,
		Parent = windowBar,
		OnClick = App.close,
	})

	for _, entry in MENU do
		local module = (require :: any)(Panels:WaitForChild(entry.id)) :: PanelModule
		panels[entry.id] = module
		local content = Kit.new("Frame", {
			Name = entry.id,
			Position = UDim2.fromOffset(14, 62),
			Size = UDim2.new(1, -28, 1, -76),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = window,
		})
		panelContent[entry.id] = content
		module.build(content)
	end
end

-- HUD ----------------------------------------------------------------------------------------

local function buildMenu(root: Frame)
	local menu = Kit.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.52, 0),
		Size = UDim2.fromOffset(160, 400),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(74, 74),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	for order, entry in MENU do
		local button = Kit.new("TextButton", {
			BackgroundColor3 = entry.color,
			Text = "",
			LayoutOrder = order,
			Parent = menu,
		}, { Kit.corner(14), Kit.stroke(3) })
		Kit.text({
			Text = entry.icon,
			Position = UDim2.fromScale(0.1, 0.02),
			Size = UDim2.fromScale(0.8, 0.62),
			MaxTextSize = 40,
			Parent = button,
		})
		Kit.text({
			Text = entry.label,
			Position = UDim2.fromScale(0.02, 0.64),
			Size = UDim2.fromScale(0.96, 0.32),
			MaxTextSize = 18,
			Parent = button,
		})
		local badge = Kit.text({
			Text = "!",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.92, 0.08),
			Size = UDim2.fromOffset(28, 28),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Red,
			MaxTextSize = 18,
			Visible = false,
			ZIndex = 3,
			Parent = button,
		})
		Kit.corner(14).Parent = badge
		badges[entry.id] = badge
		button.Activated:Connect(function()
			Sounds.play("Click", 0.3)
			App.open(entry.id)
		end)
	end
end

local function buildTopBar(root: Frame)
	local top = Kit.new("Frame", {
		Name = "Cash",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(320, 84),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local pill = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = Theme.PanelDark,
		BackgroundTransparency = 0.15,
		Parent = top,
	}, { Kit.corner(26), Kit.stroke(3) })
	cashLabel = Kit.text({
		Text = "$0",
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		TextColor3 = Theme.Money,
		MaxTextSize = 42,
		StrokeThickness = 3,
		Parent = pill,
	})
	incomeLabel = Kit.text({
		Text = "",
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 24),
		TextColor3 = Theme.Text,
		MaxTextSize = 22,
		Parent = top,
	})

	boostRow = Kit.new("Frame", {
		Name = "Boosts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.fromOffset(700, 30),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		Parent = boostRow,
	})

	tutorialFrame = Kit.new("Frame", {
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 124),
		Size = UDim2.fromOffset(560, 40),
		BackgroundColor3 = Theme.Gold,
		Visible = false,
		Parent = root,
	}, { Kit.corner(20), Kit.stroke(3) })
	tutorialLabel = Kit.text({
		Text = "",
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		MaxTextSize = 22,
		Parent = tutorialFrame,
	})

	krakenBar = Kit.new("Frame", {
		Name = "KrakenBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 168),
		Size = UDim2.fromOffset(420, 30),
		BackgroundColor3 = Theme.PanelDark,
		Visible = false,
		Parent = root,
	}, { Kit.corner(12), Kit.stroke(3) })
	krakenFill = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(200, 60, 200),
		Parent = krakenBar,
	}, { Kit.corner(12) })
	krakenText = Kit.text({
		Text = "",
		Size = UDim2.fromScale(1, 1),
		MaxTextSize = 20,
		ZIndex = 2,
		Parent = krakenBar,
	})
end

local function buildQuickShop(root: Frame)
	local holder = Kit.new("Frame", {
		Name = "QuickShop",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 70),
		Size = UDim2.fromOffset(170, 220),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = holder })
	local entries: { { id: string, text: string, color: Color3, product: boolean? } } = {
		{ id = "StarterPack", text = "🎁 Starter Pack", color = Theme.Purple, product = true },
		{ id = "DoubleMoney", text = "💰 x2 Money", color = Theme.Green },
		{ id = "AutoCollect", text = "🧲 Auto Collect", color = Theme.Red },
		{ id = "AutoOpen", text = "📦 Auto Open", color = Theme.Orange },
	}
	for order, entry in entries do
		quickButtons[entry.id] = Kit.button({
			Text = entry.text,
			Color = entry.color,
			Size = UDim2.new(1, 0, 0, 42),
			LayoutOrder = order,
			Parent = holder,
			OnClick = function()
				local shop = panels.Shop.Shop
				if entry.product then
					shop.buyProduct(entry.id)
				else
					shop.buyPass(entry.id)
				end
			end,
		})
	end
end

-- Live updates ----------------------------------------------------------------------------

local function boostChip(text: string, color: Color3): TextLabel
	local chip = Kit.text({
		Text = text,
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		TextScaled = false,
		TextSize = 18,
		BackgroundTransparency = 0.1,
		BackgroundColor3 = color,
		Parent = boostRow,
	})
	Kit.corner(12).Parent = chip
	Kit.padding(4).Parent = chip
	return chip
end

local function updateBoosts()
	for _, child in boostRow:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local data = State.data()
	if data and data.luckPotionEnds > State.osTime() then
		boostChip("🍀 x2 Luck " .. Format.duration(data.luckPotionEnds - State.osTime()), Theme.Green)
	end
	local serverNow = Workspace:GetServerTimeNow()
	for _, name in { "LowTide", "BloodMoon", "Kraken" } do
		local event = State.events[name]
		if event and event.active then
			boostChip(event.title .. " " .. Format.duration(event.endsAt - serverNow), event.color)
		end
	end
	local rebirths = data and data.rebirths or 0
	if rebirths > 0 then
		boostChip("♻ x" .. tostring(Formulas.rebirthMultiplier(rebirths)) .. " income", Color3.fromRGB(200, 140, 30))
	end
end

local function updateKraken()
	local kraken = Workspace:FindFirstChild("Kraken")
	local health = kraken and kraken:GetAttribute("Health")
	local maxHealth = kraken and kraken:GetAttribute("MaxHealth")
	if type(health) == "number" and type(maxHealth) == "number" and maxHealth > 0 then
		krakenBar.Visible = true
		krakenFill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
		krakenText.Text = ("🦑 KRAKEN  %d / %d  - click it!"):format(health, maxHealth)
	else
		krakenBar.Visible = false
	end
end

local function tutorialText(data): string?
	local stats = data.stats
	if stats.dives == 0 then
		return "Your diver is exploring the dark trench... wait for them to surface!"
	elseif stats.chestsOpened == 0 then
		return "Open your chest! Tap 📦 Chests"
	elseif stats.collected == 0 then
		return "Walk onto the green pad in front of your treasure to collect cash"
	elseif stats.rolls == 0 then
		return "Roll a new diver! Tap 🎲 Roll"
	elseif data.upgrades.DiveSlots == 0 and data.upgrades.Pedestals == 0 then
		return "Buy an upgrade to grow your dock! Tap ⬆ Upgrade"
	end
	return nil
end

local function updateHud()
	local data = State.data()
	if not data then
		return
	end
	cashLabel.Text = Format.money(State.cash())
	incomeLabel.Text = "+" .. Format.perSecond(State.get("income") or 0)

	local chests = #data.chests
	badges.Chests.Visible = chests > 0
	badges.Chests.Text = if chests > 99 then "99+" else tostring(chests)
	local canRebirth = State.cash() >= Formulas.rebirthCost(data.rebirths)
	badges.Rebirth.Visible = canRebirth

	local text = tutorialText(data)
	tutorialFrame.Visible = text ~= nil
	tutorialLabel.Text = text or ""

	for passId, button in quickButtons do
		if passId == "StarterPack" then
			button.Visible = not data.starterPackClaimed
		else
			button.Visible = not State.hasPass(passId)
		end
	end
end

-- Entry ------------------------------------------------------------------------------------

function App.start()
	local player = Players.LocalPlayer
	local gui = Kit.new("ScreenGui", {
		Name = "RollADiver",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local root = Kit.new("Frame", {
		Name = "Root",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	-- shrink the UI on small screens (phones)
	local uiScale = Kit.new("UIScale", { Parent = root })
	local function rescale()
		local camera = Workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			local scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.55, 1.15)
			uiScale.Scale = scale
			root.Size = UDim2.fromScale(1 / scale, 1 / scale)
		end
	end
	rescale()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	Notifications.mount(root)
	Reveal.mount(root)
	buildTopBar(root)
	buildMenu(root)
	buildWindow(root)
	buildQuickShop(root)

	Net.onError = function(message)
		Notifications.toast(message, "Error")
	end

	Remotes.event("Notify").OnClientEvent:Connect(function(text, kind)
		Notifications.toast(text, kind)
		if kind == "Chest" then
			Sounds.play("Coin", 0.25, 1.4)
		end
	end)
	Remotes.event("Announce").OnClientEvent:Connect(function(text, color)
		Notifications.announce(text, color)
	end)
	Remotes.event("OfflineEarnings").OnClientEvent:Connect(function(seconds, amount)
		task.delay(1.5, Reveal.offline, seconds, amount)
	end)

	-- refresh the open panel when data changes (throttled)
	local pending = false
	State.Changed:Connect(function()
		updateHud()
		if openPanel and not pending then
			pending = true
			task.delay(0.15, function()
				pending = false
				if openPanel then
					panels[openPanel].refresh()
				end
			end)
		end
	end)
	player:GetAttributeChangedSignal("Cash"):Connect(function()
		cashLabel.Text = Format.money(State.cash())
	end)

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 0.5 then
			elapsed = 0
			updateBoosts()
			updateKraken()
		end
	end)
end

return App
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--[[
	Small helpers for building UI in code: instances, text, buttons, panels, grids and viewports.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Sounds = require(script.Parent.Parent.Sounds)

local Kit = {}

-- Creates an instance, applies properties and parents children.
function Kit.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className)
	local parent = nil
	local properties: { [string]: any } = props or {}
	local childList: { any } = children or {}
	for key, value in properties do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in childList do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Kit.corner(radius: number?): any
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Kit.stroke(thickness: number?, color: Color3?): any
	return Kit.new("UIStroke", {
		Thickness = thickness or 2,
		Color = color or Theme.Stroke,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.padding(pixels: number): UIPadding
	local p = UDim.new(0, pixels)
	return Kit.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

-- Outlined cartoon text.
function Kit.text(props: { [string]: any }): TextLabel
	local label = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Text,
		TextScaled = true,
		Text = "",
	})
	for key, value in props do
		-- StrokeThickness / MaxTextSize are helper options, not TextLabel properties
		if key ~= "Parent" and key ~= "StrokeThickness" and key ~= "MaxTextSize" then
			(label :: any)[key] = value
		end
	end
	Kit.new("UIStroke", { Thickness = props.StrokeThickness or 2, Color = Theme.Stroke, Parent = label })
	if props.TextScaled ~= false then
		Kit.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 40, Parent = label })
	end
	label.Parent = props.Parent
	return label
end

-- Rainbow / special gradient for Divine and Secret items.
function Kit.rainbow(target: GuiObject | UIStroke)
	return Kit.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 80)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 255, 140)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 170, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
		}),
		Parent = target,
	})
end

export type ButtonProps = {
	Text: string,
	Color: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	Parent: Instance?,
	OnClick: (() -> ())?,
	TextColor: Color3?,
	ZIndex: number?,
}

function Kit.button(props: ButtonProps): TextButton
	local color = props.Color or Theme.Green
	local button = Kit.new("TextButton", {
		Size = props.Size or UDim2.fromOffset(120, 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = true,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	}, { Kit.corner(10), Kit.stroke(3) })
	Kit.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)),
		Rotation = 90,
		Parent = button,
	})
	Kit.text({
		Name = "Label",
		Text = props.Text,
		Size = UDim2.fromScale(0.9, 0.8),
		Position = UDim2.fromScale(0.05, 0.1),
		TextColor3 = props.TextColor or Theme.Text,
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = button,
	})
	local scale = Kit.new("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	button.MouseLeave:Connect(function()
		scale.Scale = 1
	end)
	if props.OnClick then
		local onClick = props.OnClick
		button.Activated:Connect(function()
			Sounds.play("Click", 0.3)
			onClick()
		end)
	end
	button.Parent = props.Parent
	return button
end

function Kit.setButton(button: TextButton, text: string?, color: Color3?)
	local label = button:FindFirstChild("Label") :: TextLabel?
	if label and text then
		label.Text = text
	end
	if color then
		button.BackgroundColor3 = color
	end
end

-- Scrolling grid that grows with its content.
function Kit.grid(parent: Instance, cellSize: UDim2, padding: number?): ScrollingFrame
	local frame = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.SubText,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	Kit.new("UIGridLayout", {
		CellSize = cellSize,
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = frame,
	})
	Kit.padding(6).Parent = frame
	return frame
end

function Kit.list(parent: Instance, padding: number?, horizontal: boolean?): ScrollingFrame
	local frame = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.SubText,
		AutomaticCanvasSize = if horizontal then Enum.AutomaticSize.X else Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = if horizontal then Enum.ScrollingDirection.X else Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	Kit.new("UIListLayout", {
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = frame,
	})
	Kit.padding(6).Parent = frame
	return frame
end

-- Shows a model in a ViewportFrame, framed to fit.
function Kit.viewport(parent: Instance, model: Model, props: { [string]: any }?): ViewportFrame
	local viewport = Kit.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(200, 200, 210),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -1, -1),
	})
	local properties: { [string]: any } = props or {}
	for key, value in properties do
		(viewport :: any)[key] = value
	end
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	model:PivotTo(CFrame.new())
	model.Parent = viewport
	local _, size = model:GetBoundingBox()
	local radius = math.max(size.X, size.Y, size.Z) * 0.5
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 1.25
	local centre = model:GetBoundingBox().Position
	camera.CFrame = CFrame.lookAt(centre + Vector3.new(distance * 0.35, distance * 0.25, -distance), centre)
	viewport.Parent = parent
	return viewport
end

function Kit.clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

return Kit
]]></string>
