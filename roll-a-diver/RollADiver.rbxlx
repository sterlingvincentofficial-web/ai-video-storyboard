		look = { suit = rgb(170, 150, 120), accent = rgb(200, 150, 50), skin = SKIN_A, helmet = "Brass" },
	},
	{
		id = "AnglerfishAndy",
		name = "Anglerfish Andy",
		tier = "Abyssal",
		maxDepth = 8000,
		luck = 13,
