	},
}

local chests: { Chest } = {
	{
		id = "RustyCrate",
		name = "Rusty Crate",
		zone = "Shallows",
		color = Color3.fromRGB(140, 95, 60),
		glow = Color3.fromRGB(235, 235, 235),
	},
	{
		id = "CoralChest",
		name = "Coral Chest",
		zone = "Reef",
		color = Color3.fromRGB(255, 125, 110),
		glow = Color3.fromRGB(95, 220, 110),
	},
	{
		id = "PirateChest",
		name = "Pirate Chest",
		zone = "Shipwreck",
		color = Color3.fromRGB(120, 70, 35),
		glow = Color3.fromRGB(70, 150, 255),
	},
	{
		id = "GlowingCoffer",
		name = "Glowing Coffer",
		zone = "Twilight",
		color = Color3.fromRGB(70, 80, 200),
		glow = Color3.fromRGB(175, 85, 255),
	},
	{
		id = "AbyssalRelicBox",
		name = "Abyssal Relic Box",
		zone = "Abyss",
		color = Color3.fromRGB(45, 20, 30),
		glow = Color3.fromRGB(235, 40, 45),
	},
	{
		id = "AtlanteanVault",
		name = "Atlantean Vault",
		zone = "Atlantis",
		color = Color3.fromRGB(60, 200, 170),
		glow = Color3.fromRGB(150, 255, 245),
	},
	{
		id = "UnknownBox",
		name = "??? Box",
		zone = "Bottom",
		color = Color3.fromRGB(15, 15, 18),
		glow = Color3.fromRGB(255, 255, 255),
	},
}

local zoneById: { [string]: Zone } = {}
for index, zone in zones do
	zone.index = index
	zoneById[zone.id] = zone
end

local chestById: { [string]: Chest } = {}
for _, chest in chests do
	chestById[chest.id] = chest
end

return {
	List = zones,
	ById = zoneById,
	Chests = chests,
	ChestById = chestById,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--[[
	All game math in one place. Pure functions, no Roblox services,
	so the server, the client and the offline tests use exactly the same rules.

	`rand` arguments are functions returning a number in [0, 1).
]]

local Config = script.Parent.Config
local GameConfig = require(Config.Game)
local Zones = require(Config.Zones)
local Treasures = require(Config.Treasures)
local Conditions = require(Config.Conditions)
local Divers = require(Config.Divers)
local Crates = require(Config.Crates)
local Sets = require(Config.Sets)
local Upgrades = require(Config.Upgrades)
local Rarities = require(Config.Rarities)

local Formulas = {}

export type Rand = () -> number

-- Luck ------------------------------------------------------------------------------------

-- Luck flattens "1 in N" odds: weight = N ^ -exponent, exponent shrinks as luck grows.
function Formulas.luckExponent(luck: number): number
	luck = math.max(luck, 1)
	return 1 / (1 + GameConfig.LuckCurve * math.log(luck))
end

function Formulas.weightFor(odds: number, luck: number): number
	return odds ^ -Formulas.luckExponent(luck)
end

-- Returns the index picked from a list of positive weights.
function Formulas.pickWeighted(weights: { number }, rand: Rand): number
	local total = 0
	for _, weight in weights do
		total += weight
	end
	local roll = rand() * total
	for index, weight in weights do
		roll -= weight
		if roll < 0 then
			return index
		end
	end
	return #weights
end

-- Chance (0..1) of each entry given odds and luck. Used by the UI to show real odds.
function Formulas.chances(oddsList: { number }, luck: number): { number }
	local weights = {}
	local total = 0
	for index, odds in oddsList do
		weights[index] = Formulas.weightFor(odds, luck)
		total += weights[index]
	end
	for index, weight in weights do
		weights[index] = weight / total
	end
	return weights
end

-- Rolls -----------------------------------------------------------------------------------

function Formulas.rollCrate(crateId: string, luck: number, rand: Rand): string
	local crate = Crates.ById[crateId]
	assert(crate, "Unknown crate " .. tostring(crateId))
	local weights = {}
	for index, entry in crate.pool do
		weights[index] = Formulas.weightFor(entry.odds, luck)
	end
	return crate.pool[Formulas.pickWeighted(weights, rand)].diver
end

-- Highest zone index the player has unlocked through rebirths.
function Formulas.unlockedZoneIndex(rebirths: number): number
	local best = 1
	for index, zone in Zones.List do
		if zone.rebirthReq <= rebirths then
			best = index
		end
	end
	return best
end

-- Zone indices a diver can reach given its depth and the player's zone cap.
function Formulas.reachableZones(maxDepth: number, zoneCap: number): { number }
	local result = {}
	for index, zone in Zones.List do
		if index <= zoneCap and zone.minDepth < maxDepth then
			table.insert(result, index)
		end
	end
	if #result == 0 then
		result[1] = 1
	end
	return result
end

-- Deeper zones are more likely: weight doubles with each zone.
function Formulas.rollZone(reachable: { number }, rand: Rand): number
	local weights = {}
	for index, zoneIndex in reachable do
		weights[index] = 2 ^ zoneIndex
	end
	return reachable[Formulas.pickWeighted(weights, rand)]
end

function Formulas.rollTreasure(zoneId: string, luck: number, noCommon: boolean?, rand: Rand): string
	local pool = Treasures.ByZone[zoneId]
	assert(pool, "No treasures for zone " .. tostring(zoneId))
	local candidates = {}
	local weights = {}
	for _, treasure in pool do
		if not (noCommon and treasure.rarity == "Common") then
			table.insert(candidates, treasure)
			table.insert(weights, Formulas.weightFor(treasure.odds, luck))
		end
	end
	if #candidates == 0 then
		return pool[1].id
	end
	return candidates[Formulas.pickWeighted(weights, rand)].id
end

-- Conditions use a softer luck (square root) so variants stay special.
function Formulas.rollCondition(luck: number, cursedMult: number?, rand: Rand): string
	local conditionLuck = math.sqrt(math.max(luck, 1))
	local weights = {}
	for index, condition in Conditions.List do
		local weight = Formulas.weightFor(condition.odds, conditionLuck)
		if condition.id == "Cursed" and cursedMult then
			weight *= cursedMult
		end
		weights[index] = weight
	end
	return Conditions.List[Formulas.pickWeighted(weights, rand)].id
end

-- Dives -----------------------------------------------------------------------------------

function Formulas.diveDuration(deepestZoneIndex: number, speed: number): number
	local base = GameConfig.DiveBaseTime + GameConfig.DiveTimePerZone * deepestZoneIndex
	return base / math.max(speed, 0.1)
end

-- Visual depth of the dive model in studs for a real depth in metres.
function Formulas.depthToStuds(metres: number): number
	return math.clamp(18 + math.sqrt(metres) * 2.6, 18, 300)
end

-- Income ----------------------------------------------------------------------------------

function Formulas.treasureBaseIncome(treasureId: string): number
	local treasure = Treasures.ById[treasureId]
	if not treasure then
		return 0
	end
	local zone = Zones.ById[treasure.zone]
	return zone.valueBase * treasure.odds ^ 0.55
end

function Formulas.conditionMult(conditionId: string?): number
	local condition = conditionId and Conditions.ById[conditionId]
	return if condition then condition.mult else 1
end

-- Income of a single treasure before player-wide multipliers.
function Formulas.treasureIncome(treasureId: string, conditionId: string?): number
	return Formulas.treasureBaseIncome(treasureId) * Formulas.conditionMult(conditionId)
end

function Formulas.treasureSellValue(treasureId: string, conditionId: string?): number
	return math.floor(Formulas.treasureIncome(treasureId, conditionId) * GameConfig.SellValueSeconds + 0.5)
end

-- Returns { [treasureId] = bonus } for every set fully present in `placedIds`.
function Formulas.setBonuses(placedIds: { [string]: boolean }): { [string]: number }
	local bonuses = {}
	for _, set in Sets.List do
		local complete = true
		for _, itemId in set.items do
			if not placedIds[itemId] then
				complete = false
				break
			end
		end
		if complete then
			for _, itemId in set.items do
				bonuses[itemId] = (bonuses[itemId] or 0) + set.bonus
			end
		end
	end
	return bonuses
end

export type IncomeContext = {
	rebirths: number,
	doubleMoney: boolean?,
	vip: boolean?,
	indexZonesComplete: number?,
}

function Formulas.rebirthMultiplier(rebirths: number): number
	return 1 + GameConfig.RebirthIncomeBonus * rebirths
end

function Formulas.incomeMultiplier(ctx: IncomeContext): number
	local mult = Formulas.rebirthMultiplier(ctx.rebirths)
	if ctx.doubleMoney then
		mult *= 2
	end
	if ctx.vip then
		mult *= 1.1
	end
	mult *= 1 + GameConfig.IndexZoneBonus * (ctx.indexZonesComplete or 0)
	return mult
end

-- Costs -----------------------------------------------------------------------------------

function Formulas.rebirthCost(rebirths: number): number
	return GameConfig.RebirthBaseCost * GameConfig.RebirthCostGrowth ^ rebirths
end

function Formulas.upgradeCost(upgradeId: string, level: number): number?
	local upgrade = Upgrades.ById[upgradeId]
	if not upgrade or level >= upgrade.maxLevel then
		return nil
	end
	return math.floor(upgrade.baseCost * upgrade.growth ^ level + 0.5)
end

function Formulas.diveSlotCount(slotLevel: number, hasExtraSlotsPass: boolean?): number
	local count = GameConfig.BaseDiveSlots + slotLevel + (if hasExtraSlotsPass then 2 else 0)
	return math.min(count, GameConfig.MaxDiveSlots)
end

function Formulas.pedestalCount(pedestalLevel: number): number
	return math.min(GameConfig.BasePedestals + pedestalLevel, GameConfig.MaxPedestals)
end

function Formulas.luckUpgradeMult(level: number): number
	return 1 + 0.1 * level
end

function Formulas.speedUpgradeMult(level: number): number
	return 1 + 0.08 * level
end

-- Cheapest roll that can give this diver, times the configured share.
function Formulas.diverSellValue(diverId: string): number
	local cheapest = math.huge
	for _, crate in Crates.List do
		for _, entry in crate.pool do
			if entry.diver == diverId then
				cheapest = math.min(cheapest, crate.price)
			end
		end
	end
	if cheapest == math.huge then
		cheapest = 100
	end
	return math.floor(cheapest * GameConfig.DiverSellShare)
end

-- Sorting helpers ---------------------------------------------------------------------------

-- Rough strength of a diver for "equip best": rarity first, then luck and speed.
function Formulas.diverScore(diverId: string): number
	local diver = Divers.ById[diverId]
	if not diver then
		return 0
	end
	local rank = Rarities.ById[diver.tier].rank
	return rank * 1000 + diver.luck * 10 + diver.speed
end

-- Index ------------------------------------------------------------------------------------

export type IndexData = { [string]: { [string]: boolean } }

-- A zone page is complete when every treasure of that zone was found in any condition.
function Formulas.zoneIndexComplete(index: IndexData, zoneId: string): boolean
	local pool = Treasures.ByZone[zoneId]
	if not pool then
		return false
	end
	for _, treasure in pool do
		if not index[treasure.id] then
			return false
		end
	end
	return true
end

function Formulas.indexZonesComplete(index: IndexData): number
	local count = 0
	for _, zone in Zones.List do
		if Formulas.zoneIndexComplete(index, zone.id) then
			count += 1
		end
	end
	return count
end

-- Returns found treasures, total treasures, found variants, total variants.
function Formulas.indexProgress(index: IndexData): (number, number, number, number)
	local found, variants = 0, 0
	for _, treasure in Treasures.List do
		local entry = index[treasure.id]
		if entry then
			found += 1
			for _ in entry do
				variants += 1
			end
		end
	end
	return found, #Treasures.List, variants, #Treasures.List * #Conditions.List
end

function Formulas.offlineEarnings(seconds: number, incomePerSecond: number, vip: boolean?): number
	local capHours = if vip then GameConfig.OfflineCapHoursVIP else GameConfig.OfflineCapHours
	local capped = math.clamp(seconds, 0, capHours * 3600)
	return math.floor(capped * incomePerSecond * GameConfig.OfflineShare)
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[--[[
	Builds every model in the game out of plain parts, so the place needs no uploaded assets.
	Used by the server (world models) and the client (viewport previews in the UI).

	All returned models are anchored, non-colliding and have a PrimaryPart named "Root"
	at the model's base (feet for divers, centre for treasures and chests).
]]

local Config = script.Parent.Config
local Divers = require(Config.Divers)
local Treasures = require(Config.Treasures)
local Conditions = require(Config.Conditions)
local Zones = require(Config.Zones)
local Rarities = require(Config.Rarities)

local ModelFactory = {}

local FACE_TEXTURE = "rbxasset://textures/face.png"

type PartProps = {
	name: string?,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?,
	transparency: number?,
	reflectance: number?,
	ellipsoid: boolean?, -- stretched sphere (Ball parts are always perfectly round)
}

local function makePart(model: Model, root: BasePart, props: PartProps): Part
	local part = Instance.new("Part")
	part.Name = props.name or "Part"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Shape = props.shape or Enum.PartType.Block
	part.Size = props.size
	part.Color = props.color
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Transparency = props.transparency or 0
	part.Reflectance = props.reflectance or 0
	part.CFrame = root.CFrame * props.cframe
	if props.ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	part.Parent = model
	return part
end

local function newModel(name: string, rootSize: Vector3?): (Model, Part)
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Transparency = 1
	root.Size = rootSize or Vector3.new(1, 1, 1)
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root
	return model, root
end

local function cf(x: number, y: number, z: number, rx: number?, ry: number?, rz: number?): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
end

-- Divers ---------------------------------------------------------------------------------------

local GLASS = Color3.fromRGB(140, 220, 255)
local BRASS = Color3.fromRGB(200, 150, 60)
local GOLD = Color3.fromRGB(255, 205, 60)
local DARK = Color3.fromRGB(30, 30, 35)

local function buildHelmet(model: Model, root: Part, helmet: string, suit: Color3, accent: Color3)
	local headY = 4.6
	if helmet == "Mask" then
		makePart(model, root, {
			name = "Goggles",
			size = Vector3.new(1.3, 0.45, 0.25),
			cframe = cf(0, headY + 0.15, -0.6),
			color = GLASS,
			material = Enum.Material.Glass,
			transparency = 0.2,
		})
		makePart(
			model,
			root,
			{ name = "Snorkel", size = Vector3.new(0.2, 1.3, 0.2), cframe = cf(0.7, headY + 0.6, -0.2), color = accent }
		)
	elseif helmet == "Scuba" then
		makePart(model, root, {
			name = "Mask",
			size = Vector3.new(1.35, 0.7, 0.25),
			cframe = cf(0, headY + 0.1, -0.62),
			color = GLASS,
			material = Enum.Material.Glass,
			transparency = 0.15,
		})
		makePart(
			model,
			root,
			{ name = "MaskRim", size = Vector3.new(1.45, 0.8, 0.15), cframe = cf(0, headY + 0.1, -0.52), color = DARK }
		)
		makePart(model, root, {
			name = "Regulator",
			size = Vector3.new(0.4, 0.4, 0.4),
			cframe = cf(0, headY - 0.45, -0.7),
			color = accent,
		})
		makePart(
			model,
			root,
			{ name = "Hood", size = Vector3.new(1.3, 0.5, 1.3), cframe = cf(0, headY + 0.6, 0), color = suit }
		)
	elseif helmet == "Brass" then
		makePart(model, root, {
			name = "Helmet",
			shape = Enum.PartType.Ball,
			size = Vector3.new(2.3, 2.3, 2.3),
			cframe = cf(0, headY, 0),
			color = BRASS,
			material = Enum.Material.Metal,
			reflectance = 0.1,
		})
		makePart(model, root, {
			name = "Faceplate",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(0.3, 1.2, 1.2),
			cframe = cf(0, headY, -1.05, 0, 90, 0),
			color = GLASS,
			material = Enum.Material.Glass,
			transparency = 0.25,
		})
		makePart(model, root, {
			name = "Collar",
			size = Vector3.new(2.2, 0.35, 1.8),
			cframe = cf(0, headY - 1.1, 0),
			color = BRASS,
			material = Enum.Material.Metal,
		})
		for _, x in { -0.8, 0.8 } do
			makePart(model, root, {
				name = "Porthole",
				shape = Enum.PartType.Cylinder,
				size = Vector3.new(0.2, 0.6, 0.6),
				cframe = cf(x, headY, -0.6, 0, 90 + x * 50, 0),
				color = GLASS,
				material = Enum.Material.Glass,
				transparency = 0.3,
			})
		end
	elseif helmet == "Pirate" then
		makePart(
			model,
			root,
			{ name = "Brim", size = Vector3.new(2, 0.2, 1.5), cframe = cf(0, headY + 0.65, 0), color = DARK }
		)
		makePart(
			model,
			root,
			{ name = "Hat", size = Vector3.new(1.3, 0.6, 1.2), cframe = cf(0, headY + 1.05, 0), color = DARK }
		)
		makePart(
			model,
			root,
			{ name = "Band", size = Vector3.new(1.35, 0.15, 1.25), cframe = cf(0, headY + 0.85, 0), color = accent }
		)
		makePart(model, root, {
			name = "Mask",
			size = Vector3.new(1.3, 0.4, 0.2),
			cframe = cf(0, headY + 0.15, -0.62),
			color = GLASS,
			material = Enum.Material.Glass,
			transparency = 0.2,
		})
	elseif helmet == "Crown" then
		makePart(model, root, {
			name = "CrownBand",
			size = Vector3.new(1.4, 0.35, 1.4),
			cframe = cf(0, headY + 0.75, 0),
			color = GOLD,
			material = Enum.Material.Metal,
			reflectance = 0.2,
		})
		for i = 0, 3 do
			local angle = i * 90
			local x, z = math.sin(math.rad(angle)) * 0.55, math.cos(math.rad(angle)) * 0.55
			makePart(model, root, {
				name = "Spike",
				size = Vector3.new(0.3, 0.6, 0.3),
				cframe = cf(x, headY + 1.2, z, 0, angle, 0),
				color = GOLD,
				material = Enum.Material.Metal,
			})
		end
		makePart(model, root, {
			name = "Jewel",
			size = Vector3.new(0.3, 0.3, 0.1),
			cframe = cf(0, headY + 0.75, -0.72),
			color = accent,
			material = Enum.Material.Neon,
		})
	elseif helmet == "Ghost" then
		makePart(model, root, {
			name = "Eyes",
			size = Vector3.new(1, 0.25, 0.1),
			cframe = cf(0, headY + 0.1, -0.62),
			color = accent,
			material = Enum.Material.Neon,
		})
		makePart(model, root, {
			name = "Tricorn",
			size = Vector3.new(2, 0.5, 1.6),
			cframe = cf(0, headY + 0.85, 0),
			color = DARK,
			transparency = 0.3,
		})
	elseif helmet == "Fin" then
		makePart(model, root, {
			name = "Fin",
			shape = Enum.PartType.Wedge,
			size = Vector3.new(0.2, 1, 1.2),
			cframe = cf(0, headY + 1.05, 0.1),
			color = accent,
		})
		makePart(model, root, {
			name = "Mask",
			size = Vector3.new(1.3, 0.4, 0.2),
			cframe = cf(0, headY + 0.15, -0.62),
			color = GLASS,
			material = Enum.Material.Glass,
			transparency = 0.2,
		})
	elseif helmet == "Knight" then
		makePart(model, root, {
			name = "Helm",
			size = Vector3.new(1.5, 1.5, 1.5),
			cframe = cf(0, headY, 0),
			color = suit,
			material = Enum.Material.Metal,
			reflectance = 0.1,
		})
		makePart(model, root, {
			name = "Visor",
			size = Vector3.new(1.2, 0.18, 0.1),
			cframe = cf(0, headY + 0.1, -0.76),
			color = accent,
			material = Enum.Material.Neon,
		})
		makePart(
			model,
			root,
			{ name = "Crest", size = Vector3.new(0.2, 0.6, 1.3), cframe = cf(0, headY + 1, 0), color = accent }
		)
	end
end

function ModelFactory.diver(diverId: string): Model
	local diver = Divers.ById[diverId]
	assert(diver, "Unknown diver " .. tostring(diverId))
	local look = diver.look
	local model, root = newModel(diver.name, Vector3.new(2, 0.2, 2))
	local isGhost = look.helmet == "Ghost"
	local suitMaterial = if isGhost then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local ghostAlpha = if isGhost then 0.35 else 0

	-- body (the model faces -Z, the Roblox "front")
	for _, x in { -0.5, 0.5 } do
		makePart(model, root, {
			name = "Leg",
			size = Vector3.new(0.9, 2, 0.9),
			cframe = cf(x, 1.1, 0),
			color = look.suit,
			material = suitMaterial,
			transparency = ghostAlpha,
		})
		makePart(model, root, {
			name = "Flipper",
			size = Vector3.new(1, 0.2, 1.8),
			cframe = cf(x, 0.1, -0.45),
			color = look.accent,
			transparency = ghostAlpha,
		})
	end
	makePart(model, root, {
		name = "Torso",
		size = Vector3.new(2, 2, 1),
		cframe = cf(0, 3, 0),
		color = look.suit,
		material = suitMaterial,
		transparency = ghostAlpha,
	})
	makePart(model, root, {
		name = "Belt",
		size = Vector3.new(2.05, 0.3, 1.05),
		cframe = cf(0, 2.2, 0),
		color = look.accent,
		transparency = ghostAlpha,
	})
	for _, x in { -1.45, 1.45 } do
		makePart(model, root, {
			name = "Arm",
			size = Vector3.new(0.85, 2, 0.85),
			cframe = cf(x, 3, 0),
			color = look.suit,
			material = suitMaterial,
			transparency = ghostAlpha,
		})
		makePart(model, root, {
			name = "Hand",
			size = Vector3.new(0.8, 0.5, 0.8),
			cframe = cf(x, 1.8, 0),
			color = look.skin,
			transparency = ghostAlpha,
		})
	end
	local needsTank = look.helmet ~= "Mask"
		and look.helmet ~= "Fin"
		and look.helmet ~= "Crown"
		and look.helmet ~= "Ghost"
	if needsTank then
		makePart(model, root, {
			name = "Tank",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(1.9, 0.9, 0.9),
			cframe = cf(0, 3.1, 0.85, 0, 0, 90),
			color = look.accent,
			material = Enum.Material.Metal,
		})
	end
	local head = makePart(model, root, {
		name = "Head",
		size = Vector3.new(1.2, 1.2, 1.2),
		cframe = cf(0, 4.6, 0),
		color = look.skin,
		material = suitMaterial,
		transparency = ghostAlpha,
	})
	local face = Instance.new("Decal")
	face.Name = "Face"
	face.Texture = FACE_TEXTURE
	face.Face = Enum.NormalId.Front
	face.Transparency = ghostAlpha
	face.Parent = head
	buildHelmet(model, root, look.helmet, look.suit, look.accent)

	-- lights and bubbles are switched on by the client while underwater
	local lamp = Instance.new("Attachment")
	lamp.Name = "Lamp"
	lamp.CFrame = CFrame.new(0, 0, -0.6)
	lamp.Parent = head
	local spot = Instance.new("SpotLight")
	spot.Name = "Flashlight"
	spot.Brightness = 4
	spot.Range = 45
	spot.Angle = 55
	spot.Face = Enum.NormalId.Front
	spot.Color = Color3.fromRGB(255, 245, 220)
	spot.Shadows = false
	spot.Enabled = false
	spot.Parent = head
	local glow = Instance.new("PointLight")
	glow.Name = "Glow"
	glow.Range = 18
	glow.Brightness = 0
	glow.Enabled = false
	glow.Parent = root
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Name = "Bubbles"
	bubbles.Enabled = false
	bubbles.Rate = 6
	bubbles.Lifetime = NumberRange.new(1.2, 2)
	bubbles.Speed = NumberRange.new(4, 7)
	bubbles.SpreadAngle = Vector2.new(15, 15)
	bubbles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0.5) })
	bubbles.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	bubbles.Color = ColorSequence.new(Color3.fromRGB(210, 245, 255))
	bubbles.LightEmission = 0.5
	bubbles.EmissionDirection = Enum.NormalId.Top
	bubbles.Parent = head

	-- tier glow ring under divers of Legendary and above
	local rarity = Rarities.ById[diver.tier]
	if rarity.rank >= 5 then
		makePart(model, root, {
			name = "Aura",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(0.1, 3.2, 3.2),
			cframe = cf(0, 0.05, 0, 0, 0, 90),
			color = rarity.color,
			material = Enum.Material.Neon,
			transparency = 0.45,
		})
	end

	model:SetAttribute("DiverId", diverId)
	return model
end

-- Treasures ------------------------------------------------------------------------------------

type Builder = (model: Model, root: Part, color: Color3, material: Enum.Material) -> ()

local function ring(
	model: Model,
	root: Part,
	color: Color3,
	material: Enum.Material,
	radius: number,
	segments: number,
	thickness: number
)
	for i = 0, segments - 1 do
		local angle = i * 360 / segments
		local x = math.sin(math.rad(angle)) * radius
		local y = math.cos(math.rad(angle)) * radius
		local length = 2 * math.pi * radius / segments + 0.05
		makePart(model, root, {
			name = "Ring",
			size = Vector3.new(length, thickness, thickness),
			cframe = cf(x, y, 0, 0, 0, -angle),
			color = color,
			material = material,
		})
	end
end

