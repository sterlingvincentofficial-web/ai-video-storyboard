        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[--[[
	Cash upgrades. Cost of the next level = baseCost * growth ^ currentLevel.
	Upgrades are kept through rebirth.
]]

export type Upgrade = {
	id: string,
	name: string,
	description: string,
	baseCost: number,
	growth: number,
	maxLevel: number,
	order: number?,
}

local list: { Upgrade } = {
	{
		id = "DiveSlots",
		name = "Dive Slots",
		description = "+1 diver on your dock",
		baseCost = 500,
		growth = 12,
		maxLevel = 5,
	},
	{
		id = "Pedestals",
		name = "Vault Pedestals",
		description = "+1 treasure pedestal in your vault",
		baseCost = 300,
		growth = 4,
		maxLevel = 10,
	},
	{
		id = "Luck",
		name = "Lucky Charm",
		description = "+10% luck for every diver",
		baseCost = 2000,
		growth = 2.2,
		maxLevel = 20,
	},
	{
		id = "Oxygen",
		name = "Oxygen Tanks",
		description = "+8% dive speed for every diver",
		baseCost = 1500,
		growth = 2.1,
		maxLevel = 20,
	},
}

local byId: { [string]: Upgrade } = {}
for order, upgrade in list do
	upgrade.order = order
	byId[upgrade.id] = upgrade
end

return {
	List = list,
	ById = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Zones</string>
            <string name="Source"><![CDATA[--[[
	Depth zones. A diver reaches every zone whose `minDepth` is below the diver's max depth,
	as long as the player has enough rebirths to unlock that zone.

	`valueBase` scales the income of every treasure found in the zone.
	`chest` is the chest a diver brings back from this zone (see Chests below).
]]

export type Zone = {
	id: string,
	index: number?,
	name: string,
	minDepth: number,
	maxDepth: number,
	rebirthReq: number,
	valueBase: number,
	chest: string,
	color: Color3,
	secret: boolean?,
}

export type Chest = {
	id: string,
	name: string,
	zone: string,
	color: Color3,
	glow: Color3,
}

local zones: { Zone } = {
	{
		id = "Shallows",
