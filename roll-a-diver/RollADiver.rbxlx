		shape = "Crown",
		color = rgb(10, 10, 10),
	},
}

local byId: { [string]: Treasure } = {}
local byZone: { [string]: { Treasure } } = {}
for order, treasure in list do
	assert(Zones.ById[treasure.zone], "Unknown zone for treasure " .. treasure.id)
	assert(byId[treasure.id] == nil, "Duplicate treasure id " .. treasure.id)
	treasure.order = order
	byId[treasure.id] = treasure
	byZone[treasure.zone] = byZone[treasure.zone] or {}
	table.insert(byZone[treasure.zone], treasure)
end

return {
	List = list,
	ById = byId,
	ByZone = byZone,
}
]]></string>
