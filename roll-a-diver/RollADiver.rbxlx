          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Toasts (bottom of the screen) and big announcements (top of the screen).
]]

local TweenService = game:GetService("TweenService")

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Notifications = {}

local KIND_COLORS: { [string]: Color3 } = {
	Info = Color3.fromRGB(60, 110, 200),
	Success = Color3.fromRGB(50, 170, 80),
	Danger = Color3.fromRGB(200, 50, 60),
	New = Color3.fromRGB(220, 160, 30),
	Chest = Color3.fromRGB(150, 95, 50),
	Error = Color3.fromRGB(170, 60, 60),
}

local toastHolder: Frame
local announceHolder: Frame
local announceQueue: { { text: string, color: Color3 } } = {}
local announcing = false

function Notifications.mount(root: Instance)
	toastHolder = Kit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(460, 260),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.new("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = toastHolder,
	})
	announceHolder = Kit.new("Frame", {
		Name = "Announcements",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 150),
		Size = UDim2.fromOffset(760, 54),
		BackgroundTransparency = 1,
		Parent = root,
	})
end

local order = 0
local liveToasts: { [number]: boolean } = {} -- keyed by LayoutOrder

function Notifications.toast(text: string, kind: string?)
	if not toastHolder then
		return
	end
	order += 1
	local color = KIND_COLORS[kind or "Info"] or KIND_COLORS.Info
	local frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(440, 38),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.1,
		LayoutOrder = order,
		Parent = toastHolder,
	}, { Kit.corner(10), Kit.stroke(2) })
	local id = order
	liveToasts[id] = true
	Kit.text({
		Text = text,
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		MaxTextSize = 22,
		Parent = frame,
	})
	-- keep at most 5 toasts
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #toasts > 5 do
		local oldest = table.remove(toasts, 1)
		if oldest then
			liveToasts[oldest.LayoutOrder] = nil
			oldest:Destroy()
		end
	end
	task.delay(3.5, function()
		if liveToasts[id] then
			liveToasts[id] = nil
			local tween = TweenService:Create(frame, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
			tween:Play()
			for _, descendant in frame:GetDescendants() do
				if descendant:IsA("TextLabel") then
					TweenService:Create(descendant, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
				elseif descendant:IsA("UIStroke") then
					TweenService:Create(descendant, TweenInfo.new(0.4), { Transparency = 1 }):Play()
				end
			end
			tween.Completed:Wait()
			frame:Destroy()
		end
	end)
end

local function showNextAnnouncement()
	if announcing or #announceQueue == 0 then
		return
	end
	announcing = true
	local item = table.remove(announceQueue, 1)
	assert(item)
	local label = Kit.text({
		Text = item.text,
		Size = UDim2.fromScale(1, 1),
		TextColor3 = item.color,
		StrokeThickness = 3,
		MaxTextSize = 34,
		Parent = announceHolder,
	})
	local scale = Kit.new("UIScale", { Scale = 0.5, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(4, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.4)
		label:Destroy()
		announcing = false
		showNextAnnouncement()
	end)
end

function Notifications.announce(text: string, color: Color3?)
	table.insert(announceQueue, { text = text, color = color or Theme.Gold })
	while #announceQueue > 6 do
		table.remove(announceQueue, 1)
	end
	showNextAnnouncement()
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="58">
            <Properties>
              <string name="Name">Panels</string>
            </Properties>
            <Item class="ModuleScript" referent="59">
              <Properties>
                <string name="Name">Chests</string>
                <string name="Source"><![CDATA[--[[
	Chests panel: sealed chests grouped by type with Open (reveal animation) and Open All.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local ModelFactory = require(Shared.ModelFactory)
local Zones = require(Shared.Config.Zones)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Reveal = require(UI.Reveal)
local Client = UI.Parent
local State = require(Client.State)
local Net = require(Client.Net)

local Panel = {
	title = "📦 Chests",
	color = Theme.Orange,
}

local list: ScrollingFrame
local empty: TextLabel
local openAllButton: TextButton
local lastKey = ""
local busy = false

local function open(chestId: string)
	if busy then
		return
	end
	busy = true
	local response = Net.try("OpenChest", chestId)
	if response.ok then
		Reveal.chest(chestId, response.result)
	end
	busy = false
end

local function openAll(chestId: string?)
	if busy then
		return
	end
	busy = true
	local response = Net.try("OpenAllChests", chestId)
	if response.ok then
		Reveal.summary(response.results)
	end
	busy = false
end

function Panel.build(content: Frame)
	local top = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = content })
	Kit.text({
		Text = "Divers bring chests up from the trench. Open them to find treasure!",
		Size = UDim2.new(1, -200, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.SubText,
		MaxTextSize = 18,
		Parent = top,
	})
	openAllButton = Kit.button({
		Text = "Open Everything",
		Color = Theme.Orange,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		Size = UDim2.fromOffset(190, 40),
		Parent = top,
		OnClick = function()
			task.spawn(openAll, nil)
		end,
	})
	local body = Kit.new("Frame", {
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -50),
		BackgroundTransparency = 1,
		Parent = content,
	})
	list = Kit.list(body, 8)
	empty = Kit.text({
		Text = "No chests yet. Wait for your divers to surface!",
		Position = UDim2.fromScale(0.1, 0.4),
		Size = UDim2.fromScale(0.8, 0.12),
		TextColor3 = Theme.SubText,
		MaxTextSize = 24,
		Parent = body,
	})
end

function Panel.refresh()
	local data = State.data()
	if not data then
		return
	end
	local counts: { [string]: number } = {}
	local total = 0
	for _, content in data.chests do
		counts[content.c] = (counts[content.c] or 0) + 1
		total += 1
	end
	empty.Visible = total == 0
	openAllButton.Visible = total > 1
	local parts = {}
	for _, chest in Zones.Chests do
		table.insert(parts, tostring(counts[chest.id] or 0))
	end
	local key = table.concat(parts, ",")
	if key == lastKey then
		return
	end
	lastKey = key
	Kit.clear(list)
	for order, chest in Zones.Chests do
		local count = counts[chest.id]
		if count and count > 0 then
			local row = Kit.new("Frame", {
				Size = UDim2.new(1, -12, 0, 90),
				BackgroundColor3 = Theme.Card,
				LayoutOrder = order,
				Parent = list,
			}, { Kit.corner(12), Kit.stroke(3, chest.glow) })
			local holder = Kit.new("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(8, 5),
				Size = UDim2.fromOffset(80, 80),
				Parent = row,
			})
			Kit.viewport(holder, ModelFactory.chest(chest.id))
			Kit.text({
				Text = chest.name,
				Position = UDim2.fromOffset(100, 10),
				Size = UDim2.new(0.4, 0, 0, 34),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = chest.glow,
				MaxTextSize = 28,
				Parent = row,
			})
			Kit.text({
				Text = ("x%d  •  from the %s"):format(count, Zones.ById[chest.zone].name),
				Position = UDim2.fromOffset(100, 48),
				Size = UDim2.new(0.4, 0, 0, 26),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = Theme.SubText,
				MaxTextSize = 20,
				Parent = row,
			})
			Kit.button({
				Text = "Open",
				Color = Theme.Green,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -150, 0.5, 0),
				Size = UDim2.fromOffset(120, 48),
				Parent = row,
				OnClick = function()
					task.spawn(open, chest.id)
				end,
			})
			Kit.button({
				Text = "Open All",
				Color = Theme.Orange,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.fromOffset(130, 48),
				Parent = row,
				OnClick = function()
					task.spawn(openAll, chest.id)
				end,
			})
		end
	end
end

function Panel.onClose() end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="60">
              <Properties>
                <string name="Name">Divers</string>
                <string name="Source"><![CDATA[--[[
	Divers panel: every owned diver with Place / Remove / Sell, plus Equip Best and Sell Spare.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local ModelFactory = require(Shared.ModelFactory)
local GameConfig = require(Shared.Config.Game)
local Divers = require(Shared.Config.Divers)
local Rarities = require(Shared.Config.Rarities)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Notifications = require(UI.Notifications)
local Client = UI.Parent
local State = require(Client.State)
local Net = require(Client.Net)

local Panel = {
	title = "🤿 Divers",
	color = Theme.Cyan,
}

local header: TextLabel
local grid: ScrollingFrame
local lastKey = ""

local function slotOf(data, uid: string): number?
	for key, value in data.slots do
		if value == uid then
			return tonumber(key)
		end
	end
	return nil
end

function Panel.build(content: Frame)
	local top = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = content })
	header = Kit.text({
		Text = "",
		Size = UDim2.new(0.45, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		Parent = top,
	})
	Kit.button({
		Text = "Equip Best",
		Color = Theme.Green,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -170, 0, 2),
		Size = UDim2.fromOffset(150, 40),
		Parent = top,
		OnClick = function()
			Net.try("EquipBestDivers")
		end,
	})
	Kit.button({
		Text = "Sell Spare ≤ Rare",
		Color = Theme.Red,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		Size = UDim2.fromOffset(160, 40),
		Parent = top,
		OnClick = function()
			local response = Net.try("SellUnplacedDivers", Rarities.ById.Rare.rank)
			if response.ok then
				Notifications.toast(
					if response.sold > 0
						then ("Sold %d divers for %s"):format(response.sold, Format.money(response.total))
						else "No spare divers to sell",
					"Info"
				)
			end
		end,
	})
	local body = Kit.new("Frame", {
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -50),
		BackgroundTransparency = 1,
		Parent = content,
	})
	grid = Kit.grid(body, UDim2.fromOffset(160, 230), 8)
end

local function card(uid: string, diverId: string, slot: number?, order: number)
	local diver = Divers.ById[diverId]
	local rarity = Rarities.ById[diver.tier]
	local frame = Kit.new("Frame", {
		BackgroundColor3 = if slot then Theme.Card else Theme.CardDark,
		LayoutOrder = order,
		Parent = grid,
	}, { Kit.corner(12), Kit.stroke(3, rarity.color) })
	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 4),
		Size = UDim2.new(1, -40, 0, 92),
		Parent = frame,
	})
	Kit.viewport(holder, ModelFactory.diver(diverId))
	local name = Kit.text({
		Text = diver.name,
		Position = UDim2.fromOffset(6, 98),
		Size = UDim2.new(1, -12, 0, 22),
		TextColor3 = rarity.color,
		MaxTextSize = 20,
		Parent = frame,
	})
	if rarity.rainbow then
		name.TextColor3 = Color3.new(1, 1, 1)
		Kit.rainbow(name)
	end
	Kit.text({
		Text = ("%s • %s luck"):format(diver.tier, Format.multiplier(diver.luck)),
		Position = UDim2.fromOffset(6, 120),
		Size = UDim2.new(1, -12, 0, 17),
		TextColor3 = Theme.SubText,
		MaxTextSize = 15,
		Parent = frame,
	})
	Kit.text({
		Text = ("%s • %s speed"):format(
			Format.depth(math.min(diver.maxDepth, 11000)),
			Format.multiplier(diver.speed)
		),
		Position = UDim2.fromOffset(6, 137),
		Size = UDim2.new(1, -12, 0, 17),
		TextColor3 = Theme.SubText,
		MaxTextSize = 15,
		Parent = frame,
	})
	local ability = if diver.ability then Divers.Abilities[diver.ability] else (if slot then "On your dock" else "")
	Kit.text({
		Text = ability,
		Position = UDim2.fromOffset(6, 154),
		Size = UDim2.new(1, -12, 0, 28),
		TextColor3 = if diver.ability then Theme.Gold else Theme.Money,
		TextWrapped = true,
		MaxTextSize = 13,
		Parent = frame,
	})
	Kit.button({
		Text = if slot then "Remove" else "Place",
		Color = if slot then Theme.Grey else Theme.Green,
		Position = UDim2.new(0, 6, 1, -40),
		Size = UDim2.new(0.5, -9, 0, 34),
		Parent = frame,
		OnClick = function()
			if slot then
				Net.try("RemoveDiver", uid)
			else
				Net.try("PlaceDiver", uid)
			end
		end,
	})
	Kit.button({
		Text = "Sell " .. Format.money(Formulas.diverSellValue(diverId)),
		Color = Theme.Red,
		Position = UDim2.new(0.5, 3, 1, -40),
		Size = UDim2.new(0.5, -9, 0, 34),
		Parent = frame,
		OnClick = function()
			Net.try("SellDiver", uid)
		end,
	})
end

function Panel.refresh()
	local data = State.data()
	if not data then
		return
	end
	local count = 0
	local uids = {}
	for uid in data.divers do
		count += 1
		table.insert(uids, uid)
	end
	local placed = 0
	for _ in data.slots do
		placed += 1
	end
	header.Text = ("Divers %d/%d • Dock %d/%d"):format(
		count,
		GameConfig.MaxDivers,
		placed,
		State.get("slotCount") or 0
	)

	table.sort(uids, function(a, b)
		local slotA, slotB = slotOf(data, a), slotOf(data, b)
		if (slotA ~= nil) ~= (slotB ~= nil) then
			return slotA ~= nil
		end
		local scoreA, scoreB = Formulas.diverScore(data.divers[a]), Formulas.diverScore(data.divers[b])
		if scoreA == scoreB then
			return a < b
		end
		return scoreA > scoreB
	end)

	-- only rebuild the cards when the list actually changed
	local parts = {}
	for _, uid in uids do
		table.insert(parts, uid .. ":" .. tostring(slotOf(data, uid)))
	end
	local key = table.concat(parts, ",")
	if key == lastKey then
		return
	end
	lastKey = key
	Kit.clear(grid)
	for order, uid in uids do
		card(uid, data.divers[uid], slotOf(data, uid), order)
	end
end

function Panel.onClose() end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="61">
              <Properties>
                <string name="Name">Index</string>
                <string name="Source"><![CDATA[--[[
	Index panel: one page per zone (plus a Divers page). Undiscovered items show as black silhouettes;
	coloured dots show which conditions of a treasure were found.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local ModelFactory = require(Shared.ModelFactory)
local GameConfig = require(Shared.Config.Game)
local Zones = require(Shared.Config.Zones)
local Treasures = require(Shared.Config.Treasures)
local Conditions = require(Shared.Config.Conditions)
local Rarities = require(Shared.Config.Rarities)
local Divers = require(Shared.Config.Divers)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Client = UI.Parent
local State = require(Client.State)

local Panel = {
	title = "📖 Index",
	color = Theme.Gold,
}

local header: TextLabel
local tabs: ScrollingFrame
local grid: ScrollingFrame
local selected = "Shallows"
local lastKey = ""

local function tile(order: number, name: string, rarityId: string, found: boolean, model: Model, dots: { Color3? }?)
	local rarity = Rarities.ById[rarityId]
	local frame = Kit.new("Frame", {
		BackgroundColor3 = if found then Theme.Card else Theme.CardDark,
		LayoutOrder = order,
		Parent = grid,
	}, { Kit.corner(12), Kit.stroke(3, if found then rarity.color else Theme.Stroke) })
	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(15, 4),
		Size = UDim2.new(1, -30, 0, 78),
		Parent = frame,
	})
	-- a black ImageColor3 turns the model into a silhouette
	Kit.viewport(holder, model, { ImageColor3 = if found then Color3.new(1, 1, 1) else Color3.new(0, 0, 0) })
	local nameLabel = Kit.text({
		Text = if found then name else "???",
		Position = UDim2.fromOffset(4, 84),
		Size = UDim2.new(1, -8, 0, 20),
		TextColor3 = if found then rarity.color else Theme.SubText,
		MaxTextSize = 16,
		Parent = frame,
	})
	if found and rarity.rainbow then
		nameLabel.TextColor3 = Color3.new(1, 1, 1)
		Kit.rainbow(nameLabel)
	end
	Kit.text({
		Text = rarityId,
		Position = UDim2.fromOffset(4, 104),
		Size = UDim2.new(1, -8, 0, 16),
		TextColor3 = Theme.SubText,
		MaxTextSize = 14,
		Parent = frame,
	})
	if dots then
		local row = Kit.new("Frame", {
			Position = UDim2.new(0, 8, 1, -18),
			Size = UDim2.new(1, -16, 0, 12),
			BackgroundTransparency = 1,
			Parent = frame,
		})
		Kit.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 4),
			Parent = row,
		})
		for index, color in dots do
			Kit.new("Frame", {
				Size = UDim2.fromOffset(12, 12),
				BackgroundColor3 = color or Color3.fromRGB(50, 55, 70),
				LayoutOrder = index,
				Parent = row,
			}, { Kit.corner(6) })
		end
	end
end

local function buildTabs()
	Kit.clear(tabs)
	local data = State.data()
	local rebirths = if data then data.rebirths else 0
	local entries = {}
	for _, zone in Zones.List do
		table.insert(
			entries,
			{ id = zone.id, name = if zone.secret and rebirths < zone.rebirthReq then "???" else zone.name }
		)
	end
	table.insert(entries, { id = "Divers", name = "Divers" })
	for order, entry in entries do
		Kit.button({
			Text = entry.name,
			Color = if selected == entry.id then Theme.Gold else Theme.Card,
			Size = UDim2.fromOffset(130, 34),
			LayoutOrder = order,
			Parent = tabs,
			OnClick = function()
				selected = entry.id
				lastKey = ""
				buildTabs()
				Panel.refresh()
			end,
		})
	end
end

function Panel.build(content: Frame)
	header = Kit.text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		Parent = content,
	})
	local tabHolder = Kit.new("Frame", {
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		Parent = content,
	})
	tabs = Kit.list(tabHolder, 6, true)
	local body = Kit.new("Frame", {
		Position = UDim2.fromOffset(0, 88),
		Size = UDim2.new(1, 0, 1, -88),
		BackgroundTransparency = 1,
		Parent = content,
	})
	grid = Kit.grid(body, UDim2.fromOffset(130, 150), 8)
	buildTabs()
end

-- Cheap fingerprint of index progress so the grid only rebuilds when something new was found.
local function progressKey(data: any): string
	local variants = 0
	for _, entry in data.index do
		for _ in entry do
			variants += 1
		end
	end
	local divers = 0
	for _ in data.diverIndex do
		divers += 1
	end
	return ":" .. variants .. ":" .. divers .. ":" .. data.rebirths
end

function Panel.refresh()
	local data = State.data()
	if not data then
		return
	end
	local found, total, variants, totalVariants = Formulas.indexProgress(data.index)
	local complete = Formulas.indexZonesComplete(data.index)
	header.Text = ("Treasures %d/%d • Variants %d/%d • Pages complete %d (+%d%% income)"):format(
		found,
		total,
		variants,
		totalVariants,
		complete,
		math.floor(complete * GameConfig.IndexZoneBonus * 100 + 0.5)
	)

	local key = selected .. progressKey(data)
	if key == lastKey then
		return
	end
	lastKey = key
	Kit.clear(grid)

	if selected == "Divers" then
		for order, diver in Divers.List do
			local owned = data.diverIndex[diver.id] == true
			tile(order, diver.name, diver.tier, owned, ModelFactory.diver(diver.id))
		end
		return
	end

	local zone = Zones.ById[selected]
	if data.rebirths < zone.rebirthReq and zone.secret then
		local message = Kit.text({
			Text = ("Something is down there... Reach Rebirth %d to find out."):format(zone.rebirthReq),
			Size = UDim2.new(1, -20, 0, 40),
			TextColor3 = Theme.SubText,
			MaxTextSize = 22,
			Parent = grid,
		})
		message.LayoutOrder = 0
		return
	end
	for _, treasure in Treasures.ByZone[selected] do
		local entry = data.index[treasure.id]
		local dots = {}
		for index, condition in Conditions.List do
			dots[index] = if entry and entry[condition.id] then condition.color else nil
		end
		tile(
			treasure.order or 0,
			treasure.name,
			treasure.rarity,
			entry ~= nil,
			ModelFactory.treasure(treasure.id),
			dots
		)
	end
end

function Panel.onClose() end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="62">
              <Properties>
                <string name="Name">Rebirth</string>
                <string name="Source"><![CDATA[--[[
	Rebirth panel: cost, progress, what you gain and what you keep.
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Zones = require(Shared.Config.Zones)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Client = UI.Parent
local State = require(Client.State)
local Net = require(Client.Net)

local Panel = {
	title = "♻ Rebirth",
	color = Theme.Gold,
}

local current: TextLabel
local gain: TextLabel
local unlock: TextLabel
local costLabel: TextLabel
local fill: Frame
local button: TextButton

function Panel.build(content: Frame)
	current = Kit.text({
		Text = "",
		Position = UDim2.fromScale(0.05, 0.02),
		Size = UDim2.fromScale(0.9, 0.1),
		TextColor3 = Theme.Gold,
		MaxTextSize = 34,
		Parent = content,
	})
	gain = Kit.text({
		Text = "",
		Position = UDim2.fromScale(0.05, 0.14),
		Size = UDim2.fromScale(0.9, 0.08),
		TextColor3 = Theme.Money,
		MaxTextSize = 26,
		Parent = content,
	})
	unlock = Kit.text({
		Text = "",
		Position = UDim2.fromScale(0.05, 0.23),
		Size = UDim2.fromScale(0.9, 0.08),
		TextColor3 = Theme.Cyan,
		MaxTextSize = 24,
		Parent = content,
	})
	Kit.text({
		Text = "Resets: cash, divers, treasures and chests",
		Position = UDim2.fromScale(0.05, 0.34),
		Size = UDim2.fromScale(0.9, 0.06),
		TextColor3 = Theme.Red,
		MaxTextSize = 20,
		Parent = content,
	})
	Kit.text({
		Text = "Keeps: upgrades, Index, gamepasses and Divine & Secret divers",
		Position = UDim2.fromScale(0.05, 0.41),
		Size = UDim2.fromScale(0.9, 0.06),
		TextColor3 = Theme.SubText,
		MaxTextSize = 20,
		Parent = content,
	})
	local bar = Kit.new("Frame", {
		Position = UDim2.fromScale(0.1, 0.52),
		Size = UDim2.fromScale(0.8, 0.08),
		BackgroundColor3 = Theme.PanelDark,
		Parent = content,
	}, { Kit.corner(12), Kit.stroke(3) })
	fill = Kit.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Gold,
		Parent = bar,
	}, { Kit.corner(12) })
	costLabel = Kit.text({
		Text = "",
		Size = UDim2.fromScale(1, 1),
		MaxTextSize = 22,
		ZIndex = 3,
		Parent = bar,
	})
	button = Kit.button({
		Text = "REBIRTH",
		Color = Theme.Gold,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.68),
		Size = UDim2.fromOffset(260, 64),
		Parent = content,
		OnClick = function()
			local response = Net.try("Rebirth")
			if response.ok then
				Panel.refresh()
			end
		end,
	})
end

function Panel.refresh()
	local data = State.data()
	if not data then
		return
	end
	local rebirths = data.rebirths
	local cost = Formulas.rebirthCost(rebirths)
	local cash = State.cash()
	current.Text = ("Rebirth %d"):format(rebirths)
	gain.Text = ("Income x%s  →  x%s"):format(
		tostring(Formulas.rebirthMultiplier(rebirths)),
		tostring(Formulas.rebirthMultiplier(rebirths + 1))
	)
	local nowZone = Formulas.unlockedZoneIndex(rebirths)
	local nextZone = Formulas.unlockedZoneIndex(rebirths + 1)
	if nextZone > nowZone then
		local zone = Zones.List[nextZone]
		unlock.Text = "Unlocks a new depth: " .. (if zone.secret then "???" else zone.name)
	else
		local upcoming = nil
		for _, zone in Zones.List do
			if zone.rebirthReq > rebirths + 1 then
				upcoming = zone
				break
			end
		end
		unlock.Text = if upcoming
			then ("Next new zone at Rebirth %d"):format(upcoming.rebirthReq)
			else "Every zone unlocked!"
	end
	local progress = math.clamp(cash / cost, 0, 1)
	TweenService:Create(fill, TweenInfo.new(0.3), { Size = UDim2.fromScale(progress, 1) }):Play()
	costLabel.Text = Format.money(cash) .. " / " .. Format.money(cost)
	Kit.setButton(
		button,
		if progress >= 1 then "REBIRTH!" else "Need " .. Format.money(cost - cash),
		if progress >= 1 then Theme.Gold else Theme.Grey
	)
end

function Panel.onClose() end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="63">
              <Properties>
                <string name="Name">Roll</string>
                <string name="Source"><![CDATA[--[[
	Roll panel: one card per crate with its price, real odds (after luck) and Roll / Auto buttons.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Crates = require(Shared.Config.Crates)
local Divers = require(Shared.Config.Divers)
local Rarities = require(Shared.Config.Rarities)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Reveal = require(UI.Reveal)
local Client = UI.Parent
local State = require(Client.State)
local Net = require(Client.Net)

local Panel = {
	title = "🎲 Roll Divers",
	color = Theme.Blue,
}

type CardRefs = {
	card: Frame,
	price: TextLabel,
	lock: TextLabel,
	oddsList: ScrollingFrame,
	rollButton: TextButton,
	autoButton: TextButton,
	lastLuck: number,
}

local cards: { [string]: CardRefs } = {}
local autoCrate: string? = nil
local rolling = false

local function doRoll(crateId: string, fast: boolean): boolean
	if rolling then
		return false
	end
	rolling = true
	local response = Net.try("Roll", crateId)
	if response.ok then
		Reveal.roll(crateId, response.diverId, response.isNew, response.placed, fast)
	end
	rolling = false
	return response.ok == true
end

local function setAuto(crateId: string?)
	autoCrate = crateId
	for id, refs in cards do
		Kit.setButton(
			refs.autoButton,
			if autoCrate == id then "STOP" else "AUTO",
			if autoCrate == id then Theme.Red else Theme.Purple
		)
	end
	if crateId then
		task.spawn(function()
			while autoCrate == crateId do
				if not doRoll(crateId, true) then
					setAuto(nil)
					break
				end
				task.wait(0.25)
			end
		end)
	end
end

local function fillOdds(refs: CardRefs, crateId: string, luck: number)
	refs.lastLuck = luck
	Kit.clear(refs.oddsList)
	local crate = Crates.ById[crateId]
	local oddsList = {}
	for index, entry in crate.pool do
		oddsList[index] = entry.odds
	end
	local chances = Formulas.chances(oddsList, luck)
	local data = State.data()
	for index, entry in crate.pool do
		local diver = Divers.ById[entry.diver]
		local rarity = Rarities.ById[diver.tier]
		local owned = data and data.diverIndex[entry.diver]
		local row = Kit.new("Frame", {
			Size = UDim2.new(1, -8, 0, 22),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = refs.oddsList,
		})
		local nameLabel = Kit.text({
			Text = (if owned then "" else "? ") .. diver.name,
			Size = UDim2.fromScale(0.62, 1),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = rarity.color,
			MaxTextSize = 18,
			Parent = row,
		})
		if rarity.rainbow then
			nameLabel.TextColor3 = Color3.new(1, 1, 1)
			Kit.rainbow(nameLabel)
		end
		Kit.text({
			Text = Format.odds(1 / chances[index]),
			Position = UDim2.fromScale(0.62, 0),
			Size = UDim2.fromScale(0.38, 1),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Theme.SubText,
			MaxTextSize = 16,
			Parent = row,
		})
	end
end

function Panel.build(content: Frame)
	local list = Kit.list(content, 10, true)
	for _, crate in Crates.List do
		local card = Kit.new("Frame", {
			Size = UDim2.new(0, 250, 1, -16),
			BackgroundColor3 = Theme.Card,
			LayoutOrder = crate.order,
			Parent = list,
		}, { Kit.corner(14), Kit.stroke(3, crate.color) })
		Kit.text({
			Text = crate.name,
			Position = UDim2.fromOffset(10, 8),
			Size = UDim2.new(1, -20, 0, 32),
			TextColor3 = crate.color,
			MaxTextSize = 28,
			Parent = card,
		})
		local price = Kit.text({
			Text = Format.money(crate.price),
			Position = UDim2.fromOffset(10, 40),
			Size = UDim2.new(1, -20, 0, 26),
			TextColor3 = Theme.Money,
			MaxTextSize = 24,
			Parent = card,
		})
		local oddsHolder = Kit.new("Frame", {
			Position = UDim2.fromOffset(8, 72),
			Size = UDim2.new(1, -16, 1, -130),
			BackgroundColor3 = Theme.CardDark,
			Parent = card,
		}, { Kit.corner(10) })
		local oddsList = Kit.list(oddsHolder, 2)
		local rollButton = Kit.button({
			Text = "ROLL",
			Color = Theme.Green,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 8, 1, -8),
			Size = UDim2.new(0.6, -12, 0, 44),
			Parent = card,
			OnClick = function()
				task.spawn(doRoll, crate.id, false)
			end,
		})
		local autoButton = Kit.button({
			Text = "AUTO",
			Color = Theme.Purple,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -8, 1, -8),
			Size = UDim2.new(0.4, -8, 0, 44),
			Parent = card,
			OnClick = function()
				setAuto(if autoCrate == crate.id then nil else crate.id)
			end,
		})
		local lock = Kit.text({
			Text = "",
			Position = UDim2.fromScale(0.05, 0.4),
			Size = UDim2.fromScale(0.9, 0.12),
			TextColor3 = Theme.Gold,
			MaxTextSize = 26,
			Visible = false,
			ZIndex = 5,
			Parent = card,
		})
		cards[crate.id] = {
			card = card,
			price = price,
			lock = lock,
			oddsList = oddsList,
			rollButton = rollButton,
			autoButton = autoButton,
			lastLuck = -1,
		}
	end
end

function Panel.refresh()
	local data = State.data()
	if not data then
		return
	end
	local luck = State.get("rollLuck") or 1
	local cash = State.cash()
	for id, refs in cards do
		local crate = Crates.ById[id]
		local locked = data.rebirths < crate.rebirthReq
		refs.lock.Visible = locked
		refs.lock.Text = ("🔒 Rebirth %d"):format(crate.rebirthReq)
		refs.oddsList.Visible = not locked
		refs.rollButton.Visible = not locked
		refs.autoButton.Visible = not locked
		refs.price.TextColor3 = if cash >= crate.price then Theme.Money else Theme.Red
		if refs.lastLuck ~= luck then
			fillOdds(refs, id, luck)
		end
	end
end

function Panel.onClose() end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="64">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[--[[
	Shop panel: gamepasses and developer products (Robux).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage").Shared
local Monetization = require(Shared.Config.Monetization)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Notifications = require(UI.Notifications)
local Client = UI.Parent
local State = require(Client.State)

local Panel = {
	title = "🛒 Shop",
	color = Theme.Green,
}

local passButtons: { [string]: TextButton } = {}
local starterCard: Frame? = nil

local Shop = {}

function Shop.buyPass(passId: string)
	local pass = Monetization.PassById[passId]
	if not pass then
		return
	end
	if State.hasPass(passId) then
		Notifications.toast("You already own " .. pass.name, "Info")
		return
	end
	if pass.assetId == 0 then
		Notifications.toast(pass.name .. " is coming soon!", "Info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.assetId)
end

function Shop.buyProduct(productId: string)
	local product = Monetization.ProductById[productId]
	if not product then
		return
	end
	if product.assetId == 0 then
		Notifications.toast(product.name .. " is coming soon!", "Info")
		return
	end
	MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.assetId)
end

Panel.Shop = Shop

local function itemCard(
	parent: Instance,
	order: number,
	name: string,
	description: string,
	robux: number,
	color: Color3,
	onBuy: () -> ()
): (Frame, TextButton)
	local card = Kit.new("Frame", {
		BackgroundColor3 = Theme.Card,
		LayoutOrder = order,
		Parent = parent,
	}, { Kit.corner(12), Kit.stroke(3, color) })
	Kit.text({
		Text = name,
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 30),
		TextColor3 = color,
		MaxTextSize = 26,
		Parent = card,
	})
	Kit.text({
		Text = description,
		Position = UDim2.fromOffset(8, 42),
		Size = UDim2.new(1, -16, 0, 56),
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		MaxTextSize = 17,
		Parent = card,
	})
	local button = Kit.button({
		Text = "R$ " .. robux,
		Color = Theme.Green,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -16, 0, 42),
		Parent = card,
		OnClick = onBuy,
	})
	return card, button
end

function Panel.build(content: Frame)
	local scroll = Kit.list(content, 10)
	local function section(title: string, order: number): Frame
		Kit.text({
			Text = title,
			Size = UDim2.new(1, -12, 0, 34),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Gold,
			MaxTextSize = 28,
			LayoutOrder = order,
			Parent = scroll,
		})
		local holder = Kit.new("Frame", {
			Size = UDim2.new(1, -12, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order + 1,
			Parent = scroll,
		})
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(220, 170),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Parent = holder,
		})
		return holder
	end
	local passHolder = section("Gamepasses (forever)", 1)
	for _, pass in Monetization.Passes do
		local _, button = itemCard(
			passHolder,
			pass.order or 0,
			pass.name,
			pass.description,
			pass.robux,
			Theme.Cyan,
			function()
				Shop.buyPass(pass.id)
			end
		)
		passButtons[pass.id] = button
	end
	local productHolder = section("Boosts", 3)
	for _, product in Monetization.Products do
		local card = itemCard(
			productHolder,
			product.order or 0,
			product.name,
			product.description,
			product.robux,
			Theme.Orange,
			function()
				Shop.buyProduct(product.id)
			end
		)
		if product.id == "StarterPack" then
			starterCard = card
		end
	end
end

function Panel.refresh()
	for passId, button in passButtons do
		if State.hasPass(passId) then
			Kit.setButton(button, "OWNED", Theme.Grey)
		end
	end
	local data = State.data()
	if starterCard and data then
		starterCard.Visible = not data.starterPackClaimed
	end
end

function Panel.onClose() end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="65">
              <Properties>
                <string name="Name">Upgrades</string>
                <string name="Source"><![CDATA[--[[
	Upgrades panel: dive slots, pedestals, luck and oxygen (dive speed).
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local Upgrades = require(Shared.Config.Upgrades)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Client = UI.Parent
local State = require(Client.State)
local Net = require(Client.Net)

local Panel = {
	title = "⬆ Upgrades",
	color = Theme.Green,
}

type Row = { level: TextLabel, button: TextButton }
local rows: { [string]: Row } = {}

local ICONS = { DiveSlots = "🤿", Pedestals = "🏛", Luck = "🍀", Oxygen = "🫧" }

function Panel.build(content: Frame)
	local list = Kit.list(content, 10)
	for _, upgrade in Upgrades.List do
		local row = Kit.new("Frame", {
			Size = UDim2.new(1, -12, 0, 86),
			BackgroundColor3 = Theme.Card,
			LayoutOrder = upgrade.order,
			Parent = list,
		}, { Kit.corner(12), Kit.stroke(3) })
		Kit.text({
			Text = (ICONS[upgrade.id] or "") .. " " .. upgrade.name,
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(0.55, 0, 0, 34),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 28,
			Parent = row,
		})
		Kit.text({
			Text = upgrade.description,
			Position = UDim2.fromOffset(14, 46),
			Size = UDim2.new(0.55, 0, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.SubText,
			MaxTextSize = 20,
			Parent = row,
		})
		local level = Kit.text({
			Text = "",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -200, 0.5, 0),
			Size = UDim2.fromOffset(110, 30),
			TextColor3 = Theme.Gold,
			MaxTextSize = 24,
			Parent = row,
		})
		local button = Kit.button({
			Text = "",
			Color = Theme.Green,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(170, 52),
			Parent = row,
			OnClick = function()
				Net.try("BuyUpgrade", upgrade.id)
			end,
		})
		rows[upgrade.id] = { level = level, button = button }
	end
end

function Panel.refresh()
	local data = State.data()
	if not data then
		return
	end
	local cash = State.cash()
	for id, row in rows do
		local upgrade = Upgrades.ById[id]
		local level = data.upgrades[id] or 0
		row.level.Text = ("Lv %d/%d"):format(level, upgrade.maxLevel)
		local cost = Formulas.upgradeCost(id, level)
		if cost then
			Kit.setButton(row.button, Format.money(cost), if cash >= cost then Theme.Green else Theme.Grey)
		else
			Kit.setButton(row.button, "MAX", Theme.Gold)
		end
	end
end

function Panel.onClose() end

return Panel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="66">
              <Properties>
                <string name="Name">Vault</string>
                <string name="Source"><![CDATA[--[[
	Vault panel: every treasure the player owns, with Place / Remove / Sell, Equip Best and Sell Unplaced.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local ModelFactory = require(Shared.ModelFactory)
local GameConfig = require(Shared.Config.Game)
local Treasures = require(Shared.Config.Treasures)
local Conditions = require(Shared.Config.Conditions)
local Rarities = require(Shared.Config.Rarities)
local Sets = require(Shared.Config.Sets)

local UI = script.Parent.Parent
local Kit = require(UI.Kit)
local Theme = require(UI.Theme)
local Client = UI.Parent
local State = require(Client.State)
local Net = require(Client.Net)

local Panel = {
	title = "💎 Vault",
	color = Theme.Purple,
}

local header: TextLabel
local grid: ScrollingFrame
local lastKey = ""

local function pedestalOf(data, uid: string): number?
	for key, value in data.pedestals do
		if value == uid then
			return tonumber(key)
		end
	end
	return nil
end

function Panel.build(content: Frame)
	local top = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = content })
	header = Kit.text({
		Text = "",
		Size = UDim2.new(0.5, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		Parent = top,
	})
	Kit.button({
		Text = "Equip Best",
		Color = Theme.Green,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -170, 0, 2),
		Size = UDim2.fromOffset(150, 40),
		Parent = top,
		OnClick = function()
			Net.try("EquipBestTreasures")
		end,
	})
	Kit.button({
		Text = "Sell Unplaced",
		Color = Theme.Red,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		Size = UDim2.fromOffset(160, 40),
		Parent = top,
		OnClick = function()
			Net.try("SellUnplacedTreasures")
		end,
	})
	local body = Kit.new("Frame", {
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -50),
		BackgroundTransparency = 1,
		Parent = content,
	})
	grid = Kit.grid(body, UDim2.fromOffset(150, 210), 8)
end

local function card(uid: string, item: { id: string, c: string }, pedestal: number?, order: number)
	local treasure = Treasures.ById[item.id]
	local rarity = Rarities.ById[treasure.rarity]
	local condition = Conditions.ById[item.c]
	local frame = Kit.new("Frame", {
		BackgroundColor3 = if pedestal then Theme.Card else Theme.CardDark,
		LayoutOrder = order,
		Parent = grid,
	}, { Kit.corner(12), Kit.stroke(3, rarity.color) })
	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(25, 4),
		Size = UDim2.new(1, -50, 0, 80),
		Parent = frame,
	})
	Kit.viewport(holder, ModelFactory.treasure(item.id, item.c))
	local name = Kit.text({
		Text = treasure.name,
		Position = UDim2.fromOffset(6, 86),
		Size = UDim2.new(1, -12, 0, 22),
		TextColor3 = rarity.color,
		MaxTextSize = 18,
		Parent = frame,
	})
	if rarity.rainbow then
		name.TextColor3 = Color3.new(1, 1, 1)
		Kit.rainbow(name)
	end
	local conditionText = if condition and condition.id ~= Conditions.Default
		then condition.name .. " " .. Format.multiplier(condition.mult)
		else treasure.rarity
	Kit.text({
		Text = conditionText,
		Position = UDim2.fromOffset(6, 108),
		Size = UDim2.new(1, -12, 0, 18),
		TextColor3 = if condition and condition.id ~= Conditions.Default then condition.color else Theme.SubText,
		MaxTextSize = 16,
		Parent = frame,
	})
	local setText = if treasure.set then "Set: " .. Sets.ById[treasure.set].name else ""
	Kit.text({
		Text = Format.perSecond(Formulas.treasureIncome(item.id, item.c))
			.. (if setText ~= "" then "\n" .. setText else ""),
		Position = UDim2.fromOffset(6, 126),
		Size = UDim2.new(1, -12, 0, 36),
		TextColor3 = Theme.Money,
		TextWrapped = true,
		MaxTextSize = 16,
		Parent = frame,
	})
	Kit.button({
		Text = if pedestal then "Remove" else "Place",
		Color = if pedestal then Theme.Grey else Theme.Green,
		Position = UDim2.new(0, 6, 1, -40),
		Size = UDim2.new(0.5, -9, 0, 34),
		Parent = frame,
		OnClick = function()
			if pedestal then
				Net.try("RemoveTreasure", uid)
			else
				Net.try("PlaceTreasure", uid)
			end
		end,
	})
	Kit.button({
		Text = "Sell",
		Color = Theme.Red,
		Position = UDim2.new(0.5, 3, 1, -40),
		Size = UDim2.new(0.5, -9, 0, 34),
		Parent = frame,
		OnClick = function()
			Net.try("SellTreasure", uid)
		end,
	})
end

function Panel.refresh()
	local data = State.data()
	if not data then
		return
	end
	local uids = {}
	for uid in data.treasures do
		table.insert(uids, uid)
	end
	local placed = 0
	for _ in data.pedestals do
		placed += 1
	end
	header.Text = ("Treasures %d/%d • Pedestals %d/%d • %s"):format(
		#uids,
		GameConfig.MaxTreasures,
		placed,
		State.get("pedestalCount") or 0,
		Format.perSecond(State.get("income") or 0)
	)
	local function value(uid: string): number
		local item = data.treasures[uid]
		return Formulas.treasureIncome(item.id, item.c)
	end
	table.sort(uids, function(a, b)
		local placedA, placedB = pedestalOf(data, a) ~= nil, pedestalOf(data, b) ~= nil
		if placedA ~= placedB then
			return placedA
		end
		local va, vb = value(a), value(b)
		if va == vb then
			return a < b
		end
		return va > vb
	end)
	local parts = {}
	for _, uid in uids do
		table.insert(parts, uid .. ":" .. tostring(pedestalOf(data, uid)))
	end
	local key = table.concat(parts, ",")
	if key == lastKey then
		return
	end
	lastKey = key
	Kit.clear(grid)
	for order, uid in uids do
		card(uid, data.treasures[uid], pedestalOf(data, uid), order)
	end
end

function Panel.onClose() end

return Panel
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--[[
	Full-screen reveal overlays: diver roll spin, chest opening, "open all" summary and offline earnings.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local ModelFactory = require(Shared.ModelFactory)
local Divers = require(Shared.Config.Divers)
local Crates = require(Shared.Config.Crates)
local Treasures = require(Shared.Config.Treasures)
local Conditions = require(Shared.Config.Conditions)
local Rarities = require(Shared.Config.Rarities)
local Zones = require(Shared.Config.Zones)

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Sounds = require(script.Parent.Parent.Sounds)

local Reveal = {}

local root: Instance
local current: Frame? = nil

function Reveal.mount(parent: Instance)
	root = parent
end

function Reveal.isOpen(): boolean
	return current ~= nil
end

local function close()
	if current then
		current:Destroy()
		current = nil
	end
end

local function overlay(): (Frame, Frame)
	close()
	local frame = Kit.new("TextButton", {
		Name = "Reveal",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 50,
		Parent = root,
	})
	local card = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 420),
		BackgroundColor3 = Theme.Panel,
		ZIndex = 51,
		Parent = frame,
	}, { Kit.corner(18), Kit.stroke(4) })
	Kit.new("UISizeConstraint", { MaxSize = Vector2.new(360, 420), Parent = card })
	current = frame :: any
	frame.Activated:Connect(close)
	return frame :: any, card
end

local function label(card: Frame, text: string, y: number, height: number, color: Color3?, maxSize: number?): TextLabel
	return Kit.text({
		Text = text,
		Position = UDim2.new(0.05, 0, y, 0),
		Size = UDim2.new(0.9, 0, height, 0),
		TextColor3 = color or Theme.Text,
		MaxTextSize = maxSize or 36,
		ZIndex = 52,
		Parent = card,
	})
end

local function colorFor(rarityId: string, target: TextLabel)
	local rarity = Rarities.ById[rarityId]
	target.TextColor3 = if rarity.rainbow then Color3.new(1, 1, 1) else rarity.color
	if rarity.rainbow then
		Kit.rainbow(target)
	end
end

local function popIn(card: Frame)
	local scale = Kit.new("UIScale", { Scale = 0.3, Parent = card })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

-- Spins through the crate's divers, then lands on the rolled one.
function Reveal.roll(crateId: string, diverId: string, isNew: boolean, placed: boolean, fast: boolean?)
	local crate = Crates.ById[crateId]
	local frame, card = overlay()
	popIn(card)
	label(card, crate.name, 0.03, 0.09, crate.color, 30)
	local nameLabel = label(card, "...", 0.62, 0.11, Theme.Text, 40)
	local tierLabel = label(card, "", 0.74, 0.07, Theme.SubText, 26)
	local infoLabel = label(card, "", 0.83, 0.12, Theme.SubText, 20)
	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.15, 0.13),
		Size = UDim2.fromScale(0.7, 0.48),
		ZIndex = 52,
		Parent = card,
	})

	local spinTime = if fast then 0.35 else 1.4
	local started = os.clock()
	local nextSwap = 0
	while os.clock() - started < spinTime and frame.Parent do
		local t = (os.clock() - started) / spinTime
		if os.clock() >= nextSwap then
			local entry = crate.pool[math.random(1, #crate.pool)]
			local diver = Divers.ById[entry.diver]
			nameLabel.Text = diver.name
			nameLabel.TextColor3 = Rarities.ById[diver.tier].color
			nextSwap = os.clock() + 0.04 + t * t * 0.25
			Sounds.play("Click", 0.15, 1 + t)
		end
		RunService.RenderStepped:Wait()
	end
	if not frame.Parent then
		return
	end

	local diver = Divers.ById[diverId]
	nameLabel.Text = diver.name
	colorFor(diver.tier, nameLabel)
	tierLabel.Text = diver.tier .. (if isNew then "  •  NEW!" else "")
	colorFor(diver.tier, tierLabel)
	local zoneCount = #Formulas.reachableZones(diver.maxDepth, #Zones.List)
	infoLabel.Text = ("%s luck • %s • dives to %s"):format(
		Format.multiplier(diver.luck),
		if placed then "On your dock!" else "In your inventory",
		Format.depth(math.min(diver.maxDepth, Zones.List[zoneCount].maxDepth))
	)
	Kit.viewport(holder, ModelFactory.diver(diverId), { ZIndex = 52 })
	Sounds.play("Reveal", 0.6, 1.2)
	local rarity = Rarities.ById[diver.tier]
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = rarity.color
	end
	task.delay(if fast then 0.9 else 3, function()
		if current == frame then
			close()
		end
	end)
end

local function treasureCard(card: Frame, result: { [string]: any })
	local treasure = Treasures.ById[result.treasureId]
	local condition = Conditions.ById[result.condition]
	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.2, 0.14),
		Size = UDim2.fromScale(0.6, 0.44),
		ZIndex = 52,
		Parent = card,
	})
	Kit.viewport(holder, ModelFactory.treasure(result.treasureId, result.condition), { ZIndex = 52 })
	local prefix = if condition and condition.id ~= Conditions.Default then condition.name .. " " else ""
	local nameLabel = label(card, prefix .. treasure.name, 0.6, 0.11, Theme.Text, 34)
	colorFor(treasure.rarity, nameLabel)
	local tier =
		label(card, treasure.rarity .. (if result.isNew then "  •  NEW!" else ""), 0.72, 0.07, Theme.SubText, 24)
	colorFor(treasure.rarity, tier)
	local income = Formulas.treasureIncome(result.treasureId, result.condition)
	local info = if result.autoSold
		then "Storage full: sold for " .. Format.money(result.sellValue)
		elseif result.placed then "Placed in your vault: +" .. Format.perSecond(income)
		else "In your vault inventory: " .. Format.perSecond(income)
	label(card, info, 0.81, 0.07, Theme.Money, 22)
	if condition and condition.id ~= Conditions.Default then
		label(
			card,
			condition.name .. " " .. Format.multiplier(condition.mult) .. " income",
			0.89,
			0.06,
			condition.color,
			20
		)
	end
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = Rarities.ById[treasure.rarity].color
	end
end

-- Shakes the chest, then bursts it open to show the treasure.
function Reveal.chest(chestId: string, result: { [string]: any })
	local chest = Zones.ChestById[chestId]
	local frame, card = overlay()
	popIn(card)
	local title = label(card, chest.name, 0.03, 0.09, chest.glow, 30)
	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.15, 0.18),
		Size = UDim2.fromScale(0.7, 0.5),
		ZIndex = 52,
		Parent = card,
	})
	local viewport = Kit.viewport(holder, ModelFactory.chest(chestId), { ZIndex = 52 })
	local started = os.clock()
	while os.clock() - started < 0.9 and frame.Parent do
		local t = os.clock() - started
		viewport.Rotation = math.sin(t * 40) * (4 + t * 10)
		RunService.RenderStepped:Wait()
	end
	if not frame.Parent then
		return
	end
	viewport:Destroy()
	title.Text = chest.name .. " opened!"
	Sounds.play("Reveal", 0.6, 1)
	treasureCard(card, result)
	task.delay(3.5, function()
		if current == frame then
			close()
		end
	end)
end

-- Summary after "Open All": the best finds plus totals.
function Reveal.summary(results: { { [string]: any } })
	if #results == 0 then
		return
	end
	local _, card = overlay()
	popIn(card)
	card.Size = UDim2.fromOffset(420, 460)
	local sizeConstraint = card:FindFirstChildOfClass("UISizeConstraint")
	if sizeConstraint then
		sizeConstraint.MaxSize = Vector2.new(420, 460)
	end
	label(card, ("Opened %d chests"):format(#results), 0.03, 0.08, Theme.Gold, 30)
	table.sort(results, function(a, b)
		return Formulas.treasureIncome(a.treasureId, a.condition) > Formulas.treasureIncome(b.treasureId, b.condition)
	end)
	local newCount, soldTotal = 0, 0
	for _, result in results do
		if result.isNew then
			newCount += 1
		end
		if result.autoSold then
			soldTotal += result.sellValue
		end
	end
	for index = 1, math.min(8, #results) do
		local result = results[index]
		local treasure = Treasures.ById[result.treasureId]
		local condition = Conditions.ById[result.condition]
		local prefix = if condition and condition.id ~= Conditions.Default then condition.name .. " " else ""
		local row = label(
			card,
			prefix
				.. treasure.name
				.. "  "
				.. Format.perSecond(Formulas.treasureIncome(result.treasureId, result.condition)),
			0.12 + (index - 1) * 0.085,
			0.07,
			Theme.Text,
			22
		)
		colorFor(treasure.rarity, row)
	end
	local footer = ("%d new for your Index"):format(newCount)
	if soldTotal > 0 then
		footer ..= " • auto-sold " .. Format.money(soldTotal)
	end
	label(card, footer, 0.83, 0.07, Theme.Money, 22)
	label(card, "Tap to close", 0.91, 0.06, Theme.SubText, 18)
end

function Reveal.offline(seconds: number, amount: number)
	local _, card = overlay()
	popIn(card)
	label(card, "Welcome back!", 0.08, 0.12, Theme.Gold, 40)
	label(card, "Your treasures kept earning for", 0.3, 0.08, Theme.SubText, 24)
	label(card, Format.duration(seconds), 0.4, 0.1, Theme.Text, 34)
	label(card, "+" .. Format.money(amount), 0.55, 0.16, Theme.Money, 56)
	label(card, "Tap to collect", 0.85, 0.07, Theme.SubText, 22)
	Sounds.play("Coin", 0.6)
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Colours and fonts for the whole UI.
]]

return {
	Font = Enum.Font.FredokaOne,
	FontBody = Enum.Font.GothamBold,

	Panel = Color3.fromRGB(28, 44, 78),
	PanelDark = Color3.fromRGB(18, 28, 52),
	Card = Color3.fromRGB(40, 62, 105),
	CardDark = Color3.fromRGB(30, 46, 82),
	Stroke = Color3.fromRGB(10, 16, 32),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(180, 200, 235),

	Green = Color3.fromRGB(70, 210, 90),
	Red = Color3.fromRGB(230, 60, 70),
	Blue = Color3.fromRGB(60, 150, 255),
	Gold = Color3.fromRGB(255, 200, 50),
	Purple = Color3.fromRGB(160, 90, 255),
	Grey = Color3.fromRGB(110, 115, 130),
	Cyan = Color3.fromRGB(60, 210, 230),
	Orange = Color3.fromRGB(255, 150, 50),
	Money = Color3.fromRGB(120, 255, 130),
}
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="69">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>