        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Game</string>
            <string name="Source"><![CDATA[--[[
	General tuning knobs. Most balance changes only need this file.
]]

return {
	-- Save data
	DataStoreName = "RollADiver_Data_v1",
	AutosaveInterval = 60,

	-- Starting state
	StartingCash = 250,

	-- Dock and vault
	BaseDiveSlots = 3,
	MaxDiveSlots = 10, -- 3 base + 5 upgrades + 2 from the gamepass
	BasePedestals = 6,
	MaxPedestals = 16,
	MaxDivers = 60,
	MaxTreasures = 150,

	-- Dive timing (seconds, before speed multipliers)
	DiveBaseTime = 6,
	DiveTimePerZone = 4,
	DiveRestTime = 1,
	DiveBottomShare = 0.2, -- share of the dive spent at the bottom
	DiveDescentShare = 0.4, -- share spent going down (the rest is going up)

	-- Kraken grabs a surfacing diver
	KrakenGrabChance = 0.05,
	KrakenGrabWindow = 6,

	-- Income
	CollectPadCooldown = 0.5,
	SellValueSeconds = 20, -- a treasure sells for this many seconds of its income
	DiverSellShare = 0.25, -- a diver sells for this share of the price of the cheapest roll that contains it
	OfflineShare = 0.25,
	OfflineCapHours = 8,
	OfflineCapHoursVIP = 12,
	IndexZoneBonus = 0.05, -- permanent income bonus per fully completed zone page

	-- Rebirth
	RebirthBaseCost = 30000000,
	RebirthCostGrowth = 20,
	RebirthIncomeBonus = 0.5,
	RebirthKeepTiers = { Divine = true, Secret = true },

	-- Luck math: effective exponent = 1 / (1 + LuckCurve * ln(luck))
	LuckCurve = 0.25,

	-- Server events (seconds)
	Events = {
		LowTide = { interval = 45 * 60, duration = 5 * 60, firstDelay = 10 * 60 },
		BloodMoon = { interval = 90 * 60, duration = 10 * 60, firstDelay = 30 * 60 },
		Kraken = { interval = 120 * 60, duration = 3 * 60, firstDelay = 20 * 60 },
		WarningTime = 30,
	},
	LowTideSpeedMult = 2,
	BloodMoonCursedMult = 5,
	KrakenBaseHealth = 250,
	KrakenClickCooldown = 0.12,

	-- Luck potion
	LuckPotionMult = 2,
	LuckPotionSeconds = 15 * 60,

	-- Rare find announcements: set false to only announce inside the server
	CrossServerAnnouncements = true,

	-- Plots
	PlotCount = 6,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--[[
	Game passes and developer products.

	After publishing, create each pass/product on the Creator Dashboard and paste its id here.
	While an id is 0 the shop shows the item as "Coming soon" and nothing can be bought.
]]

export type Pass = {
	id: string,
	name: string,
	description: string,
	assetId: number,
	robux: number,
	order: number?,
}

export type Product = {
	id: string,
	name: string,
	description: string,
	assetId: number,
	robux: number,
	order: number?,
}

local passes: { Pass } = {
	{
		id = "DoubleMoney",
		name = "x2 Money",
		description = "Double all treasure income forever.",
		assetId = 0,
		robux = 399,
	},
	{
		id = "AutoCollect",
		name = "Auto Collect",
		description = "Pedestal cash goes straight to your wallet.",
		assetId = 0,
		robux = 149,
	},
	{
		id = "AutoOpen",
		name = "Auto Open Chests",
		description = "Chests open themselves the moment divers surface.",
		assetId = 0,
		robux = 199,
	},
	{
		id = "ExtraSlots",
		name = "+2 Dive Slots",
		description = "Two extra divers on your dock.",
		assetId = 0,
		robux = 249,
	},
	{
		id = "LuckyDiver",
		name = "Lucky Diver",
		description = "x1.5 luck on every dive and roll.",
		assetId = 0,
		robux = 299,
	},
	{
		id = "VIP",
		name = "VIP",
		description = "+10% income, 12h offline earnings and a VIP chat tag.",
		assetId = 0,
		robux = 499,
	},
}

local products: { Product } = {
	{
		id = "StarterPack",
		name = "Starter Pack",
		description = "A Deep Sea Suit diver + $5,000. One per player.",
		assetId = 0,
		robux = 99,
	},
	{
		id = "LuckPotion",
		name = "Luck Potion",
		description = "x2 luck for 15 minutes. Stacks time.",
		assetId = 0,
		robux = 49,
	},
	{
		id = "OxygenTank",
		name = "Oxygen Tank",
		description = "All your divers surface instantly with their chests.",
		assetId = 0,
		robux = 25,
	},
	{
		id = "ServerLowTide",
		name = "Server Low Tide",
		description = "Start a Low Tide for the whole server right now.",
		assetId = 0,
		robux = 199,
	},
	{
		id = "CashSmall",
		name = "Cash Pouch",
		description = "10 minutes of your current income.",
		assetId = 0,
		robux = 39,
	},
	{
		id = "CashLarge",
		name = "Cash Chest",
		description = "2 hours of your current income.",
		assetId = 0,
		robux = 299,
	},
}

local passById: { [string]: Pass } = {}
for order, pass in passes do
	pass.order = order
	passById[pass.id] = pass
end

local productById: { [string]: Product } = {}
for order, product in products do
	product.order = order
	productById[product.id] = product
end

return {
	Passes = passes,
	PassById = passById,
	Products = products,
	ProductById = productById,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--[[
	Rarity tiers shared by divers and treasures.
	`rank` orders tiers (higher = rarer). `announce` broadcasts finds to the whole server.
]]

export type Rarity = {
	id: string,
	rank: number,
	color: Color3,
	rainbow: boolean?,
	announce: boolean?,
}

local list: { Rarity } = {
	{ id = "Common", rank = 1, color = Color3.fromRGB(205, 205, 205) },
	{ id = "Uncommon", rank = 2, color = Color3.fromRGB(95, 220, 110) },
	{ id = "Rare", rank = 3, color = Color3.fromRGB(70, 150, 255) },
	{ id = "Epic", rank = 4, color = Color3.fromRGB(175, 85, 255) },
	{ id = "Legendary", rank = 5, color = Color3.fromRGB(255, 190, 40) },
	{ id = "Mythic", rank = 6, color = Color3.fromRGB(255, 80, 160), announce = true },
	{ id = "Abyssal", rank = 7, color = Color3.fromRGB(235, 40, 45), announce = true },
	{ id = "Divine", rank = 8, color = Color3.fromRGB(150, 255, 245), rainbow = true, announce = true },
	{ id = "Secret", rank = 9, color = Color3.fromRGB(25, 25, 30), rainbow = true, announce = true },
}

local byId: { [string]: Rarity } = {}
for _, rarity in list do
	byId[rarity.id] = rarity
end

return {
	List = list,
	ById = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Sets</string>
            <string name="Source"><![CDATA[--[[
	Treasure sets. When every treasure of a set is displayed in the vault at the same time,
	each of those treasures earns `bonus` extra income (0.25 = +25%).
]]

export type TreasureSet = {
	id: string,
	name: string,
	bonus: number,
	items: { string },
}

local list: { TreasureSet } = {
	{ id = "BeachDay", name = "Beach Day", bonus = 0.25, items = { "LostSunglasses", "PearlNecklace", "GoldenDuck" } },
	{
		id = "PirateCaptain",
		name = "Pirate Captain",
		bonus = 0.25,
		items = { "CaptainsHat", "BronzeCompass", "PirateMap", "Cutlass" },
	},
	{ id = "DeepGlow", name = "Deep Glow", bonus = 0.3, items = { "BioOrb", "GlowingIdol", "Moonstone" } },
	{
		id = "KrakenSlayer",
		name = "Kraken Slayer",
		bonus = 0.35,
		items = { "KrakenTooth", "KrakenEye", "LeviathanScale" },
	},
	{
		id = "Atlantean",
		name = "Atlantean Regalia",
		bonus = 0.5,
		items = { "CrystalTablet", "AtlanteanHelm", "PoseidonTrident", "AtlanteanCrown" },
	},
}

local byId: { [string]: TreasureSet } = {}
for _, set in list do
	byId[set.id] = set
end

return {
	List = list,
	ById = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Treasures</string>
            <string name="Source"><![CDATA[--[[
	Every treasure a chest can contain.

	`odds` is the "1 in N" chance inside its zone's chest at luck x1.
	Income per second is derived from the zone and the odds (see Formulas.treasureBaseIncome),
	so a rarer treasure is always worth more.

	`shape` picks the procedural model built by ModelFactory:
	Coin, Gem, Orb, Shell, Bottle, Star, Anchor, Crown, Sword, Block, Ring, Skull, Trident, Helmet, Duck, Hat, Bell
]]

local Zones = require(script.Parent.Zones)

export type Treasure = {
	id: string,
	name: string,
	zone: string,
	rarity: string,
	odds: number,
	shape: string,
	color: Color3,
	set: string?,
	order: number?,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

