  <Item class="ServerScriptService" referent="20">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="21">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[--[[
	World layout. Everything is positioned relative to a plot CFrame whose local +Z
	points from the dock toward the open channel in the middle of the map.
]]

local Layout = {}

Layout.WaterLevel = 0
Layout.SeaFloor = -40
Layout.TrenchBottom = -340
Layout.DeckTop = 4

-- Six plots: three on each side of a central channel, facing each other.
Layout.Plots = {} :: { CFrame }
for _, x in { -160, 0, 160 } do
	table.insert(Layout.Plots, CFrame.new(x, 0, -120))
	table.insert(Layout.Plots, CFrame.new(x, 0, 120) * CFrame.Angles(0, math.pi, 0))
end

-- Deck (local space)
Layout.DeckCenter = CFrame.new(0, Layout.DeckTop - 1, -12)
Layout.DeckSize = Vector3.new(130, 2, 64)
Layout.DeckFrontZ = 20

-- Trench box (local space, x/z footprint)
Layout.TrenchCenterZ = 46
Layout.TrenchSize = Vector3.new(128, 0, 48)

-- Spawn point on the deck
Layout.Spawn = CFrame.new(0, Layout.DeckTop + 3, 0)

-- Kraken rises in the middle of the channel
Layout.KrakenPosition = Vector3.new(0, -14, 0)

-- Harbor (fallback spawn)
Layout.Harbor = CFrame.new(-290, 0, 0)

local SLOT_COUNT = 10
local SLOT_SPACING = 11

function Layout.slotX(slot: number): number
	return -((SLOT_COUNT - 1) * SLOT_SPACING) / 2 + (slot - 1) * SLOT_SPACING
end

-- Where a diver stands, facing the trench.
function Layout.slotHome(slot: number): CFrame
	local x = Layout.slotX(slot)
	return CFrame.lookAt(Vector3.new(x, Layout.DeckTop + 0.1, 14), Vector3.new(x, Layout.DeckTop + 0.1, 30))
end

-- Where a diver hits the water.
function Layout.slotEntry(slot: number): Vector3
	return Vector3.new(Layout.slotX(slot), Layout.WaterLevel, 32)
end

-- Pedestals: two rows of eight in the vault at the back of the deck.
function Layout.pedestalPosition(index: number): Vector3
	local row = if index <= 8 then 0 else 1
	local column = (index - 1) % 8
	local x = -42 + column * 12
	local z = if row == 0 then -20 else -36
	return Vector3.new(x, Layout.DeckTop, z)
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="23">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point: loads every service into the registry, then runs Init (setup) and Start (loops/events).
]]

local Services = require(script.Parent.Registry)
local folder = script.Parent.Services

-- Init order matters: the world and plots exist before players load.
local ORDER = {
	"WorldBuilder",
	"PlotService",
	"DataService",
	"EconomyService",
	"MarketService",
	"AnnouncementService",
	"EventService",
	"KrakenService",
	"VaultService",
	"ChestService",
	"DiverService",
	"RollService",
	"UpgradeService",
	"RebirthService",
	"ActionService",
	"AdminService",
	"PlayerService",
}

for _, name in ORDER do
	Services[name] = (require :: any)(folder:WaitForChild(name))
end

for _, name in ORDER do
	local service = Services[name]
	if service.Init then
		service.Init()
	end
end

for _, name in ORDER do
	local service = Services[name]
	if service.Start then
		service.Start()
	end
end

print("[Roll a Diver] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--[[
	Service registry. Main.server fills it before any service starts,
	so services can reach each other at runtime (never at require time) without circular requires.
]]

return {} :: { [string]: any }
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ActionService</string>
            <string name="Source"><![CDATA[--[[
	The single client -> server entry point. Every action is validated and rate limited here
	before it reaches the service that performs it. Clients get back { ok, err?, ... }.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Remotes = require(Shared.Remotes)
local Format = require(Shared.Util.Format)

local Services = require(script.Parent.Parent.Registry)

local ActionService = {}

local MIN_INTERVAL = 0.08
local lastAction: { [Player]: number } = {}

local function isString(value: any): boolean
	return type(value) == "string" and #value > 0 and #value < 64
end

local function isSlot(value: any): boolean
	return type(value) == "number" and value == math.floor(value) and value >= 1 and value <= 32
end

local function result(ok: boolean, err: string?)
	return { ok = ok, err = err }
end

local handlers: { [string]: (Player, ...any) -> any } = {
	Roll = function(player, crateId)
		if not isString(crateId) then
			return result(false, "Bad roll")
		end
		return Services.RollService.Roll(player, crateId)
	end,

	PlaceDiver = function(player, uid, slot)
		if not isString(uid) or (slot ~= nil and not isSlot(slot)) then
			return result(false)
		end
		return result(Services.DiverService.Place(player, uid, slot))
	end,
	RemoveDiver = function(player, uid)
		if not isString(uid) then
			return result(false)
		end
		return result(Services.DiverService.Remove(player, uid))
	end,
	SellDiver = function(player, uid)
		if not isString(uid) then
			return result(false)
		end
		return result(Services.DiverService.Sell(player, uid))
	end,
	SellUnplacedDivers = function(player, maxRank)
		if type(maxRank) ~= "number" then
			return result(false)
		end
		local sold, total = Services.DiverService.SellUnplaced(player, math.clamp(math.floor(maxRank), 1, 9))
		return { ok = true, sold = sold, total = total }
	end,
	EquipBestDivers = function(player)
		Services.DiverService.EquipBest(player)
		return result(true)
	end,

	OpenChest = function(player, chestId)
		if not isString(chestId) then
			return result(false)
		end
		local opened = Services.ChestService.Open(player, chestId)
		if not opened then
			return result(false, "No chest to open")
		end
		return { ok = true, result = opened }
	end,
	OpenAllChests = function(player, chestId)
		if chestId ~= nil and not isString(chestId) then
			return result(false)
		end
		local results = Services.ChestService.OpenAll(player, chestId)
		return { ok = true, results = results }
	end,

	PlaceTreasure = function(player, uid, index)
		if not isString(uid) or (index ~= nil and not isSlot(index)) then
			return result(false)
		end
		return result(Services.VaultService.Place(player, uid, index))
	end,
	RemoveTreasure = function(player, uid)
		if not isString(uid) then
			return result(false)
		end
		return result(Services.VaultService.Remove(player, uid))
	end,
	SellTreasure = function(player, uid)
		if not isString(uid) then
			return result(false)
		end
		return result(Services.VaultService.Sell(player, uid))
	end,
	SellUnplacedTreasures = function(player)
		local sold, total = Services.VaultService.SellUnplaced(player)
		if sold > 0 then
			Services.PlayerService.Notify(
				player,
				("Sold %d treasures for %s"):format(sold, Format.money(total)),
				"Success"
			)
		end
		return { ok = true, sold = sold, total = total }
	end,
	EquipBestTreasures = function(player)
		Services.VaultService.EquipBest(player)
		return result(true)
	end,

	BuyUpgrade = function(player, upgradeId)
		if not isString(upgradeId) then
			return result(false)
		end
		return Services.UpgradeService.Buy(player, upgradeId)
	end,
	Rebirth = function(player)
		return Services.RebirthService.Rebirth(player)
	end,
}

function ActionService.Start()
	Remotes.func("Action").OnServerInvoke = function(player: Player, name: any, ...)
		if type(name) ~= "string" or not handlers[name] then
			return result(false, "Unknown action")
		end
		if not Services.PlayerService.IsReady(player) then
			return result(false, "Still loading...")
		end
		local t = os.clock()
		if t - (lastAction[player] or 0) < MIN_INTERVAL then
			return result(false, "Slow down!")
		end
		lastAction[player] = t
		local ok, response = pcall(handlers[name], player, ...)
		if not ok then
			warn(("[ActionService] %s failed for %s: %s"):format(name, player.Name, tostring(response)))
			return result(false, "Something went wrong")
		end
		Services.DataService.MarkDirty(player)
		return response
	end
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return ActionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--[[
	Chat commands for testing. Only work in Studio or for the game's owner.

	/cash 1e6            add cash
	/rebirth             free rebirth (sets cash to the cost first)
	/event lowtide|bloodmoon|kraken
	/endevent lowtide|bloodmoon|kraken
	/diver PoseidonId    give a diver (ids from Config/Divers)
	/chest 3 5           give 5 chests from zone 3
	/pass DoubleMoney    toggle a gamepass (Studio only)
	/product LuckPotion  run a developer product's effect (Studio only)
	/wipe                reset your save
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Divers = require(Shared.Config.Divers)
local Monetization = require(Shared.Config.Monetization)

local Services = require(script.Parent.Parent.Registry)

local AdminService = {}

local EVENT_ALIASES = { lowtide = "LowTide", bloodmoon = "BloodMoon", kraken = "Kraken" }

local function isAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank >= 254
end

local commands: { [string]: (Player, { string }) -> string? } = {
	cash = function(player, args)
		local amount = tonumber(args[1]) or 1e6
		Services.EconomyService.AddCash(player, amount)
		return "Added cash"
	end,
	rebirth = function(player)
		local data = Services.DataService.Get(player)
		if not data then
			return nil
		end
		data.cash = math.max(data.cash, Formulas.rebirthCost(data.rebirths))
		local response = Services.RebirthService.Rebirth(player)
		return if response.ok then "Rebirthed" else response.err
	end,
	event = function(_, args)
		local name = EVENT_ALIASES[string.lower(args[1] or "")]
		if not name then
			return "Events: lowtide, bloodmoon, kraken"
		end
		Services.EventService.StartEvent(name)
		return "Started " .. name
	end,
	endevent = function(_, args)
		local name = EVENT_ALIASES[string.lower(args[1] or "")]
		if not name then
			return "Events: lowtide, bloodmoon, kraken"
		end
		Services.EventService.EndEvent(name)
		return "Ended " .. name
	end,
	diver = function(player, args)
		local id = args[1]
		if not id or not Divers.ById[id] then
			return "Unknown diver id"
		end
		Services.DiverService.AddDiver(player, id, true)
		return "Gave " .. id
	end,
	chest = function(player, args)
		local zone = tonumber(args[1]) or 1
		local count = math.clamp(tonumber(args[2]) or 1, 1, 100)
		Services.ChestService.GrantFromZone(player, zone, count, Services.EconomyService.LuckMult(player))
		return "Gave chests"
	end,
	pass = function(player, args)
		if not RunService:IsStudio() then
			return "Pass toggles only work in Studio"
		end
		local id = args[1]
		local data = Services.DataService.Get(player)
		if not data or not id or not Monetization.PassById[id] then
			return "Unknown pass id"
		end
		data.devPasses[id] = not data.devPasses[id] or nil
		Services.MarketService.ApplyPassPerks(player)
		Services.VaultService.Refresh(player)
		return id .. (if data.devPasses[id] then " ON" else " OFF")
	end,
	product = function(player, args)
		if not RunService:IsStudio() then
			return "Product tests only work in Studio"
		end
		local id = args[1]
		if not id or not Monetization.ProductById[id] then
			return "Unknown product id"
		end
		Services.MarketService.GrantProduct(player, id)
		return "Granted " .. id
	end,
	wipe = function(player)
		Services.DataService.Wipe(player)
		Services.DiverService.Clear(player)
		Services.VaultService.Clear(player)
		Services.DiverService.AddDiver(player, Divers.StarterDiver, true)
		Services.VaultService.Refresh(player)
		Services.EconomyService.RefreshDisplay(player)
		return "Save wiped"
	end,
}

local function onChatted(player: Player, message: string)
	if string.sub(message, 1, 1) ~= "/" or not isAdmin(player) then
		return
	end
	local parts = string.split(string.sub(message, 2), " ")
	local name = string.lower(table.remove(parts, 1) or "")
	local command = commands[name]
	if not command or not Services.PlayerService.IsReady(player) then
		return
	end
	local ok, response = pcall(command, player, parts)
	Services.DataService.MarkDirty(player)
	Services.PlayerService.Notify(player, "[Admin] " .. tostring(if ok then response or "Done" else response), "Info")
end

function AdminService.Start()
	local TextChatService = game:GetService("TextChatService")
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		-- modern chat: register real commands so they are not sent as chat messages
		local folder = Instance.new("Folder")
		folder.Name = "AdminCommands"
		folder.Parent = TextChatService
		for name in commands do
			local command = Instance.new("TextChatCommand")
			command.Name = name
			command.PrimaryAlias = "/" .. name
			command.Parent = folder
			command.Triggered:Connect(function(source, text)
				local player = Players:GetPlayerByUserId(source.UserId)
				if player then
					onChatted(player, text)
				end
			end)
		end
		return
	end
	local function hook(player: Player)
		player.Chatted:Connect(function(message)
			onChatted(player, message)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">AnnouncementService</string>
            <string name="Source"><![CDATA[--[[
	Server-wide announcements for rare finds, plus optional cross-server announcements
	for the very rarest (Divine / Secret / Glitched) through MessagingService.
]]

local MessagingService = game:GetService("MessagingService")

local Shared = game:GetService("ReplicatedStorage").Shared
local GameConfig = require(Shared.Config.Game)
local Remotes = require(Shared.Remotes)

local AnnouncementService = {}

local TOPIC = "RollADiverAnnouncements"

function AnnouncementService.Announce(text: string, color: Color3, crossServer: boolean?)
	Remotes.event("Announce"):FireAllClients(text, color)
	if crossServer and GameConfig.CrossServerAnnouncements and game.JobId ~= "" then
		task.spawn(function()
			pcall(function()
				MessagingService:PublishAsync(TOPIC, {
					text = text,
					color = color:ToHex(),
					job = game.JobId,
				})
			end)
		end)
	end
end

function AnnouncementService.Start()
	if not GameConfig.CrossServerAnnouncements or game.JobId == "" then
		return
	end
	task.spawn(function()
		pcall(function()
			MessagingService:SubscribeAsync(TOPIC, function(message)
				local payload = message.Data
				if type(payload) ~= "table" or payload.job == game.JobId then
					return
				end
				local ok, color = pcall(Color3.fromHex, payload.color)
				Remotes.event("Announce")
					:FireAllClients("🌍 " .. tostring(payload.text), if ok then color else Color3.new(1, 1, 1))
			end)
		end)
	end)
end

return AnnouncementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ChestService</string>
            <string name="Source"><![CDATA[--[[
	Chests. Contents are rolled when the diver surfaces (so the diver's luck counts)
	and stored sealed until the player opens them. Auto Open opens them straight away.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Zones = require(Shared.Config.Zones)
local Treasures = require(Shared.Config.Treasures)

local Services = require(script.Parent.Parent.Registry)

local ChestService = {}

local MAX_SEALED = 200

type Content = { c: string, t: string, v: string }

local random = Random.new()
local function rand(): number
	return random:NextNumber()
end

function ChestService.RollContents(chestId: string, luck: number, noCommon: boolean?, cursedMult: number?): Content
	local chest = Zones.ChestById[chestId]
	local treasureId = Formulas.rollTreasure(chest.zone, luck, noCommon, rand)
	local conditionId = Formulas.rollCondition(luck, cursedMult, rand)
	return { c = chestId, t = treasureId, v = conditionId }
end

local function openContent(player: Player, content: Content)
	local data = Services.DataService.Get(player)
	if data then
		data.stats.chestsOpened += 1
	end
	return Services.VaultService.AddTreasure(player, content.t, content.v)
end

-- Gives the player sealed chests (or opens them right away with Auto Open).
function ChestService.Grant(player: Player, contents: { Content })
	local data = Services.DataService.Get(player)
	if not data or #contents == 0 then
		return
	end
	local autoOpen = Services.MarketService.HasPass(player, "AutoOpen")
	local names = {}
	for _, content in contents do
		if autoOpen or #data.chests >= MAX_SEALED then
			local result = openContent(player, content)
			local treasure = Treasures.ById[content.t]
			if result and not result.autoSold then
				table.insert(names, treasure.name)
			end
		else
			table.insert(data.chests, content)
		end
	end
	local chestName = Zones.ChestById[contents[1].c].name
	if autoOpen and #names > 0 then
		Services.PlayerService.Notify(player, "Opened " .. chestName .. ": " .. table.concat(names, ", "), "Info")
	elseif not autoOpen then
		local suffix = if #contents > 1 then " x" .. #contents else ""
		Services.PlayerService.Notify(player, "+ " .. chestName .. suffix, "Chest")
	end
	Services.DataService.MarkDirty(player)
end

-- Opens the oldest sealed chest of the given type. Returns what was inside.
function ChestService.Open(player: Player, chestId: string)
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	for index, content in data.chests do
		if content.c == chestId then
			table.remove(data.chests, index)
			local result = openContent(player, content)
			Services.DataService.MarkDirty(player)
			return result
		end
	end
	return nil
end

-- Opens every sealed chest (optionally only one type). Returns the list of results.
function ChestService.OpenAll(player: Player, chestId: string?)
	local data = Services.DataService.Get(player)
	if not data then
		return {}
	end
	local results = {}
	local index = 1
	while index <= #data.chests do
		local content = data.chests[index]
		if chestId == nil or content.c == chestId then
			table.remove(data.chests, index)
			local result = openContent(player, content)
			if result then
				table.insert(results, result)
			end
		else
			index += 1
		end
	end
	Services.DataService.MarkDirty(player)
	return results
end

-- Kraken rewards and admin commands: chests from the player's deepest unlocked zone.
function ChestService.GrantFromZone(player: Player, zoneIndex: number, count: number, luck: number)
	local zone = Zones.List[math.clamp(zoneIndex, 1, #Zones.List)]
	local contents = {}
	for _ = 1, count do
		table.insert(contents, ChestService.RollContents(zone.chest, luck, false, Services.EconomyService.CursedMult()))
	end
	ChestService.Grant(player, contents)
end

return ChestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	Player save data: load with a session lock, autosave, save on leave and on shutdown.
	If DataStores are unavailable (e.g. Studio without API access) the game still runs,
	it just doesn't save.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage").Shared
local GameConfig = require(Shared.Config.Game)
local Signal = require(Shared.Util.Signal)

local DataService = {}

DataService.Saving = Signal.new()

local LOCK_TIMEOUT = 30 * 60
local LOAD_RETRIES = 4

type Profile = {
	data: { [string]: any },
	canSave: boolean,
	dirty: boolean,
	lastSave: number,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil
local shuttingDown = false

-- Fresh save for a brand new player. Keys are strings so it serialises cleanly.
function DataService.Template(): { [string]: any }
	return {
		version = 1,
		cash = GameConfig.StartingCash,
		totalEarned = 0,
		rebirths = 0,
		nextUid = 1,
		divers = {}, -- [uid] = diverId
		slots = {}, -- [tostring(slot)] = diver uid
		treasures = {}, -- [uid] = { id = treasureId, c = conditionId }
		pedestals = {}, -- [tostring(index)] = treasure uid
		chests = {}, -- list of { c = chestId, t = treasureId, v = conditionId }
		index = {}, -- [treasureId] = { [conditionId] = true }
		diverIndex = {}, -- [diverId] = true
		upgrades = { DiveSlots = 0, Pedestals = 0, Luck = 0, Oxygen = 0 },
		luckPotionEnds = 0,
		starterPackClaimed = false,
		receipts = {}, -- recent purchase ids, newest last
		devPasses = {}, -- Studio-only pass overrides for testing
		stats = { dives = 0, chestsOpened = 0, rolls = 0, collected = 0, krakenHits = 0 },
		lastOnline = 0,
		lock = nil,
	}
end

local function reconcile(target: { [string]: any }, template: { [string]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = if type(value) == "table" then table.clone(value) else value
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			reconcile(target[key], value)
		end
	end
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, progress will not save:", result)
	end
end

-- Loads (or creates) the player's data. Returns false if the player should be kicked.
function DataService.Load(player: Player): boolean
	local data: { [string]: any }? = nil
	local canSave = store ~= nil

	if store then
		local jobId = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
		for attempt = 1, LOAD_RETRIES do
			local lockedElsewhere = false
			local ok, result = pcall(function()
				return (store :: DataStore):UpdateAsync(keyFor(player), function(old)
					old = old or DataService.Template()
					local lock = old.lock
					local stealLock = attempt == LOAD_RETRIES
					if lock and lock.job ~= jobId and os.time() - (lock.time or 0) < LOCK_TIMEOUT and not stealLock then
						lockedElsewhere = true
						return nil
					end
					old.lock = { job = jobId, time = os.time() }
					return old
				end)
			end)
			if ok and result then
				data = result
				break
			elseif not ok then
				warn(("[DataService] Load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
				if RunService:IsStudio() and tostring(result):find("API") then
					-- Studio without "Enable Studio Access to API Services"
					canSave = false
					break
				end
			end
			if lockedElsewhere then
				warn(("[DataService] %s's data is locked by another server, retrying"):format(player.Name))
			end
			if not player.Parent then
				return false
			end
			task.wait(if lockedElsewhere then 6 else 2)
		end
		if not data and canSave then
			return false
		end
	end

	if not player.Parent then
		return false
	end

	local loaded = data or DataService.Template()
	reconcile(loaded, DataService.Template())
	profiles[player] = {
		data = loaded,
		canSave = canSave,
		dirty = true,
		lastSave = os.clock(),
	}
	if not canSave then
		warn("[DataService] Running without saving for " .. player.Name)
	end
	return true
end

function DataService.Get(player: Player): { [string]: any }?
	local profile = profiles[player]
	return profile and profile.data
end

function DataService.IsSaving(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.canSave
end

-- Marks the player's data as changed so the next sync sends it to their client.
function DataService.MarkDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.dirty = true
	end
end

function DataService.ConsumeDirty(player: Player): boolean
	local profile = profiles[player]
	if profile and profile.dirty then
		profile.dirty = false
		return true
	end
	return false
end

function DataService.Save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.canSave or not store then
		return false
	end
	DataService.Saving:Fire(player, profile.data)
	local jobId = profile.data.lock and profile.data.lock.job
	local data = profile.data
	data.lastOnline = os.time()
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			if old and old.lock and jobId and old.lock.job ~= jobId then
				-- another server took over this session; never overwrite its data
				return nil
			end
			data.lock = if release then nil else { job = jobId, time = os.time() }
			return data
		end)
	end)
	if not ok then
		warn(("[DataService] Save failed for %s: %s"):format(player.Name, tostring(err)))
	end
	profile.lastSave = os.clock()
	return ok
end

function DataService.Release(player: Player)
	DataService.Save(player, true)
	profiles[player] = nil
end

-- Studio/admin helper: reset a player to a fresh save.
function DataService.Wipe(player: Player)
	local profile = profiles[player]
	if profile then
		local lock = profile.data.lock
		profile.data = DataService.Template()
		profile.data.lock = lock
		profile.dirty = true
	end
end

-- Set by PlayerService: flushes things like uncollected pedestal cash before the final save.
DataService.BeforeRelease = nil :: ((Player) -> ())?

local function releaseForShutdown(player: Player)
	local hook = DataService.BeforeRelease
	if hook then
		pcall(hook, player)
	end
	DataService.Release(player)
end

function DataService.Start()
	task.spawn(function()
		while not shuttingDown do
			task.wait(5)
			for player, profile in profiles do
				if os.clock() - profile.lastSave >= GameConfig.AutosaveInterval then
					task.spawn(DataService.Save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		shuttingDown = true
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				releaseForShutdown(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DiverService</string>
            <string name="Source"><![CDATA[--[[
	Divers: inventory (add / place / remove / sell / equip best) and the dive loop.

	Each placed diver runs a small state machine on the server:
	  Idle -> Down -> Bottom -> (Grabbed) -> Up -> Idle
	The server only sets attributes on the diver model (Phase, PhaseStart, PhaseDuration, depth, glow);
	every client animates the models itself from those attributes (see client DiverAnimator).
]]

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local ModelFactory = require(Shared.ModelFactory)
local GameConfig = require(Shared.Config.Game)
local Divers = require(Shared.Config.Divers)
local Zones = require(Shared.Config.Zones)
local Treasures = require(Shared.Config.Treasures)
local Rarities = require(Shared.Config.Rarities)
local Remotes = require(Shared.Remotes)

local Services = require(script.Parent.Parent.Registry)

local DiverService = {}

type Content = { c: string, t: string, v: string }

type Record = {
	uid: string,
	diverId: string,
	slot: number,
	model: Model,
	phase: string,
	phaseEnd: number,
	chestId: string?,
	chestCount: number,
	contents: { Content }?,
	luck: number,
	noCommon: boolean,
	durations: { bottom: number, up: number },
	diveCount: number,
	tentacle: Model?,
}

local records: { [Player]: { [number]: Record } } = {}
local random = Random.new()

local function rand(): number
	return random:NextNumber()
end

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- Slots ------------------------------------------------------------------------------------

function DiverService.SlotCount(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 0
	end
	return Formulas.diveSlotCount(data.upgrades.DiveSlots, Services.MarketService.HasPass(player, "ExtraSlots"))
end

local function slotOf(data: any, uid: string): number?
	for key, value in data.slots do
		if value == uid then
			return tonumber(key)
		end
	end
	return nil
end

DiverService.SlotOf = slotOf

local function newUid(data: any, prefix: string): string
	local uid = prefix .. data.nextUid
	data.nextUid += 1
	return uid
end

-- Models -----------------------------------------------------------------------------------

local function setPhase(record: Record, phase: string, duration: number)
	record.phase = phase
	record.phaseEnd = now() + duration
	local model = record.model
	model:SetAttribute("Phase", phase)
	model:SetAttribute("PhaseStart", now())
	model:SetAttribute("PhaseDuration", duration)
end

local function destroyTentacle(record: Record)
	if record.tentacle then
		record.tentacle:Destroy()
		record.tentacle = nil
	end
end

local function destroyRecord(record: Record)
	destroyTentacle(record)
	record.model:Destroy()
end

local function makeTag(model: Model, diverId: string)
	local diver = Divers.ById[diverId]
	local rarity = Rarities.ById[diver.tier]
	local head = model:FindFirstChild("Head") :: BasePart
	local gui = Instance.new("BillboardGui")
	gui.Name = "Tag"
	gui.Size = UDim2.fromOffset(180, 66)
	gui.StudsOffset = Vector3.new(0, 3.2, 0)
	gui.MaxDistance = 90
	gui.Adornee = head
	local function line(name: string, text: string, color: Color3, y: number, height: number)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, height)
		label.Position = UDim2.fromScale(0, y)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = color
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = label
		label.Parent = gui
	end
	line("DiverName", diver.name, Color3.new(1, 1, 1), 0, 0.36)
	line("Tier", diver.tier .. "  " .. Format.multiplier(diver.luck) .. " luck", rarity.color, 0.36, 0.3)
	line("Status", "", Color3.fromRGB(170, 230, 255), 0.66, 0.34)
	gui.Parent = model
end

local function createRecord(player: Player, slot: number, uid: string, diverId: string): Record?
	local plot = Services.PlotService.Get(player)
	if not plot then
		return nil
	end
	local slotParts = plot.slots[slot]
	local model = ModelFactory.diver(diverId)
	model.Name = "Diver" .. slot
	model:SetAttribute("Home", slotParts.home)
	model:SetAttribute("Entry", slotParts.entry)
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("Slot", slot)
	model:SetAttribute("DepthStuds", 0)
	model:SetAttribute("DepthMeters", 0)
	model:PivotTo(slotParts.home)
	makeTag(model, diverId)
	CollectionService:AddTag(model, "Diver")
	model.Parent = plot.divers

	local record: Record = {
		uid = uid,
		diverId = diverId,
		slot = slot,
		model = model,
		phase = "Idle",
		phaseEnd = 0,
		chestCount = 0,
		luck = 1,
		noCommon = false,
		durations = { bottom = 1, up = 1 },
		diveCount = 0,
	}
	-- stagger the first dive so a full dock doesn't move in lockstep
	setPhase(record, "Idle", GameConfig.DiveRestTime + random:NextNumber(0, 1.5))
	return record
end

-- Rebuilds the diver models on the player's dock to match their save data.
function DiverService.Refresh(player: Player)
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.Get(player)
	if not data or not plot then
		return
	end
	local playerRecords = records[player] or {}
	records[player] = playerRecords
	local slotCount = DiverService.SlotCount(player)

	for slot = 1, GameConfig.MaxDiveSlots do
		local key = tostring(slot)
		local uid = data.slots[key]
		if uid and (slot > slotCount or not data.divers[uid]) then
			data.slots[key] = nil
			uid = nil
		end
		local record = playerRecords[slot]
		if record and record.uid ~= uid then
			destroyRecord(record)
			playerRecords[slot] = nil
			record = nil
		end
		if uid and not record then
			playerRecords[slot] = createRecord(player, slot, uid, data.divers[uid]) :: Record
		end
	end

	Services.PlotService.UpdateLocks(plot, slotCount, Services.VaultService.PedestalCount(player))
	Services.DataService.MarkDirty(player)
end

function DiverService.Clear(player: Player)
	local playerRecords = records[player]
	if playerRecords then
		for _, record in playerRecords do
			destroyRecord(record)
		end
	end
	records[player] = nil
end

-- Dive loop --------------------------------------------------------------------------------

local function neighbours(playerRecords: { [number]: Record }, slot: number): { Record }
	local result = {}
	for _, other in { slot - 1, slot + 1 } do
		local record = playerRecords[other]
		if record then
			table.insert(result, record)
		end
	end
	return result
end

local function hasAbilityPlaced(playerRecords: { [number]: Record }, ability: string): boolean
	for _, record in playerRecords do
		if Divers.ById[record.diverId].ability == ability then
			return true
		end
	end
	return false
end

local function startDive(player: Player, playerRecords: { [number]: Record }, record: Record)
	local diver = Divers.ById[record.diverId]
	local maxDepth = diver.maxDepth
	local luck = diver.luck * Services.EconomyService.LuckMult(player)
	for _, neighbour in neighbours(playerRecords, record.slot) do
		local other = Divers.ById[neighbour.diverId]
		if other.ability == "ShareDepth" then
			maxDepth = math.max(maxDepth, other.maxDepth)
		elseif other.ability == "AdjacentLuck" then
			luck *= 1.5
		end
	end

	local zoneCap = Services.EconomyService.ZoneCap(player)
	if diver.ability == "IgnoreZoneLock" then
		zoneCap = #Zones.List
	end
	local reachable = Formulas.reachableZones(maxDepth, zoneCap)
	local zoneIndex = Formulas.rollZone(reachable, rand)
	local zone = Zones.List[zoneIndex]
	local bottomDepth = math.min(zone.maxDepth, maxDepth)
	local depthMeters = math.max(5, zone.minDepth + rand() * (bottomDepth - zone.minDepth))

	local speed = diver.speed * Services.EconomyService.SpeedMult(player)
	local total = Formulas.diveDuration(reachable[#reachable], speed)

	record.diveCount += 1
	record.chestId = zone.chest
	record.chestCount = if diver.ability == "DoubleEvery5" and record.diveCount % 5 == 0 then 2 else 1
	record.contents = nil
	record.luck = luck
	record.noCommon = diver.ability == "NoCommon"
	record.durations = {
		bottom = total * GameConfig.DiveBottomShare,
		up = total * (1 - GameConfig.DiveBottomShare - GameConfig.DiveDescentShare),
	}
	local model = record.model
	model:SetAttribute("DepthMeters", depthMeters)
	model:SetAttribute("DepthStuds", Formulas.depthToStuds(depthMeters))
	model:SetAttribute("ZoneName", zone.name)
	model:SetAttribute("GlowColor", nil)
	setPhase(record, "Down", total * GameConfig.DiveDescentShare)
end

-- Rolls what is inside the chests the diver is carrying and lights the glow in the best rarity colour.
local function prepareAscent(player: Player, record: Record, duration: number)
	local contents: { Content } = {}
	local bestRank = 0
	local glow: Color3? = nil
	if record.chestId and record.chestCount > 0 then
		local cursedMult = Services.EconomyService.CursedMult()
		for _ = 1, record.chestCount do
			local content = Services.ChestService.RollContents(record.chestId, record.luck, record.noCommon, cursedMult)
			table.insert(contents, content)
			local rarity = Rarities.ById[Treasures.ById[content.t].rarity]
			if rarity.rank > bestRank then
				bestRank = rarity.rank
				glow = rarity.color
			end
		end
	end
	record.contents = contents
	record.model:SetAttribute("GlowColor", glow)
	record.model:SetAttribute("GlowRank", bestRank)
	setPhase(record, "Up", duration)
	local _ = player
end

local function rescue(player: Player, record: Record)
	if record.phase ~= "Grabbed" then
		return
	end
	destroyTentacle(record)
	record.chestCount += 1
	Services.PlayerService.Notify(player, "You fought off the Kraken! +1 bonus chest", "Success")
	prepareAscent(player, record, math.max(2, record.durations.up * 0.5))
end

local function spawnTentacle(player: Player, record: Record)
	local entry = record.model:GetAttribute("Entry") :: Vector3
	local tentacle = ModelFactory.tentacle(0.9)
	tentacle.Name = "KrakenTentacle"
	tentacle:PivotTo(
		CFrame.new(entry + Vector3.new(2.5, -3, 3)) * CFrame.Angles(0, math.rad(random:NextNumber(0, 360)), 0)
	)
	local hitbox = tentacle:FindFirstChild("Hitbox") :: BasePart
	local detector = Instance.new("ClickDetector")
	detector.MaxActivationDistance = 90
	detector.Parent = hitbox
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160, 50)
	gui.StudsOffset = Vector3.new(0, 8, 0)
	gui.AlwaysOnTop = true
	gui.Adornee = hitbox
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "🦑 CLICK TO SAVE!"
	label.TextColor3 = Color3.fromRGB(255, 90, 90)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = tentacle
	detector.MouseClick:Connect(function(clicker)
		if clicker == player then
			rescue(player, record)
		end
	end)
	CollectionService:AddTag(tentacle, "Tentacle")
	tentacle.Parent = record.model.Parent
	record.tentacle = tentacle
end

local function reachBottom(player: Player, playerRecords: { [number]: Record }, record: Record)
	local diver = Divers.ById[record.diverId]
	local immune = diver.ability == "KrakenImmune" or diver.ability == "KrakenTamer"
	if not immune and rand() < GameConfig.KrakenGrabChance then
		if hasAbilityPlaced(playerRecords, "KrakenTamer") then
			record.chestCount += 1
			Services.PlayerService.Notify(
				player,
				"Your Kraken Tamer turned a Kraken attack into a bonus chest!",
				"Success"
			)
		else
			spawnTentacle(player, record)
			Services.PlayerService.Notify(
				player,
				"🦑 The Kraken grabbed " .. diver.name .. "! Click the tentacle!",
				"Danger"
			)
			setPhase(record, "Grabbed", GameConfig.KrakenGrabWindow)
			return
		end
	end
	prepareAscent(player, record, record.durations.up)
end

local function surface(player: Player, record: Record)
	local data = Services.DataService.Get(player)
	if data then
		data.stats.dives += 1
		local contents = record.contents or {}
		if #contents > 0 and record.chestId then
			Services.ChestService.Grant(player, contents)
			Remotes.event("DiveFx")
				:FireAllClients(record.model, record.chestId, #contents, record.model:GetAttribute("GlowColor"))
		end
	end
	record.contents = nil
	record.model:SetAttribute("GlowColor", nil)
	setPhase(record, "Idle", GameConfig.DiveRestTime)
end

local function step()
	local t = now()
	for player, playerRecords in records do
		for _, record in playerRecords do
			if t >= record.phaseEnd then
				local ok, err = pcall(function()
					if record.phase == "Idle" then
						startDive(player, playerRecords, record)
					elseif record.phase == "Down" then
						setPhase(record, "Bottom", record.durations.bottom)
					elseif record.phase == "Bottom" then
						reachBottom(player, playerRecords, record)
					elseif record.phase == "Grabbed" then
						destroyTentacle(record)
						record.chestCount = 0
						Services.PlayerService.Notify(
							player,
							"The Kraken stole the chest! Be faster next time.",
							"Danger"
						)
						prepareAscent(player, record, record.durations.up)
					elseif record.phase == "Up" then
						surface(player, record)
					end
				end)
				if not ok then
					warn("[DiverService] dive step failed:", err)
					setPhase(record, "Idle", GameConfig.DiveRestTime)
				end
			end
		end
	end
end

-- Oxygen Tank: every diver still underwater comes up right away with its chest.
function DiverService.SurfaceAll(player: Player)
	local playerRecords = records[player]
	if not playerRecords then
		return
	end
	for _, record in playerRecords do
		if record.phase == "Down" or record.phase == "Bottom" then
			prepareAscent(player, record, 1.5)
		elseif record.phase == "Grabbed" then
			rescue(player, record)
		end
	end
end

-- Inventory --------------------------------------------------------------------------------

function DiverService.DiverCount(data: any): number
	local count = 0
	for _ in data.divers do
		count += 1
	end
	return count
end

-- Adds a diver to the inventory and puts it on the dock if there is a free slot.
function DiverService.AddDiver(player: Player, diverId: string, force: boolean?): (string?, boolean)
	local data = Services.DataService.Get(player)
	if not data or not Divers.ById[diverId] then
		return nil, false
	end
	if not force and DiverService.DiverCount(data) >= GameConfig.MaxDivers then
		return nil, false
	end
	local uid = newUid(data, "d")
	data.divers[uid] = diverId
	local isNew = not data.diverIndex[diverId]
	data.diverIndex[diverId] = true
	local slotCount = DiverService.SlotCount(player)
	for slot = 1, slotCount do
		if not data.slots[tostring(slot)] then
			data.slots[tostring(slot)] = uid
			break
		end
	end
	DiverService.Refresh(player)
	return uid, isNew
end

function DiverService.Place(player: Player, uid: string, slot: number?): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data or not data.divers[uid] then
		return false, "That diver doesn't exist"
	end
	local slotCount = DiverService.SlotCount(player)
	local current = slotOf(data, uid)
	if slot == nil then
		if current then
			return false, "Already on the dock"
		end
		for candidate = 1, slotCount do
			if not data.slots[tostring(candidate)] then
				slot = candidate
				break
			end
		end
		if not slot then
			return false, "Your dock is full. Remove a diver or buy more slots"
		end
	end
	assert(slot)
	if slot < 1 or slot > slotCount then
		return false, "That slot is locked"
	end
	if current then
		data.slots[tostring(current)] = nil
	end
	data.slots[tostring(slot)] = uid
	DiverService.Refresh(player)
	return true
end

function DiverService.Remove(player: Player, uid: string): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data then
		return false
	end
	local slot = slotOf(data, uid)
	if not slot then
		return false, "Not on the dock"
	end
	data.slots[tostring(slot)] = nil
	DiverService.Refresh(player)
	return true
end

function DiverService.Sell(player: Player, uid: string): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data or not data.divers[uid] then
		return false, "That diver doesn't exist"
	end
	if DiverService.DiverCount(data) <= 1 then
		return false, "You can't sell your last diver"
	end
	local slot = slotOf(data, uid)
	if slot then
		data.slots[tostring(slot)] = nil
	end
	local value = Formulas.diverSellValue(data.divers[uid])
	data.divers[uid] = nil
	Services.EconomyService.AddCash(player, value)
	DiverService.Refresh(player)
	return true
end

-- Sells every diver that is not on the dock and is at or below the given rarity rank.
function DiverService.SellUnplaced(player: Player, maxRank: number): (number, number)
	local data = Services.DataService.Get(player)
	if not data then
		return 0, 0
	end
	local sold, total = 0, 0
	for uid, diverId in data.divers do
		local rank = Rarities.ById[Divers.ById[diverId].tier].rank
		if not slotOf(data, uid) and rank <= maxRank and DiverService.DiverCount(data) > 1 then
			total += Formulas.diverSellValue(diverId)
			data.divers[uid] = nil
			sold += 1
		end
	end
	if total > 0 then
		Services.EconomyService.AddCash(player, total)
	end
	DiverService.Refresh(player)
	return sold, total
end

function DiverService.EquipBest(player: Player)
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local uids = {}
	for uid in data.divers do
		table.insert(uids, uid)
	end
	table.sort(uids, function(a, b)
		local scoreA, scoreB = Formulas.diverScore(data.divers[a]), Formulas.diverScore(data.divers[b])
		if scoreA == scoreB then
			return a < b
		end
		return scoreA > scoreB
	end)
	table.clear(data.slots)
	for slot = 1, math.min(#uids, DiverService.SlotCount(player)) do
		data.slots[tostring(slot)] = uids[slot]
	end
	DiverService.Refresh(player)
end

function DiverService.Start()
	task.spawn(function()
		while true do
			task.wait(0.1)
			step()
		end
	end)
end

return DiverService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	Cash in and out, plus every player-wide multiplier (income, luck, speed, zone cap).
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local GameConfig = require(Shared.Config.Game)
local Zones = require(Shared.Config.Zones)

local Services = require(script.Parent.Parent.Registry)

local EconomyService = {}

local function refreshCashDisplay(player: Player, data: { [string]: any })
	player:SetAttribute("Cash", data.cash)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local cash = leaderstats:FindFirstChild("Cash") :: StringValue?
		if cash then
			cash.Value = Format.money(data.cash)
		end
		local rebirths = leaderstats:FindFirstChild("Rebirths") :: IntValue?
		if rebirths then
			rebirths.Value = data.rebirths
		end
	end
end

function EconomyService.CreateLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	leaderstats.Parent = player
	local data = Services.DataService.Get(player)
	if data then
		refreshCashDisplay(player, data)
	end
end

function EconomyService.RefreshDisplay(player: Player)
	local data = Services.DataService.Get(player)
	if data then
		refreshCashDisplay(player, data)
	end
end

function EconomyService.AddCash(player: Player, amount: number)
	local data = Services.DataService.Get(player)
	if not data or amount ~= amount or amount <= 0 then
		return
	end
	data.cash += amount
	data.totalEarned += amount
	refreshCashDisplay(player, data)
end

function EconomyService.TrySpend(player: Player, amount: number): boolean
	local data = Services.DataService.Get(player)
	if not data or amount ~= amount or amount < 0 or data.cash < amount then
		return false
	end
	data.cash -= amount
	refreshCashDisplay(player, data)
	return true
end

-- Multipliers ------------------------------------------------------------------------------

function EconomyService.IncomeMult(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 1
	end
	local market = Services.MarketService
	return Formulas.incomeMultiplier({
		rebirths = data.rebirths,
		doubleMoney = market.HasPass(player, "DoubleMoney"),
		vip = market.HasPass(player, "VIP"),
		indexZonesComplete = Formulas.indexZonesComplete(data.index),
	})
end

function EconomyService.PotionActive(player: Player): boolean
	local data = Services.DataService.Get(player)
	return data ~= nil and data.luckPotionEnds > os.time()
end

-- Luck used for diver rolls (potion and gamepass only).
function EconomyService.RollLuck(player: Player): number
	local luck = 1
	if EconomyService.PotionActive(player) then
		luck *= GameConfig.LuckPotionMult
	end
	if Services.MarketService.HasPass(player, "LuckyDiver") then
		luck *= 1.5
	end
	return luck
end

-- Luck applied on top of each diver's own luck when rolling treasure.
function EconomyService.LuckMult(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 1
	end
	return Formulas.luckUpgradeMult(data.upgrades.Luck) * EconomyService.RollLuck(player)
end

function EconomyService.SpeedMult(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 1
	end
	local speed = Formulas.speedUpgradeMult(data.upgrades.Oxygen)
	if Services.EventService.IsActive("LowTide") then
		speed *= GameConfig.LowTideSpeedMult
	end
	return speed
end

-- Deepest zone the player's divers may reach (Low Tide opens one extra zone).
function EconomyService.ZoneCap(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 1
	end
	local cap = Formulas.unlockedZoneIndex(data.rebirths)
	if Services.EventService.IsActive("LowTide") then
		cap += 1
	end
	return math.min(cap, #Zones.List)
end

function EconomyService.CursedMult(): number?
	if Services.EventService.IsActive("BloodMoon") then
		return GameConfig.BloodMoonCursedMult
	end
	return nil
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--[[
	Timed server-wide events:
	  Low Tide   divers dive twice as fast and reach one zone deeper
	  Blood Moon Cursed treasures are 5x more likely, the sky turns red
	  Kraken     a giant Kraken rises in the channel; everyone clicks it for chests
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage").Shared
local GameConfig = require(Shared.Config.Game)
local Remotes = require(Shared.Remotes)

local Services = require(script.Parent.Parent.Registry)

local EventService = {}

type EventState = {
	active: boolean,
	endsAt: number,
	nextAt: number,
	warned: boolean,
}

local EVENT_NAMES = { "LowTide", "BloodMoon", "Kraken" }

local DISPLAY = {
	LowTide = {
		title = "🌊 LOW TIDE",
		start = "Low Tide! Divers dive twice as fast and reach one zone deeper!",
		warn = "The tide is going out... Low Tide in 30 seconds!",
		color = Color3.fromRGB(90, 220, 255),
	},
	BloodMoon = {
		title = "🌕 BLOOD MOON",
		start = "Blood Moon! Cursed treasures are 5x more likely!",
		warn = "The moon is turning red... Blood Moon in 30 seconds!",
		color = Color3.fromRGB(255, 70, 80),
	},
	Kraken = {
		title = "🦑 KRAKEN ATTACK",
		start = "THE KRAKEN HAS RISEN! Click it together for chests!",
		warn = "Something huge is stirring in the channel... Kraken in 30 seconds!",
		color = Color3.fromRGB(200, 90, 255),
	},
}

local states: { [string]: EventState } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

function EventService.IsActive(name: string): boolean
	local state = states[name]
	return state ~= nil and state.active
end

function EventService.PublicState()
	local result = {}
	for name, state in states do
		result[name] = {
			active = state.active,
			endsAt = state.endsAt,
			nextAt = state.nextAt,
			title = DISPLAY[name].title,
			color = DISPLAY[name].color,
		}
	end
	return result
end

local function broadcast()
	Remotes.event("EventState"):FireAllClients(EventService.PublicState())
end

function EventService.SendTo(player: Player)
	Remotes.event("EventState"):FireClient(player, EventService.PublicState())
end

local function onStarted(name: string)
	if name == "BloodMoon" then
		Services.WorldBuilder.SetLighting("BloodMoon")
	elseif name == "Kraken" then
		Services.KrakenService.Spawn()
	end
end

local function onEnded(name: string)
	if name == "BloodMoon" then
		Services.WorldBuilder.SetLighting("Day")
	elseif name == "Kraken" then
		Services.KrakenService.Despawn()
	end
end

-- Starts (or extends) an event right now. `byName` credits a player who bought it.
function EventService.StartEvent(name: string, byName: string?)
	local state = states[name]
	local config = GameConfig.Events[name]
	if not state or not config then
		return
	end
	local display = DISPLAY[name]
	if state.active then
		state.endsAt += config.duration
	else
		state.active = true
		state.endsAt = now() + config.duration
		onStarted(name)
	end
	local text = if byName then byName .. " started a " .. display.title .. "! " .. display.start else display.start
	Services.AnnouncementService.Announce(text, display.color, false)
	broadcast()
end

function EventService.EndEvent(name: string)
	local state = states[name]
	if not state or not state.active then
		return
	end
	state.active = false
	state.warned = false
	onEnded(name)
	broadcast()
end

function EventService.Init()
	local t = now()
	for _, name in EVENT_NAMES do
		local config = GameConfig.Events[name]
		states[name] = {
			active = false,
			endsAt = 0,
			nextAt = t + config.firstDelay,
			warned = false,
		}
	end
end

function EventService.Start()
	Players.PlayerAdded:Connect(function(player)
		task.defer(EventService.SendTo, player)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local t = now()
			for _, name in EVENT_NAMES do
				local state = states[name]
				local config = GameConfig.Events[name]
				if state.active then
					if t >= state.endsAt then
						EventService.EndEvent(name)
					end
				elseif t >= state.nextAt then
					state.nextAt = t + config.interval
					state.warned = false
					EventService.StartEvent(name)
				elseif not state.warned and t >= state.nextAt - GameConfig.Events.WarningTime then
					state.warned = true
					Services.AnnouncementService.Announce(DISPLAY[name].warn, DISPLAY[name].color, false)
				end
			end
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">KrakenService</string>
            <string name="Source"><![CDATA[--[[
	The Kraken boss: rises in the channel, every click deals damage,
	and everyone who helped gets chests from their deepest unlocked zone when it is defeated.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage").Shared
local ModelFactory = require(Shared.ModelFactory)
local GameConfig = require(Shared.Config.Game)

local Server = script.Parent.Parent
local Services = require(Server.Registry)
local Layout = require(Server.Layout)

local KrakenService = {}

local current: Model? = nil
local contributions: { [number]: number } = {}
local lastClick: { [Player]: number } = {}
local health = 0
local maxHealth = 0
local defeated = false

local RISE_DEPTH = 70

local function moveTo(model: Model, from: Vector3, to: Vector3, seconds: number)
	local steps = math.max(1, math.floor(seconds * 15))
	for i = 1, steps do
		if model.Parent == nil then
			return
		end
		local alpha = i / steps
		local eased = 1 - (1 - alpha) ^ 3
		model:PivotTo(CFrame.new(from:Lerp(to, eased)))
		task.wait(seconds / steps)
	end
end

local function reward()
	local total = 0
	for _, damage in contributions do
		total += damage
	end
	if total <= 0 then
		return
	end
	for userId, damage in contributions do
		local player = Players:GetPlayerByUserId(userId)
		if player and Services.DataService.Get(player) then
			local share = damage / total
			local count = math.clamp(1 + math.floor(share * 8), 1, 5)
			local luck = Services.EconomyService.LuckMult(player) * 3
			Services.ChestService.GrantFromZone(player, Services.EconomyService.ZoneCap(player), count, luck)
			Services.PlayerService.Notify(
				player,
				("Kraken defeated! You dealt %d%% of the damage: +%d chests"):format(math.floor(share * 100), count),
				"Success"
			)
		end
	end
end

local function onClick(player: Player)
	if defeated or not current then
		return
	end
	local t = os.clock()
	if t - (lastClick[player] or 0) < GameConfig.KrakenClickCooldown then
		return
	end
	lastClick[player] = t
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local damage = 1 + data.rebirths
	health = math.max(0, health - damage)
	contributions[player.UserId] = (contributions[player.UserId] or 0) + damage
	data.stats.krakenHits += 1
	current:SetAttribute("Health", health)
	if health <= 0 then
		defeated = true
		Services.AnnouncementService.Announce("THE KRAKEN HAS BEEN DEFEATED!", Color3.fromRGB(120, 255, 140), false)
		reward()
		Services.EventService.EndEvent("Kraken")
	end
end

function KrakenService.Spawn()
	KrakenService.Despawn()
	defeated = false
	table.clear(contributions)
	table.clear(lastClick)

	local players = #Players:GetPlayers()
	local rebirthSum = 0
	for _, player in Players:GetPlayers() do
		local data = Services.DataService.Get(player)
		if data then
			rebirthSum += data.rebirths
		end
	end
	local averageRebirth = if players > 0 then rebirthSum / players else 0
	maxHealth = math.floor(GameConfig.KrakenBaseHealth * math.max(1, players) * (1 + averageRebirth))
	health = maxHealth

	local model = ModelFactory.kraken()
	model:SetAttribute("MaxHealth", maxHealth)
	model:SetAttribute("Health", health)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and (part.Name == "Head" or part.Name == "Mantle" or part.Name == "Hitbox") then
			local detector = Instance.new("ClickDetector")
			detector.MaxActivationDistance = 400
			detector.MouseClick:Connect(onClick)
			detector.Parent = part
		end
	end
	local head = model:FindFirstChild("Head") :: BasePart
	local gui = Instance.new("BillboardGui")
	gui.Name = "KrakenTag"
	gui.Size = UDim2.fromOffset(300, 60)
	gui.StudsOffset = Vector3.new(0, 30, 0)
	gui.AlwaysOnTop = true
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "🦑 THE KRAKEN - CLICK IT!"
	label.TextColor3 = Color3.fromRGB(255, 120, 200)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = model

	local target = Layout.KrakenPosition
	local start = target - Vector3.new(0, RISE_DEPTH, 0)
	model:PivotTo(CFrame.new(start))
	model.Parent = Workspace
	current = model
	task.spawn(moveTo, model, start, target, 4)
end

function KrakenService.Despawn()
	local model = current
	current = nil
	if not model then
		return
	end
	for _, detector in model:GetDescendants() do
		if detector:IsA("ClickDetector") then
			detector:Destroy()
		end
	end
	local from = model:GetPivot().Position
	task.spawn(function()
		moveTo(model, from, from - Vector3.new(0, RISE_DEPTH, 0), 4)
		model:Destroy()
	end)
	if not defeated then
		Services.AnnouncementService.Announce(
			"The Kraken sank back into the deep...",
			Color3.fromRGB(200, 90, 255),
			false
		)
	end
end

return KrakenService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MarketService</string>
            <string name="Source"><![CDATA[--[[
	Game passes and developer products.
	Pass ownership is cached per player; product receipts are de-duplicated through save data.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage").Shared
local Monetization = require(Shared.Config.Monetization)
local Format = require(Shared.Util.Format)
local GameConfig = require(Shared.Config.Game)

local Services = require(script.Parent.Parent.Registry)

local MarketService = {}

local owned: { [Player]: { [string]: boolean } } = {}
local MAX_RECEIPTS = 50

local passByAsset: { [number]: string } = {}
for _, pass in Monetization.Passes do
	if pass.assetId ~= 0 then
		passByAsset[pass.assetId] = pass.id
	end
end

local productByAsset: { [number]: string } = {}
for _, product in Monetization.Products do
	if product.assetId ~= 0 then
		productByAsset[product.assetId] = product.id
	end
end

function MarketService.LoadPasses(player: Player)
	local passes = {}
	for _, pass in Monetization.Passes do
		if pass.assetId ~= 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.assetId)
			end)
			if ok and result then
				passes[pass.id] = true
			end
		end
	end
	owned[player] = passes
	MarketService.ApplyPassPerks(player)
end

function MarketService.HasPass(player: Player, passId: string): boolean
	local passes = owned[player]
	if passes and passes[passId] then
		return true
	end
	-- Studio-only overrides set with the /pass admin command
	if RunService:IsStudio() then
		local data = Services.DataService.Get(player)
		if data and data.devPasses[passId] then
			return true
		end
	end
	return false
end

function MarketService.GetOwned(player: Player): { [string]: boolean }
	local result = {}
	for _, pass in Monetization.Passes do
		if MarketService.HasPass(player, pass.id) then
			result[pass.id] = true
		end
	end
	return result
end

-- Things that change the world when a pass is gained (extra dive slots, VIP tag).
function MarketService.ApplyPassPerks(player: Player)
	player:SetAttribute("VIP", MarketService.HasPass(player, "VIP"))
	if Services.DataService.Get(player) then
		Services.DiverService.Refresh(player)
		Services.DataService.MarkDirty(player)
	end
end

function MarketService.Forget(player: Player)
	owned[player] = nil
end

-- Products ---------------------------------------------------------------------------------

local function currentIncome(player: Player): number
	return Services.VaultService.IncomePerSecond(player)
end

local productHandlers: { [string]: (Player, { [string]: any }) -> () } = {
	StarterPack = function(player, data)
		if not data.starterPackClaimed then
			data.starterPackClaimed = true
			Services.DiverService.AddDiver(player, "DeepSeaSuit")
		end
		Services.EconomyService.AddCash(player, 5000)
		Services.PlayerService.Notify(player, "Starter Pack claimed! Deep Sea Suit + $5,000", "Success")
	end,
	LuckPotion = function(player, data)
		data.luckPotionEnds = math.max(data.luckPotionEnds, os.time()) + GameConfig.LuckPotionSeconds
		Services.PlayerService.Notify(player, "Luck Potion active: x2 luck!", "Success")
	end,
	OxygenTank = function(player)
		Services.DiverService.SurfaceAll(player)
		Services.PlayerService.Notify(player, "Oxygen Tank! All divers are surfacing.", "Success")
	end,
	ServerLowTide = function(player)
		Services.EventService.StartEvent("LowTide", player.DisplayName)
	end,
	CashSmall = function(player)
		local amount = math.max(1000, currentIncome(player) * 600)
		Services.EconomyService.AddCash(player, amount)
		Services.PlayerService.Notify(player, "+" .. Format.money(amount), "Success")
	end,
	CashLarge = function(player)
		local amount = math.max(20000, currentIncome(player) * 7200)
		Services.EconomyService.AddCash(player, amount)
		Services.PlayerService.Notify(player, "+" .. Format.money(amount), "Success")
	end,
}

-- Also used by the /product admin command to test product effects in Studio.
function MarketService.GrantProduct(player: Player, productId: string): boolean
	local data = Services.DataService.Get(player)
	local handler = productHandlers[productId]
	if not data or not handler then
		return false
	end
	handler(player, data)
	Services.DataService.MarkDirty(player)
	return true
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and Services.DataService.Get(player)
	if not player or not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(data.receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local productId = productByAsset[receipt.ProductId]
	if not productId then
		warn("[MarketService] Unknown product id " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, err = pcall(MarketService.GrantProduct, player, productId)
	if not ok then
		warn("[MarketService] Grant failed: " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.receipts, purchaseId)
	while #data.receipts > MAX_RECEIPTS do
		table.remove(data.receipts, 1)
	end
	-- save right away so a crash can't grant the same purchase twice
	Services.DataService.Save(player, false)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MarketService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, assetId, purchased)
		if not purchased then
			return
		end
		local passId = passByAsset[assetId]
		if passId then
			owned[player] = owned[player] or {}
			owned[player][passId] = true
			MarketService.ApplyPassPerks(player)
			Services.PlayerService.Notify(
				player,
				"Thanks for buying " .. Monetization.PassById[passId].name .. "!",
				"Success"
			)
		end
	end)
end

return MarketService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--[[
	Player lifecycle (join, spawn, leave), state sync to the client and toast notifications.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Remotes = require(Shared.Remotes)

local Services = require(script.Parent.Parent.Registry)

local PlayerService = {}

local ready: { [Player]: boolean } = {}

function PlayerService.Notify(player: Player, text: string, kind: string?)
	Remotes.event("Notify"):FireClient(player, text, kind or "Info")
end

function PlayerService.IsReady(player: Player): boolean
	return ready[player] == true
end

-- Everything the client UI needs, in one table.
function PlayerService.BuildSync(player: Player): { [string]: any }?
	local data = Services.DataService.Get(player)
	if not data then
		return nil
	end
	local economy = Services.EconomyService
	return {
		data = data,
		passes = Services.MarketService.GetOwned(player),
		income = Services.VaultService.IncomePerSecond(player),
		incomeMult = economy.IncomeMult(player),
		luckMult = economy.LuckMult(player),
		rollLuck = economy.RollLuck(player),
		speedMult = economy.SpeedMult(player),
		zoneCap = economy.ZoneCap(player),
		unlockedZone = Formulas.unlockedZoneIndex(data.rebirths),
		slotCount = Services.DiverService.SlotCount(player),
		pedestalCount = Services.VaultService.PedestalCount(player),
		saving = Services.DataService.IsSaving(player),
		osTime = os.time(),
		serverTime = Workspace:GetServerTimeNow(),
	}
end

local function sync(player: Player)
	local payload = PlayerService.BuildSync(player)
	if payload then
		Remotes.event("DataSync"):FireClient(player, payload)
	end
end

local function teleportToPlot(player: Player, character: Model)
	local plot = Services.PlotService.Get(player)
	if not plot then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if root then
		task.wait()
		character:PivotTo(Services.PlotService.SpawnCFrame(plot))
	end
end

local function onPlayerAdded(player: Player)
	if not Services.DataService.Load(player) then
		if player.Parent then
			player:Kick("Your save data couldn't be loaded. Please rejoin in a minute.")
		end
		return
	end
	Services.MarketService.LoadPasses(player)
	local plot = Services.PlotService.Assign(player)
	if not plot then
		player:Kick("This server is full. Please join another one.")
		return
	end
	local data = Services.DataService.Get(player)
	assert(data)

	-- brand new player: a free starter diver so the first dive starts right away
	if next(data.divers) == nil then
		Services.DiverService.AddDiver(player, "SnorkelSam", true)
	end

	Services.EconomyService.CreateLeaderstats(player)
	Services.DiverService.Refresh(player)
	Services.VaultService.Refresh(player)
	Services.MarketService.ApplyPassPerks(player)

	-- offline earnings
	if data.lastOnline > 0 then
		local away = os.time() - data.lastOnline
		if away > 60 then
			local amount = Formulas.offlineEarnings(
				away,
				Services.VaultService.IncomePerSecond(player),
				Services.MarketService.HasPass(player, "VIP")
			)
			if amount > 0 then
				Services.EconomyService.AddCash(player, amount)
				Remotes.event("OfflineEarnings"):FireClient(player, away, amount)
			end
		end
	end
	data.lastOnline = os.time()

	ready[player] = true
	player:SetAttribute("Ready", true)
	sync(player)

	player.CharacterAdded:Connect(function(character)
		teleportToPlot(player, character)
	end)
	if player.Character then
		task.spawn(teleportToPlot, player, player.Character)
	end
end

local function beforeRelease(player: Player)
	Services.VaultService.CollectAll(player)
	local data = Services.DataService.Get(player)
	if data then
		data.lastOnline = os.time()
	end
end

local function onPlayerRemoving(player: Player)
	ready[player] = nil
	if Services.DataService.Get(player) then
		beforeRelease(player)
		Services.DataService.Release(player)
	end
	Services.DiverService.Clear(player)
	Services.VaultService.Clear(player)
	Services.PlotService.Release(player)
	Services.MarketService.Forget(player)
end

function PlayerService.Init()
	Services.DataService.BeforeRelease = beforeRelease
end

function PlayerService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- push state to clients a few times per second when something changed,
	-- and at least every 2 seconds so timers and income stay fresh
	local lastSync: { [Player]: number } = {}
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for player in ready do
			local since = t - (lastSync[player] or 0)
			if since >= 0.2 and (Services.DataService.ConsumeDirty(player) or since > 2) then
				lastSync[player] = t
				sync(player)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastSync[player] = nil
	end)
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--[[
	Builds the six player plots (dock, dive slots, vault pedestals, sign) and assigns them to players.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Server = script.Parent.Parent
local Services = require(Server.Registry)
local Layout = require(Server.Layout)
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.Config.Game)

local PlotService = {}

export type SlotParts = {
	pad: Part,
	board: Part,
	home: CFrame,
	entry: Vector3,
	lockLabel: TextLabel,
}

export type PedestalParts = {
	base: Part,
	top: CFrame,
	pad: Part,
	gui: BillboardGui,
	nameLabel: TextLabel,
	incomeLabel: TextLabel,
	collectLabel: TextLabel,
}

export type Plot = {
	index: number,
	cframe: CFrame,
	model: Model,
	divers: Folder,
	treasures: Folder,
	slots: { SlotParts },
	pedestals: { PedestalParts },
	signLabel: TextLabel,
	owner: Player?,
}

local plots: { Plot } = {}
local plotByPlayer: { [Player]: Plot } = {}

local WOOD = Color3.fromRGB(160, 110, 65)
local WOOD_DARK = Color3.fromRGB(115, 75, 45)
local SLOT_OPEN = Color3.fromRGB(60, 200, 220)
local SLOT_LOCKED = Color3.fromRGB(70, 70, 80)
local PAD_ON = Color3.fromRGB(70, 230, 90)
local PAD_LOCKED = Color3.fromRGB(80, 80, 90)

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = Color3.new(1, 1, 1)
	for key, value in props do
		(l :: any)[key] = value
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = l
	l.Parent = parent
	return l
end

local function buildPlot(index: number, plotCFrame: CFrame): Plot
	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("PlotIndex", index)

	local function at(localCFrame: CFrame): CFrame
		return plotCFrame * localCFrame
	end

	-- deck and supports
	local deck = part(model, {
		Name = "Deck",
		Size = Layout.DeckSize,
		CFrame = at(Layout.DeckCenter),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
	})
	model.PrimaryPart = deck
	for _, x in { -60, -30, 0, 30, 60 } do
		for _, z in { -40, -12, 16 } do
			part(model, {
				Name = "Pillar",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(30, 2.4, 2.4),
				CFrame = at(CFrame.new(x, Layout.DeckTop - 16, z) * CFrame.Angles(0, 0, math.rad(90))),
				Color = WOOD_DARK,
				Material = Enum.Material.Wood,
			})
		end
	end
	-- side and back railings
	for _, x in { -64.5, 64.5 } do
		part(model, {
			Name = "Rail",
			Size = Vector3.new(1, 3, 64),
			CFrame = at(CFrame.new(x, Layout.DeckTop + 1.5, -12)),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
		})
	end
	part(model, {
		Name = "Rail",
		Size = Vector3.new(130, 3, 1),
		CFrame = at(CFrame.new(0, Layout.DeckTop + 1.5, -43.5)),
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
	})

	-- owner sign
	local sign = part(model, {
		Name = "Sign",
		Size = Vector3.new(44, 11, 1),
		CFrame = at(CFrame.new(0, Layout.DeckTop + 10, -45) * CFrame.Angles(0, math.pi, 0)),
		Color = Color3.fromRGB(35, 55, 100),
		Material = Enum.Material.SmoothPlastic,
	})
	for _, x in { -20, 20 } do
		part(model, {
			Name = "SignPost",
			Size = Vector3.new(1.5, 12, 1.5),
			CFrame = at(CFrame.new(x, Layout.DeckTop + 5, -45)),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
		})
	end
	local signGui = Instance.new("SurfaceGui")
	signGui.Face = Enum.NormalId.Front
	signGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	signGui.PixelsPerStud = 25
	signGui.Parent = sign
	local signLabel = label(signGui, {
		Size = UDim2.fromScale(0.94, 0.8),
		Position = UDim2.fromScale(0.03, 0.1),
		Text = "Empty Dock",
		TextColor3 = Color3.fromRGB(255, 230, 90),
	})

	-- dive slots
	local slots: { SlotParts } = {}
	for slot = 1, GameConfig.MaxDiveSlots do
		local home = Layout.slotHome(slot)
		local x = home.Position.X
		local pad = part(model, {
			Name = "SlotPad" .. slot,
			Size = Vector3.new(8, 0.3, 7),
			CFrame = at(CFrame.new(x, Layout.DeckTop + 0.15, 14)),
			Color = SLOT_LOCKED,
			Material = Enum.Material.SmoothPlastic,
		})
		local board = part(model, {
			Name = "DivingBoard" .. slot,
			Size = Vector3.new(3, 0.5, 10),
			CFrame = at(CFrame.new(x, Layout.DeckTop + 0.5, 24)),
			Color = Color3.fromRGB(235, 235, 240),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
		local lockGui = Instance.new("BillboardGui")
		lockGui.Size = UDim2.fromOffset(120, 36)
		lockGui.StudsOffset = Vector3.new(0, 3, 0)
		lockGui.MaxDistance = 70
		lockGui.AlwaysOnTop = false
		lockGui.Parent = pad
		local lockLabel = label(lockGui, {
			Size = UDim2.fromScale(1, 1),
			Text = "🔒 Upgrade",
			TextColor3 = Color3.fromRGB(200, 200, 210),
		})
		table.insert(slots, {
			pad = pad,
			board = board,
			home = plotCFrame * home,
			entry = (plotCFrame * CFrame.new(Layout.slotEntry(slot))).Position,
			lockLabel = lockLabel,
		})
	end

	-- vault pedestals
	local pedestals: { PedestalParts } = {}
	for i = 1, GameConfig.MaxPedestals do
		local pos = Layout.pedestalPosition(i)
		local base = part(model, {
			Name = "Pedestal" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 4.5, 4.5),
			CFrame = at(CFrame.new(pos + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90))),
			Color = PAD_LOCKED,
			Material = Enum.Material.Marble,
		})
		local pad = part(model, {
			Name = "CollectPad" .. i,
			Size = Vector3.new(5, 0.3, 3),
			CFrame = at(CFrame.new(pos + Vector3.new(0, 0.15, 5))),
			Color = PAD_LOCKED,
			Material = Enum.Material.Neon,
		})
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(170, 78)
		gui.StudsOffset = Vector3.new(0, 7.5, 0)
		gui.MaxDistance = 60
		gui.Parent = base
		local nameLabel = label(gui, { Size = UDim2.fromScale(1, 0.34), Text = "" })
		local incomeLabel = label(gui, {
			Size = UDim2.fromScale(1, 0.3),
			Position = UDim2.fromScale(0, 0.34),
			Text = "",
			TextColor3 = Color3.fromRGB(120, 255, 140),
		})
		local collectLabel = label(gui, {
			Size = UDim2.fromScale(1, 0.34),
			Position = UDim2.fromScale(0, 0.66),
			Text = "",
			TextColor3 = Color3.fromRGB(255, 230, 90),
		})
		pad.Touched:Connect(function(hit)
			local character = hit.Parent
			local player = character and Players:GetPlayerFromCharacter(character)
			local plot = plots[index]
			if player and plot and plot.owner == player then
				Services.VaultService.CollectPedestal(player, i)
			end
		end)
		table.insert(pedestals, {
			base = base,
			top = plotCFrame * CFrame.new(pos + Vector3.new(0, 5.4, 0)),
			pad = pad,
			gui = gui,
			nameLabel = nameLabel,
			incomeLabel = incomeLabel,
			collectLabel = collectLabel,
		})
	end

	local divers = Instance.new("Folder")
	divers.Name = "Divers"
	divers.Parent = model
	local treasures = Instance.new("Folder")
	treasures.Name = "Treasures"
	treasures.Parent = model

	model.Parent = Workspace:FindFirstChild("Plots")

	return {
		index = index,
		cframe = plotCFrame,
		model = model,
		divers = divers,
		treasures = treasures,
		slots = slots,
		pedestals = pedestals,
		signLabel = signLabel,
		owner = nil,
	}
end

function PlotService.Init()
	local folder = Instance.new("Folder")
	folder.Name = "Plots"
	folder.Parent = Workspace
	for index, plotCFrame in Layout.Plots do
		plots[index] = buildPlot(index, plotCFrame)
		PlotService.UpdateLocks(plots[index], 0, 0)
	end
end

function PlotService.Assign(player: Player): Plot?
	for _, plot in plots do
		if not plot.owner then
			plot.owner = player
			plotByPlayer[player] = plot
			plot.signLabel.Text = player.DisplayName .. "'s Dock"
			plot.model:SetAttribute("OwnerId", player.UserId)
			player:SetAttribute("Plot", plot.index)
			return plot
		end
	end
	return nil
end

function PlotService.Release(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	plotByPlayer[player] = nil
	plot.owner = nil
	plot.signLabel.Text = "Empty Dock"
	plot.model:SetAttribute("OwnerId", nil)
	plot.divers:ClearAllChildren()
	plot.treasures:ClearAllChildren()
	PlotService.UpdateLocks(plot, 0, 0)
	for _, pedestal in plot.pedestals do
		pedestal.nameLabel.Text = ""
		pedestal.incomeLabel.Text = ""
		pedestal.collectLabel.Text = ""
	end
end

function PlotService.Get(player: Player): Plot?
	return plotByPlayer[player]
end

function PlotService.SpawnCFrame(plot: Plot): CFrame
	return plot.cframe * Layout.Spawn
end

-- Colours the unlocked slots/pedestals and greys out the rest.
function PlotService.UpdateLocks(plot: Plot, slotCount: number, pedestalCount: number)
	for slot, parts in plot.slots do
		local open = slot <= slotCount
		parts.pad.Color = if open then SLOT_OPEN else SLOT_LOCKED
		parts.pad.Transparency = if open then 0 else 0.3
		parts.board.Transparency = if open then 0 else 0.6
		parts.lockLabel.Visible = not open and plot.owner ~= nil
	end
	for i, parts in plot.pedestals do
		local open = i <= pedestalCount
		parts.base.Color = if open then Color3.fromRGB(235, 235, 240) else PAD_LOCKED
		parts.base.Transparency = if open then 0 else 0.5
		parts.pad.Color = if open then PAD_ON else PAD_LOCKED
		parts.pad.Transparency = if open then 0.1 else 0.6
		if not open then
			parts.nameLabel.Text = if plot.owner then "🔒" else ""
			parts.incomeLabel.Text = ""
			parts.collectLabel.Text = ""
		end
	end
end

function PlotService.All(): { Plot }
	return plots
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--[[
	Rebirth: reset cash, divers, treasures and chests for a permanent income bonus
	and access to a deeper zone. Upgrades, the Index and Divine/Secret divers are kept.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local GameConfig = require(Shared.Config.Game)
local Divers = require(Shared.Config.Divers)
local Zones = require(Shared.Config.Zones)

local Services = require(script.Parent.Parent.Registry)

local RebirthService = {}

function RebirthService.Rebirth(player: Player): { [string]: any }
	local data = Services.DataService.Get(player)
	if not data then
		return { ok = false, err = "Data not loaded" }
	end
	Services.VaultService.CollectAll(player)
	local cost = Formulas.rebirthCost(data.rebirths)
	if data.cash < cost then
		return { ok = false, err = "You need " .. Format.money(cost) }
	end

	-- keep Divine and Secret divers
	local kept = {}
	for uid, diverId in data.divers do
		if GameConfig.RebirthKeepTiers[Divers.ById[diverId].tier] then
			kept[uid] = diverId
		end
	end
	data.divers = kept
	data.slots = {}
	data.treasures = {}
	data.pedestals = {}
	data.chests = {}
	data.cash = GameConfig.StartingCash
	data.rebirths += 1
	Services.VaultService.ClearForRebirth(player)

	if next(kept) == nil then
		Services.DiverService.AddDiver(player, Divers.StarterDiver, true)
	end
	Services.DiverService.EquipBest(player)
	Services.VaultService.Refresh(player)
	Services.EconomyService.RefreshDisplay(player)
	Services.DataService.MarkDirty(player)

	local unlocked = Zones.List[Formulas.unlockedZoneIndex(data.rebirths)]
	Services.AnnouncementService.Announce(
		("%s reached Rebirth %d!"):format(player.DisplayName, data.rebirths),
		Color3.fromRGB(255, 220, 90),
		false
	)
	Services.PlayerService.Notify(
		player,
		("Rebirth %d! Income x%s. Deepest zone: %s"):format(
			data.rebirths,
			tostring(Formulas.rebirthMultiplier(data.rebirths)),
			unlocked.name
		),
		"Success"
	)
	return { ok = true, rebirths = data.rebirths }
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">RollService</string>
            <string name="Source"><![CDATA[--[[
	Diver rolls: pay for a crate, get a random diver from its pool.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local GameConfig = require(Shared.Config.Game)
local Crates = require(Shared.Config.Crates)
local Divers = require(Shared.Config.Divers)
local Rarities = require(Shared.Config.Rarities)

local Services = require(script.Parent.Parent.Registry)

local RollService = {}

local random = Random.new()
local function rand(): number
	return random:NextNumber()
end

function RollService.Roll(player: Player, crateId: string): { [string]: any }
	local data = Services.DataService.Get(player)
	local crate = Crates.ById[crateId]
	if not data or not crate then
		return { ok = false, err = "Unknown roll" }
	end
	if data.rebirths < crate.rebirthReq then
		return { ok = false, err = ("Unlocks at Rebirth %d"):format(crate.rebirthReq) }
	end
	if Services.DiverService.DiverCount(data) >= GameConfig.MaxDivers then
		return { ok = false, err = "Your diver inventory is full. Sell some divers first" }
	end
	if not Services.EconomyService.TrySpend(player, crate.price) then
		return { ok = false, err = "Not enough cash" }
	end

	local diverId = Formulas.rollCrate(crate.id, Services.EconomyService.RollLuck(player), rand)
	local uid, isNew = Services.DiverService.AddDiver(player, diverId)
	data.stats.rolls += 1
	Services.DataService.MarkDirty(player)

	local diver = Divers.ById[diverId]
	local rarity = Rarities.ById[diver.tier]
	if rarity.announce then
		local odds = 0
		for _, entry in crate.pool do
			if entry.diver == diverId then
				odds = entry.odds
			end
		end
		Services.AnnouncementService.Announce(
			("%s rolled %s (%s)!"):format(player.DisplayName, diver.name, Format.odds(odds)),
			rarity.color,
			rarity.rank >= Rarities.ById.Divine.rank
		)
	end

	return {
		ok = true,
		diverId = diverId,
		uid = uid,
		isNew = isNew,
		placed = uid ~= nil and Services.DiverService.SlotOf(data, uid) ~= nil,
	}
end

return RollService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">UpgradeService</string>
            <string name="Source"><![CDATA[--[[
	Cash upgrades: dive slots, pedestals, luck and dive speed.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Upgrades = require(Shared.Config.Upgrades)

local Services = require(script.Parent.Parent.Registry)

local UpgradeService = {}

function UpgradeService.Buy(player: Player, upgradeId: string): { [string]: any }
	local data = Services.DataService.Get(player)
	if not data or not Upgrades.ById[upgradeId] then
		return { ok = false, err = "Unknown upgrade" }
	end
	local level = data.upgrades[upgradeId] or 0
	local cost = Formulas.upgradeCost(upgradeId, level)
	if not cost then
		return { ok = false, err = "Already maxed" }
	end
	if not Services.EconomyService.TrySpend(player, cost) then
		return { ok = false, err = "Not enough cash" }
	end
	data.upgrades[upgradeId] = level + 1
	if upgradeId == "DiveSlots" then
		Services.DiverService.Refresh(player)
	elseif upgradeId == "Pedestals" then
		Services.VaultService.Refresh(player)
	end
	Services.DataService.MarkDirty(player)
	return { ok = true, level = level + 1 }
end

return UpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">VaultService</string>
            <string name="Source"><![CDATA[--[[
	Treasures and the vault: inventory, pedestals, income, collect pads, index and sets.
]]

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage").Shared
local Formulas = require(Shared.Formulas)
local Format = require(Shared.Util.Format)
local ModelFactory = require(Shared.ModelFactory)
local GameConfig = require(Shared.Config.Game)
local Treasures = require(Shared.Config.Treasures)
local Conditions = require(Shared.Config.Conditions)
local Rarities = require(Shared.Config.Rarities)
local Remotes = require(Shared.Remotes)

local Services = require(script.Parent.Parent.Registry)

local VaultService = {}

type VaultState = {
	stored: { [number]: number },
	models: { [number]: Model },
	lastCollect: { [number]: number },
	income: { [number]: number },
}

local states: { [Player]: VaultState } = {}

local function getState(player: Player): VaultState
	local state = states[player]
	if not state then
		state = { stored = {}, models = {}, lastCollect = {}, income = {} }
		states[player] = state
	end
	return state
end

function VaultService.PedestalCount(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 0
	end
	return Formulas.pedestalCount(data.upgrades.Pedestals)
end

local function pedestalOf(data: any, uid: string): number?
	for key, value in data.pedestals do
		if value == uid then
			return tonumber(key)
		end
	end
	return nil
end

VaultService.PedestalOf = pedestalOf

local function treasureCount(data: any): number
	local count = 0
	for _ in data.treasures do
		count += 1
	end
	return count
end

-- Income --------------------------------------------------------------------------------------

-- Per-pedestal income (after every multiplier) for the player's current vault.
local function computeIncomes(player: Player, data: any): { [number]: number }
	local placedIds = {}
	for _, uid in data.pedestals do
		local item = data.treasures[uid]
		if item then
			placedIds[item.id] = true
		end
	end
	local bonuses = Formulas.setBonuses(placedIds)
	local mult = Services.EconomyService.IncomeMult(player)
	local incomes = {}
	local count = Formulas.pedestalCount(data.upgrades.Pedestals)
	for i = 1, count do
		local uid = data.pedestals[tostring(i)]
		local item = uid and data.treasures[uid]
		if item then
			incomes[i] = Formulas.treasureIncome(item.id, item.c) * (1 + (bonuses[item.id] or 0)) * mult
		end
	end
	return incomes
end

function VaultService.IncomePerSecond(player: Player): number
	local data = Services.DataService.Get(player)
	if not data then
		return 0
	end
	local total = 0
	for _, value in computeIncomes(player, data) do
		total += value
	end
	return total
end

-- Pedestal display ----------------------------------------------------------------------------

local function updateLabels(player: Player, data: any, state: VaultState)
	local plot = Services.PlotService.Get(player)
	if not plot then
		return
	end
	local autoCollect = Services.MarketService.HasPass(player, "AutoCollect")
	local count = Formulas.pedestalCount(data.upgrades.Pedestals)
	for i = 1, count do
		local parts = plot.pedestals[i]
		local uid = data.pedestals[tostring(i)]
		local item = uid and data.treasures[uid]
		if item then
			local treasure = Treasures.ById[item.id]
			local condition = Conditions.ById[item.c]
			local prefix = if condition and condition.id ~= Conditions.Default then condition.name .. " " else ""
			parts.nameLabel.Text = prefix .. treasure.name
			parts.nameLabel.TextColor3 = Rarities.ById[treasure.rarity].color
			parts.incomeLabel.Text = Format.perSecond(state.income[i] or 0)
			parts.collectLabel.Text = if autoCollect then "Auto" else "Collect " .. Format.money(state.stored[i] or 0)
		else
			parts.nameLabel.Text = "Empty"
			parts.nameLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
			parts.incomeLabel.Text = ""
			parts.collectLabel.Text = if (state.stored[i] or 0) > 0
				then "Collect " .. Format.money(state.stored[i])
				else ""
		end
	end
end

function VaultService.Refresh(player: Player)
	local data = Services.DataService.Get(player)
	local plot = Services.PlotService.Get(player)
	if not data or not plot then
		return
	end
	local state = getState(player)
	local count = Formulas.pedestalCount(data.upgrades.Pedestals)
	for i = 1, GameConfig.MaxPedestals do
		local key = tostring(i)
		local uid = data.pedestals[key]
		if uid and (i > count or not data.treasures[uid]) then
			data.pedestals[key] = nil
			uid = nil
		end
		local model: Model? = state.models[i]
		if model and model:GetAttribute("Uid") ~= uid then
			model:Destroy()
			state.models[i] = nil
			model = nil
		end
		if uid and not model then
			local item = data.treasures[uid]
			local newModel = ModelFactory.treasure(item.id, item.c)
			newModel:SetAttribute("Uid", uid)
			newModel:PivotTo(plot.pedestals[i].top)
			CollectionService:AddTag(newModel, "SpinTreasure")
			newModel.Parent = plot.treasures
			state.models[i] = newModel
		end
	end
	state.income = computeIncomes(player, data)
	Services.PlotService.UpdateLocks(plot, Services.DiverService.SlotCount(player), count)
	updateLabels(player, data, state)
	Services.DataService.MarkDirty(player)
end

function VaultService.Clear(player: Player)
	local state = states[player]
	if state then
		for _, model in state.models do
			model:Destroy()
		end
	end
	states[player] = nil
end

-- Collecting ----------------------------------------------------------------------------------

function VaultService.CollectPedestal(player: Player, index: number)
	local data = Services.DataService.Get(player)
	local state = states[player]
	if not data or not state then
		return
	end
	local last = state.lastCollect[index] or 0
	if os.clock() - last < GameConfig.CollectPadCooldown then
		return
	end
	state.lastCollect[index] = os.clock()
	local amount = state.stored[index] or 0
	if amount <= 0 then
		return
	end
	state.stored[index] = 0
	Services.EconomyService.AddCash(player, amount)
	data.stats.collected += amount
	local plot = Services.PlotService.Get(player)
	if plot then
		Remotes.event("CollectFx"):FireClient(player, plot.pedestals[index].pad.CFrame.Position, amount)
	end
	updateLabels(player, data, state)
	Services.DataService.MarkDirty(player)
end

-- Moves every stored pedestal balance into the wallet (used on leave and rebirth).
function VaultService.CollectAll(player: Player): number
	local data = Services.DataService.Get(player)
	local state = states[player]
	if not data or not state then
		return 0
	end
	local total = 0
	for index, amount in state.stored do
		total += amount
		state.stored[index] = 0
	end
	if total > 0 then
		Services.EconomyService.AddCash(player, total)
		data.stats.collected += total
	end
	return total
end

local function incomeTick()
	for player, state in states do
		local data = Services.DataService.Get(player)
		if data then
			local incomes = computeIncomes(player, data)
			state.income = incomes
			local autoCollect = Services.MarketService.HasPass(player, "AutoCollect")
			local total = 0
			for index, income in incomes do
				if autoCollect then
					total += income
				else
					state.stored[index] = (state.stored[index] or 0) + income
				end
			end
			if total > 0 then
				Services.EconomyService.AddCash(player, total)
				data.stats.collected += total
			end
			updateLabels(player, data, state)
		end
	end
end

-- Treasures -----------------------------------------------------------------------------------

export type AddResult = {
	uid: string?,
	treasureId: string,
	condition: string,
	isNew: boolean,
	newVariant: boolean,
	autoSold: boolean,
	sellValue: number,
	placed: boolean,
}

-- Adds a treasure (from a chest) to the player: index, inventory, auto-place, announcements.
function VaultService.AddTreasure(player: Player, treasureId: string, conditionId: string): AddResult?
	local data = Services.DataService.Get(player)
	if not data or not Treasures.ById[treasureId] then
		return nil
	end
	local treasure = Treasures.ById[treasureId]
	local condition = Conditions.ById[conditionId]

	local zonesBefore = Formulas.indexZonesComplete(data.index)
	local isNew = data.index[treasureId] == nil
	data.index[treasureId] = data.index[treasureId] or {}
	local newVariant = not data.index[treasureId][conditionId]
	data.index[treasureId][conditionId] = true
	local zonesAfter = Formulas.indexZonesComplete(data.index)

	local result: AddResult = {
		uid = nil,
		treasureId = treasureId,
		condition = conditionId,
		isNew = isNew,
		newVariant = newVariant,
		autoSold = false,
		sellValue = Formulas.treasureSellValue(treasureId, conditionId),
		placed = false,
	}

	if treasureCount(data) >= GameConfig.MaxTreasures then
		result.autoSold = true
		Services.EconomyService.AddCash(player, result.sellValue)
		Services.PlayerService.Notify(
			player,
			"Treasure storage full: sold " .. treasure.name .. " for " .. Format.money(result.sellValue),
			"Info"
		)
	else
		local uid = "t" .. data.nextUid
		data.nextUid += 1
		data.treasures[uid] = { id = treasureId, c = conditionId }
		result.uid = uid
		local count = Formulas.pedestalCount(data.upgrades.Pedestals)
		for i = 1, count do
			if not data.pedestals[tostring(i)] then
				data.pedestals[tostring(i)] = uid
				result.placed = true
				break
			end
		end
	end

	if isNew then
		Services.PlayerService.Notify(player, "NEW! " .. treasure.name .. " added to your Index", "New")
	end
	if zonesAfter > zonesBefore then
		Services.PlayerService.Notify(player, "Index page complete! +5% income forever", "Success")
	end

	local rarity = Rarities.ById[treasure.rarity]
	if rarity.announce or (condition and condition.announce) then
		local prefix = if condition and condition.id ~= Conditions.Default then condition.name .. " " else ""
		local odds = treasure.odds * (if condition then condition.odds else 1)
		Services.AnnouncementService.Announce(
			("%s found a %s%s (%s)!"):format(player.DisplayName, prefix, treasure.name, Format.odds(odds)),
			rarity.color,
			rarity.rank >= Rarities.ById.Divine.rank or (condition ~= nil and condition.id == "Glitched")
		)
	end

	VaultService.Refresh(player)
	return result
end

function VaultService.Place(player: Player, uid: string, index: number?): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data or not data.treasures[uid] then
		return false, "That treasure doesn't exist"
	end
	local count = Formulas.pedestalCount(data.upgrades.Pedestals)
	local current = pedestalOf(data, uid)
	if index == nil then
		if current then
			return false, "Already on display"
		end
		for candidate = 1, count do
			if not data.pedestals[tostring(candidate)] then
				index = candidate
				break
			end
		end
		if not index then
			return false, "Every pedestal is full. Remove a treasure or buy more pedestals"
		end
	end
	assert(index)
	if index < 1 or index > count then
		return false, "That pedestal is locked"
	end
	if current then
		data.pedestals[tostring(current)] = nil
	end
	data.pedestals[tostring(index)] = uid
	VaultService.Refresh(player)
	return true
end

function VaultService.Remove(player: Player, uid: string): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data then
		return false
	end
	local index = pedestalOf(data, uid)
	if not index then
		return false, "Not on display"
	end
	data.pedestals[tostring(index)] = nil
	VaultService.Refresh(player)
	return true
end

function VaultService.Sell(player: Player, uid: string): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data or not data.treasures[uid] then
		return false, "That treasure doesn't exist"
	end
	local item = data.treasures[uid]
	local index = pedestalOf(data, uid)
	if index then
		data.pedestals[tostring(index)] = nil
	end
	data.treasures[uid] = nil
	Services.EconomyService.AddCash(player, Formulas.treasureSellValue(item.id, item.c))
	VaultService.Refresh(player)
	return true
end

-- Sells every treasure that is not on display. Returns how many and for how much.
function VaultService.SellUnplaced(player: Player): (number, number)
	local data = Services.DataService.Get(player)
	if not data then
		return 0, 0
	end
	local sold, total = 0, 0
	for uid, item in data.treasures do
		if not pedestalOf(data, uid) then
			total += Formulas.treasureSellValue(item.id, item.c)
			data.treasures[uid] = nil
			sold += 1
		end
	end
	if total > 0 then
		Services.EconomyService.AddCash(player, total)
	end
	VaultService.Refresh(player)
	return sold, total
end

-- Puts the highest-earning treasures on display, then tries completing sets.
function VaultService.EquipBest(player: Player)
	local data = Services.DataService.Get(player)
	if not data then
		return
	end
	local uids = {}
	for uid in data.treasures do
		table.insert(uids, uid)
	end
	local function value(uid: string): number
		local item = data.treasures[uid]
		return Formulas.treasureIncome(item.id, item.c)
	end
	table.sort(uids, function(a, b)
		local va, vb = value(a), value(b)
		if va == vb then
			return a < b
		end
		return va > vb
	end)
	local count = Formulas.pedestalCount(data.upgrades.Pedestals)
	table.clear(data.pedestals)
	for i = 1, math.min(count, #uids) do
		data.pedestals[tostring(i)] = uids[i]
	end
	VaultService.Refresh(player)
end

function VaultService.ClearForRebirth(player: Player)
	local state = states[player]
	if state then
		table.clear(state.stored)
	end
end

function VaultService.Start()
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(incomeTick :: any)
			if not ok then
				warn("[VaultService] tick failed:", err)
			end
		end
	end)
end

return VaultService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--[[
	Builds the shared world at server start: ocean terrain, the dark trenches under every plot,
	lighting, decorative islands and the harbor spawn.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Layout = require(script.Parent.Parent.Layout)

local WorldBuilder = {}

local DEFAULT_LIGHTING = {
	ClockTime = 14,
	Brightness = 2.4,
	Ambient = Color3.fromRGB(110, 120, 140),
	OutdoorAmbient = Color3.fromRGB(140, 150, 170),
	AtmosphereColor = Color3.fromRGB(200, 225, 255),
	AtmosphereDecay = Color3.fromRGB(100, 150, 200),
}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

local function buildTerrain()
	local terrain = Workspace.Terrain
	terrain:Clear()
	terrain.WaterColor = Color3.fromRGB(16, 78, 105)
	terrain.WaterTransparency = 0.3
	terrain.WaterReflectance = 0.35
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8

	local floorTop = Layout.SeaFloor
	-- ocean and sea floor
	terrain:FillBlock(CFrame.new(0, floorTop / 2, 0), Vector3.new(960, -floorTop, 760), Enum.Material.Water)
	terrain:FillBlock(CFrame.new(0, floorTop - 6, 0), Vector3.new(960, 12, 760), Enum.Material.Sand)

	-- a trench under every plot: rock walls, then a water column carved through the floor
	local trenchHeight = floorTop - Layout.TrenchBottom
	for _, plotCFrame in Layout.Plots do
		local centre = plotCFrame * CFrame.new(0, 0, Layout.TrenchCenterZ)
		local size = Layout.TrenchSize
		terrain:FillBlock(
			CFrame.new(centre.Position.X, (floorTop - 12 + Layout.TrenchBottom - 12) / 2, centre.Position.Z),
			Vector3.new(size.X + 16, trenchHeight + 12, size.Z + 16),
			Enum.Material.Slate
		)
		terrain:FillBlock(
			CFrame.new(centre.Position.X, (floorTop + Layout.TrenchBottom) / 2, centre.Position.Z),
			Vector3.new(size.X, trenchHeight, size.Z),
			Enum.Material.Water
		)
	end

	-- decorative islands around the edge of the map
	local islands = {
		Vector3.new(-400, -18, -300),
		Vector3.new(390, -20, -310),
		Vector3.new(410, -16, 290),
		Vector3.new(-120, -22, 330),
		Vector3.new(170, -24, -340),
		Vector3.new(430, -20, 0),
	}
	for index, position in islands do
		local radius = 36 + (index % 3) * 8
		terrain:FillBall(position, radius, Enum.Material.Sand)
		terrain:FillBall(position + Vector3.new(0, 6, 0), radius * 0.7, Enum.Material.Grass)
	end
end

local function palmTree(parent: Instance, base: Vector3)
	local trunkHeight = 18
	for i = 0, 5 do
		local p = part({
			Name = "Trunk",
			Size = Vector3.new(1.6, trunkHeight / 6 + 0.3, 1.6),
			CFrame = CFrame.new(base + Vector3.new(i * 0.4, i * trunkHeight / 6 + 1.5, 0))
				* CFrame.Angles(0, 0, math.rad(-8)),
			Color = Color3.fromRGB(140, 100, 60),
			Material = Enum.Material.Wood,
		})
		p.Parent = parent
	end
	local top = base + Vector3.new(2.4, trunkHeight + 1, 0)
	for i = 0, 5 do
		local angle = i * 60
		local leaf = part({
			Name = "Leaf",
			Size = Vector3.new(1.2, 0.4, 9),
			CFrame = CFrame.new(top)
				* CFrame.Angles(0, math.rad(angle), 0)
				* CFrame.new(0, -1, -4)
				* CFrame.Angles(math.rad(-20), 0, 0),
			Color = Color3.fromRGB(60, 170, 70),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
		leaf.Parent = parent
	end
end

local function buildHarbor()
	local folder = Instance.new("Folder")
	folder.Name = "Harbor"
	folder.Parent = Workspace

	local origin = Layout.Harbor
	local deck = part({
		Name = "HarborDeck",
		Size = Vector3.new(44, 2, 34),
		CFrame = origin * CFrame.new(0, Layout.DeckTop - 1, 0),
		Color = Color3.fromRGB(150, 105, 65),
		Material = Enum.Material.WoodPlanks,
	})
	deck.Parent = folder

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HarborSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = origin * CFrame.new(0, Layout.DeckTop + 0.5, 0)
	spawn.Color = Color3.fromRGB(60, 200, 230)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = folder

	local sign = part({
		Name = "Sign",
		Size = Vector3.new(30, 10, 1),
		CFrame = origin * CFrame.new(0, Layout.DeckTop + 9, -16),
		Color = Color3.fromRGB(40, 60, 110),
		Material = Enum.Material.SmoothPlastic,
	})
	sign.Parent = folder
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "ROLL A DIVER"
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.fromRGB(255, 230, 90)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Parent = label

	for _, offset in { Vector3.new(-18, 0, -12), Vector3.new(18, 0, -12) } do
		palmTree(folder, (origin * CFrame.new(offset)).Position + Vector3.new(0, Layout.DeckTop, 0))
	end
end

function WorldBuilder.SetLighting(mode: "Day" | "BloodMoon")
	local atmosphere: Atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	local found = Lighting:FindFirstChild("EventTint")
	local correction: ColorCorrectionEffect = if found and found:IsA("ColorCorrectionEffect")
		then found
		else Instance.new("ColorCorrectionEffect")
	correction.Name = "EventTint"
	correction.Parent = Lighting
	if mode == "BloodMoon" then
		Lighting.ClockTime = 0
		Lighting.Brightness = 1.5
		Lighting.Ambient = Color3.fromRGB(120, 40, 50)
		Lighting.OutdoorAmbient = Color3.fromRGB(150, 50, 60)
		atmosphere.Color = Color3.fromRGB(255, 90, 90)
		atmosphere.Decay = Color3.fromRGB(120, 20, 30)
		correction.TintColor = Color3.fromRGB(255, 200, 200)
	else
		Lighting.ClockTime = DEFAULT_LIGHTING.ClockTime
		Lighting.Brightness = DEFAULT_LIGHTING.Brightness
		Lighting.Ambient = DEFAULT_LIGHTING.Ambient
		Lighting.OutdoorAmbient = DEFAULT_LIGHTING.OutdoorAmbient
		atmosphere.Color = DEFAULT_LIGHTING.AtmosphereColor
		atmosphere.Decay = DEFAULT_LIGHTING.AtmosphereDecay
		correction.TintColor = Color3.new(1, 1, 1)
	end
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Haze = 1
	atmosphere.Glare = 0
end

function WorldBuilder.Init()
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5
	WorldBuilder.SetLighting("Day")
	buildTerrain()
	buildHarbor()
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="43">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="44">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="46">
