        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Enemies</string>
            <string name="Source"><![CDATA[-- Generated by tools/blender/build_enemies.py. Do not edit by hand.
-- Rest-pose layout of each imported enemy mesh, in studs, relative to its feet (Roblox axes).
return {
	Monkey = {
		Height = 5.900,
		Parts = {
			LeftLeg = { Size = Vector3.new(1.000, 2.045, 1.000), Center = Vector3.new(-0.500, 1.023, 0.000), Pivot = Vector3.new(-0.500, 2.000, 0.000) },
			RightLeg = { Size = Vector3.new(1.000, 2.045, 1.000), Center = Vector3.new(0.500, 1.023, 0.000), Pivot = Vector3.new(0.500, 2.000, 0.000) },
			Torso = { Size = Vector3.new(2.000, 2.000, 1.250), Center = Vector3.new(0.000, 3.000, 0.000), Pivot = Vector3.new(0.000, 3.000, 0.000) },
			LeftArm = { Size = Vector3.new(0.950, 1.905, 0.950), Center = Vector3.new(-1.475, 3.053, 0.000), Pivot = Vector3.new(-1.475, 3.620, 0.000) },
			RightArm = { Size = Vector3.new(0.950, 1.905, 0.950), Center = Vector3.new(1.475, 3.053, 0.000), Pivot = Vector3.new(1.475, 3.620, 0.000) },
			Head = { Size = Vector3.new(3.544, 1.900, 1.900), Center = Vector3.new(0.000, 4.950, 0.000), Pivot = Vector3.new(0.000, 4.000, 0.000) },
		},
	},
	Speedy = {
		Height = 5.900,
		Parts = {
			LeftLeg = { Size = Vector3.new(0.900, 2.145, 0.900), Center = Vector3.new(-0.450, 1.072, 0.000), Pivot = Vector3.new(-0.450, 2.100, 0.000) },
			RightLeg = { Size = Vector3.new(0.900, 2.145, 0.900), Center = Vector3.new(0.450, 1.072, 0.000), Pivot = Vector3.new(0.450, 2.100, 0.000) },
			Torso = { Size = Vector3.new(1.800, 1.900, 1.100), Center = Vector3.new(0.000, 3.050, 0.000), Pivot = Vector3.new(0.000, 3.050, 0.000) },
			LeftArm = { Size = Vector3.new(0.850, 1.905, 0.850), Center = Vector3.new(-1.325, 3.053, 0.000), Pivot = Vector3.new(-1.325, 3.660, 0.000) },
			RightArm = { Size = Vector3.new(0.850, 1.905, 0.850), Center = Vector3.new(1.325, 3.053, 0.000), Pivot = Vector3.new(1.325, 3.660, 0.000) },
			Head = { Size = Vector3.new(3.544, 1.900, 2.239), Center = Vector3.new(0.000, 4.950, 0.130), Pivot = Vector3.new(0.000, 4.000, 0.000) },
		},
	},
	Chucker = {
		Height = 5.900,
		Parts = {
			LeftLeg = { Size = Vector3.new(1.000, 2.045, 1.000), Center = Vector3.new(-0.500, 1.023, 0.000), Pivot = Vector3.new(-0.500, 2.000, 0.000) },
			RightLeg = { Size = Vector3.new(1.000, 2.045, 1.000), Center = Vector3.new(0.500, 1.023, 0.000), Pivot = Vector3.new(0.500, 2.000, 0.000) },
			Torso = { Size = Vector3.new(2.000, 2.000, 1.250), Center = Vector3.new(0.000, 3.000, 0.000), Pivot = Vector3.new(0.000, 3.000, 0.000) },
			LeftArm = { Size = Vector3.new(0.950, 1.905, 0.950), Center = Vector3.new(-1.475, 3.053, 0.000), Pivot = Vector3.new(-1.475, 3.620, 0.000) },
			RightArm = { Size = Vector3.new(0.950, 1.905, 3.067), Center = Vector3.new(1.475, 3.053, -1.058), Pivot = Vector3.new(1.475, 3.620, 0.000) },
			Head = { Size = Vector3.new(3.544, 1.900, 1.900), Center = Vector3.new(0.000, 4.950, 0.000), Pivot = Vector3.new(0.000, 4.000, 0.000) },
		},
	},
	Brute = {
		Height = 6.375,
		Parts = {
			LeftLeg = { Size = Vector3.new(1.200, 1.945, 1.200), Center = Vector3.new(-0.625, 0.973, 0.000), Pivot = Vector3.new(-0.625, 1.900, 0.000) },
			RightLeg = { Size = Vector3.new(1.200, 1.945, 1.200), Center = Vector3.new(0.625, 0.973, 0.000), Pivot = Vector3.new(0.625, 1.900, 0.000) },
			Torso = { Size = Vector3.new(2.500, 2.200, 1.500), Center = Vector3.new(0.000, 3.000, 0.000), Pivot = Vector3.new(0.000, 3.000, 0.000) },
			LeftArm = { Size = Vector3.new(1.150, 2.005, 1.150), Center = Vector3.new(-1.825, 3.102, 0.000), Pivot = Vector3.new(-1.825, 3.650, 0.000) },
			RightArm = { Size = Vector3.new(1.150, 2.005, 1.150), Center = Vector3.new(1.825, 3.102, 0.000), Pivot = Vector3.new(1.825, 3.650, 0.000) },
			Head = { Size = Vector3.new(3.644, 2.275, 2.160), Center = Vector3.new(0.000, 5.238, 0.000), Pivot = Vector3.new(0.000, 4.100, 0.000) },
		},
	},
	Baby = {
		Height = 3.950,
		Parts = {
