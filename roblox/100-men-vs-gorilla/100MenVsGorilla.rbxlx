			RightLeg = { Size = Vector3.new(0.700, 0.945, 0.700), Center = Vector3.new(0.350, 0.472, 0.000), Pivot = Vector3.new(0.350, 0.900, 0.000) },
			Torso = { Size = Vector3.new(1.520, 1.260, 1.190), Center = Vector3.new(0.000, 1.470, -0.035), Pivot = Vector3.new(0.000, 1.500, 0.000) },
			LeftArm = { Size = Vector3.new(0.620, 1.155, 0.620), Center = Vector3.new(-1.010, 1.528, 0.000), Pivot = Vector3.new(-1.010, 1.852, 0.000) },
			RightArm = { Size = Vector3.new(0.620, 1.155, 0.620), Center = Vector3.new(1.010, 1.528, 0.000), Pivot = Vector3.new(1.010, 1.852, 0.000) },
			Head = { Size = Vector3.new(3.357, 1.850, 1.900), Center = Vector3.new(-0.000, 3.025, 0.000), Pivot = Vector3.new(0.000, 2.100, 0.000) },
		},
	},
	Ninja = {
		Height = 5.850,
