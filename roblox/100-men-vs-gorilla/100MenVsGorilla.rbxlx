        <Item class="Folder" referent="80">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Cutscene</string>
              <string name="Source"><![CDATA[-- The intro cutscene: the squad's chopper flies in, a Banana Chucker knocks it out of the sky,
-- it crashes onto the map's wreck, the men tumble out and THE Gorilla roars from the temple.
--
-- Everything is driven by Config/Intro (generated from tools/cutscene/intro.json, which the
-- preview studio plays too): camera keys, the chopper's flight, actor tracks (men + monkeys)
-- and timed events. Client-only: actors are local clones, the map is only hidden/shown locally.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EnemyDefs = require(Shared.Config.Enemies)
local Intro = require(Shared.Config.Intro)
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)
local Fx = require(script.Parent.Fx)
local Hud = require(script.Parent.Hud)
local Juice = require(script.Parent.Juice)

local Cutscene = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local rad = math.rad
local FONT = Enum.Font.LuckiestGuy
local FONT_UI = Enum.Font.FredokaOne
local GREEN = Color3.fromRGB(120, 240, 150)

local EASE = {
	linear = function(a: number) return a end,
	out = function(a: number) return 1 - (1 - a) ^ 3 end,
	["in"] = function(a: number) return a * a * a end,
	inout = function(a: number) return if a < 0.5 then 4 * a * a * a else 1 - (-2 * a + 2) ^ 3 / 2 end,
}

local function v3(t: { number }?): Vector3?
	return if t then Vector3.new(t[1], t[2], t[3]) else nil
end

local function angles(yaw: number, pitch: number, roll: number): CFrame
	return CFrame.Angles(0, rad(yaw), 0) * CFrame.Angles(rad(pitch), 0, 0) * CFrame.Angles(0, 0, rad(roll))
end

-- playback rate (slow-mo) at time t, and the rate-scaled clock it produces
local RATE = Intro.rate
local function rateAt(t: number): number
	for i = 1, #RATE - 1 do
		local a, b = RATE[i], RATE[i + 1]
		if t < b[1] then
			local k = math.clamp((t - a[1]) / math.max(1e-4, b[1] - a[1]), 0, 1)
			return a[2] + (b[2] - a[2]) * k
		end
	end
	return RATE[#RATE][2]
end

-- ---------------------------------------------------------------- the chopper's flight

local HELI = Intro.Heli
local WRECK = HELI.Wreck
local wreckCF = CFrame.new(v3(WRECK.pos) :: Vector3) * angles(WRECK.yaw, WRECK.pitch, WRECK.roll)
local wreckFlat = CFrame.new(WRECK.pos[1], 0, WRECK.pos[3]) * CFrame.Angles(0, rad(WRECK.yaw), 0)

type HeliKey = { t: number, pos: Vector3, yaw: number, pitch: number, roll: number, linear: boolean?, ease: string? }
local HK: { HeliKey } = {}
for _, k in Intro.heli.keys do
	table.insert(HK, {
		t = k.t,
		pos = if k.pos == "wreck" then v3(WRECK.pos) :: Vector3 else v3(k.pos) :: Vector3,
		yaw = k.yaw, pitch = k.pitch, roll = k.roll, linear = k.linear, ease = k.ease,
	})
end

-- Hermite through the keys with time-scaled tangents (smooth, no overshoot on uneven spacing).
local function slope(i: number, get: (HeliKey) -> any): any
	local a, b = HK[math.max(1, i - 1)], HK[math.min(#HK, i + 1)]
	return (get(b) - get(a)) / math.max(1e-4, b.t - a.t)
end

local function heliCF(t: number): CFrame
	if t <= HK[1].t then
		local k = HK[1]
		return CFrame.new(k.pos) * angles(k.yaw, k.pitch, k.roll)
	end
	for i = 1, #HK - 1 do
		local k0, k1 = HK[i], HK[i + 1]
		if t < k1.t then
			local dt = k1.t - k0.t
			local s = (t - k0.t) / dt
			local function interp(get: (HeliKey) -> any): any
				if k1.linear then
					local e = EASE[k1.ease or "linear"](s)
					return get(k0) + (get(k1) - get(k0)) * e
				end
				local m0, m1 = slope(i, get) * dt, slope(i + 1, get) * dt
				local s2, s3 = s * s, s * s * s
				return get(k0) * (2 * s3 - 3 * s2 + 1) + m0 * (s3 - 2 * s2 + s) + get(k1) * (-2 * s3 + 3 * s2) + m1 * (s3 - s2)
			end
			local pos = interp(function(k) return k.pos end)
			local yaw = interp(function(k) return k.yaw end)
			local pitch = interp(function(k) return k.pitch end)
			local roll = interp(function(k) return k.roll end)
			return CFrame.new(pos) * angles(yaw, pitch, roll)
		end
	end
	local k = HK[#HK]
	return CFrame.new(k.pos) * angles(k.yaw, k.pitch, k.roll)
end

-- ---------------------------------------------------------------- frames + resolving keys

local playerPos = Vector3.new(0, 0, 70)
local banana = nil :: any

local function bananaPos(t: number): Vector3
	if not banana then
		return Vector3.zero
	end
	local a = math.clamp((t - banana.t0) / (banana.t1 - banana.t0), 0, 1)
	local target = heliCF(t) * banana.to
	return banana.p0:Lerp(target, a) + Vector3.new(0, math.sin(a * math.pi) * banana.arc, 0)
end

local function frameAt(rel: string?, t: number): CFrame
	if rel == "heli" then
		return heliCF(t)
	elseif rel == "wreckFlat" then
		return wreckFlat
	elseif rel == "banana" then
		return CFrame.new(bananaPos(t))
	elseif rel == "player" then
		return CFrame.new(playerPos)
	end
	return CFrame.identity
end

local function resolve(rel: string?, p: Vector3, t: number): Vector3
	if rel == "banana" or rel == "player" then
		return frameAt(rel, t).Position + p -- world-axis offsets
	end
	return frameAt(rel, t) * p
end

-- ---------------------------------------------------------------- camera

local CAM = Intro.camera
local function cameraAt(t: number): (CFrame, number)
	local i = 1
	while i < #CAM and t >= CAM[i + 1].t do
		i += 1
	end
	local k0 = CAM[i]
	local k1 = CAM[i + 1]
	local function point(k, which: string): Vector3
		local rel = if which == "pos" then k.rel else (k.lookRel or k.rel)
		return resolve(rel, v3(k[which]) :: Vector3, t)
	end
	local pos, look, fov = point(k0, "pos"), point(k0, "look"), k0.fov or 70
	if k1 and not k1.cut then
		local a = EASE[k1.ease or "inout"](math.clamp((t - k0.t) / math.max(1e-4, k1.t - k0.t), 0, 1))
		pos = pos:Lerp(point(k1, "pos"), a)
		look = look:Lerp(point(k1, "look"), a)
		fov += ((k1.fov or 70) - fov) * a
	end
	return CFrame.lookAt(pos, look), fov
end

-- ---------------------------------------------------------------- actor tracks

type Key = { [string]: any }
local tracks: { [string]: { Key } } = {}
for name, keys in Intro.tracks do
	local out = {}
	local prev: Key = { pos = Vector3.zero, yaw = 0, pitch = 0, roll = 0, visible = true }
	for i, k in keys do
		local n: Key = {
			t = k.t,
			rel = if k.pos then k.rel else prev.rel,
			pos = v3(k.pos) or prev.pos,
			yaw = k.yaw or prev.yaw,
			pitch = k.pitch or prev.pitch,
			roll = k.roll or prev.roll,
			visible = if k.hide then false elseif k.show then true else (if i == 1 then true else prev.visible),
			pose = k.pose or prev.pose,
			poseT = if k.pose then k.t else prev.poseT,
			prevPose = if k.pose then prev.pose else prev.prevPose,
			anim = k.anim or prev.anim,
			animT = if k.anim then k.t else prev.animT,
			moves = k.pos ~= nil and not k.cut,
			arc = k.arc,
			ease = k.ease,
			face = k.face,
		}
		table.insert(out, n)
		prev = n
	end
	tracks[name] = out
end

type ActorState = { cf: CFrame, visible: boolean, key: Key, speed: number }
local function trackAt(name: string, t: number): ActorState
	local keys = tracks[name]
	local i = 1
	while i < #keys and t >= keys[i + 1].t do
		i += 1
	end
	local k0 = keys[i]
	local k1 = keys[i + 1]
	local p0 = resolve(k0.rel, k0.pos, t)
	local frame = frameAt(k0.rel, t)
	local yaw, pitch, roll = k0.yaw, k0.pitch, k0.roll
	local pos, speed = p0, 0
	if t < k0.t then
		pos = p0
	elseif k1 and k1.moves then
		local span = math.max(1e-4, k1.t - k0.t)
		local a = EASE[k1.ease or "linear"](math.clamp((t - k0.t) / span, 0, 1))
		local p1 = resolve(k1.rel, k1.pos, t)
		pos = p0:Lerp(p1, a) + Vector3.new(0, math.sin(a * math.pi) * (k1.arc or 0), 0)
		local d = k1.pos - k0.pos
		speed = Vector3.new(d.X, 0, d.Z).Magnitude / span
		frame = frameAt(k1.rel, t)
		if k1.face and speed > 0.05 then
			yaw = math.deg(math.atan2(-d.X, -d.Z))
		else
			yaw += (k1.yaw - k0.yaw) * a
		end
		pitch += (k1.pitch - k0.pitch) * a
		roll += (k1.roll - k0.roll) * a
	end
	local rot = (frame - frame.Position) * angles(yaw, pitch, roll)
	return { cf = rot + pos, visible = k0.visible, key = k0, speed = speed }
end

-- ---------------------------------------------------------------- men poses

local ZERO6 = { 0, 0, 0, 0, 0, 0 }
local function full(v: { number }?): { number }
	if not v then
		return ZERO6
	end
	return { v[1], v[2], v[3], v[4] or 0, v[5] or 0, v[6] or 0 }
end

local function poseAt(name: string?, t: number): { [string]: { number } }
	local out: { [string]: { number } } = {}
	local P = name and Intro.poses[name]
	if not P then
		return out
	end
	if P.base then
		out = poseAt(P.base, t)
	end
	for j, v in P.pose or {} do
		out[j] = full(v)
	end
	if P.keys then
		local keys = P.keys
		local lt = t % P.loop
		local i = #keys
		for n = 1, #keys do
			if lt >= keys[n].t then
				i = n
			end
		end
		local k0 = keys[i]
		local k1 = keys[i % #keys + 1]
		local t1 = if i == #keys then P.loop else k1.t
		local a = EASE.inout(math.clamp((lt - k0.t) / math.max(1e-4, t1 - k0.t), 0, 1))
		for j, v in k0.pose do
			local w0, w1 = full(v), full(k1.pose[j] or v)
			local o = table.create(6)
			for n = 1, 6 do
				o[n] = w0[n] + (w1[n] - w0[n]) * a
			end
			out[j] = o
		end
	end
	return out
end

local function blendedPose(key: Key, t: number): { [string]: { number } }
	local cur = poseAt(key.pose, t - (key.poseT or 0))
	local w = math.clamp((t - (key.poseT or 0)) / 0.18, 0, 1)
	if w >= 1 or not key.prevPose then
		return cur
	end
	local old = poseAt(key.prevPose, t)
	local out = {}
	for j, v in cur do
		local o = old[j] or ZERO6
		local r = table.create(6)
		for n = 1, 6 do
			r[n] = o[n] + (v[n] - o[n]) * w
		end
		out[j] = r
	end
	for j, o in old do
		if not cur[j] then
			local r = table.create(6)
			for n = 1, 6 do
				r[n] = o[n] * (1 - w)
			end
			out[j] = r
		end
	end
	return out
end

-- ---------------------------------------------------------------- monkey animation (EnemyView's rig)

local function spring()
	return { x = 0, v = 0 }
end
local function stepSpring(s, dt: number, k: number, d: number)
	s.v += (-k * s.x - d * s.v) * dt
	s.x += s.v * dt
end

local function animateMonkey(a, t: number, dt: number, st: ActorState)
	local anim = st.key.anim or "idle"
	local moving = st.speed > 0.5
	local clock = a.clock
	if moving then
		a.phase += dt * st.speed * 0.9 * (if a.variant == "Speedy" then 1.6 elseif a.variant == "Baby" then 1.9 else 1) / a.scale
	end
	local swing = math.sin(a.phase)
	if moving and math.abs(math.cos(a.phase)) > 0.97 then
		a.headZ.v += (if swing > 0 then 1 else -1) * 3.5
		a.headX.v += 2
	end
	stepSpring(a.headX, dt, 140, 7)
	stepSpring(a.headZ, dt, 140, 7)
	local armAmp = if moving then 0.7 else 0.08
	local lArm = CFrame.Angles(-swing * armAmp + (if moving then 0 else math.sin(clock * 2) * 0.05), 0, 0)
	local rArm = CFrame.Angles(swing * armAmp, 0, 0)
	local hipL = CFrame.Angles(if moving then swing * 0.65 else 0, 0, 0)
	local hipR = CFrame.Angles(if moving then -swing * 0.65 else 0, 0, 0)
	local bob = if moving then math.abs(swing) * 0.22 * a.scale else 0
	local lean, waddle, neckX = 0, if moving then swing * 0.1 else 0, 0
	if a.gorilla and moving then
		lArm = CFrame.Angles(0.35 - swing * 0.55, 0, 0)
		rArm = CFrame.Angles(0.35 + swing * 0.55, 0, 0)
		lean = 0.25
	end
	if not moving then
		if anim == "pound" then
			local beat = math.sin(clock * 11 + a.seed)
			lArm = CFrame.Angles(1.6 + beat * 1.1, 0, -0.2)
			rArm = CFrame.Angles(1.6 - beat * 1.1, 0, 0.2)
			bob = math.abs(beat) * 0.15 * a.scale
			if beat > 0.98 then
				a.headX.v += 5
			end
		elseif anim == "throw" then
			local k = math.clamp((t - (st.key.animT or t)) / 0.8, 0, 1)
			rArm = if k < 0.6 then CFrame.Angles(-k / 0.6 * 2.4, 0, 0) else CFrame.Angles(-2.4 + (k - 0.6) / 0.4 * 4.2, 0, 0)
			lean = if k < 0.6 then -0.15 * k / 0.6 else 0.2
		elseif anim == "hang" then
			lArm = CFrame.Angles(3.0, 0, -0.15)
			rArm = CFrame.Angles(3.0, 0, 0.15)
			hipL = CFrame.Angles(0.3 + math.sin(clock * 3) * 0.35, 0, 0)
			hipR = CFrame.Angles(0.3 - math.sin(clock * 3) * 0.35, 0, 0)
			waddle = math.sin(clock * 1.6) * 0.18
		elseif anim == "eat" then
			rArm = CFrame.Angles(2.3 + math.sin(clock * 9) * 0.25, 0, 0.3)
			neckX = math.sin(clock * 9) * 0.08
		elseif anim == "roar" then
			local k = math.clamp((t - (st.key.animT or t)) / 0.25, 0, 1)
			lArm = CFrame.Angles(2.7 * k, 0, -0.7 * k)
			rArm = CFrame.Angles(2.7 * k, 0, 0.7 * k)
			lean = -0.3 * k
			neckX = -0.45 * k
		end
	end
	if a.motors.RootJoint then
		a.motors.RootJoint.Transform = CFrame.new(0, bob, 0) * CFrame.Angles(-lean, 0, waddle)
	end
	if a.motors.Neck then
		a.motors.Neck.Transform = CFrame.Angles(neckX - a.headX.x * 0.03, 0, a.headZ.x * 0.035)
	end
	if a.motors["Left Shoulder"] then
		a.motors["Left Shoulder"].Transform = lArm
	end
	if a.motors["Right Shoulder"] then
		a.motors["Right Shoulder"].Transform = rArm
	end
	if a.motors["Left Hip"] then
		a.motors["Left Hip"].Transform = hipL
	end
	if a.motors["Right Hip"] then
		a.motors["Right Hip"].Transform = hipR
	end
end

-- ---------------------------------------------------------------- UI

local function make(class: string, props: { [string]: any }): any
	local inst = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function buildUi()
	local gui = make("ScreenGui", { Name = "Intro", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20,
		Parent = player:WaitForChild("PlayerGui") })
	local ui = { gui = gui }
	ui.top = make("Frame", { Size = UDim2.new(1, 0, 0.11, 0), Position = UDim2.fromScale(0, -0.11), BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0, Parent = gui })
	ui.bottom = make("Frame", { Size = UDim2.new(1, 0, 0.11, 0), Position = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0, Parent = gui })
	TweenService:Create(ui.top, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Position = UDim2.fromScale(0, 0) }):Play()
	TweenService:Create(ui.bottom, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Position = UDim2.fromScale(0, 0.89) }):Play()
	ui.alarm = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 20, 20), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 2, Parent = gui })
	ui.flash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 9, Parent = gui })
	ui.sub = make("Frame", { Size = UDim2.new(0.8, 0, 0.07, 0), Position = UDim2.fromScale(0.5, 0.86), AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1, Visible = false, ZIndex = 5, Parent = gui })
	ui.who = make("TextLabel", { Size = UDim2.new(1, 0, 0.42, 0), BackgroundTransparency = 1, Font = FONT, TextScaled = true,
		TextColor3 = GREEN, ZIndex = 5, Parent = ui.sub })
	make("UIStroke", { Thickness = 2, Parent = ui.who })
	ui.line = make("TextLabel", { Size = UDim2.new(1, 0, 0.58, 0), Position = UDim2.fromScale(0, 0.42), BackgroundTransparency = 1,
		Font = FONT_UI, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), ZIndex = 5, Parent = ui.sub })
	make("UIStroke", { Thickness = 2, Parent = ui.line })
	ui.title = make("TextLabel", { Size = UDim2.fromScale(0.86, 0.22), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1, Font = FONT, TextScaled = true, TextColor3 = Color3.fromRGB(255, 214, 40), Visible = false,
		ZIndex = 8, Rotation = -4, Parent = gui })
	ui.titleStroke = make("UIStroke", { Thickness = 6, Parent = ui.title })
	ui.titleScale = make("UIScale", { Parent = ui.title })
	ui.skip = make("TextButton", { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -20, 1, -16), AnchorPoint = Vector2.new(1, 1),
		BackgroundColor3 = GREEN, Text = "SKIP >>", Font = FONT, TextScaled = true, TextColor3 = Color3.fromRGB(16, 18, 16),
		ZIndex = 10, Parent = gui })
	make("UICorner", { CornerRadius = UDim.new(0, 6), Parent = ui.skip })
	make("UIStroke", { Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ui.skip })
	return ui
end

-- ---------------------------------------------------------------- the player

local running = false

function Cutscene.play()
	if running then
		return
	end
	running = true
	local assets = ReplicatedStorage:WaitForChild("Assets")
	local heliTemplate = assets:WaitForChild("HeliFlying", 10)
	local squad = assets:WaitForChild("CutsceneSquad", 15)
	local rigs = ReplicatedStorage:WaitForChild("Rigs", 15)
	local map = workspace:WaitForChild("Map", 10)
	local function done()
		running = false
		Hud.setVisible(true)
		Hud.introFinished()
		Net.event("IntroDone"):FireServer()
	end
	if not (heliTemplate and squad and rigs and map) then
		warn("[Intro] assets missing, skipping the intro")
		done()
		return
	end

	-- the player stands still while it plays
	local character = player.Character or player.CharacterAdded:Wait()
	local hrp = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if hrp then
		playerPos = hrp.Position
	end
	local oldSpeed, oldJump = 16, 50
	if humanoid then
		oldSpeed, oldJump = humanoid.WalkSpeed, humanoid.JumpPower
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
	end

	local folder = Instance.new("Folder")
	folder.Name = "IntroActors"
	folder.Parent = workspace
	Hud.setVisible(false)
	local ui = buildUi()

	-- ---- map: hide what the intro reveals, restore everything at the end
	local hidden: { [BasePart]: number } = {}
	local effects: { [Instance]: boolean } = {}
	local function hide(part: BasePart)
		if hidden[part] == nil then
			hidden[part] = part.Transparency
		end
		part.Transparency = 1
	end
	local function reveal(part: BasePart)
		if hidden[part] ~= nil then
			part.Transparency = hidden[part]
		end
	end
	local wreck = map:FindFirstChild("Map_Wreck")
	local wreckParts: { BasePart } = {}
	if wreck then
		for _, d in wreck:GetDescendants() do
			if d:IsA("BasePart") then
				hide(d)
				table.insert(wreckParts, d)
			elseif d:IsA("Fire") or d:IsA("Smoke") then
				effects[d] = d.Enabled
				d.Enabled = false
			end
		end
	end
	local north = map:FindFirstChild("Map_North")
	local base = map:FindFirstChild("Map_Base")
	for _, name in { "Brazier", "BrazierFire" } do
		local p = north and north:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			hide(p)
		end
	end
	if base then
		for _, p in base:GetChildren() do
			if p:IsA("BasePart") and p.Name:match("^StashTop") then
				hide(p)
			end
		end
	end
	local eyes: { { part: BasePart, color: Color3, material: Enum.Material } } = {}
	for _, name in { "IdolEyeL", "IdolEyeR" } do
		local p = north and north:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			table.insert(eyes, { part = p, color = p.Color, material = p.Material })
			p.Color = Color3.fromRGB(40, 26, 18)
			p.Material = Enum.Material.SmoothPlastic
		end
	end

	-- ---- the flying chopper
	local heli = heliTemplate:Clone() :: Model
	local heliParts: { BasePart } = {}
	local heliLocal: { CFrame } = {}
	local heliKind: { string } = {}
	local splat: BasePart? = nil
	for _, p in heli:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			table.insert(heliParts, p)
			table.insert(heliLocal, p.CFrame)
			table.insert(heliKind, if p.Name:match("^HeliRotor") then "rotor" elseif p.Name == "HeliTailRotor" then "tail" else "")
			if p.Name == "HeliBananaSplat" then
				splat = p
				p.Transparency = 1
			end
		end
	end
	heli.Parent = folder
	local hub = CFrame.new(v3(HELI.hub) :: Vector3)
	local tailHub = CFrame.new(v3(HELI.tailHub) :: Vector3)
	local heliRoot = heli:FindFirstChild("HeliRoot") :: BasePart
	local spin, tailSpin = 0, 0

	-- ---- actors
	local actors: { [string]: any } = {}
	for name, def in Intro.actors do
		local model: Model? = nil
		local a: any = { name = name, def = def, clock = 0, phase = math.random() * 6, seed = math.random() * 10,
			headX = spring(), headZ = spring() }
		if def.kind == "man" then
			local template = squad:FindFirstChild(name)
			if template then
				model = template:Clone()
				;(model :: Model):ScaleTo(def.scale or 1)
				local root = (model :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
				-- root height above the soles: custom rigs carry it, avatars are measured
				local soles = math.huge
				for _, foot in { "LeftFoot", "RightFoot" } do
					local f = (model :: Model):FindFirstChild(foot) :: BasePart?
					if f then
						soles = math.min(soles, f.Position.Y - f.Size.Y / 2)
					end
				end
				a.root = root
				local rootHeight = template:GetAttribute("RootHeight")
				a.offset = CFrame.new(0, if rootHeight then rootHeight * (def.scale or 1)
					elseif soles < math.huge then root.Position.Y - soles else 3 * (def.scale or 1), 0)
			end
		else
			local template = rigs:FindFirstChild(def.variant)
			if template then
				model = template:Clone()
				local scale = (EnemyDefs[def.variant] and EnemyDefs[def.variant].Scale) or 1
				if scale ~= 1 then
					(model :: Model):ScaleTo(scale)
				end
				a.scale = scale
				a.variant = def.variant
				a.gorilla = EnemyDefs[def.variant] and EnemyDefs[def.variant].Boss == true
				a.root = (model :: Model).PrimaryPart
				a.offset = CFrame.new(0, (template:GetAttribute("RootHeight") or 3) * scale, 0)
			end
		end
		if model then
			a.model = model
			a.motors = {}
			for _, d in model:GetDescendants() do
				if d:IsA("Motor6D") then
					a.motors[d.Name] = d
				elseif d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
				end
			end
			if a.root then
				a.root.Anchored = true
			end
			actors[name] = a
		end
	end
	-- the Chucker carries the banana it is about to throw
	local held: BasePart? = nil
	local chucker = actors.Chucker
	if chucker then
		held = Fx.part({ Size = Vector3.new(0.5, 1.6, 0.5), Color = Color3.fromRGB(255, 214, 40), Parent = folder })
	end

	-- ---- sounds that live for a while
	local function loopSound(name: string, parent: Instance): Sound
		local def = Sounds[name]
		local s = Instance.new("Sound")
		s.SoundId = if def.Id then `rbxassetid://{def.Id}` else def.Fallback
		s.Volume = def.Volume
		s.Looped = true
		s.RollOffMinDistance = 25
		s.RollOffMaxDistance = 400
		s.Parent = parent
		s:Play()
		return s
	end
	local rotorSound: Sound? = nil
	local alarmSound: Sound? = nil
	local alarmUntil, smokeUntil, slideUntil = -1, -1, -1
	local nextSmoke, nextSlide = 0, 0
	local subToken = 0

	local function heliPoint(t: number, localP: Vector3): Vector3
		return heliCF(t) * localP
	end
	local S = HELI.scale
	local ENGINE = Vector3.new(0, 6.6 * S, 0.8 * S)
	local SKIDS = Vector3.new(0, -1.0 * S, -2 * S)

	local function say(ev)
		subToken += 1
		local token = subToken
		ui.who.Text = ev.who or ""
		ui.line.Text = ev.text or ""
		ui.sub.Visible = true
		if ev.sound then
			Juice.sound(ev.sound)
		end
		if ev.shout then
			Juice.callout(ev.shout, Color3.fromRGB(255, 60, 40), 1.2)
		end
		task.delay(ev.dur or 2, function()
			if subToken == token then
				ui.sub.Visible = false
			end
		end)
	end

	local function flash(time: number)
		ui.flash.BackgroundTransparency = 0
		TweenService:Create(ui.flash, TweenInfo.new(time), { BackgroundTransparency = 1 }):Play()
	end

	local function actorHead(a): Vector3
		local head = a.model and (a.model:FindFirstChild("Head") :: BasePart?)
		return if head then head.Position + Vector3.new(0, 1, 0) else a.root.Position
	end

	local handlers = {}
	handlers.rotor = function()
		rotorSound = loopSound("Rotor", heliRoot)
	end
	handlers.say = say
	handlers.sound = function(ev)
		Juice.sound(ev.name, nil, ev.pitch, ev.volume)
	end
	handlers.shake = function(ev)
		Juice.shake(ev.amount)
	end
	handlers.punch = function(ev)
		Juice.punch(ev.amount)
	end
	handlers.idolEyes = function()
		for _, e in eyes do
			e.part.Material = e.material
			TweenService:Create(e.part, TweenInfo.new(0.5), { Color = e.color }):Play()
			Fx.sparks(e.part.Position, e.color, 8, 3)
		end
	end
	handlers.banana = function(ev, t)
		local p0 = if actors[ev.from] then trackAt(ev.from, t).cf * (v3(ev.fromLocal) :: Vector3) else Vector3.new(0, 12, 42)
		local model = Fx.part({ Size = Vector3.new(0.6, 1.8, 0.6), Color = Color3.fromRGB(255, 214, 40), Parent = folder })
		local tip = Fx.part({ Size = Vector3.new(0.35, 0.35, 0.35), Color = Color3.fromRGB(80, 56, 30), Parent = folder })
		banana = { p0 = p0, t0 = t, t1 = ev.arrive, to = v3(ev.to), arc = ev.arc or 6, model = model, tip = tip }
		if held then
			held.Transparency = 1
		end
	end
	handlers.splat = function(_, t)
		local at = if banana then bananaPos(t) else heliPoint(t, Vector3.new(-1.6, 5.4, -5.4))
		if banana then
			banana.model:Destroy()
			banana.tip:Destroy()
		end
		if splat then
			splat.Transparency = 0
		end
		Juice.sound("Splat")
		Fx.text(at + Vector3.new(0, 1.5, 0), "SPLAT!", Color3.fromRGB(255, 214, 40), 1.3)
		Fx.bricks(at, { Color3.fromRGB(255, 214, 40), Color3.fromRGB(255, 240, 150) }, 10, 18, 0.6)
		Juice.shake(0.35)
	end
	handlers.alarm = function(ev)
		alarmUntil = ev["until"]
		alarmSound = loopSound("Alarm", heliRoot)
	end
	handlers.smoke = function(ev)
		smokeUntil = ev["until"]
	end
	handlers.slide = function(ev)
		slideUntil = ev["until"]
	end
	handlers.impact = function(_, t)
		local at = heliPoint(t, SKIDS)
		at = Vector3.new(at.X, 0.5, at.Z)
		Fx.poof(at, 7, Color3.fromRGB(236, 205, 110))
		Fx.sparks(at, Color3.fromRGB(255, 200, 80), 14, 6)
		Fx.bricks(at, { Color3.fromRGB(236, 205, 110), Color3.fromRGB(214, 180, 92) }, 14, 24, 0.8)
		Fx.ring(at, 9, Color3.fromRGB(255, 240, 200), 0.4, 0.3)
		Juice.sound("Thud", nil, 0.6)
		Juice.sound("Crash", nil, 1.15, 0.7)
		Juice.shake(0.55)
	end
	handlers.crash = function()
		heli.Parent = nil
		for _, p in wreckParts do
			reveal(p)
		end
		for e, on in effects do
			(e :: any).Enabled = on
		end
		local at = wreckCF * ENGINE
		Fx.explosion(at, 7)
		Fx.bricks(at, { Color3.fromRGB(88, 102, 56), Color3.fromRGB(66, 78, 42), Color3.fromRGB(236, 205, 110) }, 30, 34, 1)
		Fx.poof(Vector3.new(at.X, 1, at.Z), 9, Color3.fromRGB(236, 205, 110))
		flash(0.35)
		Juice.sound("Boom")
		Juice.sound("Crash")
		Juice.shake(1)
		if rotorSound then
			rotorSound:Destroy()
			rotorSound = nil
		end
		if alarmSound then
			alarmSound:Destroy()
			alarmSound = nil
		end
		alarmUntil = -1
	end
	handlers.land = function(ev, t)
		local a = actors[ev.actor]
		if not a then
			return
		end
		local p = trackAt(ev.actor, t).cf.Position
		Fx.poof(Vector3.new(p.X, 0.6, p.Z), if ev.soft then 2.5 else 4, Color3.fromRGB(236, 205, 110))
		Juice.sound("Thud", nil, if ev.soft then 1.2 else 0.9)
		Juice.shake(if ev.soft then 0.05 else 0.15)
	end
	handlers.faceBanana = function(ev)
		local a = actors[ev.actor]
		local head = a and a.model and (a.model:FindFirstChild("Head") :: BasePart?)
		if head then
			local peel = Fx.part({ Size = Vector3.new(1.0, 0.5, 0.15), Color = Color3.fromRGB(255, 214, 40), Anchored = false,
				CFrame = head.CFrame * CFrame.new(0, 0.05, -head.Size.Z / 2 - 0.05) * CFrame.Angles(0, 0, rad(20)), Parent = a.model })
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = head
			weld.Part1 = peel
			weld.Parent = peel
		end
	end
	handlers.dizzy = function(ev)
		local a = actors[ev.actor]
		if a then
			Fx.dizzy(function()
				return if a.model.Parent then actorHead(a) else nil
			end, ev.dur or 2)
		end
	end
	handlers.title = function(ev)
		ui.title.Text = ev.text
		ui.title.Visible = true
		ui.title.TextTransparency = 0
		ui.titleStroke.Transparency = 0
		ui.titleScale.Scale = 3
		TweenService:Create(ui.titleScale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		Juice.sound("Title")
		Juice.shake(0.45)
		task.delay(ev.dur or 1.8, function()
			TweenService:Create(ui.title, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
			TweenService:Create(ui.titleStroke, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		end)
	end
	handlers.letterbox = function(ev)
		if not ev.on then
			TweenService:Create(ui.top, TweenInfo.new(0.5), { Position = UDim2.fromScale(0, -0.11) }):Play()
			TweenService:Create(ui.bottom, TweenInfo.new(0.5), { Position = UDim2.fromScale(0, 1) }):Play()
			TweenService:Create(ui.skip, TweenInfo.new(0.3), { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
		end
	end

	-- ---- per frame
	camera.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local lastT = 0
	local nextEvent = 1
	local events = Intro.events
	local finished = false

	local function finish()
		if finished then
			return
		end
		finished = true
		keyConn:Disconnect()
		RunService:UnbindFromRenderStep("IntroCutscene")
		if rotorSound then
			rotorSound:Destroy()
		end
		if alarmSound then
			alarmSound:Destroy()
		end
		folder:Destroy()
		ui.gui:Destroy()
		for p, tr in hidden do
			p.Transparency = tr
		end
		for e, on in effects do
			(e :: any).Enabled = on
		end
		for _, e in eyes do
			e.part.Color = e.color
			e.part.Material = e.material
		end
		Juice.baseFov = 70
		camera.CameraType = Enum.CameraType.Custom
		if humanoid then
			humanoid.WalkSpeed = oldSpeed
			humanoid.JumpPower = oldJump
		end
		done()
	end

	ui.skip.Activated:Connect(finish)
	local keyConn = UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Return) then
			finish()
		end
	end)

	RunService:BindToRenderStep("IntroCutscene", Enum.RenderPriority.Camera.Value, function()
		if finished then
			return
		end
		local t = os.clock() - t0
		if t >= Intro.duration then
			finish()
			return
		end
		local dt = math.min(t - lastT, 1 / 20)
		lastT = t
		local rate = rateAt(t)

		while nextEvent <= #events and events[nextEvent].t <= t do
			local ev = events[nextEvent]
			nextEvent += 1
			local h = handlers[ev["do"]]
			if h then
				task.spawn(h, ev, t)
			end
		end

		-- chopper
		if heli.Parent then
			local cf = heliCF(t)
			spin += dt * rate * Intro.rotorRps * math.pi * 2
			tailSpin += dt * rate * Intro.rotorRps * math.pi * 5
			local cfs = table.create(#heliParts)
			for i, p in heliParts do
				local kind = heliKind[i]
				if kind == "rotor" then
					cfs[i] = cf * hub * CFrame.Angles(0, spin, 0) * hub:Inverse() * heliLocal[i]
				elseif kind == "tail" then
					cfs[i] = cf * tailHub * CFrame.Angles(tailSpin, 0, 0) * tailHub:Inverse() * heliLocal[i]
				else
					cfs[i] = cf * heliLocal[i]
				end
			end
			workspace:BulkMoveTo(heliParts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
			if rotorSound then
				rotorSound.PlaybackSpeed = 0.6 + 0.4 * rate
			end
		end

		-- actors
		for name, a in actors do
			local st = trackAt(name, t)
			local wanted = if st.visible then folder else nil
			if a.model.Parent ~= wanted then
				a.model.Parent = wanted
			end
			if not st.visible then
				continue
			end
			a.clock += dt * rate
			a.root.CFrame = st.cf * a.offset
			if a.def.kind == "man" then
				local pose = blendedPose(st.key, t)
				for j, m in a.motors do
					local v = pose[j]
					m.Transform = if v then CFrame.new(v[4], v[5], v[6]) * CFrame.Angles(v[1], v[2], v[3]) else CFrame.identity
				end
			else
				animateMonkey(a, t, dt * rate, st)
			end
		end
		if held and chucker then
			local arm = chucker.model:FindFirstChild("RightArm") :: BasePart?
			if arm then
				held.CFrame = arm.CFrame * CFrame.new(0, -arm.Size.Y * 0.5, -0.2) * CFrame.Angles(rad(20), 0, rad(15))
			end
		end
		if banana and banana.model.Parent then
			local p = bananaPos(t)
			banana.model.CFrame = CFrame.new(p) * CFrame.Angles(t * 9, t * 6, 0)
			banana.tip.CFrame = banana.model.CFrame * CFrame.new(0, 1.0, 0)
		end

		-- running effects
		if t < alarmUntil then
			ui.alarm.BackgroundTransparency = 0.72 + 0.28 * math.abs(math.cos(t * 6))
		else
			ui.alarm.BackgroundTransparency = 1
		end
		if t < smokeUntil and t >= nextSmoke then
			nextSmoke = t + 0.07
			Fx.poof(heliPoint(t, ENGINE), 2.6, Color3.fromRGB(70, 68, 66))
		end
		if t < slideUntil and t >= nextSlide then
			nextSlide = t + 0.05
			local nose = heliPoint(t, Vector3.new(0, 0, -6 * S))
			Fx.poof(Vector3.new(nose.X, 0.8, nose.Z), 3.4, Color3.fromRGB(236, 205, 110))
			local hx = heliCF(t).Position.X
			for _, p in wreckParts do
				if (p.Name:match("^Trench") or p.Name:match("^Berm")) and p.Position.X > hx + 1 then
					reveal(p)
				end
			end
		end

		-- camera last, so Juice's shake lands on top of it
		local cf, fov = cameraAt(t)
		camera.CFrame = cf
		Juice.baseFov = fov
		camera.FieldOfView = fov
	end)
end

return Cutscene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">EnemyView</string>
              <string name="Source"><![CDATA[-- Draws every monkey locally from the server's path data (ReplicatedStorage.Enemies), so
-- movement is perfectly smooth and free. Gives them their personality: waddle walks, springy
-- bobble heads that wobble on every step and every hit, knockback leans, pounding at the stash,
-- leaps, taunts and nets. KillFx takes a model over with EnemyView.release(id) when it dies.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EnemyDefs = require(Shared.Config.Enemies)
local MapData = require(Shared.MapData)
local PathUtil = require(Shared.PathUtil)
local Fx = require(script.Parent.Fx)
local Juice = require(script.Parent.Juice)

local EnemyView = {}

local PATHS = PathUtil.fromMapData(MapData)
local rigs = ReplicatedStorage:WaitForChild("Rigs")
local data = ReplicatedStorage:WaitForChild("Enemies")

local folder = Instance.new("Folder")
folder.Name = "ClientEnemies"
folder.Parent = workspace

type Spring = { x: number, v: number }
local function spring(): Spring
	return { x = 0, v = 0 }
end
local function stepSpring(s: Spring, dt: number, stiffness: number, damping: number)
	local a = -stiffness * s.x - damping * s.v
	s.v += a * dt
	s.x += s.v * dt
end

local views = {} -- id -> view

local function motor(model: Model, name: string): Motor6D?
	return model:FindFirstChild(name, true) :: Motor6D?
end

-- Health bar: chunky outlined pill with segment ticks. The fill shifts green -> yellow -> red,
-- a white "damage trail" lingers behind each hit and then drains, and the bar pops on every hit.
local function hpColor(r: number): Color3
	if r > 0.6 then
		return Color3.fromRGB(110, 235, 70)
	elseif r > 0.3 then
		return Color3.fromRGB(255, 205, 40)
	end
	return Color3.fromRGB(245, 60, 45)
end

local function hpBar(view)
	local head = view.model:FindFirstChild("Head") :: BasePart?
	if not head or view.def.Boss then
		return -- bosses use the big bar at the top of the screen
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(3.6 * view.def.Scale, 0.62)
	bb.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y * 0.5 + 1.3, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 150
	bb.LightInfluence = 0
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromScale(1, 1)
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.BackgroundColor3 = Color3.fromRGB(24, 22, 20)
	holder.BorderSizePixel = 0
	holder.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.45, 0)
	corner.Parent = holder
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(10, 10, 10)
	stroke.Parent = holder
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 2), UDim.new(0, 2)
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 2), UDim.new(0, 2)
	pad.Parent = holder
	local function bar(color: Color3, z: number): Frame
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.ZIndex = z
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.45, 0)
		c.Parent = f
		f.Parent = holder
		return f
	end
	local trail = bar(Color3.fromRGB(255, 255, 255), 1)
	local fill = bar(hpColor(1), 2)
	local shine = Instance.new("UIGradient") -- glossy top highlight
	shine.Rotation = 90
	shine.Transparency = NumberSequence.new(0)
	shine.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(235, 235, 235)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 170, 170)),
	})
	shine.Parent = fill
	for i = 1, 9 do
		local tick = Instance.new("Frame")
		tick.Size = UDim2.new(0, 2, 1, 0)
		tick.Position = UDim2.fromScale(i / 10, 0)
		tick.BackgroundColor3 = Color3.fromRGB(24, 22, 20)
		tick.BackgroundTransparency = 0.35
		tick.BorderSizePixel = 0
		tick.ZIndex = 3
		tick.Parent = holder
	end
	local scale = Instance.new("UIScale")
	scale.Parent = holder
	bb.Adornee = head
	bb.Enabled = false
	bb.Parent = view.model
	view.bar, view.barFill, view.barTrail, view.barScale, view.barHolder = bb, fill, trail, scale, holder
	view.trailRatio, view.trailHold = 1, 0
end

-- Called when a monkey's health changes: snap the fill, pop the bar, let the trail linger.
local function hpChanged(view, ratio: number)
	if not view.barFill then
		return
	end
	view.bar.Enabled = true
	view.barFill.Size = UDim2.fromScale(ratio, 1)
	view.barFill.BackgroundColor3 = hpColor(ratio)
	view.barScale.Scale = 1.3
	TweenService:Create(view.barScale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	view.trailHold = os.clock() + 0.3
	view.shakeUntil = os.clock() + 0.12
end

local function create(cfg: Configuration)
	local id = tonumber(cfg.Name)
	local typeName = cfg:GetAttribute("Type")
	local template = rigs:FindFirstChild(typeName)
	if not id or not template then
		return
	end
	local def = EnemyDefs[typeName]
	local model = template:Clone() :: Model
	if def.Scale ~= 1 then
		model:ScaleTo(def.Scale)
	end
	model.Name = cfg.Name
	local view = {
		id = id,
		cfg = cfg,
		def = def,
		type = typeName,
		model = model,
		root = model.PrimaryPart,
		rootHeight = (template:GetAttribute("RootHeight") or 3) * def.Scale,
		path = PATHS[cfg:GetAttribute("Path")],
		lane = cfg:GetAttribute("Lane") or 0,
		neck = motor(model, "Neck"),
		rootJoint = motor(model, "RootJoint"),
		lShoulder = motor(model, "Left Shoulder"),
		rShoulder = motor(model, "Right Shoulder"),
		lHip = motor(model, "Left Hip"),
		rHip = motor(model, "Right Hip"),
		phase = math.random() * 6,
		headX = spring(),
		headZ = spring(),
		lean = spring(),
		lastHp = cfg:GetAttribute("Hp"),
		pos = Vector3.zero,
		dir = Vector3.new(0, 0, -1),
		throwT = -10,
		slamT = -10,
		gorilla = def.Boss == true,
	}
	hpBar(view)
	model.Parent = folder
	views[id] = view
	if def.Boss then
		Juice.sound("Roar", nil, 0.9)
		Juice.shake(0.5)
	end
end

local function destroy(id: number)
	local view = views[id]
	if view then
		views[id] = nil
		view.model:Destroy()
	end
end

for _, c in data:GetChildren() do
	task.spawn(create, c)
end
data.ChildAdded:Connect(create)
data.ChildRemoved:Connect(function(c)
	local id = tonumber(c.Name)
	if id then
		task.delay(0.1, destroy, id) -- KillFx may already have claimed it
	end
end)

-- ---------------------------------------------------------------- API

function EnemyView.get(id: number)
	return views[id]
end

function EnemyView.position(id: number): Vector3?
	local v = views[id]
	return v and v.root and v.root.Position
end

-- True if any drawn monkey stands within `radius` (flat) of pos. Used to raise combat stances.
function EnemyView.anyWithin(pos: Vector3, radius: number): boolean
	local r2 = radius * radius
	for _, v in views do
		local d = v.pos - pos
		if d.X * d.X + d.Z * d.Z <= r2 then
			return true
		end
	end
	return false
end

-- Hands a model over to the kill effects (stops animating and positioning it).
function EnemyView.release(id: number)
	local v = views[id]
	views[id] = nil
	return v
end

-- A hit: wobble the bobble head, lean back, flash white, show the bar.
function EnemyView.hit(id: number, dmg: number, crit: boolean, fromDir: Vector3?)
	local v = views[id]
	if not v then
		return
	end
	local kick = (if crit then 2.2 else 1.2) / math.max(1, v.def.Scale)
	v.headX.v += (math.random() - 0.5) * 30 * kick + 14 * kick
	v.headZ.v += (math.random() - 0.5) * 34 * kick
	v.lean.v += 12 * kick
	Fx.flash(v.model, if v.def.Armor then Color3.fromRGB(200, 220, 255) else nil)
	if v.bar then
		v.bar.Enabled = true
	end
	local _ = fromDir
end

-- Ability visuals: wind-ups and throws.
function EnemyView.act(id: number, kind: string)
	local v = views[id]
	if not v then
		return
	end
	if kind == "throw" then
		v.throwT = os.clock()
	elseif kind == "slam" then
		v.slamT = os.clock()
	elseif kind == "enrage" then
		v.headX.v += 40
		for _, p in v.model:GetDescendants() do
			if p:IsA("BasePart") and p.Name == "Torso" then
				local fire = Instance.new("Fire")
				fire.Color = Color3.fromRGB(255, 60, 30)
				fire.SecondaryColor = Color3.fromRGB(255, 160, 40)
				fire.Size = 6
				fire.Heat = 12
				fire.Parent = p
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 70, 40)
				light.Range = 14
				light.Brightness = 3
				light.Parent = p
			end
		end
	end
end

-- ---------------------------------------------------------------- per frame

local roots, cframes = {}, {}
local BASE = MapData.Base

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 1 / 20)
	local t = workspace:GetServerTimeNow()
	local clock = os.clock()
	table.clear(roots)
	table.clear(cframes)
	for id, v in views do
		local cfg = v.cfg
		if not cfg.Parent then
			continue
		end
		local speed = cfg:GetAttribute("Speed") or 0
		local p = math.min((cfg:GetAttribute("P0") or 0) + speed * (t - (cfg:GetAttribute("T0") or t)), v.path.length)
		local hop = 0
		local leapT = cfg:GetAttribute("LeapT")
		if leapT and t - leapT < 0.55 then
			local a = (t - leapT) / 0.55
			local from = cfg:GetAttribute("LeapFrom") or p
			p = from + ((cfg:GetAttribute("P0") or p) - from) * a
			hop = math.sin(a * math.pi) * 7
		end
		local pos, dir = PathUtil.sampleLane(v.path, p, v.lane)
		local moving = speed > 0.1
		local tauntUntil = cfg:GetAttribute("TauntUntil") or 0
		local attacking = cfg:GetAttribute("AtBase") or t < tauntUntil
		if attacking then
			local at = if t < tauntUntil then cfg:GetAttribute("TauntPos") else BASE
			if at then
				local flat = Vector3.new(at.X - pos.X, 0, at.Z - pos.Z)
				if flat.Magnitude > 0.1 then
					dir = flat.Unit
				end
			end
		end
		-- smooth the facing so turns at path corners don't snap
		v.dir = v.dir:Lerp(dir, math.min(1, dt * 8))
		if v.dir.Magnitude < 1e-3 then
			v.dir = dir
		end
		local look = v.dir.Unit

		-- animation
		local walkRate = if v.type == "Speedy" or v.type == "Ninja" then 1.6 else if v.type == "Baby" then 1.9 else 1
		if moving then
			v.phase += dt * speed * 0.9 * walkRate / v.def.Scale
		end
		local swing = math.sin(v.phase)
		local stepKick = math.abs(math.cos(v.phase))
		local bob = if moving then math.abs(swing) * 0.22 * v.def.Scale else 0
		if v.type == "Baby" and moving then
			bob *= 2.2 -- tiny hops
		end
		-- bobble head springs: every footfall flicks the head, the spring does the rest
		if moving and stepKick > 0.97 then
			v.headZ.v += (if swing > 0 then 1 else -1) * 3.5
			v.headX.v += 2
		end
		stepSpring(v.headX, dt, 140, 7)
		stepSpring(v.headZ, dt, 140, 7)
		stepSpring(v.lean, dt, 90, 10)

		local legAmp = if moving then 0.65 else 0
		local armAmp = if moving then 0.7 else 0.08
		local lArm = CFrame.Angles(-swing * armAmp, 0, 0)
		local rArm = CFrame.Angles(swing * armAmp, 0, 0)
		-- (on this rig +X swings an arm forward/up, -X swings it back)
		if v.gorilla and moving then -- knuckle walk: arms swing wide and reach forward
			lArm = CFrame.Angles(0.35 - swing * 0.55, 0, 0)
			rArm = CFrame.Angles(0.35 + swing * 0.55, 0, 0)
		end
		if attacking then -- pounding the stash (or the Bait Guy)
			local beat = math.sin(clock * 11 + id)
			lArm = CFrame.Angles(1.6 + beat * 1.1, 0, -0.2)
			rArm = CFrame.Angles(1.6 - beat * 1.1, 0, 0.2)
			bob = math.abs(beat) * 0.15
			if beat > 0.98 then
				v.headX.v += 5
			end
		end
		local throwA = clock - v.throwT
		if throwA < 0.8 then -- wind up and fling a banana
			local k = throwA / 0.8
			-- reach back over the shoulder, then whip it forward
			rArm = if k < 0.6 then CFrame.Angles(-k / 0.6 * 2.4, 0, 0) else CFrame.Angles(-2.4 + (k - 0.6) / 0.4 * 4.2, 0, 0)
		end
		local slamA = clock - v.slamT
		local slamLean = 0
		if slamA < 0.75 then -- both fists up... and down
			local k = slamA / 0.75
			local up = if k < 0.55 then k / 0.55 else 1 - (k - 0.55) / 0.45 * 1.4
			lArm = CFrame.Angles(3 * up, 0, 0)
			rArm = CFrame.Angles(3 * up, 0, 0)
			slamLean = if k < 0.55 then -0.2 * up else 0.35
		end
		local hipL = CFrame.Angles(swing * legAmp, 0, 0)
		local hipR = CFrame.Angles(-swing * legAmp, 0, 0)
		if hop > 0 then
			hipL = CFrame.Angles(0.9, 0, 0)
			hipR = CFrame.Angles(-0.6, 0, 0)
			lArm = CFrame.Angles(2.6, 0, -0.4)
			rArm = CFrame.Angles(2.6, 0, 0.4)
		end
		local waddle = if moving then swing * 0.1 else 0
		local forwardLean = (if v.gorilla and moving then 0.25 else if v.type == "Ninja" and moving then 0.3 else 0)
			+ slamLean - v.lean.x * 0.05
		if v.rootJoint then
			v.rootJoint.Transform = CFrame.new(0, bob, 0) * CFrame.Angles(-forwardLean, 0, waddle)
		end
		if v.neck then
			v.neck.Transform = CFrame.Angles(-v.headX.x * 0.03, 0, v.headZ.x * 0.035)
		end
		if v.lShoulder then
			v.lShoulder.Transform = lArm
		end
		if v.rShoulder then
			v.rShoulder.Transform = rArm
		end
		if v.lHip then
			v.lHip.Transform = hipL
		end
		if v.rHip then
			v.rHip.Transform = hipR
		end

		-- health bar
		local hp = cfg:GetAttribute("Hp") or 0
		if v.barFill then
			local ratio = math.clamp(hp / (cfg:GetAttribute("MaxHp") or 1), 0, 1)
			if hp ~= v.lastHp then
				v.lastHp = hp
				hpChanged(v, ratio)
			end
			if clock > v.trailHold and v.trailRatio > ratio then
				v.trailRatio = math.max(ratio, v.trailRatio - dt * 1.4)
			elseif v.trailRatio < ratio then
				v.trailRatio = ratio
			end
			v.barTrail.Size = UDim2.fromScale(v.trailRatio, 1)
			local shaking = clock < (v.shakeUntil or 0)
			v.barHolder.Position = if shaking
				then UDim2.new(0.5, math.random(-3, 3), 0.5, math.random(-2, 2))
				else UDim2.fromScale(0.5, 0.5)
		end
		-- net
		local netted = (cfg:GetAttribute("Netted") or 0) > t
		if netted ~= (v.net ~= nil) then
			if netted then
				local net = Fx.part({
					Shape = Enum.PartType.Ball,
					Size = Vector3.one * 4.4 * v.def.Scale,
					Color = Color3.fromRGB(240, 240, 220),
					Material = Enum.Material.ForceField,
					Transparency = 0.2,
					Parent = v.model,
				})
				v.net = net
			elseif v.net then
				v.net:Destroy()
				v.net = nil
			end
		end

		local cf = CFrame.lookAt(pos, pos + look) + Vector3.new(0, v.rootHeight + hop, 0)
		table.insert(roots, v.root)
		table.insert(cframes, cf)
		v.pos = pos
		if v.net then
			v.net.CFrame = cf
		end
	end
	if #roots > 0 then
		workspace:BulkMoveTo(roots, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end)

return EnemyView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Fx</string>
              <string name="Source"><![CDATA[-- Visual effect building blocks, all client-side and all made of parts/GUI (no uploaded
-- textures needed). The kill effects, hits and unit animations are composed from these.

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Fx = {}

local folder = Instance.new("Folder")
folder.Name = "ClientFx"
folder.Parent = workspace
Fx.folder = folder

local liveBricks = 0
local MAX_BRICKS = 420

local function tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
Fx.tween = tween

function Fx.part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = props.Parent or folder
	return p
end

local function rand(a: number, b: number): number
	return a + math.random() * (b - a)
end
Fx.rand = rand

local function randomUnit(): Vector3
	local v = Vector3.new(rand(-1, 1), rand(-1, 1), rand(-1, 1))
	return if v.Magnitude > 1e-3 then v.Unit else Vector3.yAxis
end
Fx.randomUnit = randomUnit

-- Studded toy bricks that burst out, bounce on the ground and shrink away. The signature kill.
function Fx.bricks(origin: Vector3, colors: { Color3 }, count: number, power: number, size: number?, upBias: number?)
	size = size or 1
	local budget = math.min(count, MAX_BRICKS - liveBricks)
	for _ = 1, budget do
		liveBricks += 1
		local s = (size :: number) * rand(0.7, 1.15)
		local long = math.random() < 0.5
		local b = Fx.part({
			Size = if long then Vector3.new(0.9, 0.45, 0.45) * s else Vector3.new(0.5, 0.45, 0.5) * s,
			CFrame = CFrame.new(origin + randomUnit() * 0.6 * (size :: number)) * CFrame.Angles(rand(0, 6), rand(0, 6), rand(0, 6)),
			Color = colors[math.random(1, #colors)],
			Material = Enum.Material.Plastic,
			TopSurface = Enum.SurfaceType.Studs,
			Anchored = false,
			CanCollide = true,
		})
		local dir = randomUnit()
		dir = Vector3.new(dir.X, math.abs(dir.Y) + (upBias or 0.8), dir.Z).Unit
		b.AssemblyLinearVelocity = dir * power * rand(0.55, 1.15)
		b.AssemblyAngularVelocity = randomUnit() * rand(8, 22)
		local life = rand(1.1, 1.8)
		task.delay(life, function()
			tween(b, 0.25, { Size = Vector3.zero, Transparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.delay(0.26, function()
				b:Destroy()
				liveBricks -= 1
			end)
		end)
	end
end

function Fx.brickBudgetLeft(): number
	return MAX_BRICKS - liveBricks
end

-- Soft dust puff (balls that swell and fade).
function Fx.poof(pos: Vector3, size: number, color: Color3?)
	for _ = 1, 6 do
		local s = size * rand(0.5, 0.9)
		local ball = Fx.part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * s * 0.4,
			Position = pos + randomUnit() * size * 0.35,
			Color = color or Color3.fromRGB(245, 235, 210),
			Transparency = 0.15,
		})
		tween(ball, rand(0.35, 0.55), { Size = Vector3.one * s, Transparency = 1,
			Position = ball.Position + Vector3.new(0, size * 0.4, 0) })
		Debris:AddItem(ball, 0.6)
	end
end

-- Flat expanding shockwave ring on the ground.
function Fx.ring(pos: Vector3, radius: number, color: Color3, time: number?, thickness: number?)
	local ring = Fx.part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness or 0.25, 1, 1),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.15,
	})
	tween(ring, time or 0.35, { Size = Vector3.new(thickness or 0.25, radius * 2, radius * 2), Transparency = 1 })
	Debris:AddItem(ring, (time or 0.35) + 0.05)
end

-- Fast little neon chips.
function Fx.sparks(pos: Vector3, color: Color3, count: number, speed: number?)
	for _ = 1, count do
		local chip = Fx.part({
			Size = Vector3.new(0.18, 0.18, 0.5),
			Color = color,
			Material = Enum.Material.Neon,
			CFrame = CFrame.lookAt(pos, pos + randomUnit()),
		})
		local dir = chip.CFrame.LookVector
		tween(chip, rand(0.15, 0.3), { CFrame = chip.CFrame + dir * (speed or 4) * rand(0.6, 1.2), Size = Vector3.new(0.05, 0.05, 0.15) })
		Debris:AddItem(chip, 0.32)
	end
end

local FONT = Enum.Font.LuckiestGuy

local function billboard(pos: Vector3, w: number, h: number): (BillboardGui, Part)
	local anchor = Fx.part({ Size = Vector3.one * 0.1, Position = pos, Transparency = 1 })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(w, h)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 260
	bb.Adornee = anchor
	bb.Parent = anchor
	return bb, anchor
end

-- Comic-book burst word ("POP!", "BONK!") that punches in and floats away.
function Fx.text(pos: Vector3, text: string, color: Color3, scale: number?)
	scale = scale or 1
	local bb, anchor = billboard(pos, 7 * (scale :: number), 3 * (scale :: number))
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Text = text
	label.Font = FONT
	label.TextScaled = true
	label.TextColor3 = color
	label.Rotation = rand(-14, 14)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 0.2
	uiScale.Parent = label
	label.Parent = bb
	tween(uiScale, 0.18, { Scale = 1.15 }, Enum.EasingStyle.Back)
	task.delay(0.18, function()
		tween(uiScale, 0.1, { Scale = 1 })
	end)
	tween(anchor, 0.8, { Position = pos + Vector3.new(0, 2.2, 0) }, Enum.EasingStyle.Quad)
	task.delay(0.5, function()
		tween(label, 0.3, { TextTransparency = 1 })
		tween(stroke, 0.3, { Transparency = 1 })
	end)
	Debris:AddItem(anchor, 0.85)
end

-- Damage number: pops, drifts sideways and up, fades. Crits are bigger and gold.
function Fx.number(pos: Vector3, amount: number, crit: boolean, color: Color3?)
	local s = if crit then 1.6 else 1
	local bb, anchor = billboard(pos + Vector3.new(rand(-0.8, 0.8), 0, rand(-0.8, 0.8)), 3 * s, 1.4 * s)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = if crit then `{amount}!` else tostring(amount)
	label.Font = FONT
	label.TextScaled = true
	label.TextColor3 = if crit then Color3.fromRGB(255, 200, 30) else (color or Color3.new(1, 1, 1))
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1.8
	uiScale.Parent = label
	label.Parent = bb
	tween(uiScale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	local drift = Vector3.new(rand(-1.5, 1.5), rand(2.2, 3.2), rand(-1.5, 1.5))
	tween(anchor, 0.7, { Position = anchor.Position + drift }, Enum.EasingStyle.Quart)
	task.delay(0.45, function()
		tween(label, 0.25, { TextTransparency = 1 })
		tween(stroke, 0.25, { Transparency = 1 })
	end)
	Debris:AddItem(anchor, 0.75)
end

-- Dizzy stars circling above something for `time` seconds.
function Fx.dizzy(getPos: () -> Vector3?, time: number)
	local stars = {}
	for i = 1, 3 do
		stars[i] = Fx.part({
			Size = Vector3.new(0.45, 0.45, 0.12),
			Color = Color3.fromRGB(255, 220, 60),
			Material = Enum.Material.Neon,
		})
	end
	local t0 = os.clock()
	local conn
	conn = game:GetService("RunService").RenderStepped:Connect(function()
		local t = os.clock() - t0
		local p = getPos()
		if t > time or not p then
			conn:Disconnect()
			for _, s in stars do
				s:Destroy()
			end
			return
		end
		for i, s in stars do
			local a = t * 7 + i * math.pi * 2 / 3
			s.CFrame = CFrame.new(p + Vector3.new(math.cos(a) * 1, 0.2 + math.sin(t * 9 + i) * 0.1, math.sin(a) * 1))
				* CFrame.Angles(0, -a, t * 6)
		end
	end)
end

-- Cartoon explosion: fireball, smoke, ring, sparks.
function Fx.explosion(pos: Vector3, radius: number)
	local core = Fx.part({ Shape = Enum.PartType.Ball, Size = Vector3.one, Position = pos,
		Color = Color3.fromRGB(255, 220, 90), Material = Enum.Material.Neon })
	tween(core, 0.18, { Size = Vector3.one * radius * 1.6 }, Enum.EasingStyle.Back)
	task.delay(0.15, function()
		tween(core, 0.25, { Transparency = 1, Color = Color3.fromRGB(255, 120, 30) })
	end)
	Debris:AddItem(core, 0.45)
	for _ = 1, 7 do
		local smoke = Fx.part({ Shape = Enum.PartType.Ball, Size = Vector3.one * radius * 0.4,
			Position = pos + randomUnit() * radius * 0.4, Color = Color3.fromRGB(90, 86, 84), Transparency = 0.2 })
		tween(smoke, rand(0.5, 0.8), { Size = Vector3.one * radius * rand(0.9, 1.3), Transparency = 1,
			Position = smoke.Position + Vector3.new(0, radius * 0.8, 0) })
		Debris:AddItem(smoke, 0.85)
	end
	Fx.ring(Vector3.new(pos.X, 0.2, pos.Z), radius * 1.3, Color3.fromRGB(255, 200, 80), 0.3, 0.3)
	Fx.sparks(pos, Color3.fromRGB(255, 180, 40), 10, radius * 1.5)
end

-- Colorful paper confetti that flutters down.
function Fx.confetti(pos: Vector3, count: number)
	local palette = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 214, 40), Color3.fromRGB(80, 200, 255),
		Color3.fromRGB(120, 230, 90), Color3.fromRGB(240, 120, 255) }
	for _ = 1, count do
		local c = Fx.part({
			Size = Vector3.new(0.35, 0.05, 0.25),
			Color = palette[math.random(1, #palette)],
			CFrame = CFrame.new(pos) * CFrame.Angles(rand(0, 6), rand(0, 6), rand(0, 6)),
		})
		local target = pos + Vector3.new(rand(-6, 6), rand(2, 7), rand(-6, 6))
		tween(c, 0.4, { Position = target }, Enum.EasingStyle.Quad)
		task.delay(0.4, function()
			tween(c, rand(1, 1.6), { Position = Vector3.new(target.X + rand(-2, 2), 0.1, target.Z + rand(-2, 2)),
				Orientation = Vector3.new(rand(0, 720), rand(0, 720), rand(0, 720)) }, Enum.EasingStyle.Sine)
		end)
		Debris:AddItem(c, 2.2)
	end
end

-- White hit flash on a model (pooled Highlights; Roblox caps how many can show at once).
local flashPool: { Highlight } = {}
local FLASH_MAX = 24
local flashLive = 0
function Fx.flash(model: Model, color: Color3?, time: number?)
	if flashLive >= FLASH_MAX then
		return
	end
	local h = table.remove(flashPool) or Instance.new("Highlight")
	flashLive += 1
	h.FillColor = color or Color3.new(1, 1, 1)
	h.OutlineTransparency = 1
	h.FillTransparency = 0.05
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Adornee = model
	h.Parent = model
	tween(h, time or 0.12, { FillTransparency = 1 })
	task.delay((time or 0.12) + 0.02, function()
		h.Parent = nil
		h.Adornee = nil
		flashLive -= 1
		table.insert(flashPool, h)
	end)
end

return Fx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- The HUD: wave pill + countdown, Banana Stash health, boss bar, cash counter, army count,
-- the unit hotbar with a placement ghost, and the tap-a-man panel for upgrading/selling.
-- Green pills with black text, chunky outlines: matching the game's toy look.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EnemyDefs = require(Shared.Config.Enemies)
local MapData = require(Shared.MapData)
local Net = require(Shared.Net)
local PathUtil = require(Shared.PathUtil)
local Units = require(Shared.Config.Units)
local Fx = require(script.Parent.Fx)
local Juice = require(script.Parent.Juice)

local Hud = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local state = ReplicatedStorage:WaitForChild("GameState")
local unitsFolder = workspace:WaitForChild("Units")
local PATHS = PathUtil.fromMapData(MapData)

local GREEN = Color3.fromRGB(120, 240, 150)
local INK = Color3.fromRGB(16, 18, 16)
local FONT = Enum.Font.LuckiestGuy
local FONT_UI = Enum.Font.FredokaOne

local gui = Instance.new("ScreenGui")
gui.Name = "Hud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function make(class: string, props: { [string]: any }): any
	local inst = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function stroke(parent: Instance, thickness: number?, color: Color3?)
	return make("UIStroke", { Thickness = thickness or 3, Color = color or INK, Parent = parent })
end

local function pill(parent: Instance, text: string, size: UDim2, pos: UDim2, bg: Color3?): TextLabel
	local label = make("TextLabel", {
		Size = size, Position = pos, AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = bg or GREEN,
		Text = text, Font = FONT, TextScaled = true, TextColor3 = INK, Parent = parent,
	})
	make("UICorner", { CornerRadius = UDim.new(0, 6), Parent = label })
	make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4), Parent = label })
	local s = stroke(label, 3)
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return label
end

-- ---------------------------------------------------------------- top: wave, stash, boss

local wavePill = pill(gui, "GET READY", UDim2.fromOffset(240, 46), UDim2.new(0.5, 0, 0, 10))
local subPill = pill(gui, "", UDim2.fromOffset(300, 30), UDim2.new(0.5, 0, 0, 62), Color3.fromRGB(30, 34, 30))
subPill.TextColor3 = GREEN

local stashFrame = make("Frame", { Size = UDim2.fromOffset(300, 26), Position = UDim2.new(0.5, 0, 0, 100),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(30, 30, 30), Parent = gui })
stroke(stashFrame, 3)
make("UICorner", { CornerRadius = UDim.new(0, 6), Parent = stashFrame })
local stashFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 214, 40),
	BorderSizePixel = 0, Parent = stashFrame })
make("UICorner", { CornerRadius = UDim.new(0, 6), Parent = stashFill })
make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "BANANA STASH", Font = FONT,
	TextScaled = true, TextColor3 = INK, ZIndex = 2, Parent = stashFrame })

local bossFrame = make("Frame", { Size = UDim2.fromOffset(460, 34), Position = UDim2.new(0.5, 0, 0, 136),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(30, 10, 10), Visible = false, Parent = gui })
stroke(bossFrame, 3)
local bossFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(230, 40, 40),
	BorderSizePixel = 0, Parent = bossFrame })
local bossName = make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Font = FONT,
	TextScaled = true, TextColor3 = Color3.new(1, 1, 1), ZIndex = 2, Parent = bossFrame })
stroke(bossName, 2)

-- ---------------------------------------------------------------- bottom: cash, men, hotbar

local cashFrame = make("Frame", { Size = UDim2.fromOffset(190, 50), Position = UDim2.new(0.5, 0, 1, -150),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Parent = gui })
local dollar = make("TextLabel", { Size = UDim2.fromOffset(46, 50), BackgroundColor3 = Color3.fromRGB(236, 190, 110),
	Text = "$", Font = FONT, TextScaled = true, TextColor3 = INK, Parent = cashFrame })
stroke(dollar, 3).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
local cashLabel = make("TextLabel", { Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(50, 0),
	BackgroundColor3 = Color3.fromRGB(20, 22, 20), Text = "0", Font = FONT, TextScaled = true, TextColor3 = Color3.new(1, 1, 1),
	TextXAlignment = Enum.TextXAlignment.Left, Parent = cashFrame })
stroke(cashLabel, 3).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
make("UIPadding", { PaddingLeft = UDim.new(0, 8), Parent = cashLabel })
local cashScale = make("UIScale", { Parent = cashFrame })
local menLabel = make("TextLabel", { Size = UDim2.fromOffset(120, 28), Position = UDim2.new(0.5, 110, 1, -139),
	AnchorPoint = Vector2.new(0, 0), BackgroundTransparency = 1, Text = "MEN 0/100", Font = FONT, TextScaled = true,
	TextColor3 = GREEN, Parent = gui })
stroke(menLabel, 2)

Juice.cashScreenPos = function(): Vector2
	local p, s = cashFrame.AbsolutePosition, cashFrame.AbsoluteSize
	return Vector2.new(p.X + 23, p.Y + s.Y / 2)
end
Juice.onCoinArrive = function(_amount: number)
	cashScale.Scale = 1.18
	TweenService:Create(cashScale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

local shownCash = 0
RunService.RenderStepped:Connect(function(dt)
	local actual = player:GetAttribute("Cash") or 0
	shownCash += (actual - shownCash) * math.min(1, dt * 8)
	if math.abs(actual - shownCash) < 0.5 then
		shownCash = actual
	end
	cashLabel.Text = tostring(math.floor(shownCash + 0.5))
	menLabel.Text = `MEN {player:GetAttribute("Units") or 0}/100`
end)

local toast = make("TextLabel", { Size = UDim2.fromOffset(420, 34), Position = UDim2.new(0.5, 0, 1, -196),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Text = "", Font = FONT_UI, TextScaled = true,
	TextColor3 = Color3.fromRGB(255, 120, 100), TextTransparency = 1, Parent = gui })
local toastStroke = stroke(toast, 2)
toastStroke.Transparency = 1
local function showToast(text: string, color: Color3?)
	toast.Text = text
	toast.TextColor3 = color or Color3.fromRGB(255, 120, 100)
	toast.TextTransparency = 0
	toastStroke.Transparency = 0
	local token = {}
	Hud._toast = token
	task.delay(1.4, function()
		if Hud._toast == token then
			TweenService:Create(toast, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			TweenService:Create(toastStroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		end
	end)
end
Hud.toast = showToast

-- hotbar
local order = {}
for id, def in Units do
	table.insert(order, { id = id, def = def })
end
table.sort(order, function(a, b)
	return a.def.Order < b.def.Order
end)

local bar = make("Frame", { Size = UDim2.fromOffset(#order * 86, 88), Position = UDim2.new(0.5, 0, 1, -94),
	AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Parent = gui })
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
	HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = bar })
local slots = {}
local selected: string? = nil

local function setSelected(id: string?)
	selected = id
	for sid, b in slots do
		b.BackgroundColor3 = if sid == id then Color3.fromRGB(255, 220, 80) else GREEN
	end
	Hud.onSelectUnit(id)
end

for i, entry in order do
	local b = make("TextButton", { Size = UDim2.fromOffset(80, 86), BackgroundColor3 = GREEN, Text = "", AutoButtonColor = true,
		LayoutOrder = i, Parent = bar })
	make("UICorner", { CornerRadius = UDim.new(0, 8), Parent = b })
	stroke(b, 3).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	make("TextLabel", { Size = UDim2.new(1, -6, 0, 18), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1,
		Text = tostring(i), Font = FONT, TextScaled = true, TextColor3 = INK, TextXAlignment = Enum.TextXAlignment.Left, Parent = b })
	make("TextLabel", { Size = UDim2.new(1, -6, 0, 34), Position = UDim2.fromOffset(3, 20), BackgroundTransparency = 1,
		Text = entry.def.DisplayName, Font = FONT_UI, TextScaled = true, TextColor3 = INK, TextWrapped = true, Parent = b })
	make("TextLabel", { Size = UDim2.new(1, -6, 0, 22), Position = UDim2.new(0, 3, 1, -26), BackgroundTransparency = 1,
		Text = `${entry.def.Levels[1].Cost}`, Font = FONT, TextScaled = true, TextColor3 = Color3.fromRGB(30, 90, 30), Parent = b })
	b.Activated:Connect(function()
		Juice.sound("Ui")
		setSelected(if selected == entry.id then nil else entry.id)
	end)
	slots[entry.id] = b
end

-- ---------------------------------------------------------------- placement ghost

local ghostRing = Fx.part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 2, 2), Material = Enum.Material.Neon,
	Transparency = 0.6, Parent = nil })
local ghostBody = Fx.part({ Size = Vector3.new(2, 5, 1.2), Transparency = 0.45, Material = Enum.Material.Neon, Parent = nil })
local ghostPos: Vector3? = nil
local ghostOk = false

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Include

local function mapRoot(): Instance
	return workspace:FindFirstChild("Map") or workspace
end

local function pointerRay(screen: Vector2?): RaycastResult?
	local p = screen or UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(p.X, p.Y)
	raycastParams.FilterDescendantsInstances = { mapRoot() }
	return workspace:Raycast(ray.Origin, ray.Direction * 600, raycastParams)
end

local function localProblem(pos: Vector3, hit: RaycastResult?): string?
	local area = MapData.BuildArea
	if pos.X < area.Min.X or pos.X > area.Max.X or pos.Z < area.Min.Z or pos.Z > area.Max.Z then
		return "Out of bounds"
	end
	if not hit or not (hit.Instance.Name:match("^Sand%d") or hit.Instance.Name:match("^Plaza%d")) or math.abs(hit.Position.Y) > 0.6 then
		return "Can't stand there"
	end
	if PathUtil.distanceToPaths(PATHS, pos) < MapData.PathWidth / 2 + 1 then
		return "Too close to the path"
	end
	local base = Vector3.new(MapData.Base.X, 0, MapData.Base.Z)
	if (Vector3.new(pos.X, 0, pos.Z) - base).Magnitude < 5 then
		return "That's the Banana Stash"
	end
	for _, m in unitsFolder:GetChildren() do
		if m:IsA("Model") then
			local p = m:GetPivot().Position
			if (Vector3.new(p.X, 0, p.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude < 2.8 then
				return "Too close to another man"
			end
		end
	end
	return nil
end

local function updateGhost(screen: Vector2?)
	if not selected then
		return
	end
	local hit = pointerRay(screen)
	if not hit then
		ghostPos = nil
		ghostRing.Parent = nil
		ghostBody.Parent = nil
		return
	end
	local pos = Vector3.new(hit.Position.X, 0, hit.Position.Z)
	ghostPos = pos
	ghostOk = localProblem(pos, hit) == nil
	local range = Units[selected].Levels[1].Range
	local color = if ghostOk then Color3.fromRGB(120, 255, 120) else Color3.fromRGB(255, 80, 80)
	ghostRing.Color = color
	ghostBody.Color = color
	ghostRing.Size = Vector3.new(0.15, range * 2, range * 2)
	ghostRing.CFrame = CFrame.new(pos + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ghostBody.CFrame = CFrame.new(pos + Vector3.new(0, 2.6, 0))
	ghostRing.Parent = Fx.folder
	ghostBody.Parent = Fx.folder
end

Hud.onSelectUnit = function(id: string?)
	if not id then
		ghostRing.Parent = nil
		ghostBody.Parent = nil
	else
		Hud.closePanel()
		updateGhost()
	end
end

local function tryPlace(screen: Vector2?)
	updateGhost(screen)
	if not (selected and ghostPos) then
		return
	end
	local unitId = selected
	local ok, msg = Net.func("PlaceUnit"):InvokeServer(unitId, ghostPos)
	if not ok then
		Juice.sound("Deny")
		showToast(msg or "Can't place there")
	end
end

-- ---------------------------------------------------------------- unit panel

local panel = make("Frame", { Size = UDim2.fromOffset(250, 210), Position = UDim2.new(1, -16, 0.5, 0),
	AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = Color3.fromRGB(26, 30, 26), Visible = false, Parent = gui })
make("UICorner", { CornerRadius = UDim.new(0, 10), Parent = panel })
stroke(panel, 3, GREEN)
local panelTitle = make("TextLabel", { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), BackgroundTransparency = 1,
	Font = FONT, TextScaled = true, TextColor3 = GREEN, Text = "", Parent = panel })
local panelInfo = make("TextLabel", { Size = UDim2.new(1, -20, 0, 70), Position = UDim2.fromOffset(10, 44), BackgroundTransparency = 1,
	Font = FONT_UI, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = panel })
local upButton = make("TextButton", { Size = UDim2.new(1, -20, 0, 38), Position = UDim2.fromOffset(10, 120),
	BackgroundColor3 = GREEN, Font = FONT, TextScaled = true, TextColor3 = INK, Text = "UPGRADE", Parent = panel })
make("UICorner", { CornerRadius = UDim.new(0, 6), Parent = upButton })
local sellButton = make("TextButton", { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 166),
	BackgroundColor3 = Color3.fromRGB(240, 110, 90), Font = FONT, TextScaled = true, TextColor3 = INK, Text = "SELL", Parent = panel })
make("UICorner", { CornerRadius = UDim.new(0, 6), Parent = sellButton })
local panelRing = Fx.part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 2, 2), Material = Enum.Material.Neon,
	Color = Color3.fromRGB(255, 220, 80), Transparency = 0.65, Parent = nil })
local panelUid: number? = nil

local function refreshPanel()
	local model = panelUid and unitsFolder:FindFirstChild(tostring(panelUid))
	if not model then
		panel.Visible = false
		panelRing.Parent = nil
		return
	end
	local unitId, level = model:GetAttribute("Unit"), model:GetAttribute("Level")
	local def = Units[unitId]
	local cur = def.Levels[level]
	local nxt = def.Levels[level + 1]
	panelTitle.Text = `{def.DisplayName}  LV{level}`
	local stats = if cur.Damage > 0 then `DMG {cur.Damage}  RANGE {cur.Range}\n` else ""
	panelInfo.Text = stats .. def.Blurb
	upButton.Text = if nxt then `UPGRADE  ${nxt.Cost}` else "MAX LEVEL"
	upButton.BackgroundColor3 = if nxt then GREEN else Color3.fromRGB(90, 90, 90)
	local spent = 0
	for i = 1, level do
		spent += def.Levels[i].Cost
	end
	sellButton.Text = `SELL  +${math.floor(spent * 0.6)}`
	local pos = model:GetPivot().Position
	panelRing.Size = Vector3.new(0.15, cur.Range * 2, cur.Range * 2)
	panelRing.CFrame = CFrame.new(pos.X, 0.15, pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
	panelRing.Parent = Fx.folder
	panel.Visible = true
end

function Hud.closePanel()
	panelUid = nil
	panel.Visible = false
	panelRing.Parent = nil
end

local function openPanel(uid: number)
	panelUid = uid
	refreshPanel()
end

upButton.Activated:Connect(function()
	if not panelUid then
		return
	end
	local ok, msg = Net.func("UpgradeUnit"):InvokeServer(panelUid)
	if not ok then
		Juice.sound("Deny")
		showToast(msg or "Can't upgrade")
	end
	task.wait(0.15)
	refreshPanel()
end)
sellButton.Activated:Connect(function()
	if not panelUid then
		return
	end
	local uid = panelUid
	Hud.closePanel()
	Net.func("SellUnit"):InvokeServer(uid)
end)

local function unitUnder(screen: Vector2?): number?
	local p = screen or UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(p.X, p.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { unitsFolder }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, params)
	local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
	while model and model.Parent ~= unitsFolder do
		model = model:FindFirstAncestorOfClass("Model")
	end
	return model and model:GetAttribute("Uid")
end

-- ---------------------------------------------------------------- input

UserInputService.InputChanged:Connect(function(input)
	if selected and input.UserInputType == Enum.UserInputType.MouseMovement then
		updateGhost()
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if n >= 1 and n <= #order then
			setSelected(if selected == order[n].id then nil else order[n].id)
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.Escape then
			setSelected(nil)
			Hud.closePanel()
		end
		return
	end
	local isClick = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	if not isClick then
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			setSelected(nil)
		end
		return
	end
	local screen = if input.UserInputType == Enum.UserInputType.Touch then Vector2.new(input.Position.X, input.Position.Y) else nil
	if selected then
		tryPlace(screen)
	else
		local uid = unitUnder(screen)
		if uid then
			Juice.sound("Ui")
			openPanel(uid)
		else
			Hud.closePanel()
		end
	end
end)

-- ---------------------------------------------------------------- state + events

local bossId: number? = nil
RunService.RenderStepped:Connect(function()
	local phase = state:GetAttribute("Phase")
	local wave = state:GetAttribute("Wave") or 0
	local total = state:GetAttribute("TotalWaves") or 100
	if phase == "Intro" then
		wavePill.Text = "GET READY"
		subPill.Text = "THE SQUAD IS LANDING..."
	elseif phase == "Intermission" then
		local left = math.max(0, math.ceil((state:GetAttribute("NextWaveAt") or 0) - workspace:GetServerTimeNow()))
		wavePill.Text = if wave == 0 then "GET READY" else `WAVE {wave} CLEAR`
		subPill.Text = `NEXT WAVE IN {left}`
	elseif phase == "Wave" then
		wavePill.Text = `WAVE {wave}`
		subPill.Text = `SURVIVE WAVES {math.max(0, wave - 1)} / {total}`
	elseif phase == "GameOver" then
		wavePill.Text = "GAME OVER"
		subPill.Text = "RESTARTING..."
	elseif phase == "Victory" then
		wavePill.Text = "VICTORY!"
		subPill.Text = "100 MEN BEAT THE GORILLA"
	end
	local hp, maxHp = state:GetAttribute("BaseHp") or 0, state:GetAttribute("BaseMaxHp") or 1
	stashFill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
	-- boss bar
	if bossId then
		local cfg = ReplicatedStorage.Enemies:FindFirstChild(tostring(bossId))
		if cfg then
			bossFill.Size = UDim2.fromScale(math.clamp((cfg:GetAttribute("Hp") or 0) / (cfg:GetAttribute("MaxHp") or 1), 0, 1), 1)
		else
			bossId = nil
			bossFrame.Visible = false
		end
	end
	if panelUid then
		refreshPanel()
	end
end)

ReplicatedStorage:WaitForChild("Enemies").ChildAdded:Connect(function(cfg)
	local def = EnemyDefs[cfg:GetAttribute("Type") or ""]
	if def and def.Boss then
		bossId = tonumber(cfg.Name)
		bossName.Text = def.DisplayName
		bossFrame.Visible = true
	end
end)

-- ---------------------------------------------------------------- intro hand-off

-- The intro cutscene hides the HUD while it plays.
function Hud.setVisible(on: boolean)
	gui.Enabled = on
end

-- After the intro: the HUD pops in, the goal is called out, and a marker shows where to put
-- the first man until one has been placed.
local TUTORIAL_SPOT = Vector3.new(13, 0, 22)
function Hud.introFinished()
	local pop = make("UIScale", { Scale = 0.6, Parent = wavePill })
	TweenService:Create(pop, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	Juice.callout("PROTECT THE BANANA STASH!", Color3.fromRGB(255, 214, 40), 2.2)
	Juice.sound("Horn")
	if (player:GetAttribute("Units") or 0) > 0 then
		return
	end
	local anchor = Fx.part({ Size = Vector3.new(0.2, 0.2, 0.2), Position = TUTORIAL_SPOT + Vector3.new(0, 6, 0), Transparency = 1 })
	local bb = make("BillboardGui", { Size = UDim2.fromScale(9, 4.5), AlwaysOnTop = true, LightInfluence = 0, Adornee = anchor,
		Parent = anchor })
	local label = make("TextLabel", { Size = UDim2.fromScale(1, 0.55), BackgroundTransparency = 1, Font = FONT, TextScaled = true,
		Text = "PLACE A BRAWLER HERE", TextColor3 = GREEN, Parent = bb })
	stroke(label, 3)
	local arrow = make("TextLabel", { Size = UDim2.fromScale(1, 0.45), Position = UDim2.fromScale(0, 0.55), BackgroundTransparency = 1,
		Font = FONT, TextScaled = true, Text = "V", TextColor3 = GREEN, Parent = bb })
	stroke(arrow, 3)
	showToast("Press 1 (or tap BRAWLER), then click the marker", GREEN)
	local t0 = os.clock()
	local nextRing = 0
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if (player:GetAttribute("Units") or 0) > 0 or t > 40 then
			conn:Disconnect()
			anchor:Destroy()
			return
		end
		anchor.Position = TUTORIAL_SPOT + Vector3.new(0, 6 + math.abs(math.sin(t * 4)) * 1.2, 0)
		if t >= nextRing then
			nextRing = t + 0.9
			Fx.ring(TUTORIAL_SPOT + Vector3.new(0, 0.3, 0), 4, GREEN, 0.8, 0.25)
		end
	end)
end

function Hud.gameEvent(kind: string, a: any, b: any)
	if kind == "WaveStart" then
		Juice.callout(`WAVE {a}`, GREEN, 1.2)
		Juice.sound("Horn")
	elseif kind == "WaveClear" then
		Juice.callout("WAVE CLEARED!", Color3.fromRGB(255, 220, 80), 1.4)
		showToast(`+${b} wave bonus`, GREEN)
		Fx.confetti(camera.CFrame.Position + camera.CFrame.LookVector * 14 + Vector3.new(0, 4, 0), 30)
	elseif kind == "BossIncoming" then
		Juice.callout(`{b} IS COMING`, Color3.fromRGB(255, 60, 40), 2.2)
		Juice.sound("Roar", nil, 0.8)
		Juice.shake(0.6)
	elseif kind == "BaseHit" then
		stashFrame.BackgroundColor3 = Color3.fromRGB(160, 20, 20)
		task.delay(0.08, function()
			stashFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		end)
	elseif kind == "GameOver" then
		Juice.callout("THE MONKEYS GOT THE BANANAS", Color3.fromRGB(255, 80, 60), 4)
		Juice.shake(0.8)
	elseif kind == "Victory" then
		Juice.callout("VICTORY!", Color3.fromRGB(255, 220, 80), 5)
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Juice</string>
              <string name="Source"><![CDATA[-- Game feel: sounds with pitch variety, trauma-based camera shake, FOV punches, the kill combo
-- with escalating callouts, and coins that fly from a kill into the cash counter.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))
local Fx = require(script.Parent.Fx)

local Juice = {}

local camera = workspace.CurrentCamera
local player = Players.LocalPlayer

-- ---------------------------------------------------------------- sound

local lastPlayed: { [string]: number } = {}
local playingCount: { [string]: number } = {}
local MAX_SAME = 5

-- Plays a named sound (Sounds.luau). pos makes it 3D. pitch scales speed (1 = normal).
function Juice.sound(name: string, pos: Vector3?, pitch: number?, volume: number?)
	local def = Sounds[name]
	if not def then
		return
	end
	local t = os.clock()
	if (playingCount[name] or 0) >= MAX_SAME or t - (lastPlayed[name] or 0) < 0.025 then
		return -- stops 40 pops in one frame turning into a wall of noise
	end
	lastPlayed[name] = t
	playingCount[name] = (playingCount[name] or 0) + 1
	local s = Instance.new("Sound")
	s.SoundId = if def.Id then `rbxassetid://{def.Id}` else def.Fallback
	s.Volume = def.Volume * (volume or 1)
	s.PlaybackSpeed = (pitch or 1) * Fx.rand(0.94, 1.06)
	if pos then
		local holder = Fx.part({ Size = Vector3.one * 0.1, Position = pos, Transparency = 1 })
		s.RollOffMinDistance = 20
		s.RollOffMaxDistance = 260
		s.Parent = holder
		task.delay(4, function()
			holder:Destroy()
		end)
	else
		s.Parent = SoundService
	end
	s:Play()
	s.Ended:Once(function()
		playingCount[name] = math.max(0, (playingCount[name] or 1) - 1)
		if s.Parent == SoundService then
			s:Destroy()
		end
	end)
	task.delay(4, function()
		if s.Parent then
			playingCount[name] = math.max(0, (playingCount[name] or 1) - 1)
			s:Destroy()
		end
	end)
end

-- ---------------------------------------------------------------- camera shake + punch

local trauma = 0
local seed = math.random() * 100

-- Adds shake (0..1). Hits near the camera count more than far ones.
function Juice.shake(amount: number, at: Vector3?)
	if at then
		local d = (camera.CFrame.Position - at).Magnitude
		amount *= math.clamp(1.4 - d / 120, 0.15, 1)
	end
	trauma = math.min(1, trauma + amount)
end

local fovKick = 0
Juice.baseFov = 70 -- the intro cutscene drives this; the kick is added on top
function Juice.punch(amount: number)
	fovKick = math.max(fovKick, amount)
end

RunService:BindToRenderStep("JuiceCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if trauma > 0 then
		local s = trauma * trauma
		local t = os.clock() * 22
		local rx = math.noise(seed, t) * 0.035 * s
		local ry = math.noise(seed + 10, t) * 0.035 * s
		local rz = math.noise(seed + 20, t) * 0.05 * s
		camera.CFrame *= CFrame.Angles(rx, ry, rz)
		trauma = math.max(0, trauma - dt * 1.6)
	end
	if fovKick > 0.01 then
		camera.FieldOfView = Juice.baseFov + fovKick
		fovKick *= math.exp(-dt * 9)
	elseif camera.FieldOfView ~= Juice.baseFov then
		camera.FieldOfView = Juice.baseFov
	end
end)

-- ---------------------------------------------------------------- HUD hooks (set by Hud)

Juice.cashScreenPos = function(): Vector2
	local vp = camera.ViewportSize
	return Vector2.new(vp.X / 2, vp.Y - 70)
end
Juice.onCoinArrive = function(_amount: number) end

-- ---------------------------------------------------------------- coins

-- Gold studded coins burst out of a kill, hang for a beat, then fly into the cash counter.
function Juice.coins(pos: Vector3, count: number, reward: number)
	count = math.clamp(count, 1, 14)
	local per = reward / count
	for i = 1, count do
		local coin = Fx.part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.18, 0.75, 0.75),
			Color = Color3.fromRGB(255, 200, 40),
			Material = Enum.Material.Neon,
			CFrame = CFrame.new(pos),
		})
		local burst = pos + Vector3.new(Fx.rand(-2.5, 2.5), Fx.rand(2, 4.5), Fx.rand(-2.5, 2.5))
		Fx.tween(coin, 0.28, { Position = burst }, Enum.EasingStyle.Quad)
		task.delay(0.28 + i * 0.03, function()
			local start = coin.Position
			local t0 = os.clock()
			local dur = 0.42
			local conn
			conn = RunService.RenderStepped:Connect(function()
				local a = math.min(1, (os.clock() - t0) / dur)
				local sp = Juice.cashScreenPos()
				local ray = camera:ViewportPointToRay(sp.X, sp.Y)
				local target = ray.Origin + ray.Direction * 4
				local e = a * a
				coin.CFrame = CFrame.new(start:Lerp(target, e)) * CFrame.Angles(0, os.clock() * 20, math.pi / 2)
				coin.Size = Vector3.new(0.18, 0.75, 0.75) * (1 - e * 0.6)
				if a >= 1 then
					conn:Disconnect()
					coin:Destroy()
					Juice.sound("Coin", nil, 1 + i * 0.04, 0.6)
					Juice.onCoinArrive(per)
				end
			end)
		end)
	end
end

-- ---------------------------------------------------------------- combo

local CALLOUTS = {
	{ 5, "MONKEY MASH!" },
	{ 10, "BANANA SPLIT!" },
	{ 20, "BARREL OF MONKEYS!" },
	{ 35, "APE-POCALYPSE!" },
	{ 50, "UNSTOPPABLE!" },
	{ 75, "MONKEY MELTDOWN!" },
	{ 100, "100 MEN STRONG!!" },
}
local COMBO_WINDOW = 1.6

local gui = Instance.new("ScreenGui")
gui.Name = "Juice"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")

local comboLabel = Instance.new("TextLabel")
comboLabel.AnchorPoint = Vector2.new(1, 0.5)
comboLabel.Position = UDim2.new(1, -30, 0.42, 0)
comboLabel.Size = UDim2.fromOffset(260, 70)
comboLabel.BackgroundTransparency = 1
comboLabel.Font = Enum.Font.LuckiestGuy
comboLabel.TextScaled = true
comboLabel.TextColor3 = Color3.fromRGB(255, 230, 80)
comboLabel.TextXAlignment = Enum.TextXAlignment.Right
comboLabel.Visible = false
comboLabel.Rotation = -6
local comboStroke = Instance.new("UIStroke")
comboStroke.Thickness = 4
comboStroke.Parent = comboLabel
local comboScale = Instance.new("UIScale")
comboScale.Parent = comboLabel
comboLabel.Parent = gui

local comboBar = Instance.new("Frame")
comboBar.AnchorPoint = Vector2.new(1, 0)
comboBar.Position = UDim2.new(1, 0, 1, 2)
comboBar.Size = UDim2.new(1, 0, 0, 6)
comboBar.BackgroundColor3 = Color3.fromRGB(255, 230, 80)
comboBar.BorderSizePixel = 0
comboBar.Parent = comboLabel

local callout = Instance.new("TextLabel")
callout.AnchorPoint = Vector2.new(0.5, 0.5)
callout.Position = UDim2.fromScale(0.5, 0.3)
callout.Size = UDim2.fromOffset(700, 110)
callout.BackgroundTransparency = 1
callout.Font = Enum.Font.LuckiestGuy
callout.TextScaled = true
callout.TextColor3 = Color3.fromRGB(255, 120, 40)
callout.Visible = false
local calloutStroke = Instance.new("UIStroke")
calloutStroke.Thickness = 5
calloutStroke.Parent = callout
local calloutScale = Instance.new("UIScale")
calloutScale.Parent = callout
callout.Parent = gui

local combo = 0
local comboExpires = 0
local nextCallout = 1

-- Big center-screen shout (also used by the HUD for banners).
function Juice.callout(text: string, color: Color3?, hold: number?)
	callout.Text = text
	callout.TextColor3 = color or Color3.fromRGB(255, 120, 40)
	callout.Visible = true
	callout.TextTransparency = 0
	calloutStroke.Transparency = 0
	callout.Rotation = Fx.rand(-5, 5)
	calloutScale.Scale = 2.4
	TweenService:Create(calloutScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local token = {}
	Juice._calloutToken = token
	task.delay(hold or 1.1, function()
		if Juice._calloutToken ~= token then
			return
		end
		TweenService:Create(callout, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		TweenService:Create(calloutStroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()
	end)
end

function Juice.kill(boss: boolean)
	local t = os.clock()
	if t > comboExpires then
		combo = 0
		nextCallout = 1
	end
	combo += if boss then 10 else 1
	comboExpires = t + COMBO_WINDOW
	if combo >= 2 then
		comboLabel.Visible = true
		comboLabel.Text = `x{combo} COMBO`
		local heat = math.clamp(combo / 50, 0, 1)
		comboLabel.TextColor3 = Color3.fromRGB(255, 230, 80):Lerp(Color3.fromRGB(255, 60, 40), heat)
		comboScale.Scale = 1.35 + math.min(combo, 40) * 0.01
		TweenService:Create(comboScale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		Juice.sound("Combo", nil, 0.8 + math.min(combo, 40) * 0.025, 0.7)
	end
	local c = CALLOUTS[nextCallout]
	if c and combo >= c[1] then
		nextCallout += 1
		Juice.callout(c[2])
		Juice.shake(0.25)
		Juice.punch(4)
	end
end

RunService.RenderStepped:Connect(function()
	if comboLabel.Visible then
		local left = comboExpires - os.clock()
		if left <= 0 then
			comboLabel.Visible = false
			combo = 0
			nextCallout = 1
		else
			comboBar.Size = UDim2.new(left / COMBO_WINDOW, 0, 0, 6)
		end
	end
end)

return Juice
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">KillFx</string>
              <string name="Source"><![CDATA[-- How monkeys die. The style follows whatever landed the killing blow:
--   Bonk    (punches)  bobble head pops off with a boing, bounces away and bursts; body crumbles
--   Whack   (axe)      batted off sideways, tumbling, then bursts into bricks
--   Pop     (pebbles, bullets, taunts)  squash-and-stretch balloon pop into a brick burst
--   Launch  (grenades) blasted up into the sky screaming, bursts with a twinkle
--   Caught  (nets)     shrinks into the net and poofs
--   Boss               chain of explosions, then a giant brick shower, confetti and a coin fountain
-- Every kill also feeds the combo, shakes the camera a little and sends coins to the cash counter.
-- Everything is anchored and moved by our own little physics step: cheap, smooth, deterministic.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EnemyDefs = require(Shared.Config.Enemies)
local EnemyView = require(script.Parent.EnemyView)
local Fx = require(script.Parent.Fx)
local Juice = require(script.Parent.Juice)

local KillFx = {}

local GRAVITY = 90

-- ---------------------------------------------------------------- tiny physics for flying bits

type Flyer = {
	part: BasePart,
	pos: Vector3,
	vel: Vector3,
	rot: CFrame,
	spin: Vector3,
	floor: number,
	bounce: number,
	bounces: number,
	life: number,
	onBounce: ((Flyer) -> ())?,
	onDone: ((Flyer) -> ())?,
	trail: boolean?,
	trailT: number,
}
local flyers: { Flyer } = {}

local function fly(part: BasePart, vel: Vector3, spin: Vector3, opts: { [string]: any }?): Flyer
	part.Anchored = true
	local o = opts or {}
	local f: Flyer = {
		part = part,
		pos = part.Position,
		vel = vel,
		rot = part.CFrame.Rotation,
		spin = spin,
		floor = o.floor or 0,
		bounce = o.bounce or 0.45,
		bounces = 0,
		life = o.life or 1.2,
		onBounce = o.onBounce,
		onDone = o.onDone,
		trail = o.trail,
		trailT = 0,
	}
	table.insert(flyers, f)
	return f
end

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 1 / 20)
	local i = 1
	while i <= #flyers do
		local f = flyers[i]
		f.life -= dt
		if f.life <= 0 or not f.part.Parent then
			table.remove(flyers, i)
			if f.onDone and f.part.Parent then
				f.onDone(f)
			end
			continue
		end
		f.vel -= Vector3.new(0, GRAVITY * dt, 0)
		f.pos += f.vel * dt
		if f.spin.Magnitude > 0 then
			f.rot = CFrame.fromAxisAngle(f.spin.Unit, f.spin.Magnitude * dt) * f.rot
		end
		local half = f.part.Size.Y * 0.5
		if f.pos.Y < f.floor + half and f.vel.Y < 0 then
			f.pos = Vector3.new(f.pos.X, f.floor + half, f.pos.Z)
			f.vel = Vector3.new(f.vel.X * 0.6, -f.vel.Y * f.bounce, f.vel.Z * 0.6)
			f.spin *= 0.6
			f.bounces += 1
			if f.onBounce then
				f.onBounce(f)
			end
		end
		if f.trail then
			f.trailT -= dt
			if f.trailT <= 0 then
				f.trailT = 0.05
				Fx.poof(f.pos, 1.4, Color3.fromRGB(230, 230, 230))
			end
		end
		f.part.CFrame = CFrame.new(f.pos) * f.rot
		i += 1
	end
end)

-- ---------------------------------------------------------------- helpers

local function palette(def): { Color3 }
	local c = def.Colors
	local out = { c.Fur, c.Fur, c.Fur, c.Cream, c.Cream }
	if c.Accent then
		table.insert(out, c.Accent)
	end
	return out
end

local function visibleParts(model: Model): { BasePart }
	local out = {}
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Transparency < 1 then
			table.insert(out, p)
		end
	end
	return out
end

-- Bursts a whole model into bricks, part by part, and removes it.
local function shatter(model: Model, def, power: number, budgetScale: number)
	local colors = palette(def)
	for _, p in visibleParts(model) do
		local volume = p.Size.X * p.Size.Y * p.Size.Z
		local n = math.clamp(math.floor(volume * 2.2 * budgetScale), 2, 26)
		Fx.bricks(p.Position, colors, n, power, math.clamp(def.Scale, 0.8, 1.6))
	end
	local cf = model:GetPivot()
	Fx.poof(cf.Position, 3.2 * def.Scale)
	model:Destroy()
end

local function headOf(model: Model): BasePart?
	return model:FindFirstChild("Head") :: BasePart?
end

-- ---------------------------------------------------------------- styles

local function styleBonk(view, pos: Vector3, budget: number)
	local model, def = view.model, view.def
	local head = headOf(model)
	local neck = model:FindFirstChild("Neck", true)
	Fx.flash(model, nil, 0.08)
	Fx.text(pos + Vector3.new(0, 5 * def.Scale, 0), "BONK!", Color3.fromRGB(255, 230, 60))
	Juice.sound("Bonk", pos, 1.15 / def.Scale)
	if head and neck then
		neck:Destroy()
		head.Parent = Fx.folder
		Juice.sound("Boing", pos, 1.25 / def.Scale)
		local away = -(view.dir or Vector3.zAxis)
		local side = Vector3.new(-away.Z, 0, away.X) * Fx.rand(-6, 6)
		fly(head, away * Fx.rand(9, 14) + side + Vector3.new(0, Fx.rand(30, 38), 0),
			Fx.randomUnit() * Fx.rand(10, 18), {
				bounce = 0.55,
				life = 1.5,
				onBounce = function(f)
					Juice.sound("Boing", f.pos, 1.4 + f.bounces * 0.15, 0.6)
					Fx.poof(f.pos, 1.4)
					if f.bounces >= 2 then
						f.life = 0.01
					end
				end,
				onDone = function(f)
					Fx.bricks(f.pos, { def.Colors.Cream, def.Colors.Fur, def.Colors.Fur }, math.floor(10 * budget), 26, def.Scale)
					Fx.text(f.pos + Vector3.new(0, 2, 0), "POP!", Color3.fromRGB(255, 255, 255), 0.8)
					Juice.sound("Pop", f.pos, 1.3)
					f.part:Destroy()
				end,
			})
	end
	-- body wobbles for a beat, then crumbles
	task.delay(0.12, function()
		if model.Parent then
			shatter(model, def, 22, budget)
		end
	end)
end

local function styleWhack(view, pos: Vector3, budget: number)
	local model, def = view.model, view.def
	local root = model.PrimaryPart
	Fx.flash(model, nil, 0.08)
	Fx.text(pos + Vector3.new(0, 5 * def.Scale, 0), "WHACK!", Color3.fromRGB(255, 140, 40))
	Juice.sound("Chop", pos, 1.1 / def.Scale)
	Juice.sound("Squeak", pos, Fx.rand(1.1, 1.4))
	if not root then
		shatter(model, def, 30, budget)
		return
	end
	local side = Fx.randomUnit()
	side = Vector3.new(side.X, 0, side.Z).Unit
	fly(root, side * Fx.rand(18, 26) + Vector3.new(0, Fx.rand(22, 30), 0), Vector3.new(side.Z, 0, -side.X) * 14, {
		floor = view.rootHeight * 0.4,
		bounce = 0.35,
		life = 0.75,
		onBounce = function(f)
			Juice.sound("Thud", f.pos, 1.2)
			Fx.poof(f.pos, 2.4)
		end,
		onDone = function(_f)
			shatter(model, def, 30, budget)
			Juice.sound("Pop", root.Position, 1.1)
		end,
	})
end

local function stylePop(view, pos: Vector3, budget: number)
	local model, def = view.model, view.def
	Fx.flash(model, nil, 0.1)
	-- squash... stretch... POP
	local base = def.Scale
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = (os.clock() - t0) / 0.09
		if not model.Parent then
			conn:Disconnect()
			return
		end
		if a >= 1 then
			conn:Disconnect()
			local center = model:GetPivot().Position
			shatter(model, def, 28, budget)
			Fx.text(center + Vector3.new(0, 3 * base, 0), "POP!", Color3.fromRGB(255, 255, 255))
			Fx.confetti(center, math.floor(6 * budget))
			Juice.sound("Pop", center, 1.25 / base)
			return
		end
		pcall(function()
			model:ScaleTo(base * (1 + 0.32 * math.sin(a * math.pi * 0.5)))
		end)
	end)
end

local function styleLaunch(view, pos: Vector3, budget: number)
	local model, def = view.model, view.def
	local root = model.PrimaryPart
	Fx.flash(model, Color3.fromRGB(255, 200, 120), 0.1)
	Juice.sound("Whee", pos, Fx.rand(1.2, 1.5))
	if not root then
		shatter(model, def, 40, budget)
		return
	end
	local out = Fx.randomUnit()
	out = Vector3.new(out.X, 0, out.Z).Unit
	fly(root, out * Fx.rand(10, 16) + Vector3.new(0, Fx.rand(48, 58), 0), Fx.randomUnit() * 16, {
		life = 0.75,
		trail = true,
		onDone = function(_f)
			local at = root.Position
			shatter(model, def, 34, budget)
			-- twinkle in the sky
			local star = Fx.part({ Size = Vector3.new(0.4, 0.4, 0.1), Position = at, Color = Color3.fromRGB(255, 255, 220),
				Material = Enum.Material.Neon })
			Fx.tween(star, 0.15, { Size = Vector3.new(3, 3, 0.1) }, Enum.EasingStyle.Back)
			task.delay(0.15, function()
				Fx.tween(star, 0.25, { Size = Vector3.zero, Transparency = 1 })
			end)
			game:GetService("Debris"):AddItem(star, 0.45)
			Juice.sound("Pop", at, 1.6, 0.8)
		end,
	})
end

local function styleCaught(view, pos: Vector3, budget: number)
	local model, def = view.model, view.def
	Fx.text(pos + Vector3.new(0, 4 * def.Scale, 0), "CAUGHT!", Color3.fromRGB(120, 230, 255))
	Juice.sound("Squeak", pos, Fx.rand(1.3, 1.6))
	local base = def.Scale
	local t0 = os.clock()
	local root = model.PrimaryPart
	local startCf = root and root.CFrame
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = (os.clock() - t0) / 0.35
		if not model.Parent then
			conn:Disconnect()
			return
		end
		if a >= 1 then
			conn:Disconnect()
			local at = model:GetPivot().Position
			Fx.poof(at, 2.5, Color3.fromRGB(220, 250, 255))
			Fx.sparks(at, Color3.fromRGB(120, 230, 255), 10, 5)
			Juice.sound("Pop", at, 1.5)
			model:Destroy()
			return
		end
		pcall(function()
			model:ScaleTo(base * (1 - a * 0.9))
		end)
		if root and startCf then
			root.CFrame = startCf * CFrame.Angles(0, a * 9, 0)
		end
	end)
	local _ = budget
end

local function styleBoss(view, pos: Vector3, def)
	local model = view.model
	Juice.callout("BOSS DOWN!", Color3.fromRGB(255, 210, 40), 2)
	Juice.sound("BossDown")
	Juice.sound("Roar", pos, 0.7)
	Juice.shake(0.7)
	Juice.punch(12)
	local parts = visibleParts(model)
	for i = 1, 7 do
		task.delay(i * 0.18, function()
			if not model.Parent then
				return
			end
			Fx.flash(model, if i % 2 == 0 then Color3.new(1, 1, 1) else Color3.fromRGB(255, 120, 60), 0.12)
			local p = parts[math.random(1, #parts)]
			local at = p.Position + Fx.randomUnit() * 1.5
			Fx.explosion(at, 3.5)
			Fx.bricks(at, palette(def), 14, 30, 1.3)
			Juice.sound("Boom", at, Fx.rand(0.8, 1.1))
			Juice.shake(0.35)
		end)
	end
	task.delay(1.45, function()
		if not model.Parent then
			return
		end
		local at = model:GetPivot().Position
		Fx.explosion(at, 9)
		Fx.ring(Vector3.new(at.X, 0.3, at.Z), 34, Color3.fromRGB(255, 220, 90), 0.6, 0.5)
		shatter(model, def, 48, 3)
		Fx.confetti(at + Vector3.new(0, 4, 0), 90)
		Juice.sound("Boom", at, 0.6, 1.2)
		Juice.shake(1)
		Juice.punch(16)
	end)
end

-- ---------------------------------------------------------------- dispatch

local STYLE = {
	Punch = styleBonk,
	Chop = styleWhack,
	Pebble = stylePop,
	Bullet = stylePop,
	Taunt = stylePop,
	Grenade = styleLaunch,
	Net = styleCaught,
}

function KillFx.play(deaths: { any })
	-- many deaths in one frame: keep it fun but cap the brick count
	local budget = math.clamp(1.2 - #deaths * 0.06, 0.35, 1)
	for _, d in deaths do
		local id, typeName, kind, pos, reward, overkill = d[1], d[2], d[3], d[4], d[5], d[6]
		local def = EnemyDefs[typeName]
		if not def then
			continue
		end
		local view = EnemyView.release(id)
		Juice.kill(def.Boss == true)
		Juice.coins(pos + Vector3.new(0, 2, 0), math.floor(2 + reward / 4), reward)
		Juice.shake(if def.Boss then 0 else 0.06 * def.Scale, pos)
		if not view then
			Fx.bricks(pos + Vector3.new(0, 2, 0), palette(def), 10, 25)
			continue
		end
		if def.Boss then
			styleBoss(view, pos, def)
			continue
		end
		local style = STYLE[kind] or stylePop
		-- big overkills sometimes get the full launch treatment
		if style == stylePop and overkill and overkill > 20 and math.random() < 0.35 then
			style = styleLaunch
		end
		-- a short hit-stop: the monkey freezes for a beat before it goes
		task.delay(0.035, style, view, view.root and view.root.Position or pos, budget)
	end
end

return KillFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">UnitView</string>
              <string name="Source"><![CDATA[-- The army's side of the show: procedural attack animations layered over the idle (punch combos,
-- overhead axe chops, slingshot draws, rifle recoil, grenade lobs, net shots, banana taunts),
-- the projectiles in flight, and unit effects (placing, level-ups, stuns, heals, rallies).
-- Also plays the monkeys' ability visuals (banana throws, boss slams, boulders, summons).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapData = require(Shared.MapData)
local EnemyView = require(script.Parent.EnemyView)
local Fx = require(script.Parent.Fx)
local Juice = require(script.Parent.Juice)

local UnitView = {}

local unitsFolder = workspace:WaitForChild("Units")

local function unitModel(uid: number): Model?
	return unitsFolder:FindFirstChild(tostring(uid)) :: Model?
end

local function partOf(model: Model?, name: string): BasePart?
	return model and model:FindFirstChild(name) :: BasePart?
end

-- ---------------------------------------------------------------- combat animation
-- Data-driven (Config/UnitAnims, generated from tools/anim/unit_anims.json, also used by the
-- preview studio). While a monkey is in range a man blends into his combat stance (boxer guard,
-- shouldered rifle, raised slingshot...), attacks are keyframed clips that leave that stance and
-- return to it, and the whole pose is blended over the idle animation so nothing snaps.

local Units = require(Shared.Config.Units)
local UnitAnims = require(Shared.Config.UnitAnims)

local EASE = {
	linear = function(a: number) return a end,
	out = function(a: number) return 1 - (1 - a) ^ 3 end,
	["in"] = function(a: number) return a * a * a end,
	inout = function(a: number) return if a < 0.5 then 4 * a * a * a else 1 - (-2 * a + 2) ^ 3 / 2 end,
}
local ZERO = { 0, 0, 0, 0, 0, 0 }

local function full(v: { number }?): { number }
	if not v then
		return ZERO
	end
	return { v[1], v[2], v[3], v[4] or 0, v[5] or 0, v[6] or 0 }
end

-- Absolute pose of `kind` at time t into clip (or the stance when clip is nil).
local function poseAt(kind: string, clipName: string?, t: number): { [string]: { number } }
	local K = UnitAnims[kind]
	local stance = K.stance or {}
	local out = {}
	for j, v in stance do
		out[j] = full(v)
	end
	if not clipName then
		return out
	end
	local clip = K.clips[clipName]
	local keys = { { t = 0, pose = {} } }
	for _, k in clip.keys do
		table.insert(keys, k)
	end
	table.insert(keys, { t = clip.dur, pose = {}, ease = "inout" })
	local i = 1
	while i < #keys - 1 and t >= keys[i + 1].t do
		i += 1
	end
	local k0, k1 = keys[i], keys[i + 1]
	local a = math.clamp((t - k0.t) / math.max(1e-4, k1.t - k0.t), 0, 1)
	local e = EASE[k1.ease or "inout"](a)
	local joints = {}
	for j in stance do
		joints[j] = true
	end
	for _, k in clip.keys do
		for j in k.pose do
			joints[j] = true
		end
	end
	for j in joints do
		local v0, v1 = full(k0.pose[j] or stance[j]), full(k1.pose[j] or stance[j])
		local v = table.create(6)
		for n = 1, 6 do
			v[n] = v0[n] + (v1[n] - v0[n]) * e
		end
		out[j] = v
	end
	return out
end

local function toCFrame(v: { number }): CFrame
	return CFrame.new(v[4], v[5], v[6]) * CFrame.Angles(v[1], v[2], v[3])
end

-- The custom army rigs have no Animator idle, so they breathe here (same motion as the preview).
local function idlePose(t: number, seed: number): { [string]: CFrame }
	local b = math.sin(t * 2.2 + seed) * 0.03
	return {
		Root = CFrame.new(0, b * 0.6, 0),
		Neck = CFrame.Angles(b, 0, 0),
		RightShoulder = CFrame.Angles(0, 0, 0.06 + b),
		LeftShoulder = CFrame.Angles(0, 0, -0.06 - b),
	}
end

type AnimState = {
	motors: { [string]: Motor6D },
	kind: string,
	range: number,
	hasStance: boolean,
	w: number,
	engagedUntil: number,
	clip: string?,
	clipKind: string?,
	t0: number,
	cycle: number,
	nextScan: number,
}
local states: { [Model]: AnimState } = {}

local function motorsOf(model: Model): { [string]: Motor6D }
	local out = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			out[d.Name] = d
		end
	end
	return out
end

local function stateOf(model: Model): AnimState?
	local st = states[model]
	if st then
		return st
	end
	local unit = Units[model:GetAttribute("Unit") or ""]
	if not unit then
		return nil
	end
	local level = unit.Levels[model:GetAttribute("Level") or 1] or unit.Levels[1]
	local kind = unit.Kind
	local K = UnitAnims[kind]
	st = {
		motors = motorsOf(model),
		kind = kind,
		range = level.Range,
		hasStance = K ~= nil and next(K.stance or {}) ~= nil,
		w = 0,
		engagedUntil = 0,
		clip = nil,
		clipKind = nil,
		t0 = 0,
		cycle = 0,
		nextScan = 0,
	}
	states[model] = st
	return st
end

-- Plays the next attack clip of `kind` (cycling jab/cross etc.).
local function play(model: Model, kind: string)
	local st = stateOf(model)
	local K = UnitAnims[kind]
	if not (st and K) then
		return
	end
	st.cycle += 1
	local name = K.cycle[(st.cycle - 1) % #K.cycle + 1]
	st.clip, st.clipKind, st.t0 = name, kind, os.clock()
	st.engagedUntil = math.max(st.engagedUntil, os.clock() + (if st.hasStance then 2 else K.clips[name].dur))
end

RunService.Stepped:Connect(function(_, dt)
	local now = os.clock()
	for _, model in unitsFolder:GetChildren() do
		if not model:IsA("Model") then
			continue
		end
		local st = stateOf(model)
		if not st then
			continue
		end
		-- raise the stance when a monkey wanders into range (checked a few times a second)
		if st.hasStance and now >= st.nextScan then
			st.nextScan = now + 0.2
			if EnemyView.anyWithin(model:GetPivot().Position, st.range + 4) then
				st.engagedUntil = math.max(st.engagedUntil, now + 1)
			end
		end
		local target = if now < st.engagedUntil then 1 else 0
		st.w += (target - st.w) * math.min(1, dt * 10)
		local custom = model:GetAttribute("CustomRig") == true
		if st.w < 0.01 and not st.clip and not custom then
			continue -- fully idle: leave the Animator's idle alone
		end
		local kind = st.clipKind or st.kind
		local t = now - st.t0
		if st.clip and t >= UnitAnims[kind].clips[st.clip].dur then
			st.clip, st.clipKind = nil, nil
			kind = st.kind
		end
		local pose = poseAt(kind, st.clip, t)
		local K = UnitAnims[kind]
		if K.bounce and pose.Root then
			pose.Root[5] += math.sin(now * math.pi * 2 * K.bounce[2]) * K.bounce[1]
		end
		if custom then
			local idle = idlePose(now, (model:GetAttribute("Uid") or 0) * 1.7)
			for joint, m in st.motors do
				local base = idle[joint] or CFrame.identity
				local v = pose[joint]
				m.Transform = if v then base:Lerp(toCFrame(v), st.w) else base
			end
		else
			for joint, v in pose do
				local m = st.motors[joint]
				if m then
					m.Transform = m.Transform:Lerp(toCFrame(v), st.w)
				end
			end
		end
	end
	for model in states do
		if not model.Parent then
			states[model] = nil
		end
	end
end)

-- ---------------------------------------------------------------- projectiles

type Shot = {
	part: BasePart,
	from: Vector3,
	targetId: number?,
	targetPos: Vector3,
	t0: number,
	dur: number,
	arc: number,
	spin: number,
	onArrive: (Vector3) -> (),
}
local shots: { Shot } = {}

local function shoot(part: BasePart, from: Vector3, targetId: number?, targetPos: Vector3, dur: number, arc: number,
	spin: number, onArrive: (Vector3) -> ())
	part.CFrame = CFrame.new(from)
	table.insert(shots, { part = part, from = from, targetId = targetId, targetPos = targetPos, t0 = os.clock(),
		dur = math.max(dur, 0.05), arc = arc, spin = spin, onArrive = onArrive })
end

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local i = 1
	while i <= #shots do
		local s = shots[i]
		local live = s.targetId and EnemyView.position(s.targetId)
		if live then
			s.targetPos = live
		end
		local a = math.min(1, (now - s.t0) / s.dur)
		local pos = s.from:Lerp(s.targetPos, a) + Vector3.new(0, math.sin(a * math.pi) * s.arc, 0)
		s.part.CFrame = CFrame.new(pos) * CFrame.Angles(now * s.spin, now * s.spin * 0.7, 0)
		if a >= 1 then
			table.remove(shots, i)
			s.part:Destroy()
			s.onArrive(s.targetPos)
		else
			i += 1
		end
	end
end)

local gearModel: Instance? = nil
local function gearMesh(name: string): BasePart?
	if not gearModel then
		local assets = ReplicatedStorage:FindFirstChild("Assets")
		if assets then
			for _, d in assets:GetDescendants() do
				if d.Name == "GearFront" then
					gearModel = d.Parent
					break
				end
			end
		end
	end
	local src = gearModel and gearModel:FindFirstChild(name, true)
	return src and (src :: BasePart):Clone()
end

local function muzzle(model: Model, aimAt: Vector3): Vector3
	local hand = partOf(model, "RightHand")
	local p = if hand then hand.Position else model:GetPivot().Position
	local dir = (aimAt - p)
	dir = if dir.Magnitude > 0.1 then dir.Unit else Vector3.zAxis
	return p + dir * 2.2
end

-- ---------------------------------------------------------------- attacks

local KIND_SOUND = { Punch = "Swing", Chop = "Swing", Pebble = "Sling", Bullet = "Shot", Grenade = "Throw", Net = "NetShot" }

local function attack(entry)
	local uid, kind, targetId, targetPos, travel, level, crit = entry[1], entry[2], entry[3], entry[4], entry[5], entry[6], entry[7]
	local model = unitModel(uid)
	if not model then
		return
	end
	play(model, kind)
	local origin = model:GetPivot().Position
	local aim = (EnemyView.position(targetId) or targetPos) + Vector3.new(0, 1, 0)
	if KIND_SOUND[kind] then
		Juice.sound(KIND_SOUND[kind], origin, Fx.rand(0.95, 1.1), 0.8)
	end
	local gold = level >= 3
	if kind == "Punch" or kind == "Chop" then
		task.delay(travel, function()
			local at = (EnemyView.position(targetId) or targetPos) + Vector3.new(0, 1.5, 0)
			if kind == "Punch" then
				Fx.sparks(at, if gold then Color3.fromRGB(255, 210, 60) else Color3.new(1, 1, 1), if crit then 10 else 5, 3)
				Fx.ring(at, if crit then 3 else 1.8, Color3.new(1, 1, 1), 0.15, 0.15)
				Juice.sound("Hit", at, Fx.rand(0.9, 1.2))
				if crit then
					Fx.text(at + Vector3.new(0, 1.5, 0), "SMACK!", Color3.fromRGB(255, 220, 60), 0.8)
				end
			else
				local ground = Vector3.new(at.X, 0.25, at.Z)
				Fx.ring(ground, 7, Color3.fromRGB(255, 240, 200), 0.3, 0.3)
				Fx.poof(ground, 3)
				Fx.bricks(ground, { Color3.fromRGB(236, 205, 110), Color3.fromRGB(214, 180, 92) }, 6, 18, 0.7)
				Juice.sound("Chop", at, Fx.rand(0.9, 1.05))
				Juice.shake(0.12, at)
			end
		end)
	elseif kind == "Pebble" then
		task.delay(0.16, function()
			local lh = partOf(model, "LeftHand")
			local from = if lh then lh.Position else muzzle(model, aim)
			local pebble = gearMesh("Pebble") or Fx.part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.45 })
			pebble.Anchored = true
			pebble.CanCollide = false
			pebble.Color = if gold then Color3.fromRGB(255, 200, 40) else Color3.fromRGB(140, 140, 150)
			pebble.Parent = Fx.folder
			shoot(pebble, from, targetId, aim, math.max(0.05, travel - 0.16), 1.2, 20, function(at)
				Fx.sparks(at, Color3.new(1, 1, 1), 4, 2.5)
				Juice.sound("Hit", at, 1.4, 0.7)
			end)
		end)
	elseif kind == "Bullet" then
		local from = muzzle(model, aim)
		local flash = Fx.part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, Position = from,
			Color = Color3.fromRGB(255, 220, 120), Material = Enum.Material.Neon })
		Fx.tween(flash, 0.08, { Size = Vector3.one * 0.1, Transparency = 1 })
		game:GetService("Debris"):AddItem(flash, 0.1)
		local len = (aim - from).Magnitude
		local tracer = Fx.part({ Size = Vector3.new(0.12, 0.12, len), CFrame = CFrame.lookAt(from, aim) * CFrame.new(0, 0, -len / 2),
			Color = if gold then Color3.fromRGB(255, 210, 60) else Color3.fromRGB(255, 250, 200), Material = Enum.Material.Neon })
		Fx.tween(tracer, 0.1, { Transparency = 1, Size = Vector3.new(0.02, 0.02, len) })
		game:GetService("Debris"):AddItem(tracer, 0.12)
		Juice.shake(0.05, from)
		task.delay(travel, function()
			local at = (EnemyView.position(targetId) or targetPos) + Vector3.new(0, 1.5, 0)
			Fx.sparks(at, Color3.fromRGB(255, 230, 150), 8, 3.5)
		end)
	elseif kind == "Grenade" then
		task.delay(0.22, function()
			local rh = partOf(model, "RightHand")
			local from = if rh then rh.Position else muzzle(model, aim)
			local nade = Fx.part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.7, Color = if gold then
				Color3.fromRGB(250, 196, 40) else Color3.fromRGB(70, 90, 50) })
			local dist = (aim - from).Magnitude
			shoot(nade, from, targetId, aim, math.max(0.1, travel - 0.22), 5 + dist * 0.18, 12, function(at)
				local ground = Vector3.new(at.X, 1, at.Z)
				Fx.explosion(ground, 4.5)
				Fx.bricks(ground, { Color3.fromRGB(236, 205, 110), Color3.fromRGB(90, 86, 84) }, 8, 30, 0.8)
				Juice.sound("Boom", ground, Fx.rand(0.9, 1.1))
				Juice.shake(0.25, ground)
				Fx.text(ground + Vector3.new(0, 4, 0), "KA-BOOM!", Color3.fromRGB(255, 150, 40), 0.9)
			end)
		end)
	elseif kind == "Net" then
		local from = muzzle(model, aim)
		Fx.poof(from, 1.2, Color3.fromRGB(255, 255, 255))
		local net = gearMesh("Net")
		if net then
			net.Anchored = true
			net.CanCollide = false
			net.Color = Color3.fromRGB(240, 236, 210)
			net.Parent = Fx.folder
		else
			net = Fx.part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2, Material = Enum.Material.ForceField,
				Color = Color3.fromRGB(240, 240, 220) })
		end
		shoot(net :: BasePart, from, targetId, aim, travel, 1.5, 6, function(at)
			Fx.poof(at, 2, Color3.fromRGB(220, 250, 255))
			Juice.sound("Hit", at, 0.8, 0.6)
		end)
	elseif kind == "Taunt" then
		local pos = targetPos
		Fx.ring(Vector3.new(pos.X, 0.3, pos.Z), 14, Color3.fromRGB(255, 220, 40), 0.5, 0.35)
		Fx.text(model:GetPivot().Position + Vector3.new(0, 4, 0), "OOH BANANA!", Color3.fromRGB(255, 220, 40), 0.9)
		Juice.sound("Squeak", pos, 0.9)
	end
end

-- ---------------------------------------------------------------- unit effects

local function unitFx(kind: string, uid: number, pos: Vector3, extra: any)
	local model = unitModel(uid)
	local ground = Vector3.new(pos.X, 0.3, pos.Z)
	if kind == "place" then
		Fx.ring(ground, 4, Color3.fromRGB(120, 255, 120), 0.35, 0.3)
		Fx.poof(ground, 2.5)
		Fx.text(pos + Vector3.new(0, 6.5, 0), "+1 MAN", Color3.fromRGB(140, 255, 140), 0.8)
		Juice.sound("Place", pos)
	elseif kind == "upgrade" then
		local column = Fx.part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(14, 4, 4),
			CFrame = CFrame.new(pos + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(255, 220, 90), Material = Enum.Material.Neon, Transparency = 0.3 })
		Fx.tween(column, 0.6, { Size = Vector3.new(14, 0.2, 0.2), Transparency = 1 })
		game:GetService("Debris"):AddItem(column, 0.65)
		Fx.sparks(pos + Vector3.new(0, 3, 0), Color3.fromRGB(255, 220, 90), 16, 6)
		Fx.text(pos + Vector3.new(0, 7, 0), `LEVEL {extra}!`, Color3.fromRGB(255, 220, 60))
		Juice.sound("LevelUp", pos)
		if model then
			Fx.flash(model, Color3.fromRGB(255, 220, 90), 0.4)
		end
	elseif kind == "sell" then
		Fx.poof(ground + Vector3.new(0, 2, 0), 3)
		Juice.sound("Coin", pos)
	elseif kind == "stun" then
		if model then
			local head = partOf(model, "Head")
			Fx.dizzy(function()
				return head and head.Parent and head.Position + Vector3.new(0, 1.3, 0)
			end, extra)
		end
	elseif kind == "heal" then
		if model then
			play(model, "Heal")
		end
		Fx.ring(ground, extra, Color3.fromRGB(120, 255, 140), 0.6, 0.25)
		for _ = 1, 6 do
			local plus = Fx.part({ Size = Vector3.new(0.7, 0.2, 0.2), Color = Color3.fromRGB(110, 255, 130), Material = Enum.Material.Neon,
				Position = pos + Vector3.new(Fx.rand(-3, 3), Fx.rand(1, 3), Fx.rand(-3, 3)) })
			local bar = Fx.part({ Size = Vector3.new(0.2, 0.7, 0.2), Color = plus.Color, Material = Enum.Material.Neon, Position = plus.Position })
			for _, p in { plus, bar } do
				Fx.tween(p, 0.8, { Position = p.Position + Vector3.new(0, 3, 0), Transparency = 1 })
				game:GetService("Debris"):AddItem(p, 0.85)
			end
		end
		local base = MapData.Base
		Fx.text(base + Vector3.new(0, 9, 0), "+HP", Color3.fromRGB(120, 255, 140), 0.7)
		Juice.sound("Heal", pos)
	elseif kind == "rally" then
		if model then
			play(model, "Rally")
		end
		Fx.ring(ground, extra, Color3.fromRGB(255, 150, 40), 0.55, 0.35)
		Fx.text(pos + Vector3.new(0, 7, 0), "CHARGE!", Color3.fromRGB(255, 150, 40))
		Juice.sound("Rally", pos)
		for _, other in unitsFolder:GetChildren() do
			if other:IsA("Model") and (other:GetPivot().Position - pos).Magnitude <= extra then
				Fx.flash(other, Color3.fromRGB(255, 150, 40), 0.3)
			end
		end
	end
end

-- ---------------------------------------------------------------- monkey abilities

local function enemyAct(id: number, kind: string, data: any)
	EnemyView.act(id, kind)
	local view = EnemyView.get(id)
	local from = (view and view.root and view.root.Position or Vector3.zero) + Vector3.new(0, 2, 0)
	if kind == "throw" and data then
		local upos, flight = data[2], data[3]
		task.delay(0.45, function()
			local banana = Fx.part({ Size = Vector3.new(0.4, 1.3, 0.4), Color = Color3.fromRGB(255, 214, 40) })
			shoot(banana, from, nil, upos, flight - 0.35, 5, 14, function(at)
				Fx.text(at + Vector3.new(0, 2, 0), "SPLAT!", Color3.fromRGB(255, 214, 40), 0.8)
				Fx.bricks(at, { Color3.fromRGB(255, 214, 40), Color3.fromRGB(255, 240, 160) }, 5, 12, 0.5)
				Juice.sound("Squeak", at, 1.6)
			end)
		end)
	elseif kind == "slam" and data then
		local pos, radius = data[1], data[2]
		task.delay(0.45, function()
			local ground = Vector3.new(pos.X, 0.3, pos.Z)
			Fx.ring(ground, radius, Color3.fromRGB(255, 240, 210), 0.45, 0.6)
			Fx.ring(ground, radius * 0.6, Color3.fromRGB(255, 200, 120), 0.3, 0.4)
			Fx.poof(ground, 6)
			Fx.bricks(ground, { Color3.fromRGB(236, 205, 110), Color3.fromRGB(104, 116, 106) }, 18, 30, 1.2)
			Juice.sound("Slam", ground, 0.8)
			Juice.shake(0.55, ground)
		end)
	elseif kind == "boulder" and data then
		local upos, flight = data[1], data[2]
		local rock = Fx.part({ Size = Vector3.one * 2.6, Color = Color3.fromRGB(128, 132, 128), Material = Enum.Material.Slate })
		shoot(rock, from + Vector3.new(0, 4, 0), nil, upos, flight, 14, 5, function(at)
			local ground = Vector3.new(at.X, 0.5, at.Z)
			Fx.ring(ground, 9, Color3.fromRGB(220, 220, 210), 0.4, 0.4)
			Fx.poof(ground, 5, Color3.fromRGB(200, 200, 190))
			Fx.bricks(ground, { Color3.fromRGB(128, 132, 128), Color3.fromRGB(96, 100, 98) }, 16, 28, 1)
			Juice.sound("Boom", ground, 0.7)
			Juice.shake(0.4, ground)
		end)
	elseif kind == "summon" and data then
		Fx.text(data[1] + Vector3.new(0, 8, 0), "OOH OOH AH AH!", Color3.fromRGB(255, 140, 60))
		Fx.ring(Vector3.new(data[1].X, 0.3, data[1].Z), 10, Color3.fromRGB(255, 140, 60), 0.5, 0.3)
		Juice.sound("Roar", data[1], 1.1)
	elseif kind == "enrage" then
		Juice.callout("ENRAGED!", Color3.fromRGB(255, 60, 40), 1.2)
		Juice.sound("Roar", from, 0.75)
		Juice.shake(0.5)
	end
end

function UnitView.attacks(list)
	for _, entry in list do
		attack(entry)
	end
end
UnitView.unitFx = unitFx
UnitView.enemyAct = enemyAct

return UnitView
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
