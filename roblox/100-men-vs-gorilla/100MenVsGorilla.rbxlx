	MedicCross = { Kind = "Badge", Size = Vector3.new(0.300, 0.300, 0.060), Anchor = Vector3.new(-0.000, -0.000, -0.000) },
	OfficerBadge = { Kind = "Badge", Size = Vector3.new(0.225, 0.254, 0.050), Anchor = Vector3.new(-0.000, -0.000, -0.000) },
