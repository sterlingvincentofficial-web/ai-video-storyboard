			Torso = { Size = Vector3.new(3.800, 2.800, 2.620), Center = Vector3.new(0.000, 3.000, -0.110), Pivot = Vector3.new(0.000, 3.000, 0.000) },
			LeftArm = { Size = Vector3.new(1.890, 4.175, 1.890), Center = Vector3.new(-2.675, 2.238, 0.000), Pivot = Vector3.new(-2.675, 3.800, 0.000) },
			RightArm = { Size = Vector3.new(1.890, 4.175, 1.890), Center = Vector3.new(2.675, 2.238, 0.000), Pivot = Vector3.new(2.675, 3.800, 0.000) },
			Head = { Size = Vector3.new(3.383, 2.725, 2.100), Center = Vector3.new(0.000, 5.413, -0.350), Pivot = Vector3.new(0.000, 4.050, 0.000) },
		},
	},
}
]]></string>
