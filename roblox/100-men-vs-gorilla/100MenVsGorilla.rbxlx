  <Item class="ServerScriptService" referent="68">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="69">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="70">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry: builds the enemy rig templates from the imported meshes, hooks up the army's
-- gear, then starts the wave loop.
--
-- One-time setup in Studio: File > Import 3D -> assets/enemies/Enemies.fbx, assets/men/Men.fbx and
-- assets/men/MenGear.fbx (pebbles/nets for projectiles, and the avatar fallback's gear).
-- Leave the imported models where they land (or in ReplicatedStorage.Assets) and press Play.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EnemyDefs = require(Shared.Config.Enemies)
local EnemyRig = require(Shared.EnemyRig)
local MenFactory = require(Shared.MenFactory)
local RigData = require(Shared.RigData.Enemies)

local Services = script.Parent:WaitForChild("Services")
local GameService = require(Services.GameService)

local assets = ReplicatedStorage:WaitForChild("Assets")
local searchIn = { assets, workspace }

-- Move imports out of the Workspace so they don't stand around in the scene.
local function stash(model: Instance?)
	if model and model.Parent ~= assets then
		model.Parent = assets
	end
end

local rigs = Instance.new("Folder")
rigs.Name = "Rigs"

local import = EnemyRig.findImport(searchIn)
if import then
	stash(import)
	local flip = EnemyRig.buildAll(import, rigs)
	rigs:SetAttribute("Flipped", flip)
else
	warn("[100 Men] Enemies.fbx not imported yet - using block stand-ins. File > Import 3D -> assets/enemies/Enemies.fbx")
	for variant in RigData do
		local def = EnemyDefs[variant]
		if def then
			EnemyRig.buildFallback(variant, def.Colors).Parent = rigs
		end
	end
end
rigs.Parent = ReplicatedStorage

-- the army's custom rigs (Men.fbx); without them MenFactory falls back to Roblox avatars
local MenRig = require(Shared.MenRig)
local menImport = MenRig.findImport(searchIn)
if menImport then
	stash(menImport)
	local menRigs = Instance.new("Folder")
	menRigs.Name = "MenRigs"
	MenRig.buildAll(menImport, menRigs)
	menRigs.Parent = ReplicatedStorage
else
	warn("[100 Men] Men.fbx not imported yet - the army uses plain avatars. File > Import 3D -> assets/men/Men.fbx")
end

if MenFactory.setGear(searchIn) then
	stash(MenFactory.gear())
else
	warn("[100 Men] MenGear.fbx not imported yet - the army has no hats or weapons. File > Import 3D -> assets/men/MenGear.fbx")
end

-- The intro's squad (Players:CreateHumanoidModelFromDescription only works on the server): the
-- pilot plus a level-1 Brawler, Slingshot Kid and Lumberjack. Clients clone these for the cutscene.
local Units = require(Shared.Config.Units)
local squad = Instance.new("Folder")
squad.Name = "CutsceneSquad"
local PILOT = {
	Skin = Color3.fromRGB(245, 205, 48),
	Shirt = Color3.fromRGB(13, 105, 172),
	Pants = Color3.fromRGB(164, 189, 71),
	Hat = "ArmyHelmet",
	HatColor = Color3.fromRGB(88, 102, 56),
}
local ok, err = pcall(function()
	MenFactory.squadMember("Pilot", PILOT).Parent = squad
	for _, unitId in { "Brawler", "Slingshot", "Lumberjack" } do
		MenFactory.squadMember(unitId, Units[unitId].Levels[1].Look).Parent = squad
	end
end)
if not ok then
	warn("[100 Men] couldn't build the intro squad:", err)
end
squad.Parent = assets

GameService.start()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="71">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Co-op cash: every kill pays everyone in the server, so friends never fight over last hits.
-- Cash lives in leaderstats (shows on the player list) and the Cash attribute (drives the HUD).

local Players = game:GetService("Players")

local Economy = {}

Economy.START_CASH = 450

local function stat(player: Player): IntValue?
	local ls = player:FindFirstChild("leaderstats")
	return ls and ls:FindFirstChild("Cash") :: IntValue?
end

function Economy.setup(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Value = Economy.START_CASH
	cash.Parent = ls
	ls.Parent = player
	player:SetAttribute("Cash", Economy.START_CASH)
	player:SetAttribute("Units", 0)
end

function Economy.get(player: Player): number
	return player:GetAttribute("Cash") or 0
end

function Economy.add(player: Player, amount: number)
	local new = math.max(0, math.floor(Economy.get(player) + amount + 0.5))
	player:SetAttribute("Cash", new)
	local s = stat(player)
	if s then
		s.Value = new
	end
end

function Economy.spend(player: Player, amount: number): boolean
	if Economy.get(player) < amount then
		return false
	end
	Economy.add(player, -amount)
	return true
end

function Economy.addAll(amount: number)
	for _, p in Players:GetPlayers() do
		Economy.add(p, amount)
	end
end

function Economy.resetAll()
	for _, p in Players:GetPlayers() do
		Economy.add(p, Economy.START_CASH - Economy.get(p))
		p:SetAttribute("Units", 0)
	end
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[-- Server-side monkeys: pure data (no models). Each enemy is a "progress along a path" that both
-- server and clients advance from (P0, T0, Speed), so movement costs no network traffic.
-- Clients draw them from the attributes on ReplicatedStorage.Enemies/<id>.
-- Damage, deaths and ability visuals are batched and sent once per frame.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EnemyDefs = require(Shared.Config.Enemies)
local MapData = require(Shared.MapData)
local Net = require(Shared.Net)
local PathUtil = require(Shared.PathUtil)

local EnemyService = {}

local PATHS = PathUtil.fromMapData(MapData)
EnemyService.Paths = PATHS

local folder = Instance.new("Folder")
folder.Name = "Enemies"
folder.Parent = ReplicatedStorage

local hitsEvent = Net.event("Hits")
local deathsEvent = Net.event("Deaths")
local actsEvent = Net.event("EnemyActs")

local enemies = {} -- id -> enemy
local nextId = 0
local pendingHits = {}
local pendingDeaths = {}
local pendingActs = {}

-- Hooks wired up by GameService / UnitService
EnemyService.onBaseDamage = function(_amount: number) end
EnemyService.onReward = function(_amount: number) end
EnemyService.stunUnitsNear = function(_pos: Vector3, _radius: number, _time: number) end
EnemyService.stunUnit = function(_uid: number, _time: number) end
EnemyService.findUnitNear = function(_pos: Vector3, _radius: number): (number?, Vector3?)
	return nil, nil
end

local function now(): number
	return workspace:GetServerTimeNow()
end

local function progressOf(e, t: number): number
	return e.p0 + e.speed * (t - e.t0)
end

local function setSpeed(e, speed: number, t: number)
	if math.abs(speed - e.speed) < 1e-3 then
		return
	end
	e.p0 = math.min(progressOf(e, t), e.path.length)
	e.t0 = t
	e.speed = speed
	e.folder:SetAttribute("P0", e.p0)
	e.folder:SetAttribute("T0", e.t0)
	e.folder:SetAttribute("Speed", speed)
end

local function act(id: number, kind: string, data: any?)
	table.insert(pendingActs, { id, kind, data })
end

function EnemyService.spawn(typeName: string, pathName: string, healthMult: number, startProgress: number?, lane: number?): number
	local def = EnemyDefs[typeName]
	local path = PATHS[pathName]
	assert(def and path, `bad spawn {typeName} on {pathName}`)
	nextId += 1
	local id = nextId
	local t = now()
	local hp = math.floor(def.Health * healthMult + 0.5)
	local e = {
		id = id,
		type = typeName,
		def = def,
		path = path,
		lane = lane or ((math.random() * 2 - 1) * (MapData.PathWidth / 2 - 1.6) * (if def.Boss then 0.2 else 1)),
		hp = hp,
		maxHp = hp,
		hpMult = healthMult,
		p0 = startProgress or 0,
		t0 = t,
		speed = def.Speed,
		slowUntil = 0,
		slowFactor = 1,
		tauntUntil = 0,
		leapUntil = 0,
		nextAbility = t + 2 + math.random() * 2,
		enraged = false,
		atBase = false,
	}
	local f = Instance.new("Configuration")
	f.Name = tostring(id)
	f:SetAttribute("Type", typeName)
	f:SetAttribute("Path", pathName)
	f:SetAttribute("Lane", e.lane)
	f:SetAttribute("P0", e.p0)
	f:SetAttribute("T0", e.t0)
	f:SetAttribute("Speed", e.speed)
	f:SetAttribute("Hp", hp)
	f:SetAttribute("MaxHp", hp)
	f.Parent = folder
	e.folder = f
	enemies[id] = e
	return id
end

function EnemyService.count(): number
	local n = 0
	for _ in enemies do
		n += 1
	end
	return n
end

function EnemyService.get(id: number)
	return enemies[id]
end

function EnemyService.positionOf(e, t: number?): Vector3
	local pos = PathUtil.sampleLane(e.path, progressOf(e, t or now()), e.lane)
	return pos
end

-- Snapshot for targeting: { {id, pos, progress, hp, boss, targetable} }
function EnemyService.snapshot(t: number)
	local list = {}
	for id, e in enemies do
		local p = math.min(progressOf(e, t), e.path.length)
		local pos = PathUtil.sampleLane(e.path, p, e.lane)
		table.insert(list, {
			id = id,
			pos = pos,
			progress = p,
			remaining = e.path.length - p,
			hp = e.hp,
			boss = e.def.Boss == true,
			targetable = t >= e.leapUntil,
			radius = e.def.Scale * 1.6,
		})
	end
	return list
end

local function kill(e, kind: string, overkill: number)
	enemies[e.id] = nil
	local pos = EnemyService.positionOf(e)
	table.insert(pendingDeaths, { e.id, e.type, kind, pos, e.def.Reward, overkill })
	EnemyService.onReward(e.def.Reward)
	-- give clients a moment to grab the visual before its data disappears
	local f = e.folder
	f:SetAttribute("Dead", true)
	task.delay(0.5, function()
		f:Destroy()
	end)
end

-- Applies damage. Returns true if it killed.
function EnemyService.damage(id: number, amount: number, kind: string, opts: { splash: boolean?, crit: boolean? }?): boolean
	local e = enemies[id]
	if not e then
		return false
	end
	local dmg = amount
	if e.def.Armor and not (opts and opts.splash) then
		dmg *= 1 - e.def.Armor
	end
	dmg = math.max(1, math.floor(dmg + 0.5))
	e.hp -= dmg
	table.insert(pendingHits, { id, dmg, opts and opts.crit or false, kind })
	if e.hp <= 0 then
		kill(e, kind, -e.hp)
		return true
	end
	e.folder:SetAttribute("Hp", e.hp)
	if e.def.Ability == "Enrage" or e.def.Ability == "Titan" then
		if not e.enraged and e.hp < e.maxHp * 0.5 then
			e.enraged = true
			e.folder:SetAttribute("Enraged", true)
			act(id, "enrage")
		end
	end
	return false
end

function EnemyService.slow(id: number, factor: number, duration: number)
	local e = enemies[id]
	if not e or e.def.Boss then
		if e then -- bosses shrug off most of it
			e.slowFactor = math.max(e.slowFactor, 0.8)
			e.slowUntil = now() + duration * 0.5
		end
		return
	end
	e.slowFactor = math.min(if now() < e.slowUntil then e.slowFactor else 1, factor)
	e.slowUntil = now() + duration
	e.folder:SetAttribute("Netted", e.slowUntil)
end

function EnemyService.taunt(id: number, baitPos: Vector3, duration: number): boolean
	local e = enemies[id]
	if not e or e.def.Boss or e.atBase then
		return false
	end
	e.tauntUntil = now() + duration
	e.folder:SetAttribute("TauntPos", baitPos)
	e.folder:SetAttribute("TauntUntil", e.tauntUntil)
	return true
end

function EnemyService.clear()
	for _, e in enemies do
		e.folder:Destroy()
	end
	table.clear(enemies)
end

local function wantedSpeed(e, t: number): number
	if e.atBase or t < e.tauntUntil then
		return 0
	end
	local s = e.def.Speed * (if e.enraged then 1.6 else 1)
	if t < e.slowUntil then
		s *= e.slowFactor
	end
	return s
end

-- ---------------------------------------------------------------- abilities

local function ability(e, t: number)
	local pos = EnemyService.positionOf(e, t)
	local a = e.def.Ability
	local titan = a == "Titan"
	if a == "Throw" then
		local uid, upos = EnemyService.findUnitNear(pos, 22)
		if uid then
			act(e.id, "throw", { uid, upos, 0.8 })
			task.delay(0.8, function()
				EnemyService.stunUnit(uid, 1.2)
			end)
			e.nextAbility = t + 4.5
		else
			e.nextAbility = t + 0.5
		end
	elseif a == "Leap" then
		local uid = EnemyService.findUnitNear(pos, 9)
		if uid and not e.atBase then
			local p = progressOf(e, t)
			local target = math.min(p + 14, e.path.length - 1)
			e.p0, e.t0 = target, t + 0.55
			e.leapUntil = t + 0.55
			e.folder:SetAttribute("LeapFrom", p)
			e.folder:SetAttribute("LeapT", t)
			e.folder:SetAttribute("P0", e.p0)
			e.folder:SetAttribute("T0", e.t0)
			e.nextAbility = t + 3.5
		else
			e.nextAbility = t + 0.3
		end
	elseif a == "Slam" or a == "Enrage" or (titan and math.random() < 0.4) then
		act(e.id, "slam", { pos, 16 })
		task.delay(0.45, function()
			EnemyService.stunUnitsNear(pos, 16, 1.5)
		end)
		e.nextAbility = t + (if e.enraged then 4 else 6)
	elseif a == "Boulder" or (titan and math.random() < 0.5) then
		local uid, upos = EnemyService.findUnitNear(pos, 45)
		if uid and upos then
			act(e.id, "boulder", { upos, 1.2 })
			task.delay(1.2, function()
				EnemyService.stunUnitsNear(upos, 8, 2.5)
			end)
		end
		e.nextAbility = t + 7
	elseif a == "Summon" or titan then
		act(e.id, "summon", { pos })
		local p = progressOf(e, t)
		for i = 1, 4 do
			EnemyService.spawn("Monkey", e.path.name, e.hpMult or 1, math.max(0, p - 3 - i), (i - 2.5) * 1.6)
		end
		e.nextAbility = t + 9
	else
		e.nextAbility = math.huge
	end
end

-- ---------------------------------------------------------------- tick

function EnemyService.step(dt: number)
	local t = now()
	for _, e in enemies do
		local p = progressOf(e, t)
		if not e.atBase and p >= e.path.length - 0.25 then
			e.atBase = true
			e.folder:SetAttribute("AtBase", true)
		end
		setSpeed(e, wantedSpeed(e, t), t)
		if e.atBase then
			EnemyService.onBaseDamage(e.def.BaseDps * dt)
		end
		if t >= e.nextAbility then
			ability(e, t)
		end
	end
end

function EnemyService.flush()
	if #pendingHits > 0 then
		hitsEvent:FireAllClients(pendingHits)
		pendingHits = {}
	end
	if #pendingDeaths > 0 then
		deathsEvent:FireAllClients(pendingDeaths)
		pendingDeaths = {}
	end
	if #pendingActs > 0 then
		actsEvent:FireAllClients(pendingActs)
		pendingActs = {}
	end
end

return EnemyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[-- The game loop: waves 1-100, boss waves, the Banana Stash's health, game over and restart.
-- Public state lives as attributes on ReplicatedStorage.GameState so every HUD can read it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EnemyDefs = require(Shared.Config.Enemies)
local Net = require(Shared.Net)
local Waves = require(Shared.Config.Waves)

local Economy = require(script.Parent.Economy)
local EnemyService = require(script.Parent.EnemyService)
local UnitService = require(script.Parent.UnitService)

local GameService = {}

local BASE_MAX_HP = 1000

local state = Instance.new("Configuration")
state.Name = "GameState"
state:SetAttribute("Wave", 0)
state:SetAttribute("TotalWaves", Waves.Total)
state:SetAttribute("Phase", "Intermission") -- Intermission | Wave | GameOver | Victory
state:SetAttribute("NextWaveAt", 0)
state:SetAttribute("BaseHp", BASE_MAX_HP)
state:SetAttribute("BaseMaxHp", BASE_MAX_HP)
state:SetAttribute("Boss", "")
-- Set this in Studio (ReplicatedStorage.GameState) before pressing Play to jump to a later wave.
state:SetAttribute("StartWave", state:GetAttribute("StartWave") or 1)
state.Parent = ReplicatedStorage

local gameEvent = Net.event("GameEvent")
local INTRO_MAX = 38 -- seconds a joining player may spend in the intro before the game starts anyway
local joinedAt: { [Player]: number } = {}
Net.event("IntroDone").OnServerEvent:Connect(function(p: Player)
	p:SetAttribute("IntroDone", true)
end)
local baseHp = BASE_MAX_HP
local running = 0 -- bumps on restart so old wave threads stop

local function now(): number
	return workspace:GetServerTimeNow()
end

EnemyService.onBaseDamage = function(amount: number)
	if state:GetAttribute("Phase") ~= "Wave" and state:GetAttribute("Phase") ~= "Intermission" then
		return
	end
	baseHp = math.max(0, baseHp - amount)
end
EnemyService.onReward = function(amount: number)
	Economy.addAll(amount)
end
UnitService.onHeal = function(amount: number)
	baseHp = math.min(BASE_MAX_HP, baseHp + amount)
end

local function spawnGroup(run: number, wave, group)
	for _ = 1, group.Count do
		if running ~= run then
			return
		end
		EnemyService.spawn(group.Type, group.Path or "North", wave.HealthMult)
		task.wait(group.Gap)
	end
end

local function bossHealthMult(n: number): number
	return 1 + math.max(0, n // 10 - 1) * 0.6
end

local function runWave(run: number, n: number)
	local wave = Waves.get(n)
	state:SetAttribute("Wave", n)
	state:SetAttribute("Phase", "Wave")
	state:SetAttribute("Boss", wave.Boss or "")
	gameEvent:FireAllClients("WaveStart", n, wave.Boss)
	local spawning = 0
	for i, group in wave.Groups do
		spawning += 1
		task.delay((i - 1) * 2.2, function()
			spawnGroup(run, wave, group)
			spawning -= 1
		end)
	end
	if wave.Boss then
		spawning += 1
		task.delay(4, function()
			if running ~= run then
				return
			end
			gameEvent:FireAllClients("BossIncoming", wave.Boss, EnemyDefs[wave.Boss].DisplayName)
			task.wait(2.5)
			if running == run then
				EnemyService.spawn(wave.Boss, "North", bossHealthMult(n))
			end
			spawning -= 1
		end)
	end
	-- wait for the wave to be fully spawned and wiped (or the stash to fall)
	task.wait(1)
	while running == run and (spawning > 0 or EnemyService.count() > 0) do
		if baseHp <= 0 then
			return false
		end
		task.wait(0.25)
	end
	if running ~= run then
		return false
	end
	local bonus = 40 + n * 12
	Economy.addAll(bonus)
	gameEvent:FireAllClients("WaveClear", n, bonus)
	return true
end

-- Wave 1 waits until every player has finished (or skipped) the intro cutscene.
local function waitForIntros(run: number)
	state:SetAttribute("Phase", "Intro")
	while running == run do
		local waiting = false
		for _, p in Players:GetPlayers() do
			if not p:GetAttribute("IntroDone") and os.clock() - (joinedAt[p] or 0) < INTRO_MAX then
				waiting = true
			end
		end
		if not waiting and #Players:GetPlayers() > 0 then
			return
		end
		task.wait(0.25)
	end
end

local function gameLoop(run: number)
	waitForIntros(run)
	if running ~= run then
		return
	end
	local startWave = math.clamp(state:GetAttribute("StartWave") or 1, 1, Waves.Total)
	state:SetAttribute("Phase", "Intermission")
	state:SetAttribute("NextWaveAt", now() + Waves.FirstDelay)
	task.wait(Waves.FirstDelay)
	for n = startWave, Waves.Total do
		if running ~= run then
			return
		end
		local cleared = runWave(run, n)
		if running ~= run then
			return
		end
		if not cleared then
			GameService.gameOver(run)
			return
		end
		if n == Waves.Total then
			state:SetAttribute("Phase", "Victory")
			gameEvent:FireAllClients("Victory")
			return
		end
		state:SetAttribute("Phase", "Intermission")
		state:SetAttribute("NextWaveAt", now() + Waves.Intermission)
		task.wait(Waves.Intermission)
	end
end

function GameService.start()
	running += 1
	baseHp = BASE_MAX_HP
	state:SetAttribute("BaseHp", baseHp)
	task.spawn(gameLoop, running)
end

function GameService.gameOver(run: number)
	if running ~= run then
		return
	end
	state:SetAttribute("Phase", "GameOver")
	gameEvent:FireAllClients("GameOver", state:GetAttribute("Wave"))
	task.wait(7)
	if running ~= run then
		return
	end
	EnemyService.clear()
	UnitService.clear()
	Economy.resetAll()
	GameService.start()
end

-- per-frame heartbeat for every service
RunService.Heartbeat:Connect(function(dt)
	EnemyService.step(dt)
	UnitService.step()
	EnemyService.flush()
	UnitService.flush()
	local shown = math.floor(baseHp + 0.5)
	if state:GetAttribute("BaseHp") ~= shown then
		if shown < (state:GetAttribute("BaseHp") or shown) then
			gameEvent:FireAllClients("BaseHit", shown)
		end
		state:SetAttribute("BaseHp", shown)
	end
	if baseHp <= 0 and state:GetAttribute("Phase") == "Wave" then
		task.spawn(GameService.gameOver, running)
	end
end)

local function onJoin(p: Player)
	joinedAt[p] = os.clock()
	Economy.setup(p)
end
Players.PlayerAdded:Connect(onJoin)
for _, p in Players:GetPlayers() do
	onJoin(p)
end
Players.PlayerRemoving:Connect(function(p)
	joinedAt[p] = nil
end)
Players.PlayerRemoving:Connect(UnitService.removeOwner)

return GameService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">UnitService</string>
            <string name="Source"><![CDATA[-- The army: placement, upgrades, selling, targeting and attacks.
-- Units are real (anchored) avatar models in workspace.Units. Attacks are decided here and sent
-- to clients as one batched "Attacks" event per frame so they can animate swings, shots and
-- projectiles; damage lands when the projectile would arrive.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapData = require(Shared.MapData)
local MenFactory = require(Shared.MenFactory)
local Net = require(Shared.Net)
local PathUtil = require(Shared.PathUtil)
local Units = require(Shared.Config.Units)

local Economy = require(script.Parent.Economy)
local EnemyService = require(script.Parent.EnemyService)

local UnitService = {}

UnitService.MAX_PER_PLAYER = 100 -- the "100 men" in 100 Men vs 1 Gorilla
UnitService.SELL_RATE = 0.6
local CRIT_CHANCE = 0.12
local MIN_SPACING = 2.8

local folder = Instance.new("Folder")
folder.Name = "Units"
folder.Parent = workspace

local attacksEvent = Net.event("Attacks")
local unitFxEvent = Net.event("UnitFx")

local units = {} -- uid -> unit
local nextUid = 0
local pendingAttacks = {}
local scheduled = {} -- { at, fn }

local function now(): number
	return workspace:GetServerTimeNow()
end

local function schedule(at: number, fn: () -> ())
	table.insert(scheduled, { at, fn })
end

local function groundOk(pos: Vector3): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace:FindFirstChild("Map") or workspace }
	local hit = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -40, 0), params)
	return hit ~= nil and (hit.Instance.Name:match("^Sand%d") ~= nil or hit.Instance.Name:match("^Plaza%d") ~= nil) and math.abs(hit.Position.Y) < 0.6
end

-- Why a spot is not placeable, or nil if it is.
function UnitService.placementProblem(pos: Vector3, ignoreUid: number?): string?
	local area = MapData.BuildArea
	if pos.X < area.Min.X or pos.X > area.Max.X or pos.Z < area.Min.Z or pos.Z > area.Max.Z then
		return "Out of bounds"
	end
	if PathUtil.distanceToPaths(EnemyService.Paths, pos) < MapData.PathWidth / 2 + 1 then
		return "Too close to the path"
	end
	local base = MapData.Base
	if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(base.X, 0, base.Z)).Magnitude < MapData.BaseRadius - 1 then
		-- inside the camp is allowed, but not on the stash itself
		if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(base.X, 0, base.Z)).Magnitude < 5 then
			return "That's the Banana Stash"
		end
	end
	for uid, u in units do
		if uid ~= ignoreUid and (u.pos - pos).Magnitude < MIN_SPACING then
			return "Too close to another man"
		end
	end
	if not groundOk(pos) then
		return "Can't stand there"
	end
	return nil
end

local function facePathYaw(pos: Vector3): CFrame
	-- face the nearest bit of trail so new men look ready
	local best, bestPos = math.huge, nil
	for _, path in EnemyService.Paths do
		for d = 0, path.length, 4 do
			local p = PathUtil.sample(path, d)
			local dist = (p - pos).Magnitude
			if dist < best then
				best, bestPos = dist, p
			end
		end
	end
	if bestPos then
		return CFrame.lookAt(pos, Vector3.new(bestPos.X, pos.Y, bestPos.Z))
	end
	return CFrame.new(pos)
end

local function spawnModel(u, cf: CFrame)
	local model = MenFactory.build(u.unitId, u.level)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local height = model:GetAttribute("RootHeight") or ((humanoid :: Humanoid).HipHeight + root.Size.Y / 2)
	model:PivotTo(cf + Vector3.new(0, height, 0))
	model:SetAttribute("Uid", u.uid)
	model:SetAttribute("Owner", u.owner.UserId)
	model.Name = tostring(u.uid)
	model.Parent = folder
	MenFactory.playIdle(model)
	u.model = model
	u.height = height
end

function UnitService.place(player: Player, unitId: string, pos: Vector3): (boolean, string?)
	local unit = Units[unitId]
	if not unit then
		return false, "Unknown unit"
	end
	if (player:GetAttribute("Units") or 0) >= UnitService.MAX_PER_PLAYER then
		return false, `Army full ({UnitService.MAX_PER_PLAYER} men)`
	end
	pos = Vector3.new(pos.X, 0, pos.Z)
	local problem = UnitService.placementProblem(pos)
	if problem then
		return false, problem
	end
	local cost = unit.Levels[1].Cost
	if not Economy.spend(player, cost) then
		return false, "Not enough cash"
	end
	nextUid += 1
	local u = {
		uid = nextUid,
		unitId = unitId,
		unit = unit,
		level = 1,
		def = unit.Levels[1],
		owner = player,
		pos = pos,
		spent = cost,
		cd = now() + 0.4,
		stunUntil = 0,
		hypedUntil = 0,
		rally = 0,
	}
	units[u.uid] = u
	spawnModel(u, facePathYaw(pos))
	player:SetAttribute("Units", (player:GetAttribute("Units") or 0) + 1)
	unitFxEvent:FireAllClients("place", u.uid, pos)
	return true, nil
end

function UnitService.upgrade(player: Player, uid: number): (boolean, string?)
	local u = units[uid]
	if not u or u.owner ~= player then
		return false, "Not your man"
	end
	local nextDef = u.unit.Levels[u.level + 1]
	if not nextDef then
		return false, "Max level"
	end
	if not Economy.spend(player, nextDef.Cost) then
		return false, "Not enough cash"
	end
	u.level += 1
	u.def = nextDef
	u.spent += nextDef.Cost
	local cf = u.model:GetPivot() - Vector3.new(0, u.height, 0)
	u.model:Destroy()
	spawnModel(u, cf)
	unitFxEvent:FireAllClients("upgrade", u.uid, u.pos, u.level)
	return true, nil
end

function UnitService.sell(player: Player, uid: number): (boolean, string?)
	local u = units[uid]
	if not u or u.owner ~= player then
		return false, "Not your man"
	end
	units[uid] = nil
	Economy.add(player, u.spent * UnitService.SELL_RATE)
	player:SetAttribute("Units", math.max(0, (player:GetAttribute("Units") or 1) - 1))
	unitFxEvent:FireAllClients("sell", uid, u.pos)
	u.model:Destroy()
	return true, nil
end

function UnitService.removeOwner(player: Player)
	for uid, u in units do
		if u.owner == player then
			units[uid] = nil
			u.model:Destroy()
		end
	end
end

function UnitService.clear()
	for uid, u in units do
		units[uid] = nil
		u.model:Destroy()
	end
end

-- Hooks the enemies use (Chucker bananas, boss slams and boulders).
function UnitService.stun(uid: number, duration: number)
	local u = units[uid]
	if u then
		u.stunUntil = math.max(u.stunUntil, now() + duration)
		unitFxEvent:FireAllClients("stun", uid, u.pos, duration)
	end
end

function UnitService.stunNear(pos: Vector3, radius: number, duration: number)
	for uid, u in units do
		if (u.pos - pos).Magnitude <= radius then
			UnitService.stun(uid, duration)
		end
	end
end

function UnitService.findNear(pos: Vector3, radius: number): (number?, Vector3?)
	local best, bestD = nil, radius
	for uid, u in units do
		local d = (u.pos - pos).Magnitude
		if d <= bestD then
			best, bestD = uid, d
		end
	end
	return best, best and units[best].pos + Vector3.new(0, 3, 0)
end

-- ---------------------------------------------------------------- combat

local function faceTarget(u, target: Vector3)
	local flat = Vector3.new(target.X, u.pos.Y, target.Z)
	if (flat - u.pos).Magnitude > 0.1 then
		u.model:PivotTo(CFrame.lookAt(u.pos, flat) + Vector3.new(0, u.height, 0))
	end
end

local function pickTarget(u, list)
	local def = u.def
	local best, bestScore = nil, -math.huge
	for _, e in list do
		if e.targetable then
			local d = (Vector3.new(e.pos.X, 0, e.pos.Z) - u.pos).Magnitude - e.radius
			if d <= def.Range then
				-- hunters go for bosses, then the beefiest; everyone else hits whoever is closest to the stash
				local score = if u.unit.Kind == "Bullet" then (if e.boss then 1e9 else 0) + e.hp else -e.remaining
				if score > bestScore then
					best, bestScore = e, score
				end
			end
		end
	end
	return best
end

local function damageRoll(u, base: number): (number, boolean)
	local crit = math.random() < CRIT_CHANCE
	local dmg = base * (1 + u.rally) * (if crit then 2 else 1)
	return dmg, crit
end

local function splashAround(center: Vector3, radius: number, dmg: number, kind: string, crit: boolean, list)
	for _, e in list do
		if (e.pos - center).Magnitude <= radius + e.radius then
			EnemyService.damage(e.id, dmg, kind, { splash = true, crit = crit })
		end
	end
end

local function attack(u, t: number, list)
	local def = u.def
	local kind = u.unit.Kind
	local hype = if t < u.hypedUntil then 0.75 else 1
	if kind == "Heal" then
		UnitService.onHeal(def.Heal)
		for _, other in units do
			if (other.pos - u.pos).Magnitude <= def.Range then
				other.hypedUntil = t + 3
			end
		end
		unitFxEvent:FireAllClients("heal", u.uid, u.pos, def.Range)
		u.cd = t + def.Cooldown
		return
	end
	if kind == "Rally" then
		for _, other in units do
			if other ~= u and (other.pos - u.pos).Magnitude <= def.RallyRadius then
				other.hypedUntil = t + 2.5
			end
		end
		unitFxEvent:FireAllClients("rally", u.uid, u.pos, def.RallyRadius)
		u.cd = t + def.Cooldown
		return
	end
	if kind == "Taunt" then
		local hit = 0
		for _, e in list do
			if (e.pos - u.pos).Magnitude <= def.TauntRadius and EnemyService.taunt(e.id, u.pos, def.TauntTime) then
				hit += 1
				EnemyService.damage(e.id, def.Damage, "Taunt", { splash = true })
			end
		end
		if hit > 0 then
			table.insert(pendingAttacks, { u.uid, "Taunt", 0, u.pos, 0, u.level })
			u.cd = t + def.Cooldown
		else
			u.cd = t + 0.3
		end
		return
	end

	local target = pickTarget(u, list)
	if not target then
		u.cd = t + 0.15
		return
	end
	faceTarget(u, target.pos)
	local dmg, crit = damageRoll(u, def.Damage)
	if target.boss and def.BossBonus then
		dmg *= def.BossBonus
	end
	local travel
	if kind == "Punch" or kind == "Chop" then
		travel = if kind == "Chop" then 0.28 else 0.1
	else
		local dist = (target.pos - u.pos).Magnitude
		travel = dist / (u.unit.ProjectileSpeed or 60)
		if kind == "Grenade" then
			travel = math.max(travel, 0.65)
		end
	end
	table.insert(pendingAttacks, { u.uid, kind, target.id, target.pos, travel, u.level, crit })
	local id = target.id
	schedule(t + travel, function()
		local e = EnemyService.get(id)
		local at = if e then EnemyService.positionOf(e) else target.pos
		if kind == "Chop" or kind == "Grenade" then
			splashAround(at, def.Splash or 6, dmg, kind, crit, EnemyService.snapshot(now()))
		elseif kind == "Net" then
			EnemyService.slow(id, def.SlowFactor, def.SlowTime)
			if def.Splash then
				for _, other in EnemyService.snapshot(now()) do
					if (other.pos - at).Magnitude <= def.Splash then
						EnemyService.slow(other.id, def.SlowFactor, def.SlowTime)
					end
				end
			end
			EnemyService.damage(id, dmg, kind, { crit = crit })
		else
			EnemyService.damage(id, dmg, kind, { crit = crit })
		end
	end)
	u.cd = t + def.Cooldown * hype
end

UnitService.onHeal = function(_amount: number) end

function UnitService.step()
	local t = now()
	-- run due damage first so kills land the same frame their hit was promised
	local i = 1
	while i <= #scheduled do
		local s = scheduled[i]
		if t >= s[1] then
			table.remove(scheduled, i)
			s[2]()
		else
			i += 1
		end
	end
	-- commander auras
	for _, u in units do
		u.rally = 0
	end
	for _, c in units do
		if c.unit.Kind == "Rally" then
			for _, u in units do
				if u ~= c and (u.pos - c.pos).Magnitude <= c.def.RallyRadius then
					u.rally = math.min(1, u.rally + c.def.RallyBonus)
				end
			end
		end
	end
	local list = nil
	for _, u in units do
		if t >= u.cd and t >= u.stunUntil then
			list = list or EnemyService.snapshot(t)
			attack(u, t, list)
		end
	end
end

function UnitService.flush()
	if #pendingAttacks > 0 then
		attacksEvent:FireAllClients(pendingAttacks)
		pendingAttacks = {}
	end
end

-- wire the enemy-side hooks
EnemyService.stunUnit = UnitService.stun
EnemyService.stunUnitsNear = UnitService.stunNear
EnemyService.findUnitNear = UnitService.findNear

-- remote handlers
Net.func("PlaceUnit").OnServerInvoke = function(player, unitId, pos)
	if typeof(unitId) ~= "string" or typeof(pos) ~= "Vector3" then
		return false, "Bad request"
	end
	return UnitService.place(player, unitId, pos)
end
Net.func("UpgradeUnit").OnServerInvoke = function(player, uid)
	if typeof(uid) ~= "number" then
		return false, "Bad request"
	end
	return UnitService.upgrade(player, uid)
end
Net.func("SellUnit").OnServerInvoke = function(player, uid)
	if typeof(uid) ~= "number" then
		return false, "Bad request"
	end
	return UnitService.sell(player, uid)
end

return UnitService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="76">
