        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Waves</string>
            <string name="Source"><![CDATA[--!strict
-- Wave recipes. Waves 1-100 are generated from a budget that grows each wave; new monkey
-- types unlock as you go, and every 10th wave is a gorilla boss with an escort.

export type Group = { Type: string, Count: number, Gap: number, Path: string? }
export type Wave = { Number: number, Groups: { Group }, HealthMult: number, Boss: string? }

local Waves = {}

Waves.Total = 100
Waves.Intermission = 8 -- seconds between waves
Waves.FirstDelay = 12

-- type -> { unlock wave, budget cost per monkey }
local POOL = {
	{ "Monkey", 1, 1 },
	{ "Speedy", 3, 1.4 },
	{ "Baby", 5, 0.45 },
	{ "Chucker", 7, 2 },
	{ "Brute", 9, 5 },
	{ "Ninja", 12, 2.5 },
}

local BOSSES = { [10] = "Silverback", [20] = "RockThrower", [30] = "Berserker", [40] = "Alpha", [100] = "Titan" }
local BOSS_CYCLE = { "Silverback", "RockThrower", "Berserker", "Alpha" }
local PATHS = { "North", "West", "East" }

function Waves.get(n: number): Wave
	local rng = Random.new(n * 7919)
	local groups: { Group } = {}
	local budget = 6 + n * 3.2 + (n ^ 1.35)
	local unlocked = {}
	for _, entry in POOL do
		if n >= entry[2] then
			table.insert(unlocked, entry)
		end
	end
	-- the newest unlock gets a showcase group the wave it appears
	for _, entry in POOL do
		if n == entry[2] and n > 1 then
			table.insert(groups, { Type = entry[1], Count = 6, Gap = 0.5, Path = PATHS[rng:NextInteger(1, 3)] })
			budget -= 6 * entry[3]
		end
	end
	local paths = math.clamp(1 + math.floor(n / 4), 1, 3)
	while budget > 0 do
		local entry = unlocked[rng:NextInteger(1, #unlocked)]
		local count = if entry[1] == "Baby" then rng:NextInteger(8, 14) else rng:NextInteger(3, 8)
		table.insert(groups, {
			Type = entry[1],
			Count = count,
			Gap = if entry[1] == "Baby" then 0.18 else rng:NextNumber(0.35, 0.8),
			Path = PATHS[rng:NextInteger(1, paths)],
		})
		budget -= count * entry[3]
	end
	local boss = BOSSES[n] or (if n % 10 == 0 then BOSS_CYCLE[(n // 10 - 1) % 4 + 1] else nil)
	return {
		Number = n,
		Groups = groups,
		HealthMult = 1.045 ^ (n - 1),
		Boss = boss,
	}
end

return Waves
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">EnemyRig</string>
          <string name="Source"><![CDATA[--!strict
-- Turns the imported enemy meshes (assets/enemies/Enemies.fbx: MeshParts named <Variant>_<Part>)
-- into rigged templates: a root part + Motor6D joints, laid out from RigData/Enemies so the
-- result never depends on the importer's unit scale or placement.
--
-- The server builds one template per variant into ReplicatedStorage.Rigs at startup;
-- clients clone those for every monkey they draw (enemies are client-rendered).

local RigData = require(script.Parent.RigData.Enemies)

local EnemyRig = {}

local JOINTS = {
	Torso = { "Root", "RootJoint" },
	Head = { "Torso", "Neck" },
	LeftArm = { "Torso", "Left Shoulder" },
	RightArm = { "Torso", "Right Shoulder" },
	LeftLeg = { "Torso", "Left Hip" },
	RightLeg = { "Torso", "Right Hip" },
}

-- Finds the imported model (anywhere under the given containers) by its FrontMarker + Monkey_Torso.
function EnemyRig.findImport(containers: { Instance }): Model?
	for _, c in containers do
		for _, d in c:GetDescendants() do
			if d:IsA("Model") and d:FindFirstChild("FrontMarker", true) and d:FindFirstChild("Monkey_Torso", true) then
				return d
			end
		end
	end
	return nil
end

-- The importer may bring the file in facing +Z (backwards for Roblox). FrontMarker sits in front of
-- the first variant's feet, so if it lands behind that torso every part needs a half turn.
function EnemyRig.needsFlip(import: Model): boolean
	local marker = import:FindFirstChild("FrontMarker", true) :: BasePart
	local torso = import:FindFirstChild("Monkey_Torso", true) :: BasePart
	return (marker.Position.Z - torso.Position.Z) > 0.05
end

-- Builds the rigged template for one variant. Root sits at torso height; feet at Y = 0.
function EnemyRig.build(import: Model, variant: string, flip: boolean): Model
	local data = RigData[variant]
	assert(data, `No rig data for {variant}`)
	local turn = if flip then CFrame.Angles(0, math.pi, 0) else CFrame.identity
	local torsoPivot = data.Parts.Torso.Pivot

	local model = Instance.new("Model")
	model.Name = variant
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new(torsoPivot)
	root.Parent = model
	model.PrimaryPart = root

	local parts: { [string]: BasePart } = { Root = root }
	for name, pd in data.Parts do
		local source = import:FindFirstChild(`{variant}_{name}`, true)
		assert(source and source:IsA("BasePart"), `Imported enemies are missing {variant}_{name}`)
		local part = source:Clone() :: BasePart
		part.Name = name
		part.Anchored = false
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = true
		part.Size = pd.Size
		part.CFrame = CFrame.new(pd.Center) * turn
		part.Parent = model
		parts[name] = part
	end
	for name, joint in JOINTS do
		local p0, p1 = parts[joint[1]], parts[name]
		if not (p0 and p1) then
			continue
		end
		local pivot = CFrame.new(data.Parts[name].Pivot)
		local motor = Instance.new("Motor6D")
		motor.Name = joint[2]
		motor.Part0 = p0
		motor.Part1 = p1
		motor.C0 = p0.CFrame:Inverse() * pivot
		motor.C1 = p1.CFrame:Inverse() * pivot
		motor.Parent = p0
	end
	model:SetAttribute("RootHeight", torsoPivot.Y)
	model:SetAttribute("Height", data.Height)
	return model
end

-- Stand-in rig built from plain blocks (sizes from RigData, colors from Config) so the game is
-- playable before Enemies.fbx has been imported.
function EnemyRig.buildFallback(variant: string, colors: { Fur: Color3, Cream: Color3 }): Model
	local data = RigData[variant]
	local fake = Instance.new("Model")
	for name, pd in data.Parts do
		local p = Instance.new("Part")
		p.Name = `{variant}_{name}`
		p.Size = pd.Size
		p.Position = pd.Center
		p.Color = if name == "Head" then colors.Cream else colors.Fur
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = fake
	end
	local model = EnemyRig.build(fake, variant, false)
	fake:Destroy()
	return model
end

-- Builds every variant into a folder of templates.
function EnemyRig.buildAll(import: Model, into: Instance)
	local flip = EnemyRig.needsFlip(import)
	for variant in RigData do
		local ok, result = pcall(EnemyRig.build, import, variant, flip)
		if ok then
			result.Parent = into
		else
			warn(`[EnemyRig] {variant}: {result}`)
		end
	end
	return flip
end

return EnemyRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">MapData</string>
          <string name="Source"><![CDATA[-- Generated by tools/build_map.py. Do not edit by hand.
-- Monkey routes (spawn first, base gate last), base position and the buildable area.
return {
	PathWidth = 9,
	Base = Vector3.new(0, 0, 42),
	BaseRadius = 15,
	BuildArea = { Min = Vector3.new(-108, 0, -66), Max = Vector3.new(108, 0, 86) },
	Paths = {
		North = { Vector3.new(0, 24, -81), Vector3.new(0, 24, -74), Vector3.new(0, 0, -50), Vector3.new(-14, 0, -38), Vector3.new(-20, 0, -18), Vector3.new(-6, 0, -2), Vector3.new(2, 0, 14), Vector3.new(0, 0, 31) },
		West = { Vector3.new(-114, 0, -8), Vector3.new(-86, 0, -14), Vector3.new(-62, 0, 2), Vector3.new(-50, 0, 22), Vector3.new(-28, 0, 26), Vector3.new(-10, 0, 36) },
		East = { Vector3.new(114, 0, 14), Vector3.new(92, 0, 18), Vector3.new(74, 0, 4), Vector3.new(52, 0, 6), Vector3.new(40, 0, 24), Vector3.new(10, 0, 36) },
	},
	PlayerSpawn = Vector3.new(0, 0, 70),
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">MenFactory</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the army as real Roblox avatars (HumanoidDescription -> R15) dressed per unit level:
-- body colors (or Shirt/Pants templates), a hat, held gear and rank badges, all gear meshes
-- coming from the imported MenGear.fbx and fitted with RigData/Gear anchors.
-- Server only (CreateHumanoidModelFromDescription is server-side).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Gear = require(script.Parent.RigData.Gear)
local Units = require(script.Parent.Config.Units)

local MenFactory = {}

MenFactory.TAG = "Man"

-- Roblox's own R15 idle animation, so the men breathe instead of standing frozen.
local IDLE_ANIMATION = "rbxassetid://507766388"
local HEAD_WIDTH = 1.24 -- the head size the hats were modelled for (2 x 0.62)

-- How each held item sits in the hand (see HOLD). Carried items (medkit, grenade) hang as-is.
local HOLD = {
	-- modelled pointing forward: turned to lie along the forearm
	RifleStock = CFrame.Angles(-math.pi / 2, 0, 0), RifleBarrel = CFrame.Angles(-math.pi / 2, 0, 0),
	NetGun = CFrame.Angles(-math.pi / 2, 0, 0), NetGunMuzzle = CFrame.Angles(-math.pi / 2, 0, 0),
	Megaphone = CFrame.Angles(-math.pi / 2, 0, 0),
	-- modelled upright: fork up / banana up when the arm is held out
	Slingshot = CFrame.Angles(-math.pi / 2, 0, 0), BigBanana = CFrame.Angles(-math.pi / 2, 0, 0),
	-- modelled upright: flipped end-over-end so it extends the arm, edge facing the swing
	AxeHandle = CFrame.Angles(math.pi, 0, 0), AxeHead = CFrame.Angles(math.pi, 0, 0),
}

-- Held items that read too small at gameplay distance.
local HELD_SCALE = { Slingshot = 1.7 }

local gearModel: Instance? = nil
local gearFlip = false

-- Finds the imported MenGear model and works out whether the importer turned it around.
function MenFactory.setGear(containers: { Instance }): boolean
	for _, c in containers do
		for _, d in c:GetDescendants() do
			if d:IsA("Model") and d:FindFirstChild("GearFront", true) and d:FindFirstChild("Headband", true) then
				gearModel = d
				local front = d:FindFirstChild("GearFront", true) :: BasePart
				local back = d:FindFirstChild("GearBack", true) :: BasePart
				gearFlip = front.Position.Z > back.Position.Z
				return true
			end
		end
	end
	return false
end

function MenFactory.gear(): Instance?
	return gearModel
end

local function weldTo(part: BasePart, target: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = target
	weld.Part1 = part
	weld.Parent = part
end

-- Clones a gear mesh and places it so its anchor lands on `anchorCFrame`.
local function placeGear(name: string, anchorCFrame: CFrame, scale: number, color: Color3, parent: Instance,
	attachTo: BasePart): BasePart?
	local data = Gear[name]
	local source = gearModel and gearModel:FindFirstChild(name, true)
	if not (data and source and source:IsA("BasePart")) then
		return nil
	end
	local part = source:Clone() :: BasePart
	part.Name = name
	part.Color = color
	if part:IsA("MeshPart") then
		part.TextureID = ""
	end
	part.Material = Enum.Material.SmoothPlastic
	part.Size = data.Size * scale
	local turn = if gearFlip then CFrame.Angles(0, math.pi, 0) else CFrame.identity
	-- bounds center = anchor - Anchor (anchor is stored relative to the center)
	part.CFrame = anchorCFrame * CFrame.new(-data.Anchor * scale) * turn
	part.Parent = parent
	weldTo(part, attachTo)
	return part
end

local function dress(model: Model, look: Units.Look)
	local head = model:FindFirstChild("Head") :: BasePart?
	local torso = model:FindFirstChild("UpperTorso") :: BasePart?
	local rHand = model:FindFirstChild("RightHand") :: BasePart?
	local lHand = model:FindFirstChild("LeftHand") :: BasePart?
	local folder = Instance.new("Folder")
	folder.Name = "Gear"
	folder.Parent = model

	if head and look.Hat then
		local s = head.Size.X / HEAD_WIDTH * 1.04
		placeGear(look.Hat, head.CFrame * CFrame.new(0, head.Size.Y / 2, 0), s, look.HatColor or Color3.new(1, 1, 1),
			folder, head)
		if look.Hat == "MedicCap" then
			placeGear("MedicCross", head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.2 * s, -0.62 * s), s,
				Color3.fromRGB(220, 40, 40), folder, head)
		elseif look.Hat == "BananaHat" then
			placeGear("BananaStem", head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.42 * s, 0), s,
				Color3.fromRGB(96, 66, 34), folder, head)
		elseif look.Hat == "OfficerCap" then
			placeGear("OfficerBadge", head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.05 * s, -0.68 * s), s,
				Color3.fromRGB(250, 196, 40), folder, head)
		end
	end
	local function hold(hand: BasePart?, items: { string }?, colors: { Color3 }?)
		if not (hand and items) then
			return
		end
		local grip = hand.CFrame * CFrame.new(0, -hand.Size.Y * 0.3, 0)
		for i, item in items do
			local rot = HOLD[item] or CFrame.identity
			placeGear(item, grip * rot, HELD_SCALE[item] or 1, (colors and colors[i]) or Color3.new(1, 1, 1), folder, hand)
		end
	end
	hold(rHand, look.Held, look.HeldColors)
	hold(lHand, look.LeftHeld, look.LeftHeldColors)
	if look.Wraps then
		for _, hand in { lHand, rHand } do
			if hand then
				local wrap = placeGear("HandWrap", hand.CFrame, 1, look.Wraps, folder, hand)
				if wrap then
					wrap.Size = hand.Size * Vector3.new(1.18, 0.9, 1.18)
					wrap.CFrame = hand.CFrame
				end
			end
		end
	end
	if torso and look.Badge then
		placeGear(look.Badge, torso.CFrame * CFrame.new(-torso.Size.X * 0.22, torso.Size.Y * 0.15, -torso.Size.Z / 2 - 0.03),
			1, look.BadgeColor or Color3.new(1, 1, 1), folder, torso)
	end
	if look.ShirtTemplate then
		local shirt = Instance.new("Shirt")
		shirt.ShirtTemplate = `rbxassetid://{look.ShirtTemplate}`
		shirt.Parent = model
	end
	if look.PantsTemplate then
		local pants = Instance.new("Pants")
		pants.PantsTemplate = `rbxassetid://{look.PantsTemplate}`
		pants.Parent = model
	end
	if look.Aura and torso then
		local att = Instance.new("Attachment")
		att.Name = "AuraAttachment"
		att.Parent = torso
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Name = "Aura"
		sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
		sparkle.LightEmission = 1
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Lifetime = NumberRange.new(0.6, 1)
		sparkle.Rate = 6
		sparkle.Speed = NumberRange.new(1, 2)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Parent = att
	end
end

-- Builds an avatar wearing a Look (no unit behaviour attached). Not parented.
function MenFactory.buildLook(name: string, look: Units.Look): Model
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = look.Skin
	desc.LeftArmColor = look.Skin
	desc.RightArmColor = look.Skin
	desc.TorsoColor = if look.ShirtTemplate then look.Skin else look.Shirt
	desc.LeftLegColor = if look.PantsTemplate then look.Skin else look.Pants
	desc.RightLegColor = desc.LeftLegColor
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = name
	dress(model, look)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	return model
end

-- Builds a unit model at a level. Not parented; caller places it.
function MenFactory.build(unitId: string, level: number): Model
	local unit = Units[unitId]
	assert(unit, `Unknown unit "{unitId}"`)
	local def = unit.Levels[level]
	assert(def, `{unitId} has no level {level}`)
	local model = MenFactory.buildLook(`{unitId}_L{level}`, def.Look)

	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanTouch = false
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	root.CanQuery = true -- clicks/taps on the unit select it
	model:SetAttribute("Unit", unitId)
	model:SetAttribute("Level", level)
	CollectionService:AddTag(model, MenFactory.TAG)
	return model
end

function MenFactory.playIdle(model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = IDLE_ANIMATION
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	if ok and track then
		track.Looped = true
		track:Play()
	end
end

return MenFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Remote events/functions in one place. The server creates them; clients wait for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local EVENTS = {
	"Hits", -- server -> all: { { id, damage, crit, kind } }
	"Deaths", -- server -> all: { { id, type, kind, pos, reward, owner } }
	"Attacks", -- server -> all: { { uid, kind, targetId, targetPos, travel, level } }
	"EnemyActs", -- server -> all: ability visuals { id, act, data }
	"GameEvent", -- server -> all: wave start/clear, boss, base hit, game over
	"UnitFx", -- server -> all: unit-side visuals (stun, rally, heal)
	"IntroDone", -- client -> server: finished or skipped the intro cutscene
}
local FUNCTIONS = { "PlaceUnit", "UpgradeUnit", "SellUnit" }

local folder: Folder

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local f = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
		if not f then
			local newFolder = Instance.new("Folder")
			newFolder.Name = "Remotes"
			for _, n in EVENTS do
				local e = Instance.new("RemoteEvent")
				e.Name = n
				e.Parent = newFolder
			end
			for _, n in FUNCTIONS do
				local f2 = Instance.new("RemoteFunction")
				f2.Name = n
				f2.Parent = newFolder
			end
			newFolder.Parent = ReplicatedStorage
			f = newFolder
		end
		folder = f :: Folder
	else
		folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return folder
end

function Net.event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.func(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">PathUtil</string>
          <string name="Source"><![CDATA[--!strict
-- Monkey routes as polylines measured in studs. Server and clients both turn an enemy's
-- "progress along its path" into a position with these functions, so they always agree.

local PathUtil = {}

export type Path = {
	name: string,
	points: { Vector3 },
	cum: { number }, -- distance from the start to each point
	length: number,
}

function PathUtil.new(name: string, points: { Vector3 }): Path
	local cum = { 0 }
	for i = 2, #points do
		cum[i] = cum[i - 1] + (points[i] - points[i - 1]).Magnitude
	end
	return { name = name, points = points, cum = cum, length = cum[#cum] }
end

-- Position and travel direction (unit vector, flat) at `distance` along the path.
function PathUtil.sample(path: Path, distance: number): (Vector3, Vector3)
	local pts, cum = path.points, path.cum
	local d = math.clamp(distance, 0, path.length)
	local i = 1
	-- paths are short (< 12 points), a linear scan is fastest
	while i < #pts - 1 and cum[i + 1] < d do
		i += 1
	end
	local a, b = pts[i], pts[i + 1]
	local segLen = cum[i + 1] - cum[i]
	local t = if segLen > 0 then (d - cum[i]) / segLen else 0
	local dir = b - a
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	return a:Lerp(b, t), flat.Unit
end

-- Position with a sideways lane offset so crowds spread across the trail.
function PathUtil.sampleLane(path: Path, distance: number, lane: number): (Vector3, Vector3)
	local pos, dir = PathUtil.sample(path, distance)
	local right = Vector3.new(-dir.Z, 0, dir.X)
	return pos + right * lane, dir
end

-- Flat distance from `pos` to the nearest segment of any path (placement checks).
function PathUtil.distanceToPaths(paths: { [string]: Path }, pos: Vector3): number
	local best = math.huge
	local p = Vector3.new(pos.X, 0, pos.Z)
	for _, path in paths do
		local pts = path.points
		for i = 1, #pts - 1 do
			local a = Vector3.new(pts[i].X, 0, pts[i].Z)
			local b = Vector3.new(pts[i + 1].X, 0, pts[i + 1].Z)
			local ab = b - a
			local len2 = ab:Dot(ab)
			local t = if len2 > 0 then math.clamp((p - a):Dot(ab) / len2, 0, 1) else 0
			best = math.min(best, (a + ab * t - p).Magnitude)
		end
	end
	return best
end

-- All map paths, built once from MapData.
function PathUtil.fromMapData(mapData: any): { [string]: Path }
	local out = {}
	for name, points in mapData.Paths do
		out[name] = PathUtil.new(name, points)
	end
	return out
end

return PathUtil
]]></string>
        </Properties>
      </Item>
