--!strict
-- Turns the imported Monkey mesh (assets/monkey/Monkey.fbx -> one MeshPart per body part)
-- into a moving character: HumanoidRootPart + Motor6D joints + Humanoid.
-- Part sizes/joint pivots come from RigData.Monkey (generated by the Blender script), so the
-- result is the same whatever unit scale the 3D Importer used.

local CollectionService = game:GetService("CollectionService")

local RigData = require(script.Parent.RigData.Monkey)

local MonkeyRig = {}

MonkeyRig.TAG = "Monkey"

-- body part -> { parent part, joint name } (R6-style names so animations read naturally)
local JOINTS = {
	Torso = { "HumanoidRootPart", "RootJoint" },
	Head = { "Torso", "Neck" },
	LeftArm = { "Torso", "Left Shoulder" },
	RightArm = { "Torso", "Right Shoulder" },
	LeftLeg = { "Torso", "Left Hip" },
	RightLeg = { "Torso", "Right Hip" },
}

local ROOT_HEIGHT = RigData.Parts.Torso.Pivot.Y

-- Finds the imported mesh model: anything with the Monkey's Torso and FrontMarker inside.
function MonkeyRig.findImported(...: Instance): Model?
	for _, container in { ... } do
		for _, d in container:GetDescendants() do
			if d:IsA("Model") and d:FindFirstChild("FrontMarker", true) and d:FindFirstChild("Torso", true) then
				return d
			end
		end
	end
	return nil
end

-- The importer may bring the mesh in facing +Z instead of Roblox's -Z. FrontMarker is a tiny
-- part modelled in front of the feet, so if it lands behind the torso every part needs a half turn.
function MonkeyRig.needsFlip(meshModel: Model): boolean
	local marker = meshModel:FindFirstChild("FrontMarker", true) :: BasePart
	local torso = meshModel:FindFirstChild("Torso", true) :: BasePart
	return (marker.Position.Z - torso.Position.Z) > 0.05
end

function MonkeyRig.build(meshModel: Model, textureId: string?): Model
	local flip = MonkeyRig.needsFlip(meshModel)
	local turn = if flip then CFrame.Angles(0, math.pi, 0) else CFrame.identity

	local model = Instance.new("Model")
	model.Name = "Monkey"

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.CanCollide = true
	root.CFrame = CFrame.new(0, ROOT_HEIGHT, 0)
	root.Parent = model
	model.PrimaryPart = root

	local parts: { [string]: BasePart } = { HumanoidRootPart = root }
	for name, data in RigData.Parts do
		local source = meshModel:FindFirstChild(name, true)
		assert(source and source:IsA("BasePart"), `Imported monkey is missing part "{name}"`)
		local part = source:Clone() :: BasePart
		part.Anchored = false
		part.CanCollide = false
		part.CanQuery = false
		part.Massless = true
		part.Size = data.Size
		part.CFrame = CFrame.new(data.Center) * turn
		if textureId and part:IsA("MeshPart") then
			part.TextureID = textureId
		end
		part.Parent = model
		parts[name] = part
	end

	for name, joint in JOINTS do
		if not parts[name] then
			continue
		end
		local part0, part1 = parts[joint[1]], parts[name]
		local pivot = CFrame.new(RigData.Parts[name].Pivot)
		local motor = Instance.new("Motor6D")
		motor.Name = joint[2]
		motor.Part0 = part0
		motor.Part1 = part1
		motor.C0 = part0.CFrame:Inverse() * pivot
		motor.C1 = part1.CFrame:Inverse() * pivot
		motor.Parent = part0
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = ROOT_HEIGHT - root.Size.Y / 2
	humanoid.WalkSpeed = 9
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = model

	CollectionService:AddTag(model, MonkeyRig.TAG)
	return model
end

-- Places a built monkey with its feet on `feet` (a CFrame on the ground, facing its LookVector).
function MonkeyRig.place(model: Model, feet: CFrame)
	model:PivotTo(feet * CFrame.new(0, ROOT_HEIGHT, 0))
end

return MonkeyRig
