        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">MenGear</string>
            <string name="Source"><![CDATA[-- Generated by tools/blender/build_gear.py. Do not edit by hand.
-- Native mesh bounds in studs (Roblox axes). RingCenter is the band's ring centre relative to the bounds centre.
return {
	Headband = { Size = Vector3.new(1.072, 0.524, 1.198), RingCenter = Vector3.new(-0.000, 0.117, -0.063), RingDiameter = 1.0 },
	HandWrap = { Size = Vector3.new(1.040, 1.000, 1.040) },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Monkey</string>
            <string name="Source"><![CDATA[-- Generated by tools/blender/build_monkey.py. Do not edit by hand.
-- Rest-pose layout of the imported Monkey mesh, in studs, relative to the feet (Roblox axes).
return {
	Height = 5.312,
	Parts = {
		LeftLeg = { Size = Vector3.new(1.000, 2.000, 1.000), Center = Vector3.new(-0.500, 1.000, 0.000), Pivot = Vector3.new(-0.500, 2.000, 0.000) },
		RightLeg = { Size = Vector3.new(1.000, 2.000, 1.000), Center = Vector3.new(0.500, 1.000, 0.000), Pivot = Vector3.new(0.500, 2.000, 0.000) },
		Torso = { Size = Vector3.new(2.000, 2.000, 1.000), Center = Vector3.new(0.000, 3.000, 0.000), Pivot = Vector3.new(0.000, 3.000, 0.000) },
		LeftArm = { Size = Vector3.new(1.000, 2.000, 1.000), Center = Vector3.new(-1.500, 3.000, 0.000), Pivot = Vector3.new(-1.500, 3.500, 0.000) },
		RightArm = { Size = Vector3.new(1.000, 2.000, 1.000), Center = Vector3.new(1.500, 3.000, 0.000), Pivot = Vector3.new(1.500, 3.500, 0.000) },
		Head = { Size = Vector3.new(1.460, 1.250, 1.240), Center = Vector3.new(0.000, 4.625, 0.000), Pivot = Vector3.new(0.000, 4.000, 0.000) },
		Tail = { Size = Vector3.new(0.280, 3.348, 1.936), Center = Vector3.new(0.000, 3.638, 1.365), Pivot = Vector3.new(0.000, 2.350, 0.450) },
	},
}
]]></string>
          </Properties>
        </Item>
