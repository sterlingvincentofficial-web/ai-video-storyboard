      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">MenFactory</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the placeable men as real Roblox avatars (HumanoidDescription -> R15 model),
-- dressed from Units.luau and fitted with gear meshes from assets/men/MenGear.fbx.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local GearData = require(script.Parent.RigData.MenGear)
local Units = require(script.Parent.Units)

local MenFactory = {}

MenFactory.TAG = "Man"

-- Roblox's own R15 idle animation, so the men breathe instead of standing frozen.
local IDLE_ANIMATION = "rbxassetid://507766388"

local function weldTo(part: BasePart, target: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = target
	weld.Part1 = part
	weld.Parent = part
end

local function addHeadband(model: Model, gear: Instance?, color: Color3, flip: boolean)
	local head = model:FindFirstChild("Head") :: BasePart?
	local source = gear and gear:FindFirstChild("Headband", true)
	if not (head and source and source:IsA("BasePart")) then
		return
	end
	local data = GearData.Headband
	-- scale the ring to wrap the head, then sit it across the forehead
	local scale = head.Size.X * 1.04 / data.RingDiameter
	local band = source:Clone() :: BasePart
	band.Name = "Headband"
	band.Color = color
	band.Size = data.Size * scale
	local turn = if flip then CFrame.Angles(0, math.pi, 0) else CFrame.identity
	local ring = head.CFrame * CFrame.new(0, head.Size.Y * 0.16, 0)
	band.CFrame = ring * turn * CFrame.new(-data.RingCenter * scale)
	band.Parent = model
	weldTo(band, head)
end

local function addHandWraps(model: Model, gear: Instance?, color: Color3)
	local source = gear and gear:FindFirstChild("HandWrap", true)
	for _, handName in { "LeftHand", "RightHand" } do
		local hand = model:FindFirstChild(handName) :: BasePart?
		if not hand then
			continue
		end
		local wrap: BasePart
		if source and source:IsA("BasePart") then
			wrap = source:Clone() :: BasePart
		else
			local block = Instance.new("Part") -- no imported gear yet: plain block wraps
			block.TopSurface = Enum.SurfaceType.Smooth
			block.BottomSurface = Enum.SurfaceType.Smooth
			wrap = block
		end
		wrap.Name = handName .. "Wrap"
		wrap.Color = color
		wrap.Size = hand.Size * Vector3.new(1.15, 0.85, 1.15)
		wrap.CFrame = hand.CFrame
		wrap.Parent = model
		weldTo(wrap, hand)
	end
end

local function dress(model: Model, look: Units.Look)
	if look.ShirtTemplate then
		local shirt = Instance.new("Shirt")
		shirt.ShirtTemplate = `rbxassetid://{look.ShirtTemplate}`
		shirt.Parent = model
	end
	if look.PantsTemplate then
		local pants = Instance.new("Pants")
		pants.PantsTemplate = `rbxassetid://{look.PantsTemplate}`
		pants.Parent = model
	end
end

-- gear: the imported MenGear model (or nil). flip: same answer MonkeyRig.needsFlip gave for the
-- import, since both FBX files come out of the same Blender export settings.
function MenFactory.build(unitId: string, level: number, gear: Instance?, flip: boolean?): Model
	local unit = (Units :: any)[unitId]
	assert(unit, `Unknown unit "{unitId}"`)
	local def = unit.Levels[level]
	assert(def, `{unitId} has no level {level}`)
	local look: Units.Look = def.Look

	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = look.Skin
	desc.LeftArmColor = look.Skin
	desc.RightArmColor = look.Skin
	-- with a template the cloth covers these; without one the colors fake the outfit
	desc.TorsoColor = if look.ShirtTemplate then look.Skin else look.ShirtColor
	desc.LeftLegColor = if look.PantsTemplate then look.Skin else look.PantsColor
	desc.RightLegColor = desc.LeftLegColor

	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = `{unitId}_L{level}`
	dress(model, look)
	for _, item in look.Gear do
		if item == "Headband" then
			addHeadband(model, gear, look.HeadbandColor or Color3.new(1, 0, 0), flip == true)
		elseif item == "HandWraps" then
			addHandWraps(model, gear, look.WrapColor or Color3.new(1, 1, 1))
		end
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	model:SetAttribute("Unit", unitId)
	model:SetAttribute("Level", level)
	CollectionService:AddTag(model, MenFactory.TAG)
	return model
end

function MenFactory.playIdle(model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local anim = Instance.new("Animation")
	anim.AnimationId = IDLE_ANIMATION
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	if ok and track then
		track.Looped = true
		track:Play()
	end
end

return MenFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">MonkeyRig</string>
          <string name="Source"><![CDATA[--!strict
-- Turns the imported Monkey mesh (assets/monkey/Monkey.fbx -> one MeshPart per body part)
-- into a moving character: HumanoidRootPart + Motor6D joints + Humanoid.
-- Part sizes/joint pivots come from RigData.Monkey (generated by the Blender script), so the
-- result is the same whatever unit scale the 3D Importer used.

local CollectionService = game:GetService("CollectionService")

local RigData = require(script.Parent.RigData.Monkey)

local MonkeyRig = {}

MonkeyRig.TAG = "Monkey"

-- body part -> { parent part, joint name } (R6-style names so animations read naturally)
local JOINTS = {
	Torso = { "HumanoidRootPart", "RootJoint" },
	Head = { "Torso", "Neck" },
	LeftArm = { "Torso", "Left Shoulder" },
	RightArm = { "Torso", "Right Shoulder" },
	LeftLeg = { "Torso", "Left Hip" },
	RightLeg = { "Torso", "Right Hip" },
	Tail = { "Torso", "Tail" },
}

local ROOT_HEIGHT = RigData.Parts.Torso.Pivot.Y

-- Finds the imported mesh model: anything named "Monkey" with a Tail MeshPart inside.
function MonkeyRig.findImported(...: Instance): Model?
	for _, container in { ... } do
		for _, d in container:GetDescendants() do
			if d:IsA("Model") and d:FindFirstChild("Tail", true) and d:FindFirstChild("Torso", true) then
				return d
			end
		end
	end
	return nil
end

-- The importer may bring the mesh in facing +Z instead of Roblox's -Z. Our tail sits behind the
-- torso, so if it comes in on the -Z side every part needs a half turn.
function MonkeyRig.needsFlip(meshModel: Model): boolean
	local tail = meshModel:FindFirstChild("Tail", true) :: BasePart
	local torso = meshModel:FindFirstChild("Torso", true) :: BasePart
	return (tail.Position.Z - torso.Position.Z) < -0.05
end

function MonkeyRig.build(meshModel: Model, textureId: string?): Model
	local flip = MonkeyRig.needsFlip(meshModel)
	local turn = if flip then CFrame.Angles(0, math.pi, 0) else CFrame.identity

	local model = Instance.new("Model")
	model.Name = "Monkey"

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.CanCollide = true
	root.CFrame = CFrame.new(0, ROOT_HEIGHT, 0)
	root.Parent = model
	model.PrimaryPart = root

	local parts: { [string]: BasePart } = { HumanoidRootPart = root }
	for name, data in RigData.Parts do
		local source = meshModel:FindFirstChild(name, true)
		assert(source and source:IsA("BasePart"), `Imported monkey is missing part "{name}"`)
		local part = source:Clone() :: BasePart
		part.Anchored = false
		part.CanCollide = false
		part.CanQuery = false
		part.Massless = true
		part.Size = data.Size
		part.CFrame = CFrame.new(data.Center) * turn
		if textureId and part:IsA("MeshPart") then
			part.TextureID = textureId
		end
		part.Parent = model
		parts[name] = part
	end

	for name, joint in JOINTS do
		local part0, part1 = parts[joint[1]], parts[name]
		local pivot = CFrame.new(RigData.Parts[name].Pivot)
		local motor = Instance.new("Motor6D")
		motor.Name = joint[2]
		motor.Part0 = part0
		motor.Part1 = part1
		motor.C0 = part0.CFrame:Inverse() * pivot
		motor.C1 = part1.CFrame:Inverse() * pivot
		motor.Parent = part0
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = ROOT_HEIGHT - root.Size.Y / 2
	humanoid.WalkSpeed = 9
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = model

	CollectionService:AddTag(model, MonkeyRig.TAG)
	return model
end

-- Places a built monkey with its feet on `feet` (a CFrame on the ground, facing its LookVector).
function MonkeyRig.place(model: Model, feet: CFrame)
	model:PivotTo(feet * CFrame.new(0, ROOT_HEIGHT, 0))
end

return MonkeyRig
]]></string>
        </Properties>
      </Item>
